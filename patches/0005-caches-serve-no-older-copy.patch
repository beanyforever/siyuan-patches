diff --git a/kernel/filesys/tree_fill_during_write_test.go b/kernel/filesys/tree_fill_during_write_test.go
new file mode 100644
index 0000000..40c2361
--- /dev/null
+++ b/kernel/filesys/tree_fill_during_write_test.go
@@ -0,0 +1,125 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
