+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// Challenges to step 6 of issue #43, on lost writes and coverage: each test shows a job's save, or a writer's own
+// change, lost by one of the 18 entry points although the entry point now takes its turn. How the tests interleave a
+// job with a writer is in turns_fts5_test.go.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// challengeEditOperation is the editor's update of paragraph id: its text becomes text, its attributes attrs.
+func challengeEditOperation(id, text string, attrs map[string]string) *Operation {
+	var names []string
+	for name := range attrs {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var b strings.Builder
+	fmt.Fprintf(&b, `<div data-node-id="%s" data-type="NodeParagraph"`, id)
+	for _, name := range names {
+		fmt.Fprintf(&b, ` %s="%s"`, name, attrs[name])
+	}
+	fmt.Fprintf(&b, `><div contenteditable="true">%s</div></div>`, text)
+	return &Operation{Action: "update", ID: id, Data: b.String()}
+}
+
+// challengeBlockText is the text of block id in the page rootID, as the page's file holds it.
+func challengeBlockText(t *testing.T, rootID, id string) string {
+	t.Helper()
+	node := treenode.GetNodeInTree(pageFile(t, rootID), id)
+	if nil == node {
+		return "(no such block)"
+	}
+	return getNodeRefText0(node, 1024, false)
+}
+
+// challengeRow is the row of database avID bound to block boundID, as the database's file holds it.
+func challengeRow(t *testing.T, avID, boundID string) *av.ValueBlock {
+	t.Helper()
+	data, err := os.ReadFile(av.GetAttributeViewDataPath(avID))
+	if nil != err {
+		t.Fatalf("read database %s's file: %v", avID, err)
+	}
+	attrView := &av.AttributeView{}
+	if err = json.Unmarshal(data, attrView); nil != err {
+		t.Fatalf("parse database %s's file: %v", avID, err)
+	}
+	value := attrView.GetBlockValueByBoundID(boundID)
+	if nil == value || nil == value.Block {
+		return &av.ValueBlock{Content: "(no row)"}
+	}
+	return value.Block
+}
+
+// challengeWaitFor polls cond every 20 ms for at most d, and reports whether it held.
+func challengeWaitFor(d time.Duration, cond func() bool) bool {
+	for deadline := time.Now().Add(d); time.Now().Before(deadline); time.Sleep(20 * time.Millisecond) {
+		if cond() {
+			return true
+		}
+	}
+	return cond()
+}
+
+// The dynamic reference texts and database rows that SiYuan refreshes after a block or a page changes are computed
+// from the definition as the caller read it, before the refresh's turns: the renamed page the ref-text job was handed
+// at the rename (9), the page ReloadProtyle loads before its turns (10), and the block setBlockAttrs read in its own,
+// finished turn, which its row-text goroutine uses (1). A change to the definition saved in between, by a job or by
+// another writer, has already refreshed the references and rows with the new text; the late refresh then writes the
+// old text over them, in a turn of its own. Nothing refreshes them again until the definition next changes.
+func TestStep6ChallengeWritesRefreshesComputeFromADefinitionReadBeforeTheirTurn(t *testing.T) {
+	// The owner renames a page that is a row, then gives it an icon within the 3 s before the ref-text job runs.
+	// setBlockAttrs' row-text update puts the icon in the row; the ref-text job, holding the page as it was at the
+	// rename, takes it out again.
+	t.Run("the ref-text job after a rename (9)", func(t *testing.T) {
+		r := setupTurnReadsDatabase(t)
+		dropQueuedRefTextRenames(t)
+		dropRefTextRetries(t)
+		if err := RenameDoc(r.files.box.ID, "/"+r.pageID+".sy", "Renamed entry"); nil != err {
+			t.Fatal(err)
+		}
+		if err := SetBlockAttrs(r.pageID, map[string]string{"icon": "1f600"}); nil != err {
+			t.Fatal(err)
+		}
+		if !challengeWaitFor(10*time.Second, func() bool { return "1f600" == challengeRow(t, r.db.avID, r.pageID).Icon }) {
+			t.Fatalf("setup: setBlockAttrs' row-text update didn't put the icon in the row: %+v",
+				challengeRow(t, r.db.avID, r.pageID))
+		}
+		runRefTextJob(func() bool { return true })
+		FlushTxQueue()
+		checkPageAttr(t, "after the ref-text job", r.pageID, "icon", "1f600")
+		row := challengeRow(t, r.db.avID, r.pageID)
+		if "1f600" != row.Icon || "Renamed entry" != row.Content {
+			t.Errorf("after the ref-text job, the database's file holds the row of the page (icon 1f600, title "+
+				"Renamed entry) with icon %q and text %q: the job wrote the page as it was at the rename over "+
+				"setBlockAttrs' update of the row", row.Icon, row.Content)
+		}
+	})
+
+	// A job edits a paragraph that two pages refer to dynamically and that is a database row, after ReloadProtyle has
+	// read the paragraph's page and while it refreshes. The job's commit refreshes both references and the row with
+	// the new text; ReloadProtyle's later turns write the old text back.
+	t.Run("the refresh after a move (10)", func(t *testing.T) {
+		f := setupTurnRefTextFixture(t)
+		source2 := addFileOperationTestDoc(t, f.files, "20261018160000-source2", "Source two", false)
+		ref2 := addTurnRef(source2, f.definition.ID, "d", "Original text")
+		writeTurnPage(t, source2)
+		edit := challengeEditOperation(f.definition.ID, "Edited text", map[string]string{av.NodeAttrNameAvs: f.db.avID})
+		job := newTurnJob()
+		setTurnHook(t, job, &testHookRefTextRefTreeLoaded, func(rootID string) {
+			if f.files.sourceID == rootID || source2.ID == rootID {
+				job.send(edit)
+			}
+		})
+		job.run(t, "the refresh after a move", func() { ReloadProtyle(f.files.targetID) })
+
+		if got := challengeBlockText(t, f.files.targetID, f.definition.ID); "Edited text" != got {
+			t.Fatalf("setup: the job's edit isn't in the paragraph, which holds %q", got)
+		}
+		want := f.definition.ID + " Edited text"
+		for _, ref := range []struct{ rootID, id string }{{f.files.sourceID, f.ref.ID}, {source2.ID, ref2.ID}} {
+			if got := refText(t, ref.rootID, ref.id); want != got {
+				t.Errorf("after the refresh, with a job's edit of the paragraph during it (%s), page %s holds the "+
+					"reference %q, want %q: the refresh wrote the paragraph's text as it read it before its turn",
+					job.where(), ref.rootID, got, want)
+			}
+		}
+		if got := challengeRow(t, f.db.avID, f.definition.ID).Content; "Edited text" != got {
+			t.Errorf("after the refresh, with a job's edit of the paragraph during it (%s), the database's file holds "+
+				"the paragraph's row as %q, want Edited text", job.where(), got)
+		}
+	})
+
+	// setBlockAttrs gives a paragraph that is a database row an icon. A job queued while setBlockAttrs holds its turn
+	// edits the paragraph's text; its commit puts the new text in the row. setBlockAttrs' row-text goroutine, which
+	// takes its turn after, puts back the text setBlockAttrs read.
+	t.Run("setBlockAttrs' row-text update (1)", func(t *testing.T) {
+		f := setupTurnRefTextFixture(t)
+		var rowReads atomic.Int32
+		testHookAttributeViewBlockTextRead = func(avID string) {
+			if f.db.avID == avID {
+				rowReads.Add(1)
+			}
+		}
+		t.Cleanup(func() { testHookAttributeViewBlockTextRead = nil })
+		attrs := map[string]string{av.NodeAttrNameAvs: f.db.avID, "icon": "1f600"}
+		job := newTurnJob()
+		setTurnHook(t, job, &testHookSetBlockAttrsLoaded, func() {
+			job.send(challengeEditOperation(f.definition.ID, "Edited text", attrs))
+		})
+		job.run(t, "setBlockAttrs", func() {
+			if err := SetBlockAttrs(f.definition.ID, map[string]string{"icon": "1f600"}); nil != err {
+				t.Fatal(err)
+			}
+		})
+		// The job's commit and setBlockAttrs' goroutine each read the database once; then the goroutine's turn ends.
+		if !challengeWaitFor(10*time.Second, func() bool { return 2 <= rowReads.Load() }) {
+			t.Fatalf("setup: the database's rows were read %d times, want 2 (the job's commit, setBlockAttrs' "+
+				"row-text update)", rowReads.Load())
+		}
+		flushLock.Lock() // waits for the goroutine's turn to end
+		flushLock.Unlock()
+		time.Sleep(300 * time.Millisecond)
+
+		if got := challengeBlockText(t, f.files.targetID, f.definition.ID); "Edited text" != got {
+			t.Errorf("after setBlockAttrs, with a job's edit of the paragraph during it (%s), the paragraph holds %q, "+
+				"want Edited text", job.where(), got)
+		}
+		row := challengeRow(t, f.db.avID, f.definition.ID)
+		if "Edited text" != row.Content {
+			t.Errorf("after setBlockAttrs, with a job's edit of the paragraph during it (%s), the database's file "+
+				"holds the paragraph's row as %q (icon %q), want Edited text: the row-text update wrote the text "+
+				"setBlockAttrs read in its finished turn", job.where(), row.Content, row.Icon)
+		}
+	})
+}
+
+// A page restored from a snapshot through /api/repo/rollbackRepoSnapshotFile first takes a snapshot of the current
+// data ("Backup before checkout"), outside any turn, since a snapshot waits for the job queue; its turn comes after.
+// A job saved between the backup and the turn is in neither: the backup was taken before it, and the restore writes the
+// snapshot's copy over it. The acceptance test's hook sits inside the turn, after this window.
+func TestStep6ChallengeWritesOnePageSnapshotRestoreKeepsAJobSavedAfterItsBackup(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	originalRepoDir := util.RepoDir
+	util.RepoDir = filepath.Join(util.WorkspaceDir, "repo")
+	t.Cleanup(func() { util.RepoDir = originalRepoDir })
+	Conf.Repo.Store(&conf.Repo{Key: bytes.Repeat([]byte{7}, 32)}) // snapshots need the repository's key
+	Conf.System.Store(&conf.System{ID: "20261018160000-device1", Name: "test", OS: "linux"})
+	originalStatusBar := util.StatusBarCfg.Load()
+	util.StatusBarCfg.Store(util.NewStatusBar(false))
+	t.Cleanup(func() { util.StatusBarCfg.Store(originalStatusBar) })
+
+	snapshotID, err := IndexRepo("before the Type changed")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	index, err := repo.GetIndex(snapshotID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	repoPath := "/" + boxID + pagePath
+	fileID := ""
+	for _, id := range index.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if repoPath == file.Path {
+			fileID = id
+		}
+	}
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no %s", repoPath)
+	}
+	// A snapshot tells a changed file by its path and its modification time in whole seconds: the change waits for the
+	// next second, so the restore's backup takes a copy of its own.
+	time.Sleep(1100 * time.Millisecond)
+	setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "project")
+
+	job := newTurnJob()
+	setTurnHook(t, job, &testHookRollbackRepoSnapshotFileBackedUp, func() { job.send(pageJob(restoreCachePageID)...) })
+	job.run(t, "the one-page snapshot restore", func() {
+		if err = RollbackRepoSnapshotFile(fileID); nil != err {
+			t.Fatalf("roll the page back to the snapshot failed: %v", err)
+		}
+	})
+	checkPageAttr(t, "after the one-page snapshot restore", restoreCachePageID, "custom-object-type", "note")
+
+	inPage := pageFile(t, restoreCachePageID).Root.IALAttr(turnJobAttr)
+	latest, err := repo.Latest()
+	if nil != err {
+		t.Fatal(err)
+	}
+	if "Backup before checkout" != latest.Memo {
+		t.Fatalf("setup: the latest snapshot is %q (%s), not the restore's backup", latest.Memo, latest.ID)
+	}
+	inBackup, typeInBackup := "(no copy of the page)", ""
+	for _, id := range latest.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if repoPath != file.Path {
+			continue
+		}
+		data, openErr := repo.OpenFile(file)
+		if nil != openErr {
+			t.Fatal(openErr)
+		}
+		tree, parseErr := filesys.LoadTreeByData(data, boxID, pagePath, util.NewLute())
+		if nil != parseErr {
+			t.Fatal(parseErr)
+		}
+		inBackup, typeInBackup = tree.Root.IALAttr(turnJobAttr), tree.Root.IALAttr("custom-object-type")
+	}
+	if "project" != typeInBackup {
+		t.Fatalf("setup: the restore's backup holds the page with custom-object-type=%q, want project, its value "+
+			"when the restore began", typeInBackup)
+	}
+	if turnJobValue != inPage && turnJobValue != inBackup {
+		t.Errorf("a job's save made after the restore's backup snapshot and before its write (%s) is lost: the page "+
+			"holds %s=%q, and the backup snapshot %q (%s) holds %q", job.where(), turnJobAttr, inPage, latest.Memo,
+			latest.ID, inBackup)
+	}
+}
+
+// /api/block/transferBlockRef finds the pages holding the refs, then moves the refs page by page, each in a short turn
+// that reads the page's refs again. A ref the turn finds on another page than the one it was grouped under (a job moved
+// its block meanwhile) is moved on that page's copy too, but only the last page the turn read is saved. polka's
+// merge_objects transfers a duplicate's refs this way.
+func TestStep6ChallengeWritesTransferBlockRefMovesARefWhoseBlockChangedPage(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	from := addFileOperationTestDoc(t, files, "20261018160000-frompg1", "From", false)
+	to := addFileOperationTestDoc(t, files, "20261018160000-topage1", "To", false)
+	firstID, secondID := files.sourceID, files.targetID
+	if secondID < firstID {
+		firstID, secondID = secondID, firstID
+	}
+	first, err := LoadTreeByBlockID(firstID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	r1 := addTurnRef(first, from.ID, "d", "From")
+	writeTurnPage(t, first)
+	second, err := LoadTreeByBlockID(secondID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	r3 := addTurnRef(second, from.ID, "d", "From")
+	r4 := addTurnRef(second, from.ID, "d", "From")
+	writeTurnPage(t, second)
+
+	// While the first page's refs move, a job moves r3 from the second page to the first, after r1.
+	job := newTurnJob()
+	setTurnHook(t, job, &testHookTransferBlockRefLoaded, func() {
+		job.send(&Operation{Action: "move", ID: r3.ID, PreviousID: r1.ID})
+	})
+	job.run(t, "transferBlockRef", func() {
+		if err = TransferBlockRef(from.ID, to.ID, nil); nil != err {
+			t.Fatal(err)
+		}
+	})
+
+	firstFile, secondFile := pageFile(t, firstID), pageFile(t, secondID)
+	if nil == treenode.GetNodeInTree(firstFile, r3.ID) || nil != treenode.GetNodeInTree(secondFile, r3.ID) {
+		t.Errorf("after transferBlockRef, with a job moving a ref's block to another page during it (%s), the "+
+			"block isn't where the job moved it: on the first page %v, on the second page %v", job.where(),
+			nil != treenode.GetNodeInTree(firstFile, r3.ID), nil != treenode.GetNodeInTree(secondFile, r3.ID))
+	}
+	want := to.ID + " To"
+	for _, ref := range []*ast.Node{r1, r3, r4} {
+		for _, page := range []*parse.Tree{firstFile, secondFile} {
+			if nil == treenode.GetNodeInTree(page, ref.ID) {
+				continue
+			}
+			if got := turnRefs(page, ref.ID); 1 != len(got) || want != got[0] {
+				t.Errorf("after transferBlockRef, with a job moving a ref's block to another page during it (%s), "+
+					"block %s on page %s refers to %q, want %q: its page's change wasn't saved", job.where(), ref.ID,
+					page.ID, got, want)
+			}
+		}
+	}
+}
