+func TestTurnsCountTheirHolders(t *testing.T) {
+	if InTurn() {
+		t.Fatal("in a turn before any was entered")
+	}
+	EnterTurn()
+	EnterTurn()
+	LeaveTurn()
+	if !InTurn() {
+		t.Fatal("not in a turn while one holder is left")
+	}
+	LeaveTurn()
+	if InTurn() {
+		t.Fatal("still in a turn after every holder left")
+	}
+}
