 			if err = filelock.Remove(filepath.Join(util.DataDir, boxID, workingDoc.Path)); err != nil {
@@ -520,6 +526,24 @@ func RollbackDocHistory(historyPath string) (err error) {
 	return nil
 }
 
+// dropRestoredPageBlockIALs drops the cached attributes of every block of a page a restore has just written, as
+// deleting a page does: the blocks the page held before, as the block index listed them, and those of the restored
+// version. The write caches the page's copy and its page attributes but no block's attributes, so without this
+// getBlockAttrs would serve the ones from before the restore, custom-object-type and custom-avs among them, a block
+// deleted since would come back with the attributes it had then, and a block the restore removed would keep what an
+// edit cached under its bare id. A block fill that read the page before the write is refused by the write itself.
+func dropRestoredPageBlockIALs(oldBlocks []*treenode.BlockTree, tree *parse.Tree) {
+	for _, blockTree := range oldBlocks {
+		cache.RemoveBlockIAL(blockTree.ID)
+	}
+	ast.Walk(tree.Root, func(n *ast.Node, entering bool) ast.WalkStatus {
+		if entering && "" != n.ID {
+			cache.RemoveBlockIAL(n.ID)
+		}
+		return ast.WalkContinue
+	})
+}
