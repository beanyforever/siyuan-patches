+const (
+	searchCachePageID        = "20261016120000-needles"
+	searchCacheParagraphID   = "20261016120001-longpar"
+	searchCacheHPath         = "/Needle notes"
+	searchCacheParagraphName = "needle list"
+)
+
+// setupSearchCacheTest indexes one page, "Needle notes", holding one paragraph far longer than any search result,
+// which mentions needle at its start and is named "needle list", and returns the fixture and the paragraph's text.
+func setupSearchCacheTest(t *testing.T) (files *fileOperationTestFixture, paragraph string) {
+	t.Helper()
+	files = setupStructureTransactionTest(t)
+	setupFoldTransactionDatabase(t, files)
+	Conf.Search.Store(conf.NewSearch())
+	sql.ClearCache()
+	t.Cleanup(sql.ClearCache)
+
+	words := []string{"needle"}
+	for i := range 1000 {
+		words = append(words, "word"+strconv.Itoa(i))
+	}
+	paragraph = strings.Join(words, " ")
+	tree := treenode.NewTree(files.box.ID, "/"+searchCachePageID+".sy", searchCacheHPath, "Needle notes")
+	node := treenode.NewParagraph(searchCacheParagraphID)
+	node.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(paragraph)})
+	node.SetIALAttr("name", searchCacheParagraphName)
+	tree.Root.FirstChild.Unlink() // the empty paragraph a new page starts with
+	tree.Root.AppendChild(node)
+	if _, err := filesys.WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	treenode.UpsertBlockTree(tree)
+	sql.IndexTreeQueue(tree)
+	sql.FlushQueue()
+	t.Cleanup(func() {
+		cache.RemoveTreeData(tree.ID)
+		cache.RemoveDocIAL(tree.Path)
+	})
+	if b := sql.GetBlock(searchCacheParagraphID); nil == b || paragraph != b.Content || searchCacheParagraphName != b.Name {
+		t.Fatalf("setup: SQL doesn't hold the paragraph whole: %+v", b)
+	}
+	sql.ClearCache()
+	return
+}
+
+// checkWholeBlocks reads the page and its paragraph as GetBlock serves them to the backlinks panel and ref text, once
+// ristretto has taken in whatever the search queued, and checks they read whole, with no search marks.
+func checkWholeBlocks(t *testing.T, paragraph, after string) {
+	t.Helper()
+	time.Sleep(100 * time.Millisecond) // let ristretto take in what the search queued
+	marked := func(b *sql.Block) (fields []string) {
+		for name, value := range map[string]string{"hpath": b.HPath, "name": b.Name, "alias": b.Alias, "memo": b.Memo,
+			"tag": b.Tag, "content": b.Content, "ial": b.IAL} {
+			if strings.Contains(value, search.SearchMarkLeft) || strings.Contains(value, search.SearchMarkRight) {
+				fields = append(fields, name)
+			}
+		}
+		return
+	}
+	for _, id := range []string{searchCachePageID, searchCacheParagraphID} {
+		b := sql.GetBlock(id)
+		if nil == b {
+			t.Errorf("after %s, GetBlock finds no block %s", after, id)
+			continue
+		}
+		if fields := marked(b); 0 < len(fields) {
+			t.Errorf("after %s, GetBlock gives block %s with search marks in %v: hpath %q", after, id, fields, b.HPath)
+		}
+		if searchCacheHPath != b.HPath {
+			t.Errorf("after %s, GetBlock gives block %s the hpath %q, not %q", after, id, b.HPath, searchCacheHPath)
+		}
+	}
+	if b := sql.GetBlock(searchCacheParagraphID); nil != b && paragraph != b.Content {
+		t.Errorf("after %s, GetBlock gives the paragraph not as stored, %d characters of %d, ending %q",
+			after, len(b.Content), len(paragraph), b.Content[max(0, len(b.Content)-24):])
+	}
+}
+
+// A full-text search, a block-ref search, and opening a page from a search, that match a block longer than their
+// results leave the block reading whole everywhere else. On SiYuan v3.8.7 each stores the rows it read,
+// cut to a snippet or marked up for display, in SQL's block cache, which GetBlock reads first: the paragraph then reads
+// cut short, or with search marks in its name, until it changes or the cache is cleared. The full-text search does this
+// on its FTS route (fullTextSearchByFTSInBox), which a keyword search takes when it doesn't search paths and a
+// query-syntax search always takes; a one-word keyword search that also searches paths, the default, reads its rows as
+// maps and stores none. Opening a page with a search's query highlights its keywords (highlightByFTSInBox), whose rows
+// hold each matched field whole, with marks.
+func TestSearchLeavesBlocksWhole(t *testing.T) {
+	noPaths := false
+	for _, c := range []struct {
+		name    string
+		options BlockSearchOptions
+	}{
+		{"keyword search without paths", BlockSearchOptions{Query: "needle", Method: 0, Page: 1, PageSize: 10, SearchHPath: &noPaths}},
+		{"query-syntax search", BlockSearchOptions{Query: "needle", Method: 1, Page: 1, PageSize: 10}},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			_, paragraph := setupSearchCacheTest(t)
+			blocks, _, _, _, _ := FullTextSearchBlock(c.options)
+			if !slices.ContainsFunc(blocks, isSearchCacheParagraph) {
+				t.Fatalf("setup: the search didn't find the paragraph: %d results", len(blocks))
+			}
+			checkWholeBlocks(t, paragraph, "a "+c.name)
+		})
+	}
+	t.Run("block-ref search", func(t *testing.T) {
+		files, paragraph := setupSearchCacheTest(t)
+		// Typing (( in another page, the fixture's Source.
+		blocks, _ := SearchRefBlock("", files.sourceID, "needle", 36, false, false)
+		if !slices.ContainsFunc(blocks, isSearchCacheParagraph) {
+			t.Fatalf("setup: the block-ref search didn't find the paragraph: %d results", len(blocks))
+		}
+		checkWholeBlocks(t, paragraph, "a block-ref search")
+	})
+	t.Run("page opened from a search", func(t *testing.T) {
+		_, paragraph := setupSearchCacheTest(t)
+		// As /api/filetree/getDoc does when a search result is opened, with the search's keyword query.
+		_, _, _, _, _, _, _, _, _, _, _, keywords, _, _, err := GetDoc("", "", searchCachePageID, 0, "needle", nil, nil, 0, 0, 36, false, nil, true, false)
+		if nil != err || !slices.Contains(keywords, "needle") {
+			t.Fatalf("setup: opening the page didn't highlight needle: %v, %v", keywords, err)
+		}
+		checkWholeBlocks(t, paragraph, "opening the page from a search")
+	})
+
+	// Statements written outside SiYuan's code, as an embed block, the search panel's SQL method and a template run
+	// them, selecting a snippet or a highlight in place of a block's text. On v3.8.7 each route stored the rows it read
+	// in SQL's block cache, so the paragraph then read cut to its snippet, or marked up, wherever SiYuan reads it by id.
+	fields := func(content string) string {
+		return "SELECT id, parent_id, root_id, hash, box, path, hpath, name, alias, memo, tag, " + content +
+			" AS content, fcontent, markdown, length, type, subtype, ial, sort, created, updated FROM blocks_fts "
+	}
+	snippetMatch := fields("snippet(blocks_fts, 11, '<b>', '</b>', '...', 8)") + "WHERE blocks_fts MATCH 'needle'"
+	snippetEquals := fields("snippet(blocks_fts, 11, '<b>', '</b>', '...', 8)") + "WHERE blocks_fts = 'needle'"
+	highlight := fields("highlight(blocks_fts, 11, '<mark>', '</mark>')") + "WHERE blocks_fts MATCH 'needle'"
+	t.Run("embed block query", func(t *testing.T) {
+		_, paragraph := setupSearchCacheTest(t)
+		// As /api/search/searchEmbedBlock does for an embed block in the editor.
+		embeds := SearchEmbedBlock("", snippetMatch, nil, 0, false)
+		if !slices.ContainsFunc(embeds, func(e *EmbedBlock) bool { return isSearchCacheParagraph(e.Block) }) {
+			t.Fatalf("the embed block doesn't show the paragraph: %d results", len(embeds))
+		}
+		checkWholeBlocks(t, paragraph, "an embed block query")
+	})
+	t.Run("SQL-method search", func(t *testing.T) {
+		_, paragraph := setupSearchCacheTest(t)
+		blocks, _, _, _, _ := FullTextSearchBlock(BlockSearchOptions{Query: snippetEquals, Method: 2, Page: 1, PageSize: 10})
+		i := slices.IndexFunc(blocks, isSearchCacheParagraph)
+		if 0 > i {
+			t.Fatalf("the search didn't find the paragraph: %d results", len(blocks))
+		}
+		if found := blocks[i].Content; !strings.Contains(found, "needle") || len(paragraph) <= len(found) {
+			t.Errorf("the search shows the paragraph as %d characters, not its snippet: %q", len(found), found[:min(64, len(found))])
+		}
+		checkWholeBlocks(t, paragraph, "an SQL-method search")
+	})
+	t.Run("template query", func(t *testing.T) {
+		_, paragraph := setupSearchCacheTest(t)
+		out, err := RenderGoTemplate("{{range queryBlocks `" + highlight + "`}}[{{.ID}}: {{.Content}}]{{end}}")
+		if nil != err || !strings.Contains(out, "["+searchCacheParagraphID+": <mark>needle</mark> word0 word1") {
+			t.Fatalf("the template doesn't show the paragraph highlighted: %v, %q", err, out[:min(160, len(out))])
+		}
+		checkWholeBlocks(t, paragraph, "a template query")
+	})
+	t.Run("template snippet query", func(t *testing.T) {
+		_, paragraph := setupSearchCacheTest(t)
+		out, err := RenderGoTemplate("{{range queryBlocks `" + snippetMatch + "`}}{{if eq .ID `" + searchCacheParagraphID + "`}}{{.Content}}{{end}}{{end}}")
+		if nil != err || !strings.HasPrefix(out, "<b>needle</b>") || len(paragraph) <= len(out) {
+			t.Fatalf("the template doesn't show the paragraph's snippet: %v, %q", err, out[:min(160, len(out))])
+		}
+		checkWholeBlocks(t, paragraph, "a template snippet query")
+	})
+}
+
+func isSearchCacheParagraph(b *Block) bool {
+	return searchCacheParagraphID == b.ID
+}
