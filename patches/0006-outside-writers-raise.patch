+
+// fillAVForRaiseTest caches a database's copy, normalized copy and search info as a fill does: at the version it noted
+// before its lookup.
+func fillAVForRaiseTest(t *testing.T, avID, boxID string, version uint64) {
+	t.Helper()
+	raw := []byte(`{"id":"` + avID + `"}`)
+	SetAVDataInBox(avID, boxID, raw, version)
+	avCache.Wait()
+	if !SetAVNormalizedDataInBox(avID, boxID, version, raw, raw) {
+		t.Fatalf("database %s's normalized copy wasn't stored at the current version", avID)
+	}
+	if !SetAVSearchDataInBox(avID, boxID, version, "info") {
+		t.Fatalf("database %s's search info wasn't stored at the current version", avID)
+	}
+	avCache.Wait()
+}
+
+// servedAV reports whether the database's copy, normalized copy and search info are served.
+func servedAV(avID, boxID string, version uint64) (raw, normalized, search bool) {
+	_, _, raw = GetAVDataWithVersionInBox(avID, boxID)
+	_, normalized = GetAVNormalizedDataInBox(avID, boxID, version)
+	_, search = GetAVSearchDataInBox[string](avID, boxID)
+	return
+}
+
+// Raising a page refuses every copy of it noted before, in the three caches that copy pages, and only of it: another
+// page's copies are still served, and a copy noted after the raise is served.
+func TestRaisingAPageMakesOnlyItsCopiesMiss(t *testing.T) {
+	t.Cleanup(clearVersionTestCaches)
+	const raised, other = "20261017120000-raised1", "20261017120000-other01"
+	noted := NewFillToken()
+	storeVersionTestPage(raised, noted)
+	storeVersionTestPage(other, noted)
+
+	RaisePages(raised, "")
+
+	if page, block, doc := servedVersionTestPage(raised); page || block || doc {
+		t.Fatalf("copies of a raised page noted before the raise were served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+	if page, block, doc := servedVersionTestPage(other); !page || !block || !doc {
+		t.Fatalf("raising one page made another's copies miss: page %v, block %v, page attributes %v", page, block, doc)
+	}
+	storeVersionTestPage(raised, NewFillToken())
+	if page, block, doc := servedVersionTestPage(raised); !page || !block || !doc {
+		t.Fatalf("copies noted after the raise weren't served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+}
+
+// Raising a database refuses its copy, normalized copy and search info noted before, in its own notebook only.
+func TestRaisingADatabaseMakesOnlyItsCopiesMiss(t *testing.T) {
+	t.Cleanup(ClearAVCache)
+	const raised, other = "20261017120000-raiseav", "20261017120000-otherav"
+	raisedVersion := EnsureAVDataVersionInBox(raised, raiseTestBox)
+	otherBoxVersion := EnsureAVDataVersionInBox(raised, raiseTestOther)
+	otherVersion := EnsureAVDataVersionInBox(other, raiseTestBox)
+	fillAVForRaiseTest(t, raised, raiseTestBox, raisedVersion)
+	fillAVForRaiseTest(t, raised, raiseTestOther, otherBoxVersion)
+	fillAVForRaiseTest(t, other, raiseTestBox, otherVersion)
+
+	RaiseAVs(AVKey{AVID: raised, BoxID: raiseTestBox})
+
+	if raw, normalized, search := servedAV(raised, raiseTestBox, raisedVersion); raw || normalized || search {
+		t.Fatalf("a raised database's copies were served: raw %v, normalized %v, search info %v", raw, normalized, search)
+	}
+	if raw, normalized, search := servedAV(raised, raiseTestOther, otherBoxVersion); !raw || !normalized || !search {
+		t.Fatalf("raising a database made its copy in another notebook miss: raw %v, normalized %v, search info %v", raw, normalized, search)
+	}
+	if raw, normalized, search := servedAV(other, raiseTestBox, otherVersion); !raw || !normalized || !search {
+		t.Fatalf("raising a database made another's copies miss: raw %v, normalized %v, search info %v", raw, normalized, search)
+	}
+
+	// A fill that noted the version before the raise and stores after it isn't served.
+	SetAVDataInBox(raised, raiseTestBox, []byte(`{}`), raisedVersion)
+	avCache.Wait()
+	if _, _, ok := GetAVDataWithVersionInBox(raised, raiseTestBox); ok {
+		t.Fatal("a database copy noted before the raise and stored after it was served")
+	}
+}
+
+// A database no reader has noted gets no version from a raise, so raising every database a folder holds doesn't grow
+// the version map with databases nobody reads.
+func TestRaisingADatabaseNeverReadAddsNoVersion(t *testing.T) {
+	t.Cleanup(ClearAVCache)
+	const avID = "20261017120000-neverrd"
+	RaiseAVs(AVKey{AVID: avID})
+	avSearchDataCacheLock.RLock()
+	_, ok := avDataVersions[avCacheKey(avID, "")]
+	avSearchDataCacheLock.RUnlock()
+	if ok {
+		t.Fatal("raising a database never read gave it a version")
+	}
+}
+
+// RaiseAll refuses every page's and every database's copies noted before it, raises no cache's own floor, and serves
+// what is noted after it.
+func TestRaisingEverythingRefusesEveryOlderCopy(t *testing.T) {
+	t.Cleanup(func() {
+		clearVersionTestCaches()
+		ClearAVCache()
+	})
+	const rootID, avID = "20261017120000-allpage", "20261017120000-allavdb"
+	noted := NewFillToken()
+	storeVersionTestPage(rootID, noted)
+	avVersion := EnsureAVDataVersionInBox(avID, "")
+	fillAVForRaiseTest(t, avID, "", avVersion)
+	floors := [3]uint64{treeCacheFloor.floor.Load(), blockIALCacheFloor.floor.Load(), docIALCacheFloor.floor.Load()}
+
+	RaiseAll()
+
+	if page, block, doc := servedVersionTestPage(rootID); page || block || doc {
+		t.Fatalf("page copies noted before RaiseAll were served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+	if raw, normalized, search := servedAV(avID, "", avVersion); raw || normalized || search {
+		t.Fatalf("database copies noted before RaiseAll were served: raw %v, normalized %v, search info %v", raw, normalized, search)
+	}
+	if after := [3]uint64{treeCacheFloor.floor.Load(), blockIALCacheFloor.floor.Load(), docIALCacheFloor.floor.Load()}; after != floors {
+		t.Fatalf("RaiseAll moved a cache's own floor: %v, then %v", floors, after)
+	}
+
+	storeVersionTestPage(rootID, NewFillToken())
+	if page, block, doc := servedVersionTestPage(rootID); !page || !block || !doc {
+		t.Fatalf("page copies noted after RaiseAll weren't served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+	avVersion = EnsureAVDataVersionInBox(avID, "")
+	fillAVForRaiseTest(t, avID, "", avVersion)
+	if raw, normalized, search := servedAV(avID, "", avVersion); !raw || !normalized || !search {
+		t.Fatalf("database copies noted after RaiseAll weren't served: raw %v, normalized %v, search info %v", raw, normalized, search)
+	}
+}
+
+// A write of a page or a database under way when its version is raised from outside caches nothing, as when another
+// write overlaps it: the outside writer may have written the file after it.
+func TestWritesOverlappingARaiseCacheNothing(t *testing.T) {
+	t.Cleanup(ClearAVCache)
+	const rootID, avID = "20261017120000-overlap", "20261017120000-overlav"
+	for name, raise := range map[string]func(){
+		"page raised": func() { RaisePages(rootID) },
+		"all raised":  RaiseAll,
+	} {
+		t.Run(name, func(t *testing.T) {
+			begin := BeginTreeWrite(rootID)
+			raise()
+			if version := EndTreeWrite(rootID, begin); 0 != version {
+				t.Fatalf("a page write overlapping a raise may cache at version %d", version)
+			}
+			begin = BeginTreeWrite(rootID)
+			if version := EndTreeWrite(rootID, begin); 0 == version {
+				t.Fatal("a page write after the raise may cache nothing")
+			}
+		})
+	}
+	for name, raise := range map[string]func(){
+		"database raised": func() { RaiseAVs(AVKey{AVID: avID}) },
+		"all raised":      RaiseAll,
+	} {
+		t.Run(name, func(t *testing.T) {
+			begin := BeginAVWrite(avID, "")
+			raise()
+			if version := EndAVWrite(avID, "", begin); 0 != version {
+				t.Fatalf("a database save overlapping a raise may cache at version %d", version)
+			}
+			begin = BeginAVWrite(avID, "")
+			if version := EndAVWrite(avID, "", begin); 0 == version {
+				t.Fatal("a database save after the raise may cache nothing")
+			}
+		})
+	}
+}
+
+// RaiseChangedSince raises again only what rose after its token: a page written since is refused, even the copy its
+// write stored, while a page and a database untouched since keep being served.
+func TestRaisingWhatChangedSinceATokenLeavesTheRest(t *testing.T) {
+	t.Cleanup(func() {
+		clearVersionTestCaches()
+		ClearAVCache()
+	})
+	const untouched, written = "20261018120000-untouch", "20261018120000-written"
+	const quietAV, savedAV = "20261018120000-quietav", "20261018120000-savedav"
+	storeVersionTestPage(untouched, NewFillToken())
+	quietVersion := EnsureAVDataVersionInBox(quietAV, "")
+	fillAVForRaiseTest(t, quietAV, "", quietVersion)
+
+	since := NewFillToken()
+	begin := BeginTreeWrite(written)
+	storeVersionTestPage(written, EndTreeWrite(written, begin))
+	saveAVData(savedAV, "", []byte(`{"id":"`+savedAV+`"}`))
+	avCache.Wait()
+
+	RaiseChangedSince(since)
+
+	if page, block, doc := servedVersionTestPage(written); page || block || doc {
+		t.Fatalf("a page written since the token was served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+	if _, _, ok := GetAVDataWithVersionInBox(savedAV, ""); ok {
+		t.Fatal("a database saved since the token was served")
+	}
+	if page, block, doc := servedVersionTestPage(untouched); !page || !block || !doc {
+		t.Fatalf("a page untouched since the token was refused: page %v, block %v, page attributes %v", page, block, doc)
+	}
+	if raw, normalized, search := servedAV(quietAV, "", quietVersion); !raw || !normalized || !search {
+		t.Fatalf("a database untouched since the token was refused: raw %v, normalized %v, search info %v", raw, normalized, search)
+	}
+}
+
+// A page cached after a raise of everything, during a bracket, has no id in the version map; RaiseChangedSince raises
+// the epoch again, so its copy is refused too.
+func TestRaisingWhatChangedSinceCoversARaiseOfEverything(t *testing.T) {
+	t.Cleanup(clearVersionTestCaches)
+	const bulk = "20261018130000-bulkpge"
+	since := NewFillToken()
+	RaiseAll()
+	storeVersionTestPage(bulk, NewFillToken())
+	if page, block, doc := servedVersionTestPage(bulk); !page || !block || !doc {
+		t.Fatalf("setup: a page cached after the raise wasn't served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+
+	RaiseChangedSince(since)
+
+	if page, block, doc := servedVersionTestPage(bulk); page || block || doc {
+		t.Fatalf("a page cached after a raise of everything since the token was served: page %v, block %v, page attributes %v", page, block, doc)
+	}
+}
