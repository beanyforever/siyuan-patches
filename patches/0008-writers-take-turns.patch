+// finish waits for the job once the writer has returned. It stops the test if the writer never reached its hook, or
+// if the job doesn't commit.
+func (j *turnJob) finish(t *testing.T) {
+	t.Helper()
+	j.mu.Lock()
+	sent := j.sent
+	j.mu.Unlock()
+	if !sent {
+		t.Fatal("setup: the writer never reached its test hook, so no job ran between its read and its save")
+	}
+	select {
+	case <-j.done:
+	case <-time.After(turnJobCommitWait):
+		t.Fatalf("the job sent between the writer's read and its save didn't commit within %s of the writer returning",
+			turnJobCommitWait)
+	}
+	FlushTxQueue()
+}
+
+// wait waits for the job, if it was sent, for a bounded time. Tests' cleanups use it before they set hooks back.
+func (j *turnJob) wait() {
+	j.mu.Lock()
+	sent := j.sent
+	j.mu.Unlock()
+	if !sent || turnTripwireMode {
+		return
+	}
+	select {
+	case <-j.done:
+	case <-time.After(turnJobCommitWait):
+	}
+}
+
+// where says when the job ran, for failure messages.
+func (j *turnJob) where() string {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	switch {
+	case j.atHook:
+		return fmt.Sprintf("the job (%s) committed between the writer's read and its save", j.operation)
+	case j.turnHeld:
+		return fmt.Sprintf("the job (%s) waited for the turn the writer held", j.operation)
+	default:
+		return fmt.Sprintf("the job (%s) didn't commit within %s of the writer's hook", j.operation, turnJobWait)
+	}
+}
+
+// setTurnHook sets a writer's test hook for the test. Once the test ends it waits for job, which the hook sends, and
+// sets the hook back.
+func setTurnHook[T any](t *testing.T, job *turnJob, hook *T, fn T) {
+	t.Helper()
+	*hook = fn
+	t.Cleanup(func() {
+		job.wait()
+		var zero T
+		*hook = zero
+	})
+}
