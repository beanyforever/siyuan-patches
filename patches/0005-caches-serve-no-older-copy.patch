+// settleBlockIALCache gives the block attribute cache time to take in what a read has just stored in it. ristretto
+// takes a key it doesn't hold yet in on a goroutine of its own, so a read straight after the store can miss it and
+// load the page again, which would hide what the store left. It returns once the cache serves the block, or after
+// 200 ms if it doesn't.
+func settleBlockIALCache(id, boxID string) {
+	for deadline := time.Now().Add(200 * time.Millisecond); nil == cache.GetBlockIALInBox(id, boxID) && time.Now().Before(deadline); {
+		time.Sleep(time.Millisecond)
+	}
+}
