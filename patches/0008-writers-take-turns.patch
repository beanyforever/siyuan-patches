+	t.Run("createAttributeViewItemDocs", func(t *testing.T) {
+		d := setupTurnNewItemDatabase(t, "")
+		detached, err := CreateAttributeViewItem(d.attrView.ID, d.blockID, d.attrView.Views[0].ID, "", "", "")
