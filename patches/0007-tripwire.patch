+// The tripwire: a save of a page or a database made while no job holds the turn (flushLock) writes one line to
+// SiYuan's log. The line holds the marker "tripwire: save outside a turn", the kind ("page" or "database") and the call
+// site, the first caller outside the save functions, as "<package.Function> <file>:<line>". Each site logs once per
+// process. Saves in a turn, the first save of a new page or database, and repairs made while loading log nothing.
+//
+// How these tests read the log: each points SiYuan's logging at a file of its own with logging.SetLogPath, as
+// SiYuan's OCR and plugin tests do, and reads the lines of that file that hold the marker. A mark, the log's length
+// before a step, keeps a check to the lines that step wrote.
+//
+// A site logs once per process, so each test runs in a process of its own: the test binary run again for that one test,
+// as SiYuan's own recovery tests do. No earlier test in the same run can have used up a site a test checks, the checks
+// that nothing is logged can't pass because a stock site logged earlier, and -count runs each test afresh.
+//
+// Each check that nothing is logged ends with a control: a save outside a turn from a site of the test's own, which
+// must log. It shows that the tripwire is on in that process and that the test reads its lines.
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+	"github.com/88250/lute/render"
+	"github.com/siyuan-note/logging"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const (
+	tripwireMarker = "tripwire: save outside a turn"
+	// tripwireChildEnv holds the name of the test a child process runs.
+	tripwireChildEnv = "SIYUAN_TEST_TRIPWIRE_CHILD"
+)
+
+// runTripwireTest runs body in a process of its own: the test binary, run again for this test alone. In that process it
+// runs body; here it fails the test with the process's output if the process fails.
+func runTripwireTest(t *testing.T, body func(t *testing.T)) {
+	t.Helper()
+	if os.Getenv(tripwireChildEnv) == t.Name() {
+		body(t)
+		return
+	}
+	var pattern []string
+	for _, part := range strings.Split(t.Name(), "/") {
+		pattern = append(pattern, "^"+regexp.QuoteMeta(part)+"$")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	command := exec.CommandContext(ctx, os.Args[0], "-test.run="+strings.Join(pattern, "/"), "-test.count=1",
+		"-test.timeout=4m", "-test.v")
+	command.Env = append(os.Environ(), tripwireChildEnv+"="+t.Name())
+	output, err := command.CombinedOutput()
+	if nil != err {
+		t.Fatalf("the test failed in its own process (%v):\n%s", err, output)
+	}
+	if !bytes.Contains(output, []byte("--- PASS: "+t.Name()+" ")) {
+		t.Fatalf("setup: the test's own process didn't run it:\n%s", output)
+	}
+}
+
+// tripwireLog is SiYuan's log, pointed at a file of the test's own.
+type tripwireLog struct {
+	path string
+}
+
+func newTripwireLog(t *testing.T) *tripwireLog {
+	t.Helper()
+	ret := &tripwireLog{path: filepath.Join(t.TempDir(), "siyuan.log")}
+	previous := logging.LogPath
+	logging.SetLogPath(ret.path)
+	t.Cleanup(func() { logging.SetLogPath(previous) })
+	return ret
+}
+
+// mark is the log's length now: what is logged after it is what the steps since wrote.
+func (l *tripwireLog) mark(t *testing.T) int {
+	t.Helper()
+	return len(l.read(t))
+}
+
+// linesSince returns the tripwire's lines logged after mark.
+func (l *tripwireLog) linesSince(t *testing.T, mark int) (ret []string) {
+	t.Helper()
+	data := l.read(t)
+	if len(data) < mark {
+		t.Fatalf("setup: the log shrank from %d to %d bytes", mark, len(data))
+	}
+	for _, line := range strings.Split(string(data[mark:]), "\n") {
+		if strings.Contains(line, tripwireMarker) {
+			ret = append(ret, line)
+		}
+	}
+	return
+}
+
+func (l *tripwireLog) read(t *testing.T) []byte {
+	t.Helper()
+	data, err := os.ReadFile(l.path)
+	if nil != err && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// tripwireSite is a call site of a save, as the tripwire names it: "<package.Function> <file>:<line>".
+type tripwireSite struct {
+	function string // package.Function, as model.tripwireSavePageA
+	file     string // the file's base name
+	line     int
+}
+
+func (s tripwireSite) String() string {
+	return fmt.Sprintf("%s %s:%d", s.function, s.file, s.line)
+}
+
+// matches says whether line names the site. The file may be written with or without its folders.
+func (s tripwireSite) matches(line string) bool {
+	return regexp.MustCompile(regexp.QuoteMeta(s.function) + ` (?:\S*[/\\])?` + regexp.QuoteMeta(s.file) + ":" +
+		strconv.Itoa(s.line) + `\b`).MatchString(line)
+}
+
+// tripwireNextLine is the call site of the save on the line after its caller's call of it.
+//
+//go:noinline
+func tripwireNextLine() tripwireSite {
+	pc, file, line, _ := runtime.Caller(1)
+	name := runtime.FuncForPC(pc).Name()
+	if i := strings.LastIndex(name, "/"); 0 <= i {
+		name = name[i+1:]
+	}
+	return tripwireSite{function: name, file: filepath.Base(file), line: line + 1}
+}
+
+// The call sites of the saves below. Each saves outside a turn, from a site of its own.
+
+//go:noinline
+func tripwireSavePageA(tree *parse.Tree) (tripwireSite, error) {
+	site := tripwireNextLine()
+	_, err := filesys.WriteTree(tree)
+	return site, err
+}
