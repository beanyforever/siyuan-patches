# SiYuan's official image with its kernel rebuilt from the same release plus patches/.
# The kernel build matches upstream's Dockerfile; the front end is reused unchanged.
ARG SIYUAN_VERSION=v3.8.7

FROM golang:1.26-alpine AS kernel
ARG SIYUAN_VERSION
RUN apk add --no-cache gcc musl-dev git
WORKDIR /src
RUN git clone --quiet --depth 1 --branch "$SIYUAN_VERSION" --filter=blob:none --sparse \
        https://github.com/siyuan-note/siyuan.git . \
    && git sparse-checkout set kernel
COPY patches/ /patches/
RUN git apply /patches/*.patch
WORKDIR /src/kernel
ENV CGO_ENABLED=1
# The packages' tests and the kernel build run at once, each to a log of its own, shown when all have ended; the
# step fails if any of them fails.
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg \
    pids=""; \
    go test -tags "fts5 sqlcipher" ./mcp/ > /tmp/t0.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^(TestFileToolWritesServeWhatTheToolWrote|TestFileToolCopyThroughALinkServesTheCopy|TestFileToolCopyIntoALinkServesTheCopy)$' ./mcp/tools/ > /tmp/t1.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^TestAttributeViewPropertyGuard|^TestSystemPageGuard|^TestSearchLeavesBlocksWhole|^(TestMoveToAnotherNotebookAndBackKeepsEdits|TestMoveAfterEditReadsNewType|TestRollbackDocHistoryRestoresAttributes|TestRollbackRepoSnapshotFileRestoresAttributes|TestRestoreRemovedBlockReadsNoAttributes|TestOlderPageAttributesStoredAfterASaveAreNotServed|TestJobAttributesAreNotServedBeforeItsPageIsWritten|TestFailedCommitCachesNothing|TestNewRowPageReadsWithItsDatabase|TestGroupedTableCellEditKeepsStaticText|TestDocToHeadingServesTheHeadingsAttributes|TestDocToHeadingLeavesNoCopyOfTheSourcePage|TestDataImportServesTheImportedCopies|TestCheckoutServesTheSnapshotRightAfterItsWrite|TestDoc2HeadingLeavesNoCurrentCopyOfItsSourcePage|TestRollingAnUnchangedPageBackToASnapshotKeepsItsFile|TestTripwireLogsAPageSaveOutsideATurnOncePerSite|TestTripwireLogsADatabaseSaveOutsideATurnOncePerSite|TestTripwireLogsAddAttributeViewKeyOnce|TestTripwireLeavesSavesInATurnUnlogged|TestTripwireLeavesTheFirstSaveOfANewFileUnlogged|TestTripwireLeavesRepairsWhileLoadingUnlogged|TestTripwireTheFlushersEmptyTickIsNoTurn|TestTripwireLogsOnlyTheSaveMadeOutsideATurn|TestTripwireChallengeNamesEachWriterBehindAvSaveView|TestTripwireChallengeLogsASaveToAPathItsPageHasLeft|TestTripwireChallengeNamesAGoStatementThatCallsASaveFunction|TestTripwireProbeNamesTheWriterThroughEveryWrapper|TestTripwireProbeAPanickingJobLeavesNoTurn|TestTakeTurnRunsTheQueuedJobsFirst|TestTakeTurnKeepsJobsOutUntilItsRelease|TestWithTurnGivesTheTurnBackWhenTheWriterPanics|TestWritersWaitForTheTurnBeforeTheyRead|TestReadsThatSaveDontWaitForTheTurn|TestReadNoteSavesOnlyWhatNothingSavedSince|TestGetAttributeViewKeysSavesItsCorrection|TestInTurnVariantsRunInATurn|TestStep6ChallengeLocksFlushTxQueueWaitsForTheJobsATurnHasTakenOffTheQueue|TestStep6ChallengeLocksProbeFlushTxQueueReturnsBeforeAQueuedJobUnderTurns|TestStep6ChallengeLocksProbeTurnsStressLeavesNoGoroutines|TestStep6ChallengeLocksAssetRelinkRefreshesRefsInItsTurnWithoutDeadlock|TestStep6ChallengeLocksJobWaitBehindAMoveOfManySubPages|TestStep6ChallengeLocksJobWaitBehindADeletionOfManySubPages|TestStep6ChallengeLocksRound1RefTextTurnReadsOnlyTheDefinitionsItsPageRefersTo|TestStep6ChallengeLocksRound2SnapshotRestoreOfAPageDatedAheadReturnsPromptly|TestStep6ChallengeLocksRound3TouchBeforeASnapshotRestoreBackupWaitsAtMostASecond|TestStep6ChallengeLocksRound4TouchPassesOverARunOfStoredCopiesPromptly|TestStep6ChallengeLocksRound4TouchDoesNotWaitForTheTurn|TestStep6ChallengeWritesRefreshesComputeFromADefinitionReadBeforeTheirTurn|TestStep6ChallengeWritesOnePageSnapshotRestoreKeepsAJobSavedAfterItsBackup|TestStep6ChallengeWritesTransferBlockRefMovesARefWhoseBlockChangedPage|TestStep6ChallengeWritesRound1OnePageSnapshotRestoreKeepsASaveInTheLatestSnapshotsSecond|TestStep6ChallengeWritesRound3OnePageSnapshotRestoreKeepsASaveAfterItsBackupOfAPageDatedAhead|TestStep6ChallengeWritesRound3OnePageSnapshotRestoreKeepsAWriteDatedBackWhileAhead|TestStep6ChallengeWritesRound4TouchFindsStoredCopiesWhereDejavuPutsThem|TestStep6ChallengeWritesRound5RetriedRestoreNextSnapshotHoldsTheRestoredPageAndASaveRightAfterIt|TestReadsThatSaveKeepAJobsSaveMadeAfterTheirRead|TestReadsThatSaveLeaveAnUnchangedDatabaseUnsaved|TestPageDeletionKeepsAJobsSaveToItsDatabasesMadeBetweenTheirReadAndTheirSave|TestSystemPageDeletionRefusalHoldsForAPageMadeUnderItDuringTheDeletion|TestNewRowKeepsAJobsSaveToItsPageMadeBetweenItsReadAndItsSave|TestDatabaseDuplicateKeepsAJobsSaveToARowsPageMadeBetweenItsReadAndItsSave|TestDatabaseHistoryRollbackKeepsAJobsSaveMadeBetweenItsReadAndItsWrite|TestPageDeletionInsideAJobDoesntDeadlock|TestRefTextRefreshInsideAJobDoesntDeadlock|TestRefTextRetryDoesntDeadlock|TestSetBlockAttrsKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestBatchSetBlockAttrsKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestRenameDocKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestTransferBlockRefKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestMoveDocsKeepsAJobsSaveMadeWhileItMovesThePage|TestDailyNoteKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestAssetRenameKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestWritersSaveWithinTheirTurn|TestRefTextJobKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestReloadProtyleKeepsAJobsSaveMadeBetweenItsReadAndItsSave|TestPageHistoryRestoreKeepsAJobsSaveMadeBetweenItsReadAndItsWrite|TestOnePageSnapshotRestoreKeepsAJobsSaveMadeBetweenItsReadAndItsWrite|TestOnePageSnapshotRestoreLeavesBlocksMovedSinceInTheirNewPage)$' ./model/ > /tmp/t2.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^(TestReadCheckRefusesCopiesOlderThanTheirPage|TestBlockAttributesWithoutTheirPageAreNotServed|TestDroppingBlockAttributesRaisesTheirPage|TestClearingACacheMakesOnlyItsEntriesMiss|TestForgettingVersionsKeepsOtherEntries|TestFillVersionsForgetPastTheirLimit|TestConcurrentRaisesNeverLowerTheFloor|TestForgettingVersionsStallsReadsBriefly|TestOverlappingClearsKeepTheLaterFloor|TestWriteEndsCacheOnlyWithoutAnotherRaise|TestRaisingAPageMakesOnlyItsCopiesMiss|TestRaisingADatabaseMakesOnlyItsCopiesMiss|TestRaisingADatabaseNeverReadAddsNoVersion|TestRaisingEverythingRefusesEveryOlderCopy|TestWritesOverlappingARaiseCacheNothing|TestRaisingWhatChangedSinceATokenLeavesTheRest|TestRaisingWhatChangedSinceCoversARaiseOfEverything)$' ./cache/ > /tmp/t3.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^(TestTreeFillRacesWrite|TestTreeFillsRacingASaveServeTheSave|TestOverlappingWritesOfAPageCacheWhatTheFileHolds|TestPanickingPageWriteRaisesItsPageAndReleasesItsLocks|TestDataPathsNameWhatTheyHold|TestRaiseForDataPathRaisesWhatAFolderHolds|TestBeginDataPathWriteRaisesWhatARemoveTookAway|TestDataCopiesNameWhatTheyWrote|TestRemovingAFolderRaisesAPageWrittenIntoItDuringTheRemove|TestRemovingAFolderRaisesAPageABulkWriterPutInItDuringTheRemove|TestRemovingALargeFolderRaisesAPageWrittenIntoItDuringTheRemove|TestTripwireLogsAPageSaveOutsideATurnAtItsWriter|TestTripwirePassesOverRepairsMadeWhileLoading)$' ./filesys/ > /tmp/t4.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^(TestBatchGetBlockAttrsWitTreesCachesNothing|TestBlockAttrsReadsFillWhatTheyLoad|TestBlockAttrsFillThenWriteKeepsWrite|TestPageWritesMakeOlderBlockAttrsMiss|TestBlockAttrsReadBeforeTheirPageChangedAreNotServed|TestKanbanRenderAfterAWriteServesNewAttributes)$' ./sql/ > /tmp/t5.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^(TestAVReadAfterSaveGivesTheSave|TestAVSaveOfUnchangedCopyRacingASaveKeepsTheSave|TestAVHistoryReadLeavesTheLiveEntry|TestAVDropRacingAFillInANotebookLeavesNoOlderCopy|TestAVOverlappingSavesCacheWhatTheFileHolds|TestAVSaveWithoutOverlapIsServedFromTheCache|TestPanickingDatabaseSaveRaisesItsVersionAndReleasesItsLocks|TestTripwireLogsADatabaseSaveOutsideATurnAtItsWriter)$' ./av/ > /tmp/t6.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" ./tripwire/ > /tmp/t7.log 2>&1 & pids="$pids $!"; \
    go test -tags "fts5 sqlcipher" -run '^(TestPutFileServesTheFileItWrote|TestCopiedFilesServeTheCopy|TestRenamedFilesServeTheFileRenamedIn|TestRemovedPageServesNoAttributes|TestUnzippedFilesServeTheArchivesCopy)$' ./api/ > /tmp/t8.log 2>&1 & pids="$pids $!"; \
    go build -tags "fts5 sqlcipher" -ldflags "-s -w" > /tmp/build.log 2>&1 & pids="$pids $!"; \
    fail=0; for p in $pids; do wait "$p" || fail=1; done; \
    cat /tmp/t*.log /tmp/build.log; exit "$fail"

FROM b3log/siyuan:${SIYUAN_VERSION}
COPY --from=kernel --chmod=755 /src/kernel/kernel /opt/siyuan/kernel
