+// Step 4's challenger, fix round 1: the MCP file tool's copy now raises a walk of its destination, which follows no
+// link. copyPath writes through a link at the destination (os.MkdirAll accepts a link to a folder, os.Create follows a
+// link to a file), so a copy into a destination that is a link to a notebook's folder writes the notebook's pages, and
+// the walk, which sees the link as a file whose name is no page, raises none of them. Links inside the workspace are
+// allowed. (The file API's copies refuse a destination that is a link.)
+func TestFileToolCopyIntoALinkServesTheCopy(t *testing.T) {
+	f := setupToolWriterTest(t)
+	stageToolFile(t, "stage/"+toolBoxID+"/"+toolPageID+".sy", f.newPage)
+	alias := filepath.Join(util.DataDir, "alias")
+	if err := os.Symlink(filepath.Join(util.DataDir, toolBoxID), alias); nil != err {
+		t.Skipf("symbolic links unavailable: %v", err)
+	}
+	callFileTool(t, map[string]any{"action": "copy", "src": "stage/" + toolBoxID, "dst": "data/alias"})
+	checkToolPage(t, "after the tool's copy into a link to the notebook's folder", "new")
+}
