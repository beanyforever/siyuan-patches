@@ -868,13 +868,22 @@ func selectBlocksRawStmtNoParseWithQuery(stmt string, limit int, boxID string, q
 }
 
 func scanBlockRows(rows *sql.Rows) (ret *Block) {
+	if ret = scanBlockRowsNoCache(rows); nil != ret {
+		putBlockCache(ret)
+	}
+	return
+}
+
+// scanBlockRowsNoCache scans a row as scanBlockRows does but stores nothing in SQL's block cache. A search's rows hold
+// snippets and search marks rather than the block as stored, and GetBlock, which reads the cache first, would serve them
+// to the backlinks panel and ref text.
+func scanBlockRowsNoCache(rows *sql.Rows) (ret *Block) {
 	var block Block
 	if err := rows.Scan(&block.ID, &block.ParentID, &block.RootID, &block.Hash, &block.Box, &block.Path, &block.HPath, &block.Name, &block.Alias, &block.Memo, &block.Tag, &block.Content, &block.FContent, &block.Markdown, &block.Length, &block.Type, &block.SubType, &block.IAL, &block.Sort, &block.Created, &block.Updated); err != nil {
 		logging.LogErrorf("query scan field failed: %s\n%s", err, logging.ShortStack())
 		return
 	}
 	ret = &block
-	putBlockCache(ret)
 	return
 }
 
