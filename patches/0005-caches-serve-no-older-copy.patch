+)
+
+// The stress test uses only functions stock SiYuan has, so that it builds on the base too and its race reports can be
+// compared.
+
+const (
+	stressRows      = 6
+	stressMovePage  = "20261017189000-movepag"
+	stressRestore   = "20261017189001-restore"
+	stressRestorePa = "20261017189001-restpar"
+	stressMirror    = "20261017189002-mirrorb"
+)
+
+// locksStress is how long the stress test runs its workers: go test ... -args -locks-stress=30s.
+var locksStress = flag.Duration("locks-stress", 5*time.Second, "how long TestLocksStressJobsReadsRendersAndWriters runs")
+
+// stressFixture is a workspace with a database whose block sits on the fixture's source page and a mirror of it on
+// the target page, with a table, a kanban and a gallery view, rows bound to pages of their own, a page that moves and
+// a page that is restored from its history, and a history copy of the database's file.
+type stressFixture struct {
+	files                 *fileOperationTestFixture
+	avID, blockID         string
+	blockKeyID            string
+	tableID, kanbanID     string
+	galleryID             string
+	rowPages, rowItems    []string
+	historyPath           string // the restored page's history copy, relative to the workspace
+	historyAVPath         string // the database's history copy, absolute
+	watchedIDs            []string
+	originalWorkspaceDir  string
+	originalHistoryDirSet bool
+}
+
+func setupLocksStress(t *testing.T) *stressFixture {
+	t.Helper()
+	files := setupStructureTransactionTest(t)
+	setupFoldTransactionDatabase(t, files)
+	originalWorkspaceDir, originalHistoryDir := util.WorkspaceDir, util.HistoryDir
+	util.WorkspaceDir = t.TempDir()
+	util.HistoryDir = filepath.Join(util.WorkspaceDir, "history")
+	oldLang, oldAVLangs, oldUndoLog := util.Lang, util.AttrViewLangs, GlobalUndoLog
+	util.Lang = "en"
+	util.AttrViewLangs = map[string]map[string]any{"en": {"key": "Key", "select": "Select", "table": "Table",
+		"gallery": "Gallery", "kanban": "Kanban", "list": "List", "calendar": "Calendar"}}
+	GlobalUndoLog = newUndoLog(64)
+	clearCaches := func() {
+		cache.ClearTreeCache()
+		cache.ClearBlocksIAL()
+		cache.ClearDocsIAL()
+		cache.ClearAVCache()
+	}
+	clearCaches()
+	t.Cleanup(func() {
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		sql.FlushQueue()
+		// RollbackDocHistory refreshes on a goroutine of its own, which reads Conf and the workspace folders.
+		time.Sleep(time.Second)
+		clearCaches()
+		util.Lang, util.AttrViewLangs, GlobalUndoLog = oldLang, oldAVLangs, oldUndoLog
+		util.WorkspaceDir, util.HistoryDir = originalWorkspaceDir, originalHistoryDir
+	})
+
+	ret := &stressFixture{files: files}
+	created, err := CreateAttributeViewDatabase(files.sourceID, "", "", "Stress", "Name", av.LayoutTypeTable, nil)
+	if nil != err {
+		t.Fatalf("setup: create the database: %v", err)
+	}
+	ret.avID, ret.blockID, ret.tableID = created.AvID, created.BlockID, created.ViewID
+	ret.blockKeyID = created.AttributeView.GetBlockKeyValues().Key.ID
+	if ret.kanbanID, err = AddAttributeViewView(ret.avID, ret.blockID, "Board", av.LayoutTypeKanban); nil != err {
+		t.Fatalf("setup: add the kanban view: %v", err)
+	}
+	if ret.galleryID, err = AddAttributeViewView(ret.avID, ret.blockID, "Cards", av.LayoutTypeGallery); nil != err {
+		t.Fatalf("setup: add the gallery view: %v", err)
+	}
+	if err = SetDatabaseBlockView(ret.blockID, ret.avID, ret.tableID); nil != err {
+		t.Fatalf("setup: show the table: %v", err)
+	}
+
+	// A mirror of the database on the target page, inserted as the editor inserts a database block.
+	mirrorDOM := `<div class="av" data-node-id="` + stressMirror + `" data-av-id="` + ret.avID +
+		`" data-type="NodeAttributeView" data-av-type="table" custom-sy-av-view="` + ret.tableID + `"></div>`
+	if err = PerformTxSync(&Transaction{DoOperations: []*Operation{{Action: "insert", Data: mirrorDOM,
+		ParentID: files.targetID}}}); nil != err {
+		t.Fatalf("setup: insert the mirror: %v", err)
+	}
+	if !slices.Contains(treenode.GetMirrorAttrViewBlockIDs(ret.avID), stressMirror) {
+		t.Fatalf("setup: the mirror isn't listed: %v", treenode.GetMirrorAttrViewBlockIDs(ret.avID))
+	}
+
+	for i := range stressRows {
+		pageID := fmt.Sprintf("2026101718%04d-rowpage", i)
+		page := treenode.NewTree(files.box.ID, "/"+pageID+".sy", "/Row "+fmt.Sprint(i), "Row "+fmt.Sprint(i))
+		// Each row's page shows an image, so kanban and gallery cards take it as their cover. A card without one renders
+		// its page's first blocks as its cover, through sql.renderBlockDOMByNode, which sets an option on a lute engine
+		// every render shares: a race stock SiYuan has, which would hide any new race from -race here.
+		lute := util.NewLute()
+		page.Root.AppendChild(lute.BlockDOM2Tree(lute.Md2BlockDOM("![cover](assets/cover.png)", false)).Root.FirstChild)
+		if _, err = filesys.WriteTree(page); nil != err {
+			t.Fatal(err)
+		}
+		treenode.UpsertBlockTree(page)
+		itemID := ast.NewNodeID()
+		op := &Operation{}
+		data := fmt.Sprintf(`{"action":"insertAttrViewBlock","avID":"%s","viewID":"%s","srcs":[{"itemID":"%s","id":"%s","isDetached":false}]}`,
+			ret.avID, ret.tableID, itemID, pageID)
+		if err = json.Unmarshal([]byte(data), op); nil != err {
+			t.Fatal(err)
+		}
+		if err = PerformTxSync(&Transaction{DoOperations: []*Operation{op}}); nil != err {
+			t.Fatalf("setup: bind row %d: %v", i, err)
+		}
+		ret.rowPages = append(ret.rowPages, pageID)
+		ret.rowItems = append(ret.rowItems, itemID)
+	}
+
+	for _, id := range []string{stressMovePage, stressRestore} {
+		page := treenode.NewTree(files.box.ID, "/"+id+".sy", "/"+id, id)
+		if id == stressRestore {
+			page.Root.AppendChild(treenode.NewParagraph(stressRestorePa))
+		}
+		if _, err = filesys.WriteTree(page); nil != err {
+			t.Fatal(err)
+		}
+		treenode.UpsertBlockTree(page)
+	}
+	if err = SetBlockAttrs(stressRestore, map[string]string{"custom-restore": "kept"}); nil != err {
+		t.Fatal(err)
+	}
+	ret.historyPath = filepath.Join("history", "2026-10-17-180000-update", files.box.ID, stressRestore+".sy")
+	ret.historyAVPath = filepath.Join(util.HistoryDir, "2026-10-17-180000-update", "storage", "av", ret.avID+".json")
+	for from, to := range map[string]string{
+		filepath.Join(util.DataDir, files.box.ID, stressRestore+".sy"): filepath.Join(util.WorkspaceDir, ret.historyPath),
+		av.GetAttributeViewDataPath(ret.avID):                          ret.historyAVPath,
+	} {
+		data, readErr := os.ReadFile(from)
+		if nil != readErr {
+			t.Fatal(readErr)
+		}
+		if err = os.MkdirAll(filepath.Dir(to), 0755); nil != err {
+			t.Fatal(err)
+		}
+		if err = os.WriteFile(to, data, 0644); nil != err {
+			t.Fatal(err)
+		}
+	}
+
+	ret.watchedIDs = append([]string{files.sourceID, files.targetID, files.childID, ret.blockID, stressMirror,
+		stressRestore}, ret.rowPages...)
+	return ret
+}
+
+// stressRun runs workers until told to stop, counting what each did and the errors each met.
+type stressRun struct {
+	stop   atomic.Bool
+	wg     sync.WaitGroup
+	mu     sync.Mutex
+	ops    map[string]int
+	errs   map[string]int
+	sample map[string]string
+}
+
+func newStressRun() *stressRun {
+	return &stressRun{ops: map[string]int{}, errs: map[string]int{}, sample: map[string]string{}}
+}
+
+func (r *stressRun) worker(name string, step func(i int) error) {
+	r.wg.Add(1)
+	go func() {
+		defer r.wg.Done()
+		for i := 0; !r.stop.Load(); i++ {
+			err := step(i)
+			r.mu.Lock()
+			r.ops[name]++
+			if nil != err {
+				r.errs[name]++
+				if _, ok := r.sample[name]; !ok {
+					r.sample[name] = err.Error()
+				}
+			}
+			r.mu.Unlock()
+		}
+	}()
+}
+
+// waitOrDump waits for done to close within limit; otherwise it prints every goroutine's stack and reports false.
+func waitOrDump(t *testing.T, what string, limit time.Duration, done <-chan struct{}) bool {
+	t.Helper()
+	select {
+	case <-done:
+		return true
+	case <-time.After(limit):
+		buf := make([]byte, 1<<24)
+		n := runtime.Stack(buf, true)
+		fmt.Fprintf(os.Stderr, "\n===== %s: not done after %s; goroutines follow =====\n%s\n===== end of goroutines =====\n",
+			what, limit, buf[:n])
+		t.Errorf("%s: not done after %s (deadlock or starvation); the goroutine dump is on stderr", what, limit)
+		return false
+	}
+}
+
+func goroutineCountSettles(limit time.Duration, want int) (got int) {
+	deadline := time.Now().Add(limit)
+	for {
+		got = runtime.NumGoroutine()
+		if got <= want || time.Now().After(deadline) {
+			return
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+}
+
+// fileBlockAttrs reads block id's attributes from its page's file.
+func fileBlockAttrs(id string) (map[string]string, error) {
+	bt := treenode.GetBlockTree(id)
+	if nil == bt {
+		return nil, fmt.Errorf("block %s isn't in the block index", id)
+	}
+	data, err := os.ReadFile(filepath.Join(util.DataDir, bt.BoxID, bt.Path))
+	if nil != err {
+		return nil, err
+	}
+	tree, err := filesys.LoadTreeByData(data, bt.BoxID, bt.Path, util.NewLute())
+	if nil != err {
+		return nil, err
+	}
+	node := treenode.GetNodeInTree(tree, id)
+	if nil == node {
+		return nil, fmt.Errorf("block %s isn't in its page's file", id)
+	}
+	ret := map[string]string{}
+	for _, kv := range node.KramdownIAL {
+		ret[kv[0]] = html.UnescapeAttrVal(kv[1])
+	}
+	return ret, nil
+}
+
+// Jobs, reads of attributes, renders of the table, kanban and gallery views, database saves, page saves, the view
+// operations both inside jobs and through their exported functions, moves, restores and reads of a database's history
+// copy all run at once for a few seconds. Then every worker must stop within its limit (no deadlock, no job left
+// waiting for the queue), the goroutines started must end (no leak), and every watched block must read what its file
+// holds. Run it under -race too: the rows' pages show images so that the cards' covers don't trip the stock race in
+// sql.renderBlockDOMByNode.
+func TestLocksStressJobsReadsRendersAndWriters(t *testing.T) {
+	f := setupLocksStress(t)
+	files := f.files
+	box := Conf.Box(files.box.ID)
+	if nil == box {
+		t.Fatal("setup: the fixture's notebook isn't open")
+	}
+	FlushTxQueue()
+	backgroundRefreshWaitGroup.Wait()
+	time.Sleep(500 * time.Millisecond)
+	goroutinesBefore := runtime.NumGoroutine()
+
+	duration := *locksStress
+	r := newStressRun()
+	layouts := []av.LayoutType{av.LayoutTypeTable, av.LayoutTypeKanban, av.LayoutTypeGallery}
+	viewIDs := func() (ret []string) {
+		attrView, err := av.ParseAttributeView(f.avID)
+		if nil != err {
+			return
+		}
+		for _, view := range attrView.Views {
+			ret = append(ret, view.ID)
+		}
+		return
+	}
+	sync1 := func(ops ...*Operation) error {
+		return PerformTransactionSync(&Transaction{DoOperations: ops})
+	}
+
+	// Jobs through the queue, as the editor sends them: attributes set on rows' pages, and the source page's paragraph
+	// edited. They come in bursts, so the queue empties between bursts and FlushTxQueue's callers get their turn.
+	r.worker("queued jobs", func(i int) error {
+		var txs []*Transaction
+		for j := range 3 {
+			page := f.rowPages[(i*3+j)%len(f.rowPages)]
+			txs = append(txs, &Transaction{DoOperations: []*Operation{{Action: "setAttrs", ID: page,
+				Data: fmt.Sprintf(`{"custom-stress":"q%d-%d"}`, i, j)}}})
+		}
+		edit := fmt.Sprintf(`<div data-node-id="%s" data-type="NodeParagraph" custom-edit="e%d"><div contenteditable="true">edit %d</div></div>`,
+			files.childID, i, i)
+		txs = append(txs, &Transaction{DoOperations: []*Operation{{Action: "update", ID: files.childID, Data: edit}}})
+		PerformTransactions(&txs)
+		time.Sleep(120 * time.Millisecond)
+		return nil
+	})
+	// Cell edits in jobs: a Name cell's edit sets its page's static anchor text and regroups the kanban view, which
+	// renders inside the job with the job's own attributes.
+	r.worker("cell edits", func(i int) error {
+		k := i % len(f.rowPages)
+		op := &Operation{}
+		data := fmt.Sprintf(`{"action":"updateAttrViewCell","avID":"%s","keyID":"%s","rowID":"%s","data":{"isDetached":false,"block":{"id":"%s","content":"Label %d"}}}`,
+			f.avID, f.blockKeyID, f.rowItems[k], f.rowPages[k], i)
+		if err := json.Unmarshal([]byte(data), op); nil != err {
+			return err
+		}
+		time.Sleep(5 * time.Millisecond)
+		return sync1(op)
+	})
+	// The seven view operations routed through the job, from two workers.
+	viewOperationsInJobs := func(i int) error {
+		switch i % 6 {
+		case 0:
+			return sync1(&Operation{Action: "changeAttrViewLayout", AvID: f.avID, BlockID: stressMirror,
+				Layout: layouts[(i/6)%len(layouts)]})
+		case 1:
+			ids := viewIDs()
+			if 1 > len(ids) {
+				return nil
+			}
+			return sync1(&Operation{Action: "setAttrViewBlockView", BlockID: f.blockID, AvID: f.avID,
+				ID: ids[(i/6)%len(ids)]})
+		case 2:
+			ids := viewIDs()
+			if 1 > len(ids) {
+				return nil
+			}
+			return sync1(&Operation{Action: "setAttrViewBlockVisibleViews", BlockID: stressMirror, AvID: f.avID,
+				ViewIDs: ids})
+		case 3:
+			viewID, err := AddAttributeViewView(f.avID, f.blockID, fmt.Sprintf("Extra %d", i), layouts[(i/6)%len(layouts)])
+			if nil != err {
+				return err
+			}
+			return RemoveAttributeViewView(f.avID, f.blockID, viewID)
+		case 4:
+			viewID, err := DuplicateAttributeViewView(f.avID, f.blockID, f.tableID, fmt.Sprintf("Copy %d", i))
+			if nil != err {
+				return err
+			}
+			return RemoveAttributeViewView(f.avID, stressMirror, viewID)
+		default:
+			return sync1(&Operation{Action: "addAttrViewView", AvID: f.avID, BlockID: stressMirror, ID: ast.NewNodeID(),
+				Name: fmt.Sprintf("Mirror view %d", i), Layout: av.LayoutTypeTable})
+		}
+	}
+	r.worker("view operations in jobs 0", viewOperationsInJobs)
+	r.worker("view operations in jobs 1", func(i int) error { return viewOperationsInJobs(i + 3) })
+	// The same operations through their exported functions, outside any job.
+	r.worker("view operations outside jobs", func(i int) error {
+		switch i % 3 {
+		case 0:
+			_, view, err := GetAttributeViewViewTarget(f.avID, f.blockID, f.galleryID)
+			if nil != err {
+				return err
+			}
+			return ChangeAttrViewLayoutForView(f.blockID, f.avID, f.galleryID, AttributeViewViewConfigRevision(view),
+				[]av.LayoutType{av.LayoutTypeTable, av.LayoutTypeGallery}[(i/3)%2])
+		case 1:
+			return SetDatabaseBlockView(stressMirror, f.avID, []string{f.tableID, f.kanbanID}[(i/3)%2])
+		default:
+			ids := viewIDs()
+			if 1 > len(ids) {
+				return nil
+			}
+			return SetDatabaseBlockVisibleViews(f.blockID, f.avID, ids)
+		}
+	})
+	// Reads: getBlockAttrs, the batch read, renders of every view, and the page tree's page attributes.
+	for reader := range 2 {
+		r.worker(fmt.Sprintf("reader %d", reader), func(i int) error {
+			switch i % 4 {
+			case 0:
+				for _, id := range f.watchedIDs {
+					sql.GetBlockAttrs(id)
+				}
+			case 1:
+				sql.BatchGetBlockAttrs(f.watchedIDs)
+			case 2:
+				for _, viewID := range []string{f.tableID, f.kanbanID, f.galleryID} {
+					RenderAttributeView(f.blockID, f.avID, viewID, "", 1, 50, nil, false, false)
+					RenderAttributeView(stressMirror, f.avID, viewID, "", 1, 50, nil, false, false)
+				}
+			default:
+				if _, _, err := ListDocTree(files.box.ID, "/", util.SortModeNameASC, false, false, 100); nil != err {
+					return err
+				}
+			}
+			return nil
+		})
+	}
+	// Writers outside the queue: setBlockAttrs, batchSetBlockAttrs, a database save and a page save.
+	r.worker("writers outside jobs", func(i int) error {
+		k := i % len(f.rowPages)
+		switch i % 4 {
+		case 0:
+			return SetBlockAttrs(f.rowPages[k], map[string]string{"custom-outside": fmt.Sprint(i)})
+		case 1:
+			return BatchSetBlockAttrs([]map[string]any{
+				{"id": f.rowPages[k], "attrs": map[string]string{"custom-batch": fmt.Sprint(i)}},
+				{"id": files.targetID, "attrs": map[string]string{"custom-batch": fmt.Sprint(i)}},
+			})
+		case 2:
+			attrView, err := av.ParseAttributeView(f.avID)
+			if nil != err {
+				return err
+			}
+			attrView.Name = fmt.Sprintf("Stress %d", i)
+			return av.SaveAttributeView(attrView)
+		default:
+			tree, err := LoadTreeByBlockID(files.targetID)
+			if nil != err {
+				return err
+			}
+			tree.Root.SetIALAttr("custom-page-save", fmt.Sprint(i))
+			_, err = filesys.WriteTree(tree)
+			return err
+		}
+	})
+	// A page moved under the source page and back, a page restored from its history, and the database's history copy
+	// read as history indexing reads it.
+	r.worker("moves, restores and history", func(i int) error {
+		switch i % 3 {
+		case 0:
+			bt := treenode.GetBlockTree(stressMovePage)
+			if nil == bt {
+				return fmt.Errorf("the moving page isn't in the block index")
+			}
+			to := files.sourcePath
+			if strings.Count(bt.Path, "/") > 1 {
+				to = "/"
+			}
+			return MoveDocs([]string{bt.Path}, files.box.ID, to, nil)
+		case 1:
+			if err := RollbackDocHistory(f.historyPath); nil != err {
+				return err
+			}
+			time.Sleep(100 * time.Millisecond)
+			return nil
+		default:
+			_, err := av.ParseAttributeViewByPath(f.historyAVPath)
+			return err
+		}
+	})
+
+	// The caches emptied and the notebook indexed again, as a full reindex does, without rebuilding SQL's database.
+	r.worker("clears and indexing", func(i int) error {
+		cache.ClearTreeCache()
+		cache.ClearDocsIAL()
+		cache.ClearBlocksIAL()
+		cache.ClearAVCache()
+		indexBox(files.box.ID)
+		time.Sleep(300 * time.Millisecond)
+		return nil
+	})
+
+	time.Sleep(duration)
+	r.stop.Store(true)
+	stopped := make(chan struct{})
+	go func() {
+		r.wg.Wait()
+		close(stopped)
+	}()
+	if !waitOrDump(t, "the workers", 120*time.Second, stopped) {
+		return
+	}
+	drained := make(chan struct{})
+	go func() {
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		sql.FlushQueue()
+		close(drained)
+	}()
+	if !waitOrDump(t, "the job queue and background refreshes", 60*time.Second, drained) {
+		return
+	}
+
+	r.mu.Lock()
+	names := slices.Sorted(maps.Keys(r.ops))
+	for _, name := range names {
+		t.Logf("%-32s %5d operations, %4d errors %s", name, r.ops[name], r.errs[name], r.sample[name])
+	}
+	r.mu.Unlock()
+
+	// Goroutines the workers started end: ReloadAttrView's pushes, RollbackDocHistory's refresh, setNodeAttrs' ref
+	// text refreshes and the like. A few seconds is ample.
+	if after := goroutineCountSettles(20*time.Second, goroutinesBefore+2); after > goroutinesBefore+2 {
+		buf := make([]byte, 1<<24)
+		n := runtime.Stack(buf, true)
+		fmt.Fprintf(os.Stderr, "\n===== goroutines left after the stress =====\n%s\n===== end =====\n", buf[:n])
+		t.Errorf("%d goroutines before the stress, %d twenty seconds after it ended; the dump is on stderr",
+			goroutinesBefore, after)
+	}
+
+	// What every watched block reads is what its file holds.
+	var stale []string
+	for _, id := range f.watchedIDs {
+		want, err := fileBlockAttrs(id)
+		if nil != err {
+			t.Errorf("read %s from its file: %v", id, err)
+			continue
+		}
+		got := sql.GetBlockAttrs(id)
+		for _, key := range slices.Sorted(maps.Keys(want)) {
+			if strings.HasPrefix(key, "custom-") || av.NodeAttrView == key || av.NodeAttrVisibleViewIDs == key {
+				if got[key] != want[key] {
+					stale = append(stale, fmt.Sprintf("%s %s: reads %q, file holds %q", id, key, got[key], want[key]))
+				}
+			}
+		}
+	}
+	sort.Strings(stale)
+	for _, s := range stale {
+		t.Errorf("after the stress, %s", s)
+	}
+	raw, err := os.ReadFile(av.GetAttributeViewDataPath(f.avID))
+	if nil != err {
+		t.Fatal(err)
+	}
+	fromFile, err := av.ParseAttributeViewData(f.avID, raw)
+	if nil != err {
+		t.Fatal(err)
+	}
+	served, err := av.ParseAttributeView(f.avID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if fromFile.Name != served.Name || len(fromFile.Views) != len(served.Views) {
+		t.Errorf("after the stress, the database reads name %q with %d views; its file holds %q with %d views",
+			served.Name, len(served.Views), fromFile.Name, len(fromFile.Views))
+	}
+	if !t.Failed() && 0 == len(stale) {
+		t.Logf("goroutines: %d before, %d after", goroutinesBefore, runtime.NumGoroutine())
+	}
+	_ = box
+}
