+package model
+
+import (
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+)
+
+// Reads that save: getAttributeViewKeys, a writable render and getAttributeViewPrimaryKeyValues read a database and,
+// now and then, correct what they read (the order of its fields, a render's groups, a reference's subtype) and save
+// the correction. They read without the turn, as readers do: polka polls getAttributeViewKeys every 250 ms after a
+// rename, and a read that waited behind every job, or held the turn through a render, would hold the editor's edits up
+// with it. Only a read that changed something saves, and it saves in a turn, and only if the database's version it
+// noted before it read still holds: nothing saved the database since. Otherwise it saves nothing, and the next read
+// makes the correction again from the newer copy.
+
+// attrViewReadNote is a database's version, noted before a read that may save what it read.
+type attrViewReadNote struct {
+	avID, boxID string
+	version     uint64
+}
+
+// noteAttrViewRead notes database avID's version before a read of it through av.ParseAttributeView, keyed as that
+// parse and av.SaveAttributeView find it.
+func noteAttrViewRead(avID string) *attrViewReadNote {
+	_, boxID := av.FindAttributeViewPath(avID)
+	return &attrViewReadNote{avID: avID, boxID: boxID, version: cache.EnsureAVDataVersionInBox(avID, boxID)}
+}
+
+// noteAttrViewReadInBox notes database avID's version before a read of it through av.ParseAttributeViewInBox.
+func noteAttrViewReadInBox(avID, boxID string) *attrViewReadNote {
+	_, boxID = av.FindAttributeViewPathInBox(avID, boxID)
+	return &attrViewReadNote{avID: avID, boxID: boxID, version: cache.EnsureAVDataVersionInBox(avID, boxID)}
+}
+
+// holds reports whether nothing saved the database since the note. The caller has the turn.
+func (note *attrViewReadNote) holds() bool {
+	return note.version == cache.EnsureAVDataVersionInBox(note.avID, note.boxID)
+}
+
+// saveIfUnchanged saves attrView, the database the note was taken for as the read changed it, in a turn of its own and
+// only if the note holds. It reports whether it saved.
+func (note *attrViewReadNote) saveIfUnchanged(attrView *av.AttributeView) (saved bool, err error) {
+	release := takeTurn()
+	defer release()
+	return note.saveIfUnchangedInTurn(attrView)
+}
+
+// saveIfUnchangedInTurn is saveIfUnchanged for a caller that has the turn.
+func (note *attrViewReadNote) saveIfUnchangedInTurn(attrView *av.AttributeView) (saved bool, err error) {
+	if !note.holds() {
+		return false, nil
+	}
+	if err = av.SaveAttributeView(attrView); nil != err {
+		return false, err
+	}
+	// The save raised the version, unless the file already held the bytes: the read's next correction, if it makes
+	// one, compares with what this save left.
+	note.version = cache.EnsureAVDataVersionInBox(note.avID, note.boxID)
+	return true, nil
+}
