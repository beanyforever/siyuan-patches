+// turnLock is flushLock's type: a mutex whose holder has the turn. A job holds it while it runs, and so does every
+// writer that takes turns with jobs. Holding it is what the tripwire reads as being in a turn: a page or database save
+// made while no one holds it is logged once per call site.
+type turnLock struct {
+	mu sync.Mutex
+}
+
+func (l *turnLock) Lock() {
+	l.mu.Lock()
+	tripwire.EnterTurn()
+}
+
+func (l *turnLock) TryLock() bool {
+	if !l.mu.TryLock() {
+		return false
+	}
+	tripwire.EnterTurn()
+	return true
+}
+
+func (l *turnLock) Unlock() {
+	tripwire.LeaveTurn()
+	l.mu.Unlock()
+}
+
 func init() {
 	go flushQueue()
+
+	// These only forward to a page or database save function; a save outside a turn is named at their caller.
+	tripwire.SaveFunctions(writeTreeUpsertQueue, writeTreeUpsertQueue0, indexWriteTreeIndexQueue,
+		indexWriteTreeUpsertQueue, indexWriteTreeUpsertQueue0, renameWriteJSONQueue, writeRenameDoc,
+		writeRenameDocIfUnchanged, writeRenameDocWith, restoreCreatedDocTreeSnapshot, avSaveView)
 }
 
 func flushQueue() {
 	ticker := time.NewTicker(50 * time.Millisecond)
 	defer ticker.Stop()
 	for range ticker.C {
-		flushLock.Lock()
+		// The tick takes flushLock's mutex without the turn, and enters the turn only when it has jobs to run: an empty
+		// tick runs nothing and saves nothing, and taking it for a turn would hide a save outside a turn landing in it.
+		flushLock.mu.Lock()
 		isFlushing.Store(true)
 		transactions := takeQueuedTransactions()
-		for _, tx := range transactions {
-			flushTx(tx)
+		if 0 < len(transactions) {
+			tripwire.EnterTurn()
+			for _, tx := range transactions {
+				flushTx(tx)
+			}
+			tripwire.LeaveTurn()
 		}
 		isFlushing.Store(false)
-		flushLock.Unlock()
+		flushLock.mu.Unlock()
 	}
 }
 
