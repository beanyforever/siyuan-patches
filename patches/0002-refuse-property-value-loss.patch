+		{Action: "updateAttrViewColOptions", AvID: f.tasks, ID: f.status, Data: []*av.SelectOption{{Name: name, Color: "4"}}},
+		{Action: "updateAttrViewCell", AvID: f.tasks, KeyID: f.status, RowID: row,
+			Data: map[string]any{"mSelect": []any{map[string]any{"content": name}}}},
+	}
+}
+
+// undoing applies an edit's inverse as the editor's undo does: replayed, carrying the edit as its
+// undo operations.
+func undoing(edit []*Operation, inverse ...*Operation) error {
+	tx := &Transaction{DoOperations: inverse, UndoOperations: edit}
+	tx.MarkReplay()
+	return PerformTxSync(tx)
+}
