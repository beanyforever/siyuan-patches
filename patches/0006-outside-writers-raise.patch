+// Step 4's challenger: the sync's raise comes after its upload.
+
+// syncIndexUploadProbe, when set, runs each time a sync is about to upload an index to the cloud. A two-way sync
+// (dejavu's Repo.Sync) does that only after it has written the cloud's files into the data folder (restoreFiles) and
+// indexed the merge, and before it returns.
+var syncIndexUploadProbe atomic.Pointer[func()]
+var subscribeSyncIndexUploadProbe sync.Once
+
+func probeSyncIndexUpload(t *testing.T, probe func()) {
+	t.Helper()
+	subscribeSyncIndexUploadProbe.Do(func() {
+		// eventbus has no unsubscribe: the handler stays, and does nothing while no probe is set.
+		if err := eventbus.Subscribe(eventbus.EvtCloudBeforeUploadIndex, func(context map[string]any, id string) {
+			if p := syncIndexUploadProbe.Load(); nil != p {
+				(*p)()
+			}
+		}); nil != err {
+			t.Fatal(err)
+		}
+	})
+	syncIndexUploadProbe.Store(&probe)
+	t.Cleanup(func() { syncIndexUploadProbe.Store(nil) })
+}
+
+// A two-way sync (the sync job, the API's sync, boot and perception sync all reach syncRepoWithPublication), here
+// with a cloud in a local folder that another device has published a page's new copy to. dejavu writes the cloud's
+// copy over the page's file (restoreFiles), then, since this device has changes of its own, indexes the merge and
+// uploads it: chunks, files, then the indexes and refs, each a network round trip on a real cloud. Only after
+// repo.Sync returns does raiseAfterSync raise everything. All that while, the caches serve the page as it was before
+// the sync, though its file holds the cloud's copy: a read gets the old copy, and a job that edits the page then saves
+// the old copy plus its edit over the cloud's, losing it, after which the next sync publishes the loss.
+//
+// dejavu publishes EvtCheckoutUpsertFile after each file it writes and EvtCheckoutRemoveFile after each file it
+// removes, in every sync, checkout and asset recovery, and SiYuan already subscribes to both (subscribeRepoEvents), so
+// a raise can follow each write there rather than the network calls. The test reads the page as SiYuan serves it
+// when the sync is about to upload its index, after it has written the page's file: it must read the cloud's copy.
+func TestSyncServesTheMergedPageWhileItUploads(t *testing.T) {
+	f := setupMoveCacheTest(t)
