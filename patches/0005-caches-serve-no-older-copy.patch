+)
+
+// fillVersions stays bounded without ever serving a copy older than its file, and without refusing everything when it
+// forgets. Past its limit it forgets ids, and an id it has forgotten can't be told from one never written.
+//   - A copy of an id noted before the id's last write is refused, whether the map still holds the id or has forgotten
+//     it, since serving it would serve a copy older than the file.
+//   - A copy of an id never written, noted before the map forgot anything, is mostly still served. Refusing every copy
+//     noted before the forgetting would make every cached page miss at once. Some may be refused, since a miss is
+//     safe, so the test asks for at least half; a design that refuses everything noted before it forgets serves none.
+//   - A copy noted after every write is served, whatever the id.
+func TestFillVersionsForgetPastTheirLimit(t *testing.T) {
+	v := newFillVersions()
+	writes := fillVersionsLimit + 1 // one past the limit, so the map must forget
+	unwritten := min(1024, fillVersionsLimit)
+	step := fillVersionsLimit / unwritten
+	written := func(i int) string { return fmt.Sprintf("written-%d", i) }
+	never := func(j int) string { return fmt.Sprintf("never-written-%d", j) }
+
+	notedBeforeWrite := make([]FillToken, writes)
+	notedUnwritten := make([]FillToken, unwritten)
+	for i := range writes {
+		// The never-written ids' copies are noted at even steps through the writes, all before the limit is passed.
+		if j := i / step; 0 == i%step && j < unwritten {
+			notedUnwritten[j] = NewFillToken()
+		}
+		notedBeforeWrite[i] = NewFillToken()
+		v.bump(written(i))
+	}
+	notedAfter := NewFillToken()
+
+	stale := 0
+	for i := range writes {
+		if v.fresh(written(i), notedBeforeWrite[i]) {
+			stale++
+		}
+	}
+	if 0 < stale {
+		t.Errorf("past the limit of %d, a copy noted before its id's last write was served for %d of %d written ids",
+			fillVersionsLimit, stale, writes)
+	}
+
+	served := 0
+	for j := range unwritten {
+		if v.fresh(never(j), notedUnwritten[j]) {
+			served++
+		}
+	}
+	t.Logf("once the map forgot ids, %d of %d ids never written were still served a copy noted before", served, unwritten)
+	if served*2 < unwritten {
+		t.Errorf("forgetting refused most copies noted before it: fewer than half of the ids never written were served")
+	}
+
+	refused := 0
+	for i := range writes {
+		if !v.fresh(written(i), notedAfter) {
+			refused++
+		}
+	}
+	for j := range unwritten {
+		if !v.fresh(never(j), notedAfter) {
+			refused++
+		}
+	}
+	if 0 < refused {
+		t.Errorf("a copy noted after every write was refused for %d ids", refused)
+	}
+}
