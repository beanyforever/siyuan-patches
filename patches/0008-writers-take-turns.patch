+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// The locks challenger's tests of step 6's fix round 4 (issue #43): how long the touch before a one-page snapshot
+// restore's backup takes to pass over the seconds of stored copies, and that it never waits for the turn.
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/dejavu/entity"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// r4TouchWorkspace points util.DataDir and util.RepoDir at folders under base for one test, and makes a database file
+// dated a minute ago. It returns the file's absolute path and its path in the repository.
+func r4TouchWorkspace(t *testing.T, base string) (p, repoPath string) {
+	t.Helper()
+	originalDataDir, originalRepoDir := util.DataDir, util.RepoDir
+	util.DataDir, util.RepoDir = filepath.Join(base, "data"), filepath.Join(base, "repo")
+	t.Cleanup(func() { util.DataDir, util.RepoDir = originalDataDir, originalRepoDir })
+	p = filepath.Join(util.DataDir, "storage", "av", "20261018000000-r4touch.json")
+	if err := os.MkdirAll(filepath.Dir(p), 0755); nil != err {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte("{}"), 0644); nil != err {
+		t.Fatal(err)
+	}
+	minuteAgo := time.Now().Add(-time.Minute)
+	if err := os.Chtimes(p, minuteAgo, minuteAgo); nil != err {
+		t.Fatal(err)
+	}
+	return p, "/storage/av/20261018000000-r4touch.json"
+}
+
+// r4StoreCopies makes an empty object in the repository for each of n seconds from first, where dejavu keeps the copy
+// of repoPath dated in that second.
+func r4StoreCopies(t *testing.T, repoPath string, first time.Time, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		id := entity.NewFile(repoPath, 0, first.Add(time.Duration(i)*time.Second).UnixMilli()).ID
+		dir := filepath.Join(util.RepoDir, "objects", id[:2])
+		if err := os.MkdirAll(dir, 0755); nil != err {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, id[2:]), nil, 0644); nil != err {
+			t.Fatal(err)
+		}
+	}
+}
+
+// The pass over stored copies ends at the first second with none, costs one stat per copy in a row, and dates the
+// file that many seconds ahead of the clock. With 20,000 copies in a row on the container's disk it takes well under a
+// second; on the checkout's network share, 500 in a row are timed and logged for the per-copy cost.
+func TestStep6ChallengeLocksRound4TouchPassesOverARunOfStoredCopiesPromptly(t *testing.T) {
+	cases := []struct {
+		name string
+		base func(t *testing.T) string
+		run  int
+		most time.Duration
+	}{
+		{name: "local disk, 20000 copies", base: func(t *testing.T) string { return t.TempDir() }, run: 20000,
+			most: time.Second},
+		{name: "network share, 500 copies", base: func(t *testing.T) string {
+			dir, err := os.MkdirTemp(".", "zz-r4-touch-")
+			if nil != err {
+				t.Fatal(err)
+			}
+			abs, _ := filepath.Abs(dir)
+			t.Cleanup(func() { _ = os.RemoveAll(abs) })
+			return abs
+		}, run: 500, most: 5 * time.Second},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			p, repoPath := r4TouchWorkspace(t, c.base(t))
+			// From two seconds back, so the run covers whatever second the touch starts in.
+			first := time.Now().Truncate(time.Second).Add(-2 * time.Second)
+			made := time.Now()
+			r4StoreCopies(t, repoPath, first, c.run)
+			t.Logf("made %d copies in %s", c.run, time.Since(made))
+			start := time.Now()
+			touchSnapshotRestoreTarget(false, "", p)
+			took := time.Since(start)
+			info, err := os.Stat(p)
+			if nil != err {
+				t.Fatal(err)
+			}
+			end := first.Add(time.Duration(c.run) * time.Second)
+			t.Logf("passed over the copies in %s (%s each); file dated %s, %s ahead of the clock", took,
+				took/time.Duration(c.run), info.ModTime().UTC(), time.Until(info.ModTime()).Round(time.Second))
+			if !info.ModTime().Truncate(time.Second).Equal(end) {
+				t.Errorf("the file was dated %s, not in the first second after the run, %s", info.ModTime(), end)
+			}
+			if took > c.most {
+				t.Errorf("the pass took %s, more than %s", took, c.most)
+			}
+		})
+	}
+}
+
+// The touch takes no lock a job holds: with the turn held elsewhere, it still dates the file past its stored copies
+// and returns. RollbackRepoSnapshotFile calls it before it waits for the queue and before its turn.
+func TestStep6ChallengeLocksRound4TouchDoesNotWaitForTheTurn(t *testing.T) {
+	p, repoPath := r4TouchWorkspace(t, t.TempDir())
+	first := time.Now().Truncate(time.Second).Add(-2 * time.Second)
+	r4StoreCopies(t, repoPath, first, 10)
+	release := takeTurn()
+	defer release()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		touchSnapshotRestoreTarget(false, "", p)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the touch waited for the turn")
+	}
+	info, err := os.Stat(p)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if end := first.Add(10 * time.Second); !info.ModTime().Truncate(time.Second).Equal(end) {
+		t.Errorf("the file was dated %s, not %s", info.ModTime(), end)
+	}
+}
