+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package filesys
+
+import (
+	"fmt"
+	"hash/fnv"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// Step 4's challenger, fix round 1: the folder bracket's RaiseChangedSince scans only the version map's ids. A page
+// written into the folder during the remove escapes it when its version rose without an entry in the map: through the
+// epoch of a bulk raise (RaiseAll), or because the bounded map forgot it into a bucket before the scan.
+
+// waitRaiseTestCached waits up to 200 ms for ristretto to take in the page cache's store of page id.
+func waitRaiseTestCached(t *testing.T, box, id string) {
+	t.Helper()
+	for deadline := time.Now().Add(200 * time.Millisecond); ; time.Sleep(time.Millisecond) {
+		if _, ok := cache.GetTreeDataInBox(id, box); ok {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("setup: the page cache doesn't serve page %s", id)
+		}
+	}
+}
+
+// checkRemovedPageNotServed wants the page the remove took away served by nobody: the page cache refuses its entry, and
+// a save of the page as it was writes its file rather than skip it as already written.
+func checkRemovedPageNotServed(t *testing.T, tree *parse.Tree) {
+	t.Helper()
+	absPath := filepath.Join(util.DataDir, tree.Box, tree.Path)
+	if _, err := os.Stat(absPath); !os.IsNotExist(err) {
+		t.Fatalf("setup: the remove left the page's file: %v", err)
+	}
+	if _, ok := cache.GetTreeDataInBox(tree.ID, tree.Box); ok {
+		t.Error("after the remove, the page cache serves the page written into the folder during it, whose file the " +
+			"remove took away")
+	}
+	if _, err := WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(absPath); nil != err {
+		t.Errorf("a save of the page as it was, after the remove, wrote no file: %v", err)
+	}
+}
+
+// A bulk writer (a sync's or a checkout's file event, a data.zip import, the user guide's mount, any raw write over
+// data/) can't name what it writes, so it raises everything at once: RaiseAll moves the epoch and puts no page in the
+// version map. A page such a writer puts into a folder while the folder's remove runs, and that a read then caches, has
+// no entry in the map above the bracket's start, so RaiseChangedSince doesn't raise it, and the remove takes its file.
+func TestRemovingAFolderRaisesAPageABulkWriterPutInItDuringTheRemove(t *testing.T) {
+	box, parent, _, _ := setupStalePathTest(t)
+	folder := filepath.Join(util.DataDir, box, parent)
+	existing := treenode.NewTree(box, "/"+parent+"/20261018050001-existng.sy", "/Parent/Existing", "Existing")
+	if _, err := WriteTree(existing); nil != err {
+		t.Fatal(err)
+	}
+	// The page's bytes as WriteTree writes them, taken from a copy in another notebook, so that a save of the page later
+	// compares equal to what a read of its file caches.
+	const otherBox = "20261018050000-otherbx"
+	late := treenode.NewTree(otherBox, "/"+parent+"/20261018050002-bulkpge.sy", "/Parent/Bulk", "Bulk")
+	if _, err := WriteTree(late); nil != err {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(util.DataDir, otherBox, late.Path))
+	if nil != err {
+		t.Fatal(err)
+	}
+	late.Box = box
+
+	end := BeginDataPathWrite(folder)
+	// The bulk writer writes the page into the folder and raises everything, then a read caches the page.
+	if err = os.WriteFile(filepath.Join(util.DataDir, box, late.Path), data, 0644); nil != err {
+		t.Fatal(err)
+	}
+	cache.RaiseAll()
+	if _, err = LoadTree(box, late.Path, util.NewLute()); nil != err {
+		t.Fatal(err)
+	}
+	waitRaiseTestCached(t, box, late.ID)
+	if err = os.RemoveAll(folder); nil != err {
+		t.Fatal(err)
+	}
+	end()
+
+	checkRemovedPageNotServed(t, late)
+}
+
+// The version map remembers 32,768 ids; past that it forgets the eighth raised longest ago into buckets. A folder's end
+// first raises every page its walks noted, then calls RaiseChangedSince. When the folder holds more pages than the map
+// remembers (a notebook of that size, or a page with that many sub-pages), that first raise forgets the page written
+// into the folder during the remove, the oldest raise in the map, into its bucket, and RaiseChangedSince, which scans
+// only the map's ids, never raises it again. Its bucket keeps the version its write cached, so the page cache serves
+// it. The folder's pages here are chosen so none shares the written page's bucket, which another forgotten id raised
+// later would otherwise raise by chance (one time in about 16).
+func TestRemovingALargeFolderRaisesAPageWrittenIntoItDuringTheRemove(t *testing.T) {
+	box, parent, _, _ := setupStalePathTest(t)
+	folder := filepath.Join(util.DataDir, box, parent)
+	if err := os.MkdirAll(folder, 0755); nil != err {
+		t.Fatal(err)
+	}
+	bucket := func(id string) uint64 {
+		h := fnv.New64a()
+		h.Write([]byte(id))
+		return h.Sum64() % (1 << 16)
+	}
+	late := treenode.NewTree(box, "/"+parent+"/20261018060000-largepg.sy", "/Parent/Large", "Large")
+	lateBucket := bucket(late.ID)
+	const pages = 33000
+	for i, n := 0, 0; n < pages; i++ {
+		id := fmt.Sprintf("20261018%06d-a%06d", i, i)
+		if lateBucket == bucket(id) {
+			continue
+		}
+		if err := os.WriteFile(filepath.Join(folder, id+".sy"), []byte("{}"), 0644); nil != err {
+			t.Fatal(err)
+		}
+		n++
+	}
+
+	end := BeginDataPathWrite(folder)
+	if _, err := WriteTree(late); nil != err {
+		t.Fatal(err)
+	}
+	waitRaiseTestCached(t, box, late.ID)
+	if err := os.RemoveAll(folder); nil != err {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	end()
+	t.Logf("the end of a remove of %d pages took %s", pages, time.Since(start))
+
+	checkRemovedPageNotServed(t, late)
+}
