 kernel/model/repository.go                    |  26 ++
 .../model/restore_moved_blocks_fts5_test.go   | 235 ++++++++++++++++++
 2 files changed, 261 insertions(+)
 create mode 100644 kernel/model/restore_moved_blocks_fts5_test.go

diff --git a/kernel/model/repository.go b/kernel/model/repository.go
index 0eb5f41..ce4261f 100644
--- a/kernel/model/repository.go
+++ b/kernel/model/repository.go
@@ -518,6 +518,31 @@ func noteSnapshotRestoreTarget(repoPath string) (what string, changedSince func(
 	return "file", func() bool { return false }
 }
 
+// resetIDsOfBlocksInOtherPages gives a block of a page's restored copy a new id when the block record places that id
+// under another page, as for a block moved there since the snapshot, so that the block stays in that page alone and the
+// restored page holds the snapshot's copy of it as a block of its own. The page block keeps its id, and so do the
+// restored page's own blocks and the blocks the block record doesn't hold. It compares pages by root id, not notebook,
+// so a page moved to another notebook since restores as before; a restore from history renews the ids of a page in
+// another notebook too (https://github.com/siyuan-note/siyuan/issues/14358).
+func resetIDsOfBlocksInOtherPages(tree *parse.Tree) {
+	nodes := map[string]*ast.Node{}
+	ast.Walk(tree.Root, func(n *ast.Node, entering bool) ast.WalkStatus {
+		if entering && n.IsBlock() && ast.NodeDocument != n.Type {
+			nodes[n.ID] = n
+		}
+		return ast.WalkContinue
+	})
+	ids := make([]string, 0, len(nodes))
+	for id := range nodes {
+		ids = append(ids, id)
+	}
+	for id, bt := range treenode.GetBlockTrees(ids) {
+		if nil != bt && tree.Root.ID != bt.RootID {
+			treenode.ResetNodeID(nodes[id])
+		}
+	}
+}
+
 // rollbackRepoSnapshotDocInTurn replaces page rootID with its snapshot copy, already written to from, and gives the
 // page as written. Its caller has the turn.
 func rollbackRepoSnapshotDocInTurn(boxID, rootID, repoPath, from string, needResetTree bool) (tree *parse.Tree, err error) {
@@ -545,6 +570,7 @@ func rollbackRepoSnapshotDocInTurn(boxID, rootID, repoPath, from string, needRes
 	if needResetTree {
 		resetTree(tree, "", true)
 	}
+	resetIDsOfBlocksInOtherPages(tree)
 
 	if nil != testHookRollbackRepoSnapshotFileRead {
 		testHookRollbackRepoSnapshotFileRead()
