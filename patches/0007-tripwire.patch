+// The first save of a new page or database, whose file doesn't exist yet, logs nothing. A later save of it outside a
+// turn, from another site, logs: the file exists by then.
+func TestTripwireLeavesTheFirstSaveOfANewFileUnlogged(t *testing.T) {
+	t.Run("a page", func(t *testing.T) {
+		runTripwireTest(t, func(t *testing.T) {
+			files := setupFileOperationTest(t)
+			log := newTripwireLog(t)
+			page := treenode.NewTree(files.box.ID, "/20261018000300-trippg3.sy", "/New page", "New page")
+			t.Cleanup(func() {
+				cache.RemoveTreeData(page.ID)
+				cache.RemoveDocIAL(page.Path)
+			})
+			if _, err := os.Stat(tripwirePagePath(page)); !os.IsNotExist(err) {
+				t.Fatalf("setup: the new page's file exists before its first save: %v", err)
+			}
+			begin := log.mark(t)
+			if _, err := tripwireSaveNewPage(page); nil != err {
+				t.Fatal(err)
+			}
+			treenode.UpsertBlockTree(page)
+			requireTripwireFileHolds(t, "the new page's first save", tripwirePagePath(page), page.ID)
+			checkNothingLogged(t, log, begin, "after the first save of a new page")
+
+			checkPageControl(t, log, page)
+		})
+	})
+	t.Run("a database", func(t *testing.T) {
+		runTripwireTest(t, func(t *testing.T) {
+			setupFileOperationTest(t)
+			log := newTripwireLog(t)
+			const id = "20261018000301-tripdb3"
+			attrView := newTripwireAttributeView(t, id, "New database")
+			avPath := av.GetAttributeViewDataPath(id)
+			if _, err := os.Stat(avPath); !os.IsNotExist(err) {
+				t.Fatalf("setup: the new database's file exists before its first save: %v", err)
+			}
+			begin := log.mark(t)
+			if _, err := tripwireSaveNewDatabase(attrView); nil != err {
+				t.Fatal(err)
+			}
+			requireTripwireFileHolds(t, "the new database's first save", avPath, attrView.Name)
+			checkNothingLogged(t, log, begin, "after the first save of a new database")
+
+			// Control: the database exists now, and a save of it outside a turn logs.
+			mark := log.mark(t)
+			attrView.Name = "Saved again"
+			site, err := tripwireSaveDatabaseControl(attrView)
+			if nil != err {
+				t.Fatal(err)
+			}
+			requireTripwireFileHolds(t, "control", avPath, attrView.Name)
+			checkTripwireSite(t, "control: after a save of the database outside a turn, once it exists",
+				log.linesSince(t, mark), site, "database", 1)
+		})
+	})
+}
