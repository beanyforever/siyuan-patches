+// Rolling a database back to its history keeps a job's save of the database made between the rollback's read of the
+// history copy and its copy over the database: the job runs after the rollback, on the restored database.
+func TestDatabaseHistoryRollbackKeepsAJobsSaveMadeBetweenItsReadAndItsWrite(t *testing.T) {
