+// A repair made while loading a page logs nothing: fixTreeJSONData's write-back of a damaged page, and of a page in an
+// older format, and the rebuild of a missing parent page. Each file is written as another program would, around SiYuan,
+// and then loaded through SiYuan's page load, which repairs it.
+func TestTripwireLeavesRepairsWhileLoadingUnlogged(t *testing.T) {
+	// writeRaw writes tree's file as JSON, without SiYuan's save, and returns what it wrote.
+	writeRaw := func(t *testing.T, tree *parse.Tree) []byte {
+		t.Helper()
+		luteEngine := util.NewLute()
+		data := render.NewJSONRenderer(tree, luteEngine.RenderOptions, luteEngine.ParseOptions).Render()
+		absPath := tripwirePagePath(tree)
+		if err := os.MkdirAll(filepath.Dir(absPath), 0755); nil != err {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(absPath, data, 0644); nil != err {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() {
+			cache.RemoveTreeData(tree.ID)
+			cache.RemoveDocIAL(tree.Path)
+		})
+		return data
+	}
+	// requireRewritten stops the test if loading didn't write the repaired page back: the file must have changed, and
+	// match repaired, a regular expression.
+	requireRewritten := func(t *testing.T, tree *parse.Tree, written []byte, repaired string) {
+		t.Helper()
+		data, err := os.ReadFile(tripwirePagePath(tree))
+		if nil != err {
+			t.Fatal(err)
+		}
+		if bytes.Equal(data, written) || !regexp.MustCompile(repaired).Match(data) {
+			t.Fatalf("setup: loading the page didn't write its repair back (%q):\n%s", repaired, data)
+		}
+	}
+
+	t.Run("a damaged page", func(t *testing.T) {
+		runTripwireTest(t, func(t *testing.T) {
+			files := setupFileOperationTest(t)
+			log := newTripwireLog(t)
+			// A paragraph directly under a list, which fixTreeJSONData wraps in a list item.
+			tree := treenode.NewTree(files.box.ID, "/20261018000400-trippg4.sy", "/Damaged", "Damaged")
+			paragraph := tree.Root.FirstChild
+			paragraph.Unlink()
+			list := &ast.Node{Type: ast.NodeList, ID: "20261018000400-triplst", ListData: &ast.ListData{Typ: 1}}
+			list.SetIALAttr("id", list.ID)
+			list.AppendChild(paragraph)
+			tree.Root.AppendChild(list)
+			written := writeRaw(t, tree)
+
+			begin := log.mark(t)
+			loaded := loadTripwirePage(t, files.box.ID, tree.Path)
+			requireRewritten(t, tree, written, "NodeListItem")
+			checkNothingLogged(t, log, begin, "after loading a damaged page wrote its repair back")
+
+			checkPageControl(t, log, loaded)
+		})
+	})
+	t.Run("an older-format page", func(t *testing.T) {
+		runTripwireTest(t, func(t *testing.T) {
+			files := setupFileOperationTest(t)
+			log := newTripwireLog(t)
+			// Spec 1, which fixTreeJSONData upgrades to 2.
+			tree := treenode.NewTree(files.box.ID, "/20261018000401-trippg5.sy", "/Older", "Older")
+			tree.Root.Spec = "1"
+			written := writeRaw(t, tree)
+			if !regexp.MustCompile(`"Spec":\s*"1"`).Match(written) {
+				t.Fatalf("setup: the older-format page's file doesn't say Spec 1:\n%s", written)
+			}
+
+			begin := log.mark(t)
+			loaded := loadTripwirePage(t, files.box.ID, tree.Path)
+			requireRewritten(t, tree, written, `"Spec":\s*"2"`)
+			checkNothingLogged(t, log, begin, "after loading an older-format page wrote its upgrade back")
+
+			checkPageControl(t, log, loaded)
+		})
+	})
+	t.Run("a page whose parent is missing", func(t *testing.T) {
+		runTripwireTest(t, func(t *testing.T) {
+			files := setupFileOperationTest(t)
+			log := newTripwireLog(t)
+			const parentID = "20261018000402-tripprt"
+			parentPath := filepath.Join(util.DataDir, files.box.ID, parentID+".sy")
+			t.Cleanup(func() {
+				cache.RemoveTreeData(parentID)
+				cache.RemoveDocIAL("/" + parentID + ".sy")
+			})
+			tree := treenode.NewTree(files.box.ID, "/"+parentID+"/20261018000403-tripchd.sy", "/Parent/Child", "Child")
+			writeRaw(t, tree)
+			if _, err := os.Stat(parentPath); !os.IsNotExist(err) {
+				t.Fatalf("setup: the parent page's file exists before the load: %v", err)
+			}
+
+			begin := log.mark(t)
+			loaded := loadTripwirePage(t, files.box.ID, tree.Path)
+			if _, err := os.Stat(parentPath); nil != err {
+				t.Fatalf("setup: loading the page didn't rebuild its missing parent: %v", err)
+			}
+			checkNothingLogged(t, log, begin, "after loading a page rebuilt its missing parent")
+
+			checkPageControl(t, log, loaded)
+		})
+	})
+}
