+
+// setupAttrsCacheTest is the file operation fixture with SQL's databases, and the page cache and both attribute caches
+// emptied, as after a restart.
+func setupAttrsCacheTest(t *testing.T) *fileOperationTestFixture {
+	t.Helper()
+	files := setupStructureTransactionTest(t)
+	setupFoldTransactionDatabase(t, files)
+	clear := func() {
+		cache.ClearTreeCache()
+		cache.ClearBlocksIAL()
+		cache.ClearDocsIAL()
+	}
+	clear()
+	t.Cleanup(func() {
+		testHookDocIALFill = nil
+		clear()
+	})
+	return files
+}
+
+// loadAttrsCachePageFile loads a page as its file holds it, a copy of its own that a test can change and save.
+func loadAttrsCachePageFile(t *testing.T, boxID, p string) *parse.Tree {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(util.DataDir, boxID, p))
+	if nil != err {
+		t.Fatal(err)
+	}
+	ret, err := filesys.LoadTreeByData(data, boxID, p, util.NewLute())
+	if nil != err {
+		t.Fatal(err)
+	}
+	return ret
+}
+
+// settleAttrsCache gives the block attribute cache time to take in what a read has just stored in it: ristretto takes
+// a key it doesn't hold yet in on a goroutine of its own. It returns once the cache serves each block, or after 200 ms.
+func settleAttrsCache(boxID string, ids ...string) {
+	deadline := time.Now().Add(200 * time.Millisecond)
+	for _, id := range ids {
+		for nil == cache.GetBlockIALInBox(id, boxID) && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+	}
+}
+
+// jobAttrsOperations are a job's attribute changes, as the editor sends them: the page's attributes set, and an edit of
+// its paragraph that gives the paragraph an attribute.
+func jobAttrsOperations(files *fileOperationTestFixture) []*Operation {
+	edit := fmt.Sprintf(`<div data-node-id="%s" data-type="NodeParagraph" custom-job="edited"><div contenteditable="true">edited</div></div>`, files.childID)
+	return []*Operation{
+		{Action: "setAttrs", ID: files.sourceID, Data: `{"custom-job":"set"}`},
+		{Action: "update", ID: files.childID, Data: edit},
+	}
+}
+
+// A copy of a page's attributes read before a save of the page and stored after the save has stored its own is not
+// served: the page tree shows what the save wrote. The page tree reads each page's attributes through the page
+// attribute cache, and on a miss reads the page's file and stores what it read; ristretto applies a store of a key it
+// already holds at once, so the later store wins whatever it holds. A test hook places the save between that read and
+// that store, after the save's own copy is in the cache, as when the read is slow.
+func TestOlderPageAttributesStoredAfterASaveAreNotServed(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	box := Conf.Box(files.box.ID)
+	if nil == box {
+		t.Fatal("setup: the fixture's notebook isn't open")
+	}
+	saved := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath)
+	saved.Root.SetIALAttr("memo", "Saved")
+	fired := false
+	testHookDocIALFill = func() {
+		if fired {
+			return
+		}
+		fired = true
+		if _, err := filesys.WriteTree(saved); nil != err {
+			t.Error(err)
+		}
+		for deadline := time.Now().Add(time.Second); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+			if "Saved" == cache.GetDocIALInBox(files.sourcePath, files.box.ID)["memo"] {
+				break
+			}
+		}
+	}
+	if ial := box.docIAL(files.sourcePath); nil == ial || "" != ial["memo"] {
+		t.Fatalf("setup: the read that loaded the page before the save gave %v", ial)
+	}
+	testHookDocIALFill = nil
+	if !fired {
+		t.Fatal("setup: the read stored nothing")
+	}
+	if got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("memo"); "Saved" != got {
+		t.Fatalf("setup: the page's file holds memo=%q", got)
+	}
+
+	docs, _, err := ListDocTree(files.box.ID, "/", util.SortModeNameASC, false, false, 100)
+	if nil != err {
+		t.Fatal(err)
+	}
+	for _, doc := range docs {
+		if files.sourceID != doc.ID {
+			continue
+		}
+		if "Saved" != doc.Memo {
+			t.Errorf("the page tree shows the page's memo as %q, read before the save, though its file says Saved", doc.Memo)
+		}
+		return
+	}
+	t.Fatalf("setup: the page tree doesn't list the page: %+v", docs)
+}
+
+// A job's attribute changes aren't served before the job's commit has written its page: until then a read gives what
+// the page's file holds, and once the commit has written it, what the job set. Without the fix the job's operations
+// store their attributes in the shared cache as they run, so a read made while the job runs gets attributes the file
+// doesn't hold yet, and that the job may still fail to save. The read is made where the commit writes the page.
+func TestJobAttributesAreNotServedBeforeItsPageIsWritten(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	// Both blocks' attributes are read, as the editor shows them, so the cache holds them before the job runs.
+	if got := sql.GetBlockAttrs(files.sourceID)["custom-job"]; "" != got {
+		t.Fatalf("setup: the page reads custom-job=%q", got)
+	}
+	if got := sql.GetBlockAttrs(files.childID)["custom-job"]; "" != got {
+		t.Fatalf("setup: the paragraph reads custom-job=%q", got)
+	}
+	settleAttrsCache(files.box.ID, files.sourceID, files.childID)
+
+	var pageRead, paragraphRead string
+	written := false
+	tx := &Transaction{DoOperations: jobAttrsOperations(files)}
+	tx.writeTransactionTree = func(tree *parse.Tree) error {
+		if !written {
+			written = true
+			pageRead = sql.GetBlockAttrs(files.sourceID)["custom-job"]
+			paragraphRead = sql.GetBlockAttrs(files.childID)["custom-job"]
+		}
+		return writeTreeUpsertQueue(tree)
+	}
+	if err := PerformTxSync(tx); nil != err {
+		t.Fatal(err)
+	}
+	if !written {
+		t.Fatal("setup: the job wrote no page")
+	}
+	if "" != pageRead {
+		t.Errorf("before the job's page was written, getBlockAttrs gave the page custom-job=%q, which its file didn't hold", pageRead)
+	}
+	if "" != paragraphRead {
+		t.Errorf("before the job's page was written, getBlockAttrs gave the paragraph custom-job=%q, which its file didn't hold", paragraphRead)
+	}
+	if got := sql.GetBlockAttrs(files.sourceID)["custom-job"]; "set" != got {
+		t.Errorf("after the job, getBlockAttrs gives the page custom-job=%q, not what the job set", got)
+	}
+	if got := sql.GetBlockAttrs(files.childID)["custom-job"]; "edited" != got {
+		t.Errorf("after the job, getBlockAttrs gives the paragraph custom-job=%q, not what the job set", got)
+	}
+}
+
+// A job whose commit fails to write its page leaves no attribute it changed in the cache: a read gives what the
+// page's file still holds. Without the fix the job's operations store their attributes as they run, and the failed
+// commit's rollback drops none of them.
+func TestFailedCommitCachesNothing(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	if got := sql.GetBlockAttrs(files.sourceID)["custom-job"]; "" != got {
+		t.Fatalf("setup: the page reads custom-job=%q", got)
+	}
+	if got := sql.GetBlockAttrs(files.childID)["custom-job"]; "" != got {
+		t.Fatalf("setup: the paragraph reads custom-job=%q", got)
+	}
+	settleAttrsCache(files.box.ID, files.sourceID, files.childID)
+
+	tx := &Transaction{DoOperations: jobAttrsOperations(files)}
+	tx.writeTransactionTree = func(*parse.Tree) error { return errors.New("injected page write failure") }
+	if err := PerformTxSync(tx); nil == err {
+		t.Fatal("setup: the job whose page write failed succeeded")
+	}
+	if got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-job"); "" != got {
+		t.Fatalf("setup: the page's file holds custom-job=%q after the failed job", got)
+	}
+	if got := sql.GetBlockAttrs(files.sourceID)["custom-job"]; "" != got {
+		t.Errorf("after the job failed, getBlockAttrs gives the page custom-job=%q, which its file doesn't hold", got)
+	}
+	if got := sql.GetBlockAttrs(files.childID)["custom-job"]; "" != got {
+		t.Errorf("after the job failed, getBlockAttrs gives the paragraph custom-job=%q, which its file doesn't hold", got)
+	}
+}
+
+// attrsCacheDatabase is a Journal database with a Name key bound to pages and a Note text key, whose Recent view filters
+// on Note, as polka's views do, so that adding a row renders the view to fill the row's defaults.
+type attrsCacheDatabase struct {
+	avID, blockKeyID, noteKeyID string
+	view                        *av.View
+}
+
+func newAttrsCacheDatabase(t *testing.T) *attrsCacheDatabase {
+	t.Helper()
+	// Regrouping a view names its groups' views, which needs the database words.
+	originalAttrViewLangs := util.AttrViewLangs
+	util.AttrViewLangs = map[string]map[string]any{util.Lang: {"key": "Key", "select": "Select", "table": "Table",
+		"gallery": "Gallery", "kanban": "Kanban", "list": "List", "calendar": "Calendar"}}
+	t.Cleanup(func() { util.AttrViewLangs = originalAttrViewLangs })
+	ret := &attrsCacheDatabase{avID: "20261017140000-journal", blockKeyID: "20261017140000-namekey",
+		noteKeyID: "20261017140000-notekey"}
+	blockKey := &av.Key{ID: ret.blockKeyID, Name: "Name", Type: av.KeyTypeBlock}
+	noteKey := &av.Key{ID: ret.noteKeyID, Name: "Note", Type: av.KeyTypeText}
+	ret.view = &av.View{ID: "20261017140000-recentv", Name: "Recent", LayoutType: av.LayoutTypeTable,
+		Table: av.NewLayoutTable(), PageSize: av.ViewDefaultPageSize, Filters: []*av.ViewFilter{{Column: noteKey.ID,
+			Operator: av.FilterOperatorIsEmpty, Value: &av.Value{Type: av.KeyTypeText, Text: &av.ValueText{}}}}}
+	ret.view.Table.Columns = []*av.ViewTableColumn{{BaseField: &av.BaseField{ID: blockKey.ID}},
+		{BaseField: &av.BaseField{ID: noteKey.ID}}}
+	attrView := &av.AttributeView{ID: ret.avID, Spec: av.PlainTextSpec, Name: "Journal",
+		KeyValues: []*av.KeyValues{{Key: blockKey}, {Key: noteKey}}, Views: []*av.View{ret.view},
+		RenderedViewables: map[string]av.Viewable{}}
+	if err := av.SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { cache.RemoveAVData(ret.avID) })
+	return ret
+}
+
+// performAttrsCacheOperation sends one operation, given as the editor sends it, as a job of its own.
+func performAttrsCacheOperation(t *testing.T, data string) {
+	t.Helper()
+	operation := &Operation{}
+	if err := json.Unmarshal([]byte(data), operation); nil != err {
+		t.Fatal(err)
+	}
+	if err := PerformTxSync(&Transaction{DoOperations: []*Operation{operation}}); nil != err {
+		t.Fatalf("%s failed: %v", operation.Action, err)
+	}
+}
+
+// addAttrsCacheRow is "+ New" in the database's Recent view: a new page, bound to a new row.
+func addAttrsCacheRow(t *testing.T, files *fileOperationTestFixture, db *attrsCacheDatabase, pageID string) (itemID string, page *parse.Tree) {
+	t.Helper()
+	page = treenode.NewTree(files.box.ID, "/"+pageID+".sy", "/Entry", "Entry")
+	if _, err := filesys.WriteTree(page); nil != err {
+		t.Fatal(err)
+	}
+	treenode.UpsertBlockTree(page)
+	itemID = ast.NewNodeID()
+	performAttrsCacheOperation(t, fmt.Sprintf(`{"action":"insertAttrViewBlock","avID":"%s","viewID":"%s",`+
+		`"srcs":[{"itemID":"%s","id":"%s","isDetached":false}]}`, db.avID, db.view.ID, itemID, pageID))
+	return
+}
+
+// A page that "+ New" binds to a row in a filtered view reads as bound to the database. "+ New" renders the view to
+// place the new row, which reads the new page's attributes and caches them without custom-avs, and a moment later
+// binds the page, storing custom-avs in the same cache. Without the fix ristretto can turn the second store away while
+// the first is still queued, and the page then reads as bound to no database. Only the timing differs between rounds.
+func TestNewRowPageReadsWithItsDatabase(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	db := newAttrsCacheDatabase(t)
+	const rounds = 200
+	unbound := 0
+	for i := range rounds {
+		pageID := fmt.Sprintf("20261017140%03d-newpage", i)
+		_, page := addAttrsCacheRow(t, files, db, pageID)
+		if db.avID != loadAttrsCachePageFile(t, files.box.ID, page.Path).Root.IALAttr(av.NodeAttrNameAvs) {
+			t.Fatalf("setup: round %d: the new page's file isn't bound to the database", i)
+		}
+		if !strings.Contains(sql.GetBlockAttrs(pageID)[av.NodeAttrNameAvs], db.avID) {
+			unbound++
+		}
+	}
+	if 0 < unbound {
+		t.Fatalf("a page \"+ New\" bound read without custom-avs in %d of %d rounds", unbound, rounds)
+	}
+}
+
+// Editing a bound row's Name cell in a grouped table keeps the static anchor text it sets. The job sets the page's
+// static anchor text attribute, then regroups the view, which renders it and fills each Name from the attributes of the
+// row's page, and saves the database. That render must read the job's own change: if it read the attributes as they
+// were before the job, it would save the old anchor text into the database. A guard for keeping a job's attributes
+// private until its commit; SiYuan as it is passes it.
+func TestGroupedTableCellEditKeepsStaticText(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	db := newAttrsCacheDatabase(t)
+	const pageID = "20261017140500-grouped"
+	itemID, _ := addAttrsCacheRow(t, files, db, pageID)
+	attrView, err := av.ParseAttributeView(db.avID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	attrView.GetView(db.view.ID).Group = &av.ViewGroup{Field: db.noteKeyID, Method: av.GroupMethodValue}
+	if err = av.SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	editName := func(content string) {
+		t.Helper()
+		performAttrsCacheOperation(t, fmt.Sprintf(`{"action":"updateAttrViewCell","avID":"%s","keyID":"%s","rowID":"%s",`+
+			`"data":{"isDetached":false,"block":{"id":"%s","content":"%s"}}}`, db.avID, db.blockKeyID, itemID, pageID, content))
+	}
+	staticText := av.NodeAttrViewStaticText + "-" + db.avID
+	editName("Old label")
+	// The page is read as the editor shows it after a restart, so the cache holds what its file says before the job.
+	cache.ClearBlocksIAL()
+	if got := sql.GetBlockAttrs(pageID)[staticText]; "Old label" != got {
+		t.Fatalf("setup: after the first edit, the page reads %s=%q", staticText, got)
+	}
+	settleAttrsCache(files.box.ID, pageID)
+
+	editName("New label")
+	saved, err := av.ParseAttributeView(db.avID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	value := saved.GetBlockValue(itemID)
+	if nil == value || nil == value.Block {
+		t.Fatalf("after the Name cell was edited in a grouped table, the database has no Name for the row: %+v", value)
+	}
+	if "New label" != value.Block.Content {
+		t.Errorf("after the Name cell was edited to New label in a grouped table, the database holds the Name %q", value.Block.Content)
+	}
+	if got := sql.GetBlockAttrs(pageID)[staticText]; "New label" != got {
+		t.Errorf("after the Name cell was edited to New label, the page reads %s=%q", staticText, got)
+	}
+}
