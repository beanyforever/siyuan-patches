+
+// A clear that finishes after another clear of the same cache, begun first, leaves that cache's floor at its own raise,
+// so a fill that noted the clock before it and stores after it is refused. A clear raises its cache's floor in two
+// steps, cacheFloor.raise: it reads a new value off the clock (fillClock.Add), then stores it as the floor. ClearBlocksIAL
+// and ClearDocsIAL raise outside any lock, so when two clears overlap, the one that read the clock first can store its
+// smaller value after the other stored the larger one, lowering the floor. Every entry noted between the two reads of
+// the clock then passes the floor, though it may copy what the later clear was clearing. (ClearTreeCache raises under
+// treeCacheKeysMu, so its clears take turns and its floor only rises.)
+//
+// testHookFloorRaise holds the first clear between its two steps while a fill notes the clock and the second clear runs
+// to its end; then the fill stores, and the first clear stores its floor. Red at df08f4e (with the hook) for both
+// attribute caches: the fill's copy is served.
+func TestOverlappingClearsKeepTheLaterFloor(t *testing.T) {
+	t.Cleanup(func() {
+		testHookFloorRaise = nil
+		clearVersionTestCaches()
+	})
+	const rootID = "20261017180000-floorpg"
+	for _, c := range []struct {
+		name   string
+		clear  func()
+		floor  *cacheFloor
+		store  func(version FillToken)
+		served func() bool
+	}{
+		{"block attributes", ClearBlocksIAL, &blockIALCacheFloor,
+			func(version FillToken) {
+				PutBlockIALInBox(rootID+"-b", rootID, versionTestBox, map[string]string{"id": rootID + "-b"}, version)
+				blockIALCache.Wait()
+			},
+			func() bool { return nil != GetBlockIALInBox(rootID+"-b", versionTestBox) }},
+		{"page attributes", ClearDocsIAL, &docIALCacheFloor,
+			func(version FillToken) {
+				PutDocIALInBox("/"+rootID+".sy", versionTestBox, map[string]string{"id": rootID}, version)
+				docIALCache.Wait()
+			},
+			func() bool { return nil != GetDocIALInBox("/"+rootID+".sy", versionTestBox) }},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			var noted FillToken
+			firstHeld, secondDone := make(chan struct{}), make(chan struct{})
+			var calls atomic.Int32
+			testHookFloorRaise = func() {
+				if 1 != calls.Add(1) {
+					return
+				}
+				// The first clear has read its floor off the clock. A fill notes the clock now, before the second
+				// clear, and reads what is about to be cleared.
+				noted = NewFillToken()
+				close(firstHeld)
+				<-secondDone
+			}
+			firstDone := make(chan struct{})
+			go func() {
+				defer close(firstDone)
+				c.clear()
+			}()
+			select {
+			case <-firstHeld:
+			case <-time.After(10 * time.Second):
+				t.Fatal("setup: the first clear never raised its floor")
+			}
+			c.clear() // the second clear, begun after the fill noted the clock, runs to its end
+			secondFloor := c.floor.floor.Load()
+			close(secondDone)
+			select {
+			case <-firstDone:
+			case <-time.After(10 * time.Second):
+				t.Fatal("setup: the first clear never finished")
+			}
+			testHookFloorRaise = nil
+			// The fill stores what it read before the second clear, with the version it noted.
+			c.store(noted)
+			if floor := c.floor.floor.Load(); floor < secondFloor {
+				t.Errorf("after two overlapping clears the floor is %d, below the later clear's %d", floor, secondFloor)
+			}
+			if c.served() {
+				t.Errorf("an entry noted at %d, before the clear that raised the floor to %d, is served after both clears",
+					noted, secondFloor)
+			}
+		})
+	}
+}
+
+// Forgetting the ids raised longest ago, once treeVersions remembers fillVersionsLimit of them, holds its lock for a
+// moment only. Every read check of the page cache and of both attribute caches takes that lock to read (fresh), and the
+// page cache's under treeCacheKeysMu, so a long forget would stall every page and attribute read of the kernel at once.
+// This measures the longest a read check waits while ids are raised past the limit, forgets included. It is a check of
+// the bound, which passes at df08f4e; the numbers are logged.
+func TestForgettingVersionsStallsReadsBriefly(t *testing.T) {
+	v := newFillVersions()
+	for i := range fillVersionsLimit {
+		v.bump(fmt.Sprintf("20261017180000-%07d", i))
+	}
+	var stop atomic.Bool
+	var longest atomic.Int64
+	var reads atomic.Int64
+	var readers sync.WaitGroup
+	for r := range 3 {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for i := 0; !stop.Load(); i++ {
+				id := fmt.Sprintf("20261017180000-%07d", (i*7919+r)%fillVersionsLimit)
+				began := time.Now()
+				v.fresh(id, FillToken(fillClock.Load()))
+				if waited := int64(time.Since(began)); waited > longest.Load() {
+					longest.Store(waited)
+				}
+				reads.Add(1)
+			}
+		}()
+	}
+	var longestBump time.Duration
+	forgets := 0
+	for i := range 4 * (fillVersionsLimit / 8) {
+		before := len(v.last)
+		began := time.Now()
+		v.bump(fmt.Sprintf("20261017180001-%07d", i))
+		took := time.Since(began)
+		if len(v.last) < before {
+			forgets++
+		}
+		longestBump = max(longestBump, took)
+	}
+	stop.Store(true)
+	readers.Wait()
+	t.Logf("%d forgets; the longest raise took %s; %d read checks, the longest waited %s", forgets, longestBump,
+		reads.Load(), time.Duration(longest.Load()))
+	if 1 > forgets {
+		t.Fatal("setup: no raise forgot any id")
+	}
+	if limit := 50 * time.Millisecond; time.Duration(longest.Load()) > limit {
+		t.Errorf("a read check waited %s while ids were forgotten, more than %s", time.Duration(longest.Load()), limit)
+	}
+}
+
+// Fix round 1 re-check (be97cad). Concurrent raises never leave a floor below the newest raise, whatever the
+// interleaving: each round several raises of one floor run at once, and the hook between the clock read and the store
+// yields, sleeps or spins, differently on each call, so the stores come in many orders. Once a round's raises are done,
+// the floor must equal the clock, since only they moved it. With the plain store of 72014dc it is red (33 to 41 of the
+// 3,000 rounds lowered the floor, in 3 runs); from be97cad, with the compare-and-swap loop, it is green.
+func TestConcurrentRaisesNeverLowerTheFloor(t *testing.T) {
+	t.Cleanup(func() { testHookFloorRaise = nil })
+	var calls atomic.Uint64
+	testHookFloorRaise = func() {
+		switch calls.Add(1) % 4 {
+		case 0:
+			runtime.Gosched()
+		case 1:
+			time.Sleep(time.Microsecond)
+		case 2:
+			for i := 0; i < 200; i++ {
+				calls.Load()
+			}
+		}
+	}
+	const rounds, raisers = 3000, 4
+	var floor cacheFloor
+	lowered := 0
+	for range rounds {
+		var start, done sync.WaitGroup
+		start.Add(1)
+		done.Add(raisers)
+		for range raisers {
+			go func() {
+				defer done.Done()
+				start.Wait()
+				floor.raise()
+			}()
+		}
+		start.Done()
+		done.Wait()
+		if floor.floor.Load() != fillClock.Load() {
+			lowered++
+			floor.raise()
+		}
+	}
+	if 0 < lowered {
+		t.Errorf("in %d of %d rounds of %d raises at once, the floor ended below the newest raise", lowered, rounds,
+			raisers)
+	}
+}
+
+// Fix round 1 re-check (be97cad). A write's end returns a version, so that the write caches, only if nothing else raised
+// its page or database between its begin and its end. The end reads the id's last raise and raises it under one lock
+// (fillVersions.end; avSearchDataCacheLock for databases), so there is no gap for another raise to slip through. Writers
+// and drops of one page, and of one database, run at once here, yielding inside their brackets. Only they move the
+// clock, one step per raise, so a write that cached had no other raise inside its bracket exactly when its end is its
+// begin plus one.
+func TestWriteEndsCacheOnlyWithoutAnotherRaise(t *testing.T) {
+	const (
+		pageID   = "20261017200000-overlap"
+		avID     = "20261017200000-overlav"
+		workers  = 4
+		attempts = 3000
+	)
+	for _, c := range []struct {
+		name  string
+		begin func() uint64
+		end   func(begin uint64) uint64
+		drop  func()
+	}{
+		{"page",
+			func() uint64 { return uint64(BeginTreeWrite(pageID)) },
+			func(begin uint64) uint64 { return uint64(EndTreeWrite(pageID, FillToken(begin))) },
+			func() { RemoveTreeData(pageID) }},
+		{"database",
+			func() uint64 { return BeginAVWrite(avID, "") },
+			func(begin uint64) uint64 { return EndAVWrite(avID, "", begin) },
+			func() { RemoveAVDataInBox(avID, "") }},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			var cached, refused, wrong atomic.Int64
+			var example atomic.Value
+			var wg sync.WaitGroup
+			for w := range workers {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					for i := range attempts {
+						if 0 == (i+w)%5 {
+							c.drop()
+							continue
+						}
+						begin := c.begin()
+						if 0 == i%3 {
+							runtime.Gosched()
+						}
+						end := c.end(begin)
+						switch {
+						case 0 == end:
+							refused.Add(1)
+						case begin+1 == end:
+							cached.Add(1)
+						default:
+							wrong.Add(1)
+							example.CompareAndSwap(nil, fmt.Sprintf("a write that began at %d ended at %d and cached", begin, end))
+						}
+					}
+				}()
+			}
+			wg.Wait()
+			t.Logf("%d writes cached, %d cached nothing", cached.Load(), refused.Load())
+			if 0 < wrong.Load() {
+				t.Errorf("%d writes cached though something else raised their id while they ran; %v", wrong.Load(),
+					example.Load())
+			}
+			if 1 > cached.Load() || 1 > refused.Load() {
+				t.Errorf("setup: the writes didn't both overlap and not overlap (%d cached, %d refused)", cached.Load(),
+					refused.Load())
+			}
+		})
+	}
+}
