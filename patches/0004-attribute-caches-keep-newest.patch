+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package cache
+
+import (
+	"fmt"
+	"testing"
+)
+
+// A fill is a read that missed the cache, loaded the file and caches what it read. It takes a FillToken before its
+// first lookup and before it loads, and lands only if nothing wrote or removed the key since.
+
+const fillTestBox, fillTestRoot = "20261016090000-notebk1", "20261016090000-fillrot"
+
+func olderIAL(id string) map[string]string {
+	return map[string]string{"id": id, "custom-object-type": "note"}
+}
+func newerIAL(id string) map[string]string {
+	return map[string]string{"id": id, "custom-object-type": "task"}
+}
+
+func blockFill(id string, ial map[string]string, token FillToken) bool {
+	return FillBlockIALInBox(id, fillTestRoot, fillTestBox, ial, token)
+}
+
+func pageFill(p string, ial map[string]string, token FillToken) bool {
+	return FillDocIALInBox(p, fillTestBox, ial, token)
+}
+
+func readBlock(id string) map[string]string { return GetBlockIALWithBoxFallback(id, fillTestBox) }
+func readPage(p string) map[string]string   { return GetDocIALInBox(p, fillTestBox) }
+
+// A fill that took its token before a write doesn't store, so the write stays: setBlockAttrs, a transaction's
+// binding of a row, an edit's write under the block's bare key, or a page write, landing while the fill loads the
+// file from before it.
+func TestIALFillTakenBeforeWriteDoesNotStore(t *testing.T) {
+	cases := []struct {
+		name  string
+		write func(id string)
+		fill  func(id string, ial map[string]string, token FillToken) bool
+		read  func(id string) map[string]string
+		clear func()
+	}{
+		{"block, notebook-key write", func(id string) { PutBlockIALInBox(id, fillTestBox, newerIAL(id)) },
+			blockFill, readBlock, ClearBlocksIAL},
+		{"block, edit's bare-key write", func(id string) { PutBlockIAL(id, newerIAL(id)) },
+			blockFill, readBlock, ClearBlocksIAL},
+		{"page write", func(p string) { PutDocIALInBox(p, fillTestBox, newerIAL(p)) },
+			pageFill, readPage, ClearDocsIAL},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			c.clear()
+			t.Cleanup(c.clear)
+			const id = "20261016090000-fillwrt"
+			token := NewFillToken() // the read missed, and is about to load the file
+			c.write(id)
+			if c.fill(id, olderIAL(id), token) {
+				t.Fatal("a fill that took its token before a write stored the file's older attributes")
+			}
+			if got := c.read(id); "task" != got["custom-object-type"] {
+				t.Fatalf("after a write and a fill that started before it, a read gave %v, not the write", got)
+			}
+		})
+	}
+}
+
+// A remove, or a clear, between a fill's token and its store stops the fill, as a move, a restore or a deletion
+// drops a page's cached attributes while a read of it loads the file from before.
+func TestIALFillAfterRemoveDoesNotStore(t *testing.T) {
+	cases := []struct {
+		name   string
+		remove func(id string)
+		fill   func(id string, ial map[string]string, token FillToken) bool
+		read   func(id string) map[string]string
+		clear  func()
+	}{
+		{"block, removed", RemoveBlockIAL, blockFill, readBlock, ClearBlocksIAL},
+		{"block, removed in its notebook", func(id string) { RemoveBlockIALInBox(id, fillTestBox) },
+			blockFill, readBlock, ClearBlocksIAL},
+		{"block, cache cleared", func(string) { ClearBlocksIAL() }, blockFill, readBlock, ClearBlocksIAL},
+		{"page, removed", RemoveDocIAL, pageFill, readPage, ClearDocsIAL},
+		{"page, removed in its notebook", func(p string) { RemoveDocIALInBox(p, fillTestBox) },
+			pageFill, readPage, ClearDocsIAL},
+		{"page, cache cleared", func(string) { ClearDocsIAL() }, pageFill, readPage, ClearDocsIAL},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			c.clear()
+			t.Cleanup(c.clear)
+			const id = "20261016090000-fillrmv"
+			token := NewFillToken()
+			c.remove(id)
+			if c.fill(id, olderIAL(id), token) {
+				t.Fatal("a fill stored after a remove between its token and its store")
+			}
+			if got := c.read(id); nil != got {
+				t.Fatalf("after a remove between a fill's token and its store, a read gave %v rather than missing", got)
+			}
+		})
+	}
+}
+
+// A fill nothing raced stores, a read straight after it gets what it stored, and a second fill of a key the cache
+// holds doesn't replace it.
+func TestIALFillUnracedStoresAtOnce(t *testing.T) {
+	cases := []struct {
+		name  string
+		fill  func(id string, ial map[string]string, token FillToken) bool
+		read  func(id string) map[string]string
+		clear func()
+	}{
+		{"block", blockFill, readBlock, ClearBlocksIAL},
+		{"page", pageFill, readPage, ClearDocsIAL},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			c.clear()
+			t.Cleanup(c.clear)
+			const id = "20261016090000-fillok1"
+			if !c.fill(id, newerIAL(id), NewFillToken()) {
+				t.Fatal("a fill nothing raced didn't store")
+			}
+			if got := c.read(id); "task" != got["custom-object-type"] {
+				t.Fatalf("a read straight after a fill gave %v", got)
+			}
+			if c.fill(id, olderIAL(id), NewFillToken()) {
+				t.Fatal("a fill replaced attributes the cache already held")
+			}
+		})
+	}
+}
+
+// A write straight after a fill keeps the write. "+ New" in a filtered view does this to the page it makes: placing
+// the new row renders the view, whose read of the page's attributes fills the cache from its file without custom-avs,
+// and a fraction of a millisecond later the row's binding writes them with custom-avs. A fill left queued in
+// ristretto would turn the write away, as a second put of a key it doesn't hold yet, so fills wait too.
+func TestIALFillThenWriteKeepsWrite(t *testing.T) {
+	cases := []struct {
+		name  string
+		fill  func(id string, ial map[string]string, token FillToken) bool
+		write func(id string, ial map[string]string)
+		read  func(id string) map[string]string
+		wait  func()
+		clear func()
+	}{
+		{"block", blockFill, func(id string, ial map[string]string) { PutBlockIALInBox(id, fillTestBox, ial) },
+			readBlock, blockIALCache.Wait, ClearBlocksIAL},
+		{"page", pageFill, func(p string, ial map[string]string) { PutDocIALInBox(p, fillTestBox, ial) },
+			readPage, docIALCache.Wait, ClearDocsIAL},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			c.clear()
+			t.Cleanup(c.clear)
+			for i := range 100 {
+				id := fmt.Sprintf("20261016090000-fillnw%d", i)
+				c.fill(id, olderIAL(id), NewFillToken())
+				c.write(id, newerIAL(id))
+				c.wait() // whatever the cache still has queued, it has now taken in or turned away
+				if got := c.read(id); "task" != got["custom-object-type"] {
+					t.Fatalf("after a fill and then a write of %s, a read gave %v, not the write", id, got)
+				}
+			}
+		})
+	}
+}
+
+// A block fill also checks the page it read the block from: a page write bumps no block's version, so a fill that
+// loaded the page before the write, or while it was being written, could otherwise store the block's older
+// attributes.
+func TestIALBlockFillChecksItsPage(t *testing.T) {
+	const id, root = "20261016090000-fillblk", "20261016090000-fillpge"
+	fill := func(token FillToken) bool { return FillBlockIALInBox(id, root, fillTestBox, olderIAL(id), token) }
+	t.Cleanup(ClearBlocksIAL)
+
+	ClearBlocksIAL()
+	token := NewFillToken()
+	BeginTreeWrite(root)
+	EndTreeWrite(root)
+	if fill(token) {
+		t.Fatal("a block fill whose token came before a write of its page stored")
+	}
+
+	BeginTreeWrite(root)
+	if fill(NewFillToken()) {
+		t.Fatal("a block fill stored while its page was being written")
+	}
+	EndTreeWrite(root)
+
+	token = NewFillToken()
+	RemoveTreeData(root)
+	if fill(token) {
+		t.Fatal("a block fill whose page was removed from the page cache after its token stored")
+	}
+
+	if !fill(NewFillToken()) {
+		t.Fatal("a block fill that took its token after its page's last write didn't store")
+	}
+}
+
+// fillVersions forgets every key once it holds too many, and refuses the fills that began before, so memory stays
+// bounded at the cost of a few refused fills.
+func TestFillVersionsForgetPastTheirLimit(t *testing.T) {
+	v := newFillVersions()
+	token := NewFillToken()
+	for i := range fillVersionsLimit + 1 {
+		v.bump(fmt.Sprintf("key%d", i))
+	}
+	if fillVersionsLimit < len(v.last) {
+		t.Fatalf("fillVersions holds %d keys, past its limit of %d", len(v.last), fillVersionsLimit)
+	}
+	if v.fresh("never-written", token) {
+		t.Fatal("a fill that began before fillVersions forgot its keys was let through")
+	}
+	if !v.fresh("never-written", NewFillToken()) {
+		t.Fatal("a fill that began after fillVersions forgot its keys was refused")
+	}
+}
