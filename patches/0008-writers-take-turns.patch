+// turnWriterWait is how long a writer may take in these tests before the test takes it for deadlocked.
+const turnWriterWait = time.Minute
+
+// runWriter runs fn, the call of the writer under test, on the test's goroutine. If fn hasn't returned within
+// turnWriterWait, as when a writer waits for a turn it already holds, it ends the test binary with SiYuan's goroutines,
+// which would otherwise hang until go test's own timeout.
+func runWriter(t *testing.T, what string, fn func()) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		select {
+		case <-done:
+		case <-time.After(turnWriterWait):
+			exitStuck(t, what, turnWriterWait)
+		}
+	}()
+	defer close(done)
+	fn()
+}
+
+// requireFinishes runs fn, which reaches a writer while a job holds the turn, and requires it to finish within d. Run it
+// in a process of its own (runTripwireTest): if fn deadlocks, the turn stays held and every later test would wait on
+// it, so on a timeout it ends the process at once, without the cleanups, which would wait on the turn too.
+func requireFinishes(t *testing.T, what string, d time.Duration, fn func()) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		fn()
+	}()
+	select {
+	case <-done:
+	case <-time.After(d):
+		exitStuck(t, what, d)
+	}
+}
+
+// exitStuck prints the goroutines that wait in SiYuan's code and ends the process.
+func exitStuck(t *testing.T, what string, d time.Duration) {
+	buf := make([]byte, 8<<20)
+	buf = buf[:runtime.Stack(buf, true)]
+	var stuck []string
+	for _, goroutine := range strings.Split(string(buf), "\n\n") {
+		if strings.Contains(goroutine, "siyuan/kernel/model.") {
+			stuck = append(stuck, goroutine)
+		}
+	}
+	fmt.Fprintf(os.Stderr, "--- FAIL: %s: %s didn't finish within %s: a deadlock. SiYuan's goroutines:\n%s\n",
+		t.Name(), what, d, strings.Join(stuck, "\n\n"))
+	os.Exit(1)
+}
