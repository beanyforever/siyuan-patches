+)
+
+// Fix round 1 re-check (be97cad). A database save that panics after its file write still ends its bracket, raising the
+// database's version, and leaves no lock held: writeAttributeViewBracketed defers EndAVWrite, which takes and releases
+// avSearchDataCacheLock, and the file write's lock is released by the write's own defer. A test hook panics where a save
+// would stall between its file write and its end. Then the version noted while the save was under way must no longer
+// be current, and the next save, which takes the same locks, must end and be read back.
+func TestPanickingDatabaseSaveRaisesItsVersionAndReleasesItsLocks(t *testing.T) {
+	setupSaveCacheTest(t)
+	attrView := parseSaveCacheTest(t)
+	var duringSave uint64
+	testHookAVSaveBeforeEnd = func() {
+		duringSave = cache.EnsureAVDataVersionInBox(saveCacheTestID, "")
+		panic("a database save panics before its end")
+	}
+	t.Cleanup(func() { testHookAVSaveBeforeEnd = nil })
+	attrView.Name = "Panicked"
+	func() {
+		defer func() {
+			if nil == recover() {
+				t.Error("setup: the save didn't panic")
+			}
+		}()
+		_ = SaveAttributeView(attrView)
+	}()
+	testHookAVSaveBeforeEnd = nil
+	if now := cache.EnsureAVDataVersionInBox(saveCacheTestID, ""); now == duringSave {
+		t.Errorf("after a database save panicked, the version noted while it was under way (%d) is still current: its "+
+			"end didn't raise the database", duringSave)
+	}
+
+	next := parseSaveCacheTest(t)
+	next.Name = "After"
+	done := make(chan error, 1)
+	go func() { done <- SaveAttributeView(next) }()
+	select {
+	case err := <-done:
+		if nil != err {
+			t.Fatal(err)
+		}
+	case <-time.After(10 * time.Second):
+		buf := make([]byte, 1<<20)
+		t.Fatalf("the next save of the database didn't end within 10 s, so the panicking save left a lock held:\n%s",
+			buf[:runtime.Stack(buf, true)])
+	}
+	settleAVCache()
+	if got := parseSaveCacheTest(t).Name; "After" != got {
+		t.Errorf("after the save that followed the panic, the database reads the name %q", got)
+	}
+	if got := saveCacheTestFileName(t); "After" != got {
+		t.Errorf("after the save that followed the panic, the database's file holds the name %q", got)
+	}
+}
