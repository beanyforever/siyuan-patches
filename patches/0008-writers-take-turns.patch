+// A one-page snapshot restore of a page whose file is dated ahead of the clock returns promptly. The file's date can be
+// ahead: /api/file/putFile sets the modTime its caller passes, a clock set back leaves every file saved before it
+// ahead, and a checkout gives files the dates their snapshot holds. Since a29af1a's parent, 3392994, the restore
+// touches the file before every backup, the first included, and touchSnapshotRestoreTarget waits until the clock
+// passes the second after the file's date: for a file dated ahead, that is not "the next second at most once" but as
+// long as the date is ahead, with the request, and on an encrypted notebook its hold on the notebook, kept meanwhile.
+// Here the date is 20 seconds ahead; the restore is given 8.
+func TestStep6ChallengeLocksRound2SnapshotRestoreOfAPageDatedAheadReturnsPromptly(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	originalRepoDir := util.RepoDir
+	util.RepoDir = filepath.Join(util.WorkspaceDir, "repo")
+	t.Cleanup(func() { util.RepoDir = originalRepoDir })
+	Conf.Repo.Store(&conf.Repo{Key: bytes.Repeat([]byte{7}, 32)}) // snapshots need the repository's key
+	Conf.System.Store(&conf.System{ID: "20261018150000-device1", Name: "test", OS: "linux"})
+	originalStatusBar := util.StatusBarCfg.Load()
+	util.StatusBarCfg.Store(util.NewStatusBar(false))
+	t.Cleanup(func() { util.StatusBarCfg.Store(originalStatusBar) })
+
+	snapshotID, err := IndexRepo("before the Type changed")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	index, err := repo.GetIndex(snapshotID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	fileID := ""
+	for _, id := range index.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if "/"+boxID+pagePath == file.Path {
+			fileID = id
+		}
+	}
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no %s", "/"+boxID+pagePath)
+	}
+	setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "task")
+	FlushTxQueue()
+
+	// The page's file dated 20 seconds ahead, as putFile with a modTime ahead would leave it.
+	ahead := time.Now().Add(20 * time.Second)
+	if err = os.Chtimes(filepath.Join(util.DataDir, boxID, pagePath), ahead, ahead); nil != err {
+		t.Fatal(err)
+	}
+
+	start := time.Now()
+	done := make(chan error, 1)
+	go func() { done <- RollbackRepoSnapshotFile(fileID) }()
+	select {
+	case err = <-done:
+		if nil != err {
+			t.Fatalf("roll the page back to the snapshot failed: %v", err)
+		}
+		t.Logf("the restore took %s", time.Since(start).Round(time.Millisecond))
+	case <-time.After(8 * time.Second):
+		err = <-done // the workspace stays until the restore ends
+		t.Fatalf("the one-page snapshot restore of a page dated 20 s ahead took %s (error %v): it waited for the "+
+			"file's date before its backup", time.Since(start).Round(time.Second), err)
+	}
+	checkPageAttr(t, "after the one-page snapshot restore", restoreCachePageID, "custom-object-type", "note")
+}
