+const versionTestBox = "20261017090000-versbox"
+
+// waitCaches lets ristretto take in the stores queued before it.
+func waitCaches() {
+	treeCache.Wait()
+	blockIALCache.Wait()
+	docIALCache.Wait()
+}
+
+// storeVersionTestPage stores a copy of a page in the page cache, of one of its blocks in the block attribute cache and
+// of its attributes in the page attribute cache, all at version.
+func storeVersionTestPage(rootID string, version FillToken) {
+	SetTreeDataInBox(rootID, versionTestBox, []byte(`{"ID":"`+rootID+`"}`), version)
+	PutBlockIALInBox(rootID+"-b", rootID, versionTestBox, map[string]string{"id": rootID + "-b"}, version)
+	PutDocIALInBox("/"+rootID+".sy", versionTestBox, map[string]string{"id": rootID}, version)
+	waitCaches()
+}
+
+// servedVersionTestPage reports which of the three copies storeVersionTestPage stored the caches serve.
+func servedVersionTestPage(rootID string) (page, block, doc bool) {
+	_, page = GetTreeDataInBox(rootID, versionTestBox)
+	block = nil != GetBlockIALInBox(rootID+"-b", versionTestBox)
+	doc = nil != GetDocIALInBox("/"+rootID+".sy", versionTestBox)
+	return
+}
+
+func clearVersionTestCaches() {
+	ClearTreeCache()
+	ClearBlocksIAL()
+	ClearDocsIAL()
+}
+
+// The read check: an entry noted before a write of its page, or written by an older write, isn't served, in any of the
+// three caches that copy pages; one noted after the write, or stored with the write's version, is.
+func TestReadCheckRefusesCopiesOlderThanTheirPage(t *testing.T) {
+	t.Cleanup(clearVersionTestCaches)
+	for name, raise := range map[string]func(rootID string) FillToken{
+		"write": func(rootID string) FillToken {
+			begin := BeginTreeWrite(rootID)
+			return EndTreeWrite(rootID, begin)
+		},
+		"write under way": func(rootID string) FillToken {
+			BeginTreeWrite(rootID)
+			return 0
+		},
+		"page dropped": func(rootID string) FillToken {
+			RemoveTreeData(rootID)
+			return 0
+		},
+		"page dropped in another notebook": func(rootID string) FillToken {
+			RemoveTreeDataInBox(rootID, "20261017090000-otherbx")
+			return 0
+		},
+		"page attributes dropped": func(rootID string) FillToken {
+			RemoveDocIAL("/" + rootID + ".sy")
+			return 0
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			rootID := "20261017090000-" + fmt.Sprintf("%07d", len(name))
+			noted := NewFillToken()
+			version := raise(rootID)
+			storeVersionTestPage(rootID, noted)
+			if page, block, doc := servedVersionTestPage(rootID); page || block || doc {
+				t.Fatalf("copies noted before the page changed were served: page %v, block %v, page attributes %v", page, block, doc)
+			}
+			if 0 == version {
+				return
+			}
+			storeVersionTestPage(rootID, version)
+			if page, block, doc := servedVersionTestPage(rootID); !page || !block || !doc {
+				t.Fatalf("copies stored with the write's version weren't served: page %v, block %v, page attributes %v", page, block, doc)
+			}
+			begin := BeginTreeWrite(rootID)
+			if page, block, doc := servedVersionTestPage(rootID); page || block || doc {
+				t.Fatalf("copies older than a write under way were served: page %v, block %v, page attributes %v", page, block, doc)
+			}
+			EndTreeWrite(rootID, begin)
+		})
+	}
+}
+
+// A block attribute entry is checked against the page it names, and one without a page is never served, whichever key
+// it is found under.
+func TestBlockAttributesWithoutTheirPageAreNotServed(t *testing.T) {
+	t.Cleanup(ClearBlocksIAL)
+	const id = "20261017090000-nopage1"
+	PutBlockIALInBox(id, "", versionTestBox, map[string]string{"id": id}, NewFillToken())
+	PutBlockIALInBox(id, "", "", map[string]string{"id": id}, NewFillToken())
+	waitCaches()
+	if nil != GetBlockIALWithBoxFallback(id, "", versionTestBox) {
+		t.Fatal("block attributes stored without their page were served")
+	}
+}
+
+// Dropping a block's attributes raises the page they copy, so a copy of that block's attributes still on its way into
+// the cache, or of the page, isn't served after it.
+func TestDroppingBlockAttributesRaisesTheirPage(t *testing.T) {
+	t.Cleanup(clearVersionTestCaches)
+	const rootID = "20261017090000-blkdrop"
+	noted := NewFillToken()
+	storeVersionTestPage(rootID, noted)
+	RemoveBlockIAL(rootID + "-b")
+	if page, _, doc := servedVersionTestPage(rootID); page || doc {
+		t.Fatalf("copies of a page whose block attributes were dropped were served: page %v, page attributes %v", page, doc)
+	}
+	storeVersionTestPage(rootID, noted)
+	if _, block, _ := servedVersionTestPage(rootID); block {
+		t.Fatal("block attributes noted before their drop were served")
+	}
+}
+
+// Clearing a cache refuses what was noted before the clear in that cache only.
+func TestClearingACacheMakesOnlyItsEntriesMiss(t *testing.T) {
+	t.Cleanup(clearVersionTestCaches)
+	for name, clear := range map[string]func(){
+		"page":            ClearTreeCache,
+		"block":           ClearBlocksIAL,
+		"page attributes": ClearDocsIAL,
+	} {
+		t.Run(name, func(t *testing.T) {
+			rootID := "20261017090000-" + fmt.Sprintf("clear%02d", len(name))
+			noted := NewFillToken()
+			storeVersionTestPage(rootID, noted)
+			clear()
+			// What a fill noted before the clear stores after it.
+			storeVersionTestPage(rootID, noted)
+			page, block, doc := servedVersionTestPage(rootID)
+			for cacheName, served := range map[string]bool{"page": page, "block": block, "page attributes": doc} {
+				if cacheName == name && served {
+					t.Fatalf("an entry noted before the %s cache was cleared was served", name)
+				}
+				if cacheName != name && !served {
+					t.Fatalf("clearing the %s cache made the %s cache's entry miss", name, cacheName)
+				}
+			}
+		})
+	}
+}
+
+// Past its limit, fillVersions forgets the ids raised longest ago without refusing what every other id holds: a copy
+// of a forgotten id noted before its last raise is still refused, and most copies of ids never raised are still
+// served.
+func TestForgettingVersionsKeepsOtherEntries(t *testing.T) {
+	v := newFillVersions()
+	before := NewFillToken()
+	v.bump("first")
+	for i := range fillVersionsLimit {
+		v.bump(fmt.Sprintf("key%d", i))
+	}
+	if fillVersionsLimit < len(v.last) {
+		t.Fatalf("fillVersions holds %d ids, past its limit of %d", len(v.last), fillVersionsLimit)
+	}
+	if _, ok := v.last["first"]; ok {
+		t.Fatal("the id raised longest ago wasn't forgotten")
+	}
+	if v.fresh("first", before) {
+		t.Fatal("a copy noted before a forgotten id's last raise was served")
+	}
+	refused := 0
+	for i := range 1000 {
+		if !v.fresh(fmt.Sprintf("never-raised%d", i), before) {
+			refused++
+		}
+	}
+	if 200 < refused {
+		t.Fatalf("forgetting refused %d of 1000 ids never raised", refused)
+	}
+}
