+package cache
+
+// A write that changes a page's or a database's file without WriteTree or saveAttributeView (a raw copy, a rename, a
+// remove, an unzip, a restore, a sync) raises what it wrote once the write has finished. Raised before, a fill could
+// note the new version and then read the old file. A raise only moves versions: it drops no entry and touches no floor,
+// and it takes no lock but the version map's own, a leaf, so a writer may raise while holding any of its locks.
+
+// RaisePages raises the version of each page, so no copy of it, of its blocks' attributes or of its own attributes
+// noted before is served after.
+func RaisePages(rootIDs ...string) {
+	if 1 > len(rootIDs) {
+		return
+	}
+	treeVersions.mu.Lock()
+	defer treeVersions.mu.Unlock()
+	for _, rootID := range rootIDs {
+		if "" != rootID {
+			treeVersions.bumpLocked(rootID)
+		}
+	}
+}
+
+// AVKey names a database's file: database AVID of notebook BoxID, where BoxID is "" for data/storage/av.
+type AVKey struct {
+	AVID  string
+	BoxID string
+}
+
+// RaiseAVs raises the version of each database, so no copy of it, normalized copy or search info noted before is
+// served after. A database no reader has noted a version for has nothing cached that could be served, and is skipped,
+// which keeps the version map to the databases read.
+func RaiseAVs(keys ...AVKey) {
+	if 1 > len(keys) {
+		return
+	}
+	avSearchDataCacheLock.Lock()
+	defer avSearchDataCacheLock.Unlock()
+	for _, k := range keys {
+		key := avCacheKey(k.AVID, k.BoxID)
+		if _, ok := avDataVersions[key]; ok {
+			invalidateAVSearchDataByKeyLocked(key)
+		}
+	}
+}
+
+// RaiseChangedSince raises again every page and database whose version rose after since. A write that can take files
+// away (a folder's remove) notes since before it begins, and raises this way once it has finished, so a page written
+// into the folder while the remove ran, which no walk of the folder finds, is raised too. It touches only what was
+// written or dropped while the write ran, scanning the version maps once:
+//   - every id in the map whose version rose;
+//   - every bucket whose value rose, since a page raised during the write may have been forgotten into its bucket
+//     since, as when the write's own end raised more pages than the map remembers;
+//   - the epoch, if it rose: a bulk writer raised everything, and a page it wrote into the folder has no id in the map.
+//
+// With a full map it costs a few hundred microseconds, once per folder remove.
+func RaiseChangedSince(since FillToken) {
+	treeVersions.mu.Lock()
+	var rootIDs []string
+	for rootID, version := range treeVersions.last {
+		if version > uint64(since) {
+			rootIDs = append(rootIDs, rootID)
+		}
+	}
+	for _, rootID := range rootIDs {
+		treeVersions.bumpLocked(rootID)
+	}
+	for b, version := range treeVersions.forgotten {
+		if version > uint64(since) {
+			treeVersions.forgotten[b] = fillClock.Add(1)
+		}
+	}
+	if treeVersions.all > uint64(since) {
+		treeVersions.all = fillClock.Add(1)
+	}
+	treeVersions.mu.Unlock()
+
+	avSearchDataCacheLock.Lock()
+	defer avSearchDataCacheLock.Unlock()
+	var keys []string
+	for key, version := range avDataVersions {
+		if version > uint64(since) {
+			keys = append(keys, key)
+		}
+	}
+	for _, key := range keys {
+		invalidateAVSearchDataByKeyLocked(key)
+	}
+}
+
+// RaiseAll raises every page and every database at once, for a writer that changes more than it can name: a sync, a
+// full snapshot checkout, a data.zip import, the user guide's mount. Pages get one epoch shared by the page cache and
+// the block and page attribute caches, so it isn't a clear: the caches keep their entries and their own floors.
+func RaiseAll() {
+	treeVersions.bumpAll()
+
+	avSearchDataCacheLock.Lock()
+	defer avSearchDataCacheLock.Unlock()
+	for key := range avDataVersions {
+		invalidateAVSearchDataByKeyLocked(key)
+	}
+}
