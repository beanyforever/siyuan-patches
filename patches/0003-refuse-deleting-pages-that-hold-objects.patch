From fb2044bf39f81f271d2fac75a65a8d963c4072e5 Mon Sep 17 00:00:00 2001
From: Beany <24502088+beanyforever@users.noreply.github.com>
Date: Mon, 12 Oct 2026 20:51:37 -0400
Subject: [PATCH] Deleting a page or a notebook that holds a Type's pages is
 refused

Deleting a page deletes the pages under it, and removing a notebook deletes
every page in it. A system page, one whose custom-object-type is "system", is
scaffolding such as a home folder, and a home folder like People holds every
page of its Type in its notebook, so deleting it took them all, and their rows
with them. Deleting a system page is now refused while pages sit under it, and
so is removing a notebook that holds a system page, with the reason as the
error: "People wasn't deleted: 120 pages are under it and would go with it.
Move or delete the pages under it first." A system page with nothing under it,
and any page that isn't a system page, are deleted as before.

The checks sit in RemoveDoc, RemoveDocs and RemoveBox, which the page tree, the
Delete key, the page menu, /api/filetree/removeDoc, removeDocByID and
removeDocs, /api/notebook/removeNotebook, the MCP document and notebook tools
and the CLI all reach, and a deletion of several pages is checked whole before
any of them goes. Files deleted directly, a snapshot checkout and sync go
around them.
---
 kernel/model/file.go                   |   8 ++
 kernel/model/mount.go                  |   3 +
 kernel/model/system_page_guard.go      |  87 ++++++++++++++++++
 kernel/model/system_page_guard_test.go | 121 +++++++++++++++++++++++++
 4 files changed, 219 insertions(+)
 create mode 100644 kernel/model/system_page_guard.go
 create mode 100644 kernel/model/system_page_guard_test.go

diff --git a/kernel/model/file.go b/kernel/model/file.go
index 4915ec1..3c24d7f 100644
--- a/kernel/model/file.go
+++ b/kernel/model/file.go
@@ -2025,6 +2025,9 @@ func RemoveDoc(boxID, p string) error {
 	if IsBoxDocPath(boxID, p) {
 		return errors.New(Conf.Language(341))
 	}
+	if err := systemPageDeletionRefusal(box, p); nil != err {
+		return err
+	}
 
 	FlushTxQueue()
 	luteEngine := util.NewLute()
@@ -2052,6 +2055,11 @@ func RemoveDocs(paths []string) error {
 		if nil != box && IsBoxDocPath(box.ID, p) {
 			return errors.New(Conf.Language(341))
 		}
+		if nil != box {
+			if err := systemPageDeletionRefusal(box, p); nil != err {
+				return err
+			}
+		}
 	}
 	FlushTxQueue()
 	luteEngine := util.NewLute()
diff --git a/kernel/model/mount.go b/kernel/model/mount.go
index 6961d9c..300d18e 100644
--- a/kernel/model/mount.go
+++ b/kernel/model/mount.go
@@ -280,6 +280,9 @@ func RemoveBox(boxID string) (err error) {
 	if util.IsReservedFilename(boxID) {
 		return fmt.Errorf("can not remove [%s] caused by it is a reserved file", boxID)
 	}
+	if err = systemNotebookRemovalRefusal(boxID); nil != err {
+		return
+	}
 
 	FlushTxQueue()
 	sql.FlushQueue()
