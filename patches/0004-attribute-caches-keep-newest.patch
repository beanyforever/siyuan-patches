+// storeIALLocked puts attributes in an attribute cache, returns once the cache has taken them in or turned them away,
+// and reports which. ristretto takes in a key it doesn't hold yet later, on its own goroutine, and turns away a second
+// put of that key queued before the first is taken in, as one it already holds; without waiting, the first put's
+// attributes would stay, and a page made a row just after it is made would read as bound to no database. It can also
+// turn a put away for want of room. The caller holds the cache's lock, so puts take turns and no put is ever queued
+// behind another; these caches set no callback that could wait on a lock.
+func storeIALLocked(c *ristretto.Cache, key string, ial map[string]string, cost int64) bool {
+	c.Set(key, maps.Clone(ial), cost)
+	c.Wait()
+	_, ok := c.Get(key)
+	return ok
+}
+
+func rememberIALKeyLocked(index map[string]map[string]struct{}, id, key string) {
+	keys := index[id]
+	if keys == nil {
+		keys = map[string]struct{}{}
+		index[id] = keys
+	}
+	keys[key] = struct{}{}
+}
+
+func forgetIALKeyLocked(index map[string]map[string]struct{}, id, key string) {
+	if keys := index[id]; keys != nil {
+		delete(keys, key)
+		if len(keys) == 0 {
+			delete(index, id)
+		}
+	}
+}
