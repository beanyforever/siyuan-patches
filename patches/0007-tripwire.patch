+// through (the agent's view operations, SetAttrViewFilters, SetAttrViewSorts, cell edits outside jobs, ...), but it
+// isn't among the save functions the tripwire passes over. So the first of those writers to save outside a turn is
+// logged as "model.avSaveView attribute_view.go:5643", and every other writer behind it is never logged at all.
+func TestTripwireChallengeNamesEachWriterBehindAvSaveView(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		fixture, _, _, _ := setupAttributeViewItemsTest(t, false)
+		setAttributeViewListTestLangs()
+		created, err := CreateAttributeViewDatabase(fixture.sourceID, "", "", "Challenge database", "Task",
+			av.LayoutTypeTable, []*AttributeViewCreateKey{{Name: "Status", Type: "text"}})
+		if nil != err {
+			t.Fatal(err)
+		}
+		avID, blockID, viewID := created.AvID, created.BlockID, created.ViewID
+		var textKeyID string
+		for _, kv := range created.AttributeView.KeyValues {
+			if av.KeyTypeText == kv.Key.Type {
+				textKeyID = kv.Key.ID
+			}
+		}
+		if "" == textKeyID {
+			t.Fatal("setup: the database has no text field")
+		}
+		avPath := av.GetAttributeViewDataPath(avID)
+		// Nothing may hold the turn when the writers save: no job, no background refresh.
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		log := newTripwireLog(t)
+		begin := log.mark(t)
+
+		_, view, err := GetAttributeViewViewTarget(avID, blockID, viewID)
+		if nil != err {
+			t.Fatal(err)
+		}
+		filters := []*av.ViewFilter{{Combination: av.FilterCombinationAnd, Filters: []*av.ViewFilter{{
+			Column: textKeyID, Operator: av.FilterOperatorContains,
+			Value: &av.Value{Type: av.KeyTypeText, Text: &av.ValueText{Content: "challenge-filter"}},
+		}}}}
+		if err = SetAttributeViewViewFilters(avID, blockID, viewID, AttributeViewViewConfigRevision(view), filters); nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the filters' save", avPath, "challenge-filter")
+
+		backgroundRefreshWaitGroup.Wait()
+		_, view, err = GetAttributeViewViewTarget(avID, blockID, viewID)
+		if nil != err {
+			t.Fatal(err)
+		}
+		sorts := []*av.ViewSort{{Column: textKeyID, Order: av.SortOrderDesc}}
+		if err = SetAttributeViewViewSorts(avID, blockID, viewID, AttributeViewViewConfigRevision(view), sorts); nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the sorts' save", avPath, string(av.SortOrderDesc))
+
+		lines := log.linesSince(t, begin)
+		for _, writer := range []string{"SetAttributeViewViewFilters", "SetAttributeViewViewSorts"} {
+			site := regexp.MustCompile(`\bdatabase model\.` + writer + ` (?:\S*[/\\])?attribute_view_agent\.go:\d+\b`)
+			var named []string
+			for _, line := range lines {
+				if site.MatchString(line) {
+					named = append(named, line)
+				}
+			}
+			if 1 != len(named) {
+				t.Errorf("the tripwire logged %d lines naming the writer model.%s, want 1; its lines since the writers "+
+					"began: %q", len(named), writer, lines)
+			}
+		}
+	})
+}
