+var testHookAVSaveSkipFill func()
+
+// writeAttributeViewBracketed runs write, a write of the database's file, between BeginAVWrite and EndAVWrite. It
+// returns the version EndAVWrite returned, which is 0 when the write failed or when something else raised the database
+// during it; then the caller caches nothing. The end runs even if write panics, and always before the caller's stores.
+func writeAttributeViewBracketed(avID, boxID string, write func() error) (version uint64, err error) {
+	begin := cache.BeginAVWrite(avID, boxID)
+	defer func() {
+		version = cache.EndAVWrite(avID, boxID, begin)
+		if nil != err {
+			version = 0
+		}
+	}()
+	err = write()
+	return
+}
