+// keepBlockAttrsAndPush keeps the attributes as keepBlockAttrs does, and tells clients of the change from oldAttrs
+// once the commit has written node's page.
+func (tx *Transaction) keepBlockAttrsAndPush(node *ast.Node, oldAttrs map[string]string) {
+	tx.keepBlockAttrs0(node, oldAttrs)
+}
+
+func (tx *Transaction) keepBlockAttrs0(node *ast.Node, oldAttrs map[string]string) {
+	if nil == tx.blockAttrs {
+		tx.blockAttrs = map[string]*keptBlockAttrs{}
+	}
+	kept := tx.blockAttrs[node.ID]
+	if nil == kept {
+		kept = &keptBlockAttrs{}
+		tx.blockAttrs[node.ID] = kept
+	}
+	kept.node = node
+	if nil == kept.oldAttrs {
+		kept.oldAttrs = oldAttrs
+	}
+}
+
+// keptBlockAttrsByPage groups the kept blocks by the page the transaction holds them in. A block in none of its pages,
+// deleted or left in a copy of a page the transaction has since replaced, is left out: no file will hold what was set
+// on it.
+func (tx *Transaction) keptBlockAttrsByPage() (ret map[string][]*keptBlockAttrs) {
+	ret = map[string][]*keptBlockAttrs{}
+	for _, kept := range tx.blockAttrs {
+		root := kept.node
+		for nil != root.Parent {
+			root = root.Parent
+		}
+		if tree := tx.trees[root.ID]; nil != tree && tree.Root == root {
+			ret[tree.ID] = append(ret[tree.ID], kept)
+		}
+	}
+	return
+}
+
+// privateBlockAttrs returns, by block id, the attributes the transaction set on blocks of its pages and hasn't
+// written yet.
+func (tx *Transaction) privateBlockAttrs() (ret map[string]map[string]string) {
+	if nil == tx || 1 > len(tx.blockAttrs) {
+		return
+	}
+	ret = map[string]map[string]string{}
+	for _, kept := range tx.keptBlockAttrsByPage() {
+		for _, k := range kept {
+			ret[k.node.ID] = parse.IAL2Map(k.node.KramdownIAL)
+		}
+	}
+	return
+}
