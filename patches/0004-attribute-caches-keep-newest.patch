+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package cache
+
+import "sync/atomic"
+
+// FillToken is taken by a reader before it first looks in a cache and, on a miss, loads the file. A fill, which caches
+// what the reader loaded, lands only if no write, removal or clear of the key came after the token, so it never
+// replaces anything newer than what it read. One clock serves the attribute caches and the page cache, so one token
+// can be checked against several: a block's fill checks the block and the page it read the block from.
+type FillToken uint64
+
+var fillClock atomic.Uint64
+
+// NewFillToken reads the clock that writes, removals and clears advance.
+func NewFillToken() FillToken {
+	return FillToken(fillClock.Load())
+}
+
+// fillVersionsLimit bounds how many keys a fillVersions remembers. Past it, every key is forgotten and the fills that
+// began earlier are refused, so memory stays bounded at the cost of a few refused fills.
+const fillVersionsLimit = 1 << 14
+
+// fillVersions records, per key, the clock's value at its last write or removal, and keeps it when the cache's entry
+// goes, so a fill that began before a removal is still refused. A clear raises the floor below which every token is
+// refused. The cache that owns it guards it with its lock.
+type fillVersions struct {
+	floor uint64            // tokens below it began before the last clear, or before the keys were forgotten
+	last  map[string]uint64 // key -> the clock's value at its last write or removal
+}
+
+func newFillVersions() *fillVersions {
+	return &fillVersions{last: map[string]uint64{}}
+}
+
+// bump records a write or a removal of key.
+func (v *fillVersions) bump(key string) {
+	if len(v.last) >= fillVersionsLimit {
+		v.reset()
+	}
+	v.last[key] = fillClock.Add(1)
+}
+
+// fresh reports whether a fill of key that took token may still land.
+func (v *fillVersions) fresh(key string, token FillToken) bool {
+	t := uint64(token)
+	return t >= v.floor && v.last[key] <= t
+}
+
+// reset forgets every key and refuses the fills that began before it.
+func (v *fillVersions) reset() {
+	v.floor = fillClock.Add(1)
+	v.last = map[string]uint64{}
+}
