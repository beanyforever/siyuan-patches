index 0000000..0443516
--- /dev/null
+++ b/kernel/model/turns_databases_fts5_test.go
@@ -0,0 +1,479 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// Writers of databases, and of the pages a database makes, take their turn (issue #43, step 6). How the tests interleave
+// a job with a writer is in turns_fts5_test.go.
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/siyuan-note/filelock"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// turnReadsDatabase is a Journal database (newAttrsCacheDatabase) shown by a database block on the fixture's source
+// page, with one row, bound to a page.
+type turnReadsDatabase struct {
+	files   *fileOperationTestFixture
+	db      *attrsCacheDatabase
+	blockID string
+	pageID  string
+	itemID  string
+}
+
+func setupTurnReadsDatabase(t *testing.T) *turnReadsDatabase {
+	t.Helper()
+	files := setupAttrsCacheTest(t)
+	db := newAttrsCacheDatabase(t)
+	source, err := LoadTreeByBlockID(files.sourceID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	block := &ast.Node{Type: ast.NodeAttributeView, ID: "20261018130000-avblock", AttributeViewID: db.avID,
+		AttributeViewType: string(av.LayoutTypeTable)}
+	block.SetIALAttr("id", block.ID)
+	block.SetIALAttr(av.NodeAttrView, db.view.ID)
+	source.Root.AppendChild(block)
+	writeTurnPage(t, source)
+	av.UpsertBlockRel(db.avID, block.ID)
+	const pageID = "20261018130000-rowpage"
+	itemID, _ := addAttrsCacheRow(t, files, db, pageID)
+	ret := &turnReadsDatabase{files: files, db: db, blockID: block.ID, pageID: pageID, itemID: itemID}
+	// The fields' order, which getAttributeViewKeys fills in when a database has none, so it has nothing to correct.
+	ret.change(t, func(attrView *av.AttributeView) { attrView.KeyIDs = []string{db.blockKeyID, db.noteKeyID} })
+	return ret
+}
+
+// change parses the database, changes it with fn, and saves it.
+func (r *turnReadsDatabase) change(t *testing.T, fn func(attrView *av.AttributeView)) {
+	t.Helper()
+	attrView, err := av.ParseAttributeView(r.db.avID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	fn(attrView)
+	if err = av.SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	cache.ClearAVCache()
+}
+
+// stored is the database as its file holds it.
+func (r *turnReadsDatabase) stored(t *testing.T) *av.AttributeView {
+	t.Helper()
+	data, err := filelock.ReadFile(av.GetAttributeViewDataPath(r.db.avID))
+	if nil != err {
+		t.Fatal(err)
+	}
+	ret := &av.AttributeView{}
+	if err = json.Unmarshal(data, ret); nil != err {
+		t.Fatal(err)
+	}
+	return ret
+}
+
+// turnRead is one of the reads that save a database: a read of what the database holds that, on SiYuan before step 6,
+// also corrects the database and saves it.
+type turnRead struct {
+	name string
+	// hook is the read's test hook, called after the read has read the database and before it saves it.
+	hook *func(avID string)
+	// read reads the database, as its endpoint does.
+	read func(t *testing.T, r *turnReadsDatabase)
+	// flaw makes the database need the read's correction, and check checks that the file still holds the flaw.
+	flaw  func(t *testing.T, r *turnReadsDatabase)
+	check func(t *testing.T, r *turnReadsDatabase) bool
+}
+
+const turnGoneKeyID = "20261018130000-goneky1"
+
+var turnReads = []turnRead{
+	{
+		name: "getAttributeViewKeys",
+		hook: &testHookBlockAttributeViewKeysRead,
+		read: func(t *testing.T, r *turnReadsDatabase) {
+			if got := GetBlockAttributeViewKeys(r.pageID); 1 != len(got) {
+				t.Fatalf("setup: getAttributeViewKeys lists %d databases for the row's page, want 1", len(got))
+			}
+		},
+		// The fields' order lists a field the database no longer has, and misses the Name field.
+		flaw: func(t *testing.T, r *turnReadsDatabase) {
+			r.change(t, func(attrView *av.AttributeView) { attrView.KeyIDs = []string{r.db.noteKeyID, turnGoneKeyID} })
+		},
+		check: func(t *testing.T, r *turnReadsDatabase) bool {
+			keyIDs := r.stored(t).KeyIDs
+			return 2 == len(keyIDs) && turnGoneKeyID == keyIDs[1]
+		},
+	},
+	{
+		name: "a writable renderAttributeView",
+		hook: &testHookRenderAttributeViewRead,
+		read: func(t *testing.T, r *turnReadsDatabase) {
+			if _, _, err := RenderAttributeView("", r.db.avID, r.db.view.ID, "", 1, -1, nil, false, false); nil != err {
+				t.Fatalf("setup: renderAttributeView: %v", err)
+			}
+		},
+		// The view sorts on a field the database no longer has.
+		flaw: func(t *testing.T, r *turnReadsDatabase) {
+			r.change(t, func(attrView *av.AttributeView) {
+				attrView.GetView(r.db.view.ID).Sorts = []*av.ViewSort{{Column: turnGoneKeyID, Order: av.SortOrderAsc}}
+			})
+		},
+		check: func(t *testing.T, r *turnReadsDatabase) bool {
+			view := r.stored(t).GetView(r.db.view.ID)
+			return nil != view && 1 == len(view.Sorts) && turnGoneKeyID == view.Sorts[0].Column
+		},
+	},
+	{
+		name: "getAttributeViewPrimaryKeyValues",
+		hook: &testHookAttributeViewPrimaryKeyValuesRead,
+		read: func(t *testing.T, r *turnReadsDatabase) {
+			if _, _, _, _, err := GetAttributeViewPrimaryKeyValues(r.db.avID, "", nil, 1, 16); nil != err {
+				t.Fatalf("setup: getAttributeViewPrimaryKeyValues: %v", err)
+			}
+		},
+		// The bound row's reference subtype is missing, as in a database saved by an older SiYuan.
+		flaw: func(t *testing.T, r *turnReadsDatabase) {
+			r.change(t, func(attrView *av.AttributeView) { attrView.GetBlockValue(r.itemID).Block.RefSubtype = "" })
+		},
+		check: func(t *testing.T, r *turnReadsDatabase) bool {
+			value := r.stored(t).GetBlockValue(r.itemID)
+			return nil != value && nil != value.Block && "" == value.Block.RefSubtype
+		},
+	},
+}
+
+// The reads that save keep a job's save of the database made after their read: a newer save isn't written over. The
+// job renames the database between the read's read and its save, both when the read has nothing to correct and when it
+// corrects the database. getAttributeViewKeys saves the database on every call, whether or not it changed it, and polka
+// calls it every 250 ms after a rename; a writable renderAttributeView and getAttributeViewPrimaryKeyValues save only
+// a database they corrected, so with nothing to correct they write nothing over the job's save on the base either:
+// those two cases are guards there.
+func TestReadsThatSaveKeepAJobsSaveMadeAfterTheirRead(t *testing.T) {
+	for _, read := range turnReads {
+		t.Run(read.name, func(t *testing.T) {
+			for _, flawed := range []bool{false, true} {
+				name := "a database it leaves as it is"
+				if flawed {
+					name = "a database it corrects"
+				}
+				t.Run(name, func(t *testing.T) {
+					r := setupTurnReadsDatabase(t)
+					if flawed {
+						read.flaw(t, r)
+						if !read.check(t, r) {
+							t.Fatal("setup: the database's file doesn't hold the flaw the read corrects")
+						}
+					}
+					job := newTurnJob()
+					setTurnHook(t, job, read.hook, func(avID string) {
+						if r.db.avID == avID {
+							job.send(databaseJob(avID)...)
+						}
+					})
+					job.run(t, read.name, func() { read.read(t, r) })
+					checkDatabaseKeepsJob(t, job, read.name, r.db.avID)
+				})
+			}
+		})
+	}
+}
+
+// The reads that save leave a database they don't change unsaved: its file's bytes and modification time stay. Guards
+// on the base, where saveAttributeView writes nothing when the bytes to save equal those cached or on disk.
+func TestReadsThatSaveLeaveAnUnchangedDatabaseUnsaved(t *testing.T) {
+	for _, read := range turnReads {
+		t.Run(read.name, func(t *testing.T) {
+			r := setupTurnReadsDatabase(t)
+			avPath := av.GetAttributeViewDataPath(r.db.avID)
+			before, err := filelock.ReadFile(avPath)
+			if nil != err {
+				t.Fatal(err)
+			}
+			info, err := os.Stat(avPath)
+			if nil != err {
+				t.Fatal(err)
+			}
+			// A save after this would show in the modification time even on a file system with coarse times.
+			time.Sleep(20 * time.Millisecond)
+			FlushTxQueue()
+			runWriter(t, read.name, func() { read.read(t, r) })
+			after, err := filelock.ReadFile(avPath)
+			if nil != err {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(before, after) {
+				t.Errorf("%s changed a database it had nothing to correct in", read.name)
+			}
+			if afterInfo, statErr := os.Stat(avPath); nil != statErr {
+				t.Fatal(statErr)
+			} else if !afterInfo.ModTime().Equal(info.ModTime()) {
+				t.Errorf("%s saved a database it had nothing to correct in: its file's modification time went from %s to %s",
+					read.name, info.ModTime().Format(time.RFC3339Nano), afterInfo.ModTime().Format(time.RFC3339Nano))
+			}
+		})
+	}
+}
+
+// Deleting a page keeps a job's save of a database the page is a row of, made between the deletion's read of the
+// database and its save of the database without the page's row. The editor's Delete key and page menu, and the page
+// tree, delete pages through removeDocByID and removeDocs.
+func TestPageDeletionKeepsAJobsSaveToItsDatabasesMadeBetweenTheirReadAndTheirSave(t *testing.T) {
+	for _, run := range []struct {
+		name   string
+		remove func(r *turnReadsDatabase) error
+	}{
+		{"removeDocByID", func(r *turnReadsDatabase) error {
+			return RemoveDoc(r.files.box.ID, "/"+r.pageID+".sy")
+		}},
+		{"removeDocs", func(r *turnReadsDatabase) error {
+			return RemoveDocs([]string{r.files.box.ID + "/" + r.pageID + ".sy"})
+		}},
+	} {
+		t.Run(run.name, func(t *testing.T) {
+			r := setupTurnReadsDatabase(t)
+			job := newTurnJob()
+			setTurnHook(t, job, &testHookRemoveDocBindingsRead, func() { job.send(databaseJob(r.db.avID)...) })
+			job.run(t, "the page's deletion", func() {
+				if err := run.remove(r); nil != err {
+					t.Fatal(err)
+				}
+			})
+			checkDatabaseKeepsJob(t, job, "the page's deletion", r.db.avID)
+			if nil != r.stored(t).GetBlockValue(r.itemID) {
+				t.Errorf("after the page's deletion, its database still holds its row")
+			}
+		})
+	}
+}
+
+// Patch 0003's refusal to delete a system page with pages under it holds for a page made under the system page while
+// the deletion runs, after the deletion's check found none. Either the deletion sees the new page and is refused, or
+// the new page is made after the deletion and survives it: it is never deleted with the system page unrefused. Here a
+// job makes the page between the deletion's check and its removal of the pages, as the editor's "New sub-document"
+// would.
+func TestSystemPageDeletionRefusalHoldsForAPageMadeUnderItDuringTheDeletion(t *testing.T) {
+	for _, run := range []struct {
+		name   string
+		remove func(boxID, p string) error
+	}{
+		{"removeDocByID", func(boxID, p string) error { return RemoveDoc(boxID, p) }},
+		{"removeDocs", func(boxID, p string) error { return RemoveDocs([]string{boxID + p}) }},
+	} {
+		t.Run(run.name, func(t *testing.T) {
+			files := setupAttrsCacheTest(t)
+			system := addFileOperationTestDoc(t, files, "20261018131000-sysfold", "People", false)
+			system.Root.SetIALAttr("custom-object-type", "system")
+			writeTurnPage(t, system)
+			const childID = "20261018131001-newpers"
+			child := treenode.NewTree(files.box.ID, "/"+system.ID+"/"+childID+".sy", "/People/Ann", "Ann")
+			t.Cleanup(func() {
+				cache.RemoveTreeData(childID)
+				cache.RemoveDocIAL(child.Path)
+			})
+			childFile := filepath.Join(util.DataDir, files.box.ID, child.Path)
+
+			job := newTurnJob()
+			setTurnHook(t, job, &testHookPageDeletionChecked, func() {
+				job.send(&Operation{Action: "create", Tree: child})
+			})
+			var err error
+			job.run(t, "the system page's deletion", func() { err = run.remove(files.box.ID, system.Path) })
+			_, statErr := os.Stat(childFile)
+			if nil != err {
+				if !strings.Contains(err.Error(), "wasn't deleted") {
+					t.Fatalf("the deletion failed, not with patch 0003's refusal: %v", err)
+				}
+				if nil != statErr {
+					t.Errorf("the deletion was refused, but the page made under the system page is gone (%v)", statErr)
+				}
+				return
+			}
+			if nil != statErr {
+				t.Errorf("a page made under a system page while it was being deleted (%s) was deleted with it, without "+
+					"patch 0003's refusal: its file is gone (%v)", job.where(), statErr)
+			}
+		})
+	}
+}
