 kernel/cache/tree_fill_test.go        | 130 ++++++++++++++++++++
 kernel/filesys/tree.go                |   8 +-
 kernel/filesys/tree_fill_race_test.go | 167 ++++++++++++++++++++++++++
 4 files changed, 346 insertions(+), 7 deletions(-)
 create mode 100644 kernel/cache/tree_fill_test.go
 create mode 100644 kernel/filesys/tree_fill_race_test.go

diff --git a/kernel/cache/tree.go b/kernel/cache/tree.go
index c0f44dd..d85558a 100644
--- a/kernel/cache/tree.go
+++ b/kernel/cache/tree.go
@@ -85,6 +85,8 @@ func GetTreeDataInBox(rootID, boxID string) (raw []byte, ok bool) {
 	return raw, true
 }
 
+// SetTreeDataInBox caches raw, what a write has just put in page rootID's file in notebook boxID. A read that missed
+// the cache and loaded the file stores what it loaded with FillTreeDataInBox instead.
 func SetTreeDataInBox(rootID, boxID string, raw []byte) {
 	if raw == nil {
 		return
@@ -93,6 +95,33 @@ func SetTreeDataInBox(rootID, boxID string, raw []byte) {
 		RemoveTreeDataInBox(rootID, boxID)
 		return
 	}
+	entry := newTreeCacheEntry(raw)
+	treeCacheKeysMu.Lock()
+	defer treeCacheKeysMu.Unlock()
+	// A fill whose reader took its token before this write may hold the page from before it.
+	treeVersions.bump(rootID)
+	putTreeCacheEntryLocked(rootID, boxID, entry)
+}
+
+// FillTreeDataInBox caches raw, which a reader that took token before its first lookup loaded from page rootID's file
+// in notebook boxID, unless the file is being written or something wrote the page or removed it from this cache since
+// token: the reader may then have loaded the page from before, and the next edit would save that copy over the file.
+// A page too big for the cache isn't stored. It reports whether it stored.
+func FillTreeDataInBox(rootID, boxID string, raw []byte, token FillToken) bool {
+	if raw == nil || len(raw) >= treeCacheMaxCost {
+		return false
+	}
+	entry := newTreeCacheEntry(raw)
+	treeCacheKeysMu.Lock()
+	defer treeCacheKeysMu.Unlock()
+	if !treeFreshLocked(rootID, token) {
+		return false
+	}
+	putTreeCacheEntryLocked(rootID, boxID, entry)
+	return true
+}
+
+func newTreeCacheEntry(raw []byte) *treeCacheEntry {
 	entry := &treeCacheEntry{rawSize: len(raw)}
 	// 小文档不压缩；只有实际减少驻留字节时才保存压缩结果。
 	if len(raw) >= 1024 && treeCacheEncoder != nil && treeCacheDecoder != nil {
@@ -105,9 +134,12 @@ func SetTreeDataInBox(rootID, boxID string, raw []byte) {
 	if !entry.compressed {
 		entry.raw = bytes.Clone(raw)
 	}
+	return entry
+}
+
+// putTreeCacheEntryLocked stores entry as the page's newest copy in notebook boxID; treeCacheKeysMu must be held.
+func putTreeCacheEntryLocked(rootID, boxID string, entry *treeCacheEntry) {
 	key := treeCacheKey(rootID, boxID)
-	treeCacheKeysMu.Lock()
-	defer treeCacheKeysMu.Unlock()
 	treeCacheGeneration++
 	entry.generation = treeCacheGeneration
 	keys := treeCacheKeys[rootID]
@@ -120,9 +152,11 @@ func SetTreeDataInBox(rootID, boxID string, raw []byte) {
 }
 
 // treeVersions and treeWriting say, per page id, when the page was last written or removed from this cache, and how
-// many writes of its file are under way. A load storing what it read bumps neither, so they tell a block attribute
-// fill whether the page it read the block from may have changed since its FillToken (TreeFresh). treeCacheKeysMu
-// guards them.
+// many writes of its file are under way. A load storing what it read bumps neither, so they tell a fill whether the
+// page it read may have changed since its FillToken: the page cache's own fills (FillTreeDataInBox), and block
+// attribute fills, which read a block from its page (TreeFresh). They are kept per page id, not per notebook key, and
+// outlive the page's entries, so a removal stops a fill whatever key it was to store under. treeCacheKeysMu guards
+// them.
 var treeVersions = newFillVersions()
 var treeWriting = map[string]int{}
 
@@ -151,6 +185,10 @@ func EndTreeWrite(rootID string) {
 func TreeFresh(rootID string, token FillToken) bool {
 	treeCacheKeysMu.Lock()
 	defer treeCacheKeysMu.Unlock()
+	return treeFreshLocked(rootID, token)
+}
+
+func treeFreshLocked(rootID string, token FillToken) bool {
 	return 0 == treeWriting[rootID] && treeVersions.fresh(rootID, token)
 }
 
