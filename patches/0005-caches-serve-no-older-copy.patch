+// A page write makes the attributes read from the page before it miss, so the next read gives what the write saved:
+// both for the page and for a block in it. That holds for WriteTree, which a job's commit and setBlockAttrs save a page
+// with, and for WriteTreeIfUnchanged, which find and replace and asset relinking save with. A page write changes its
+// blocks' attributes without storing them in the block attribute cache, so without the fix the cache keeps serving
+// the copies read before the write.
+func TestPageWritesMakeOlderBlockAttrsMiss(t *testing.T) {
+	const rootID, paragraphID = "20261017120001-written", "20261017120001-shelf01"
+	cases := []struct {
+		name  string
+		write func(t *testing.T, tree *parse.Tree)
+	}{
+		{"WriteTree", func(t *testing.T, tree *parse.Tree) {
+			if _, err := filesys.WriteTree(tree); nil != err {
+				t.Fatal(err)
+			}
+		}},
+		{"WriteTreeIfUnchanged", func(t *testing.T, tree *parse.Tree) {
+			_, original, err := filesys.LoadTreeSnapshot(tree.Box, tree.Path, util.NewLute())
+			if nil != err {
+				t.Fatal(err)
+			}
+			if _, err = filesys.WriteTreeIfUnchanged(tree, original); nil != err {
+				t.Fatal(err)
+			}
+		}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			setupBlockAttrsTest(t)
+			tree := writeBlockAttrsPage(t, rootID, paragraphID)
+			if got := GetBlockAttrs(rootID)["custom-object-type"]; "" != got {
+				t.Fatalf("setup: the page reads custom-object-type=%q", got)
+			}
+			if got := GetBlockAttrs(paragraphID)["custom-shelf"]; "left" != got {
+				t.Fatalf("setup: the paragraph reads custom-shelf=%q", got)
+			}
+			settleBlockIALCache(rootID, blockAttrsTestBox)
+			settleBlockIALCache(paragraphID, blockAttrsTestBox)
+
+			changed := loadBlockAttrsPageFile(t, tree)
+			changed.Root.SetIALAttr("custom-object-type", "task")
+			treenode.GetNodeInTree(changed, paragraphID).SetIALAttr("custom-shelf", "right")
+			c.write(t, changed)
+
+			if got := GetBlockAttrs(rootID)["custom-object-type"]; "task" != got {
+				t.Errorf("after the page's write, getBlockAttrs gives the page custom-object-type=%q, though its file says task", got)
+			}
+			if got := GetBlockAttrs(paragraphID)["custom-shelf"]; "right" != got {
+				t.Errorf("after the page's write, getBlockAttrs gives the paragraph custom-shelf=%q, though its file says right", got)
+			}
+		})
+	}
+}
+
+// A block's attributes read from its page before the page changed are not served once it has: the next read gives
+// what the page's file holds. The block's own attributes are checked against its page, since a page write or a page
+// dropped from the page cache changes no block's own entry. Two ways the page changes after the read:
+//   - a save of the page lands between the read's load of the page and its store, so the read stores what it loaded
+//     after the save; a test hook places the save there, so the race happens every time;
+//   - a writer that bypasses WriteTree, as an import or a sync does, writes the page's file and then drops the page
+//     from the page cache.
+func TestBlockAttrsReadBeforeTheirPageChangedAreNotServed(t *testing.T) {
+	const rootID, paragraphID = "20261017120002-changed", "20261017120002-shelf01"
+	cases := []struct {
+		name   string
+		change func(t *testing.T, tree *parse.Tree)
+	}{
+		{"a save lands between the read's load and its store", func(t *testing.T, tree *parse.Tree) {
+			saved := loadBlockAttrsPageFile(t, tree)
+			treenode.GetNodeInTree(saved, paragraphID).SetIALAttr("custom-shelf", "right")
+			testHookBlockAttrsFill = func() {
+				testHookBlockAttrsFill = nil
+				if _, err := filesys.WriteTree(saved); nil != err {
+					t.Error(err)
+				}
+			}
+			if got := GetBlockAttrs(paragraphID)["custom-shelf"]; "left" != got {
+				t.Fatalf("setup: the read that loaded the page before the save gave custom-shelf=%q", got)
+			}
+			if nil != testHookBlockAttrsFill {
+				t.Fatal("setup: the read stored nothing")
+			}
+			settleBlockIALCache(paragraphID, blockAttrsTestBox)
+		}},
+		{"a write outside WriteTree, then the page dropped from the page cache", func(t *testing.T, tree *parse.Tree) {
+			if got := GetBlockAttrs(paragraphID)["custom-shelf"]; "left" != got {
+				t.Fatalf("setup: the paragraph reads custom-shelf=%q", got)
+			}
+			settleBlockIALCache(paragraphID, blockAttrsTestBox)
+			absPath := filepath.Join(util.DataDir, tree.Box, tree.Path)
+			data, err := os.ReadFile(absPath)
+			if nil != err {
+				t.Fatal(err)
+			}
+			changed := data
+			for _, separator := range []string{":", ": "} {
+				changed = bytes.Replace(changed, []byte(`"custom-shelf"`+separator+`"left"`), []byte(`"custom-shelf"`+separator+`"right"`), 1)
+			}
+			if bytes.Equal(changed, data) {
+				t.Fatal("setup: the page's file holds no custom-shelf")
+			}
+			if err = os.WriteFile(absPath, changed, 0644); nil != err {
+				t.Fatal(err)
+			}
+			cache.RemoveTreeData(tree.ID)
+		}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			setupBlockAttrsTest(t)
+			tree := writeBlockAttrsPage(t, rootID, paragraphID)
+			c.change(t, tree)
+			if onDisk := loadBlockAttrsPageFile(t, tree); "right" != treenode.GetNodeInTree(onDisk, paragraphID).IALAttr("custom-shelf") {
+				t.Fatal("setup: the page's file doesn't hold the change")
+			}
+			if got := GetBlockAttrs(paragraphID)["custom-shelf"]; "right" != got {
+				t.Errorf("getBlockAttrs gives the paragraph custom-shelf=%q, read before its page changed, though the file says right", got)
+			}
+		})
+	}
+}
+
+// A kanban render that runs after a save of a card's page shows what the save wrote. A kanban or gallery render loads
+// its cards' pages first and reads their attributes from those pages later, so a save can land in between: that render
+// shows the attributes from before the save, which is as it should be, but must not cache them, since they are now
+// older than the file. Without the fix it caches them, and every later render, and getBlockAttrs, serve them. A test
+// hook places the save after the first render has loaded the pages. The attribute shown is the card's static anchor
+// text, which a render reads from the page's attributes.
+func TestKanbanRenderAfterAWriteServesNewAttributes(t *testing.T) {
+	setupBlockAttrsTest(t)
+	const avID, pageID = "20261017120003-kanbndb", "20261017120003-kanbnpg"
+	staticText := av.NodeAttrViewStaticText + "-" + avID
+	tree := writeBlockAttrsPage(t, pageID, "")
+	tree.Root.SetIALAttr(staticText, "Old label")
+	if _, err := filesys.WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	render := func() string {
+		t.Helper()
+		key := &av.Key{ID: "20261017120003-blockky", Name: "Card", Type: av.KeyTypeBlock}
+		value := &av.Value{ID: "20261017120003-blockvl", KeyID: key.ID, BlockID: pageID, Type: av.KeyTypeBlock,
+			Block: &av.ValueBlock{ID: pageID, Content: "Card", RefSubtype: av.BlockRefSubtypeStatic}}
+		view := &av.View{ID: "20261017120003-kanbnvw", LayoutType: av.LayoutTypeKanban, Kanban: av.NewLayoutKanban()}
+		view.Kanban.Fields = []*av.ViewKanbanField{{BaseField: &av.BaseField{ID: key.ID}}}
+		attrView := &av.AttributeView{ID: avID, KeyValues: []*av.KeyValues{{Key: key, Values: []*av.Value{value}}},
+			Views: []*av.View{view}, RenderedViewables: map[string]av.Viewable{}}
+		kanban, ok := RenderView(attrView, view, "", false).(*av.Kanban)
+		if !ok || 1 != len(kanban.Cards) || 1 != len(kanban.Cards[0].Values) || nil == kanban.Cards[0].Values[0].Value ||
+			nil == kanban.Cards[0].Values[0].Value.Block {
+			t.Fatalf("setup: the render gave %+v", kanban)
+		}
+		return kanban.Cards[0].Values[0].Value.Block.Content
+	}
+
+	saved := loadBlockAttrsPageFile(t, tree)
+	saved.Root.SetIALAttr(staticText, "New label")
+	testHookKanbanTreesLoaded = func() {
+		testHookKanbanTreesLoaded = nil
+		if _, err := filesys.WriteTree(saved); nil != err {
+			t.Error(err)
+		}
+	}
+	if got := render(); "Old label" != got {
+		t.Fatalf("setup: the render that loaded the page before the save shows %q", got)
+	}
+	if nil != testHookKanbanTreesLoaded {
+		t.Fatal("setup: the render loaded no pages")
+	}
+	settleBlockIALCache(pageID, blockAttrsTestBox)
+
+	if got := render(); "New label" != got {
+		t.Errorf("a kanban render after the save shows %q, though the page's file says New label", got)
+	}
+	if got := GetBlockAttrs(pageID)[staticText]; "New label" != got {
+		t.Errorf("after the save, getBlockAttrs gives %s=%q, though the page's file says New label", staticText, got)
+	}
+}
