+// A job saves a page and a database while it holds the turn, and the tripwire logs neither: an edit of a paragraph,
+// which the commit writes to the page, and a rename of a database, which saves it. The job runs through the queue, as
+// the editor's /api/transactions sends it, and at once, as PerformTxSync runs it.
+func TestTripwireLeavesSavesInATurnUnlogged(t *testing.T) {
+	for _, run := range []struct {
+		name    string
+		perform func(t *testing.T, tx *Transaction)
+	}{
+		{"a queued job", func(t *testing.T, tx *Transaction) {
+			PerformTransactions(&[]*Transaction{tx})
+			WaitForTransactions([]*Transaction{tx})
+			FlushTxQueue()
+		}},
+		{"a job run at once", func(t *testing.T, tx *Transaction) {
+			if err := PerformTxSync(tx); nil != err {
+				t.Fatal(err)
+			}
+		}},
+	} {
+		t.Run(run.name, func(t *testing.T) {
+			runTripwireTest(t, func(t *testing.T) {
+				files := setupStructureTransactionTest(t)
+				setupFoldTransactionDatabase(t, files)
+				log := newTripwireLog(t)
+				attrView := newTripwireDatabase(t, "20261018000200-tripdb2", "Before the job")
+				begin := log.mark(t)
+
+				edit := fmt.Sprintf(`<div data-node-id="%s" data-type="NodeParagraph"><div contenteditable="true">`+
+					`Saved in a job</div></div>`, files.childID)
+				tx := &Transaction{Timestamp: time.Now().UnixMilli(), DoOperations: []*Operation{
+					{Action: "update", ID: files.childID, Data: edit},
+					{Action: "setAttrViewName", ID: attrView.ID, Data: "Renamed in a job"},
+				}}
+				run.perform(t, tx)
+				requireTripwireFileHolds(t, "the job's page", filepath.Join(util.DataDir, files.box.ID, files.sourcePath),
+					"Saved in a job")
+				requireTripwireFileHolds(t, "the job's database", av.GetAttributeViewDataPath(attrView.ID),
+					"Renamed in a job")
+				checkNothingLogged(t, log, begin, "after a job saved a page and a database in its turn")
+
+				checkPageControl(t, log, loadTripwirePage(t, files.box.ID, files.sourcePath))
+			})
+		})
+	}
+}
