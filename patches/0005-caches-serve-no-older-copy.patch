+	data, err := os.ReadFile(filepath.Join(util.DataDir, tree.Box, tree.Path))
+	if nil != err {
+		t.Fatal(err)
+	}
+	ret, err := filesys.LoadTreeByData(data, tree.Box, tree.Path, util.NewLute())
