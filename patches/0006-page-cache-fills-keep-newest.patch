 }
@@ -507,6 +509,8 @@ func WriteTree(tree *parse.Tree) (size uint64, err error) {
 	}
 
 	// 缓存与待写入数据一致时跳过落盘；缓存未命中时再读盘比对，避免无变更的重复写入
+	// Skipping the write after reading the file makes its store a fill, which mustn't land over a write since the lookup.
+	token := cache.NewFillToken()
 	if cachedData, ok := cache.GetTreeDataInBox(tree.ID, tree.Box); ok {
 		if len(cachedData) == len(data) && bytes.Equal(cachedData, data) {
 			return
@@ -516,7 +520,7 @@ func WriteTree(tree *parse.Tree) (size uint64, err error) {
 		if diskData, readErr := filelock.ReadFile(filePath); nil == readErr {
 			decDisk, decErr := decryptDataWithDEK(tree.Box, tree.Path, diskData, dek)
 			if decErr == nil && len(decDisk) == len(data) && bytes.Equal(decDisk, data) {
-				cache.SetTreeDataInBox(tree.ID, tree.Box, data)
+				cache.FillTreeDataInBox(tree.ID, tree.Box, data, token)
 				return
 			}
 		}
diff --git a/kernel/filesys/tree_fill_race_test.go b/kernel/filesys/tree_fill_race_test.go
new file mode 100644
index 0000000..f9941ba
--- /dev/null
+++ b/kernel/filesys/tree_fill_race_test.go
@@ -0,0 +1,167 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
