+// Finding: a writer that loaded a page saves it after the page has moved (here under another page, through MoveDocs).
+// Its save writes the page's old path, where no file is any more, so the tripwire takes it for the first save of a
+// brand-new page and logs nothing. The page isn't new: the block index has it at its new path, and the save puts a
+// second copy of it back at the old one. The same holds for a database whose file was removed under a writer.
+func TestTripwireChallengeLogsASaveToAPathItsPageHasLeft(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		files := setupStructureTransactionTest(t)
+		setupFoldTransactionDatabase(t, files)
+		stale := loadTripwirePage(t, files.box.ID, files.sourcePath) // the writer's copy, loaded before the move
+		if err := MoveDocs([]string{files.sourcePath}, files.box.ID, files.targetPath, nil); nil != err {
+			t.Fatal(err)
+		}
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		oldPath := tripwirePagePath(stale)
+		if _, err := os.Stat(oldPath); !os.IsNotExist(err) {
+			t.Fatalf("setup: the move left the page's file at its old path: %v", err)
+		}
+		bt := treenode.GetBlockTree(stale.ID)
+		if nil == bt || files.sourcePath == bt.Path {
+			t.Fatalf("setup: the block index doesn't have the page at a new path: %+v", bt)
+		}
+		if _, err := os.Stat(filepath.Join(util.DataDir, bt.BoxID, bt.Path)); nil != err {
+			t.Fatalf("setup: the moved page has no file at its new path: %v", err)
+		}
+		log := newTripwireLog(t)
+		begin := log.mark(t)
+
+		stale.Root.SetIALAttr("custom-tripwire-stale", "saved")
+		site, err := tripwireChallengeSaveStalePage(stale)
+		if nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the stale save", oldPath, "custom-tripwire-stale")
+		checkTripwireSite(t, "after a save, outside a turn, of a moved page at the path it left",
+			log.linesSince(t, begin), site, "page", 1)
+	})
+}
