+package model
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/filelock"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// systemPageGuardFixture is the file operation fixture's notebook with a People home folder, a system
+// page holding one Person page, and a Dashboard, a system page with nothing under it.
+type systemPageGuardFixture struct {
+	files                  *fileOperationTestFixture
+	people, ada, dashboard *parse.Tree
+}
+
+func setupSystemPageGuardTest(t *testing.T) *systemPageGuardFixture {
+	t.Helper()
+	f := &systemPageGuardFixture{files: setupFileOperationTest(t)}
+	page := func(boxID, path, hpath, title, objectType string) *parse.Tree {
+		tree := treenode.NewTree(boxID, path, hpath, title)
+		tree.Root.SetIALAttr("custom-object-type", objectType)
+		if _, err := filesys.WriteTree(tree); nil != err {
+			t.Fatalf("write test page failed: %v", err)
+		}
+		treenode.UpsertBlockTree(tree)
+		t.Cleanup(func() {
+			cache.RemoveTreeData(tree.ID)
+			cache.RemoveDocIAL(tree.Path)
+		})
+		return tree
+	}
+	box := f.files.box.ID
+	f.people = page(box, "/20260718000010-peoplex.sy", "/People", "People", systemPageType)
+	f.ada = page(box, "/20260718000010-peoplex/20260718000011-adaxxxx.sy", "/People/Ada", "Ada", "person")
+	f.dashboard = page(box, "/20260718000012-dashbrd.sy", "/Dashboard", "Dashboard", systemPageType)
+	return f
+}
+
+func (f *systemPageGuardFixture) assertNothingDeleted(t *testing.T, way string) {
+	t.Helper()
+	for _, tree := range []*parse.Tree{f.people, f.ada, f.dashboard} {
+		if !filelock.IsExist(filepath.Join(util.DataDir, tree.Box, tree.Path)) {
+			t.Fatalf("%s deleted %s", way, tree.HPath)
+		}
+	}
+}
+
+func TestSystemPageGuardRefusesDeletingASystemPageWithPagesUnderIt(t *testing.T) {
+	f := setupSystemPageGuardTest(t)
+	box := f.files.box.ID
+	const want = "People wasn't deleted: 1 page is under it and would go with it. Move or delete the pages under it first."
+	for _, way := range []struct {
+		name   string
+		remove func() error
+	}{
+		{"RemoveDoc", func() error { return RemoveDoc(box, f.people.Path) }},
+		{"RemoveDocs", func() error { return RemoveDocs([]string{box + f.dashboard.Path, box + f.people.Path}) }},
+	} {
+		if err := way.remove(); nil == err || want != err.Error() {
+			t.Fatalf("%s: want %q, got %v", way.name, want, err)
+		}
+		f.assertNothingDeleted(t, way.name)
+	}
+}
+
+func TestSystemPageGuardRefusesRemovingANotebookHoldingASystemPage(t *testing.T) {
+	f := setupSystemPageGuardTest(t)
+	const want = "File operation test wasn't removed: it holds system pages, such as People, and removing it would " +
+		"delete every page in it. Delete its pages first."
+	if err := RemoveBox(f.files.box.ID); nil == err || want != err.Error() {
+		t.Fatalf("want %q, got %v", want, err)
+	}
+	f.assertNothingDeleted(t, "RemoveBox")
+}
+
+func TestSystemPageGuardAllowsWhatDeletesNoOtherPage(t *testing.T) {
+	f := setupSystemPageGuardTest(t)
+	box := f.files.box
+	for name, path := range map[string]string{
+		"a system page with nothing under it": f.dashboard.Path,
+		"a page under a system page":          f.ada.Path,
+		"a page that isn't a system page":     f.files.sourcePath,
+	} {
+		if err := systemPageDeletionRefusal(box, path); nil != err {
+			t.Errorf("deleting %s was refused: %v", name, err)
+		}
+	}
+	other := treenode.NewTree("20260718000020-otherbx", "/20260718000021-pagexxx.sy", "/Page", "Page")
+	if _, err := filesys.WriteTree(other); nil != err {
+		t.Fatalf("write test page failed: %v", err)
+	}
+	t.Cleanup(func() {
+		cache.RemoveTreeData(other.ID)
+		cache.RemoveDocIAL(other.Path)
+	})
+	if err := systemNotebookRemovalRefusal(other.Box); nil != err {
+		t.Errorf("removing a notebook with no system page was refused: %v", err)
+	}
+}
