+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// A save that overlaps no other write of its database caches its copy, so a read straight after it is served from the
+// cache rather than the file. A save caches nothing when another write of the database ran during it; this guards that
+// a save on its own still caches. Once ristretto has taken the store in, the file is changed behind the cache's back,
+// and a parse must still give the save.
+func TestAVSaveWithoutOverlapIsServedFromTheCache(t *testing.T) {
+	const avID = "20261018090000-guardav"
+	originalDataDir := util.DataDir
+	util.DataDir = t.TempDir()
+	t.Cleanup(func() {
+		cache.RemoveAVData(avID)
+		util.DataDir = originalDataDir
+	})
+	attrView := &AttributeView{ID: avID, Spec: RichTextSpec, Name: "Original",
+		KeyValues: []*KeyValues{{Key: &Key{ID: "20261018090000-blockky", Name: "Name", Type: KeyTypeBlock}}},
+		Views: []*View{{ID: "20261018090000-tablevw", Name: "Table", LayoutType: LayoutTypeTable, Table: NewLayoutTable(),
+			PageSize: ViewDefaultPageSize}},
+		RenderedViewables: map[string]Viewable{}}
+	if err := SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	attrView.Name = "Saved"
+	if err := SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+
+	// ristretto takes a new key in on its own goroutine.
+	cached := false
+	for deadline := time.Now().Add(time.Second); !cached && time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		data, ok := cache.GetAVData(avID)
+		cached = ok && bytes.Contains(data, []byte(`"Saved"`))
+	}
+	if !cached {
+		t.Fatal("a save that overlapped no other write left nothing in the database cache")
+	}
+
+	path := GetAttributeViewDataPath(avID)
+	data, err := os.ReadFile(path)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, bytes.Replace(data, []byte(`"Saved"`), []byte(`"Behind"`), 1), 0644); nil != err {
+		t.Fatal(err)
+	}
+	got, err := ParseAttributeView(avID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if "Saved" != got.Name {
+		t.Fatalf("a read straight after the save gave the name %q, from the file, not the save's copy", got.Name)
+	}
+}
