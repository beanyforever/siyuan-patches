+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package tripwire
+
+// The challenger's measures of what a save costs the tripwire (issue #43, step 5). They assert nothing:
+// go test -run '^$' -bench Challenge -benchmem ./tripwire/
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// benchSetup gives the benchmark a file that exists, a log that drops its lines, and an empty site set.
+func benchSetup(b *testing.B) string {
+	b.Helper()
+	p := filepath.Join(b.TempDir(), "20261018000000-bench01.sy")
+	if err := os.WriteFile(p, []byte("{}"), 0644); err != nil {
+		b.Fatal(err)
+	}
+	previous := logWarnf
+	logWarnf = func(string, ...any) {}
+	sites.Lock()
+	seen, full := sites.seen, sites.full
+	sites.seen, sites.full = map[string]Kind{}, false
+	sites.Unlock()
+	b.Cleanup(func() {
+		logWarnf = previous
+		sites.Lock()
+		sites.seen, sites.full = seen, full
+		sites.Unlock()
+	})
+	return p
+}
+
+// deepSave calls Save depth frames down, as a writer in model does through its callers.
+//
+//go:noinline
+func deepSave(depth int, kind Kind, p string) {
+	if 0 < depth {
+		deepSave(depth-1, kind, p)
+		return
+	}
+	Save(kind, p)
+}
+
+// A save inside a turn: one atomic load.
+func BenchmarkChallengeSaveInATurn(b *testing.B) {
+	p := benchSetup(b)
+	EnterTurn()
+	defer LeaveTurn()
+	b.ReportAllocs()
+	for b.Loop() {
+		deepSave(20, Page, p)
+	}
+}
+
+// A save outside a turn from a site already logged, the case of polka's getAttributeViewKeys every 250 ms: a stat, the
+// stack walk and a look in the site set.
+func BenchmarkChallengeSaveOutsideATurnFromALoggedSite(b *testing.B) {
+	p := benchSetup(b)
+	b.ReportAllocs()
+	for b.Loop() {
+		deepSave(20, Database, p)
+	}
+}
diff --git a/kernel/tripwire/tripwire.go b/kernel/tripwire/tripwire.go
new file mode 100644
index 0000000..c344b83
--- /dev/null
+++ b/kernel/tripwire/tripwire.go
@@ -0,0 +1,286 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+// Package tripwire names the writers that save pages and databases without taking turns with jobs. A save made while
+// no job holds the turn is logged once per call site, with the caller it was first seen with, and then once for each
+// further caller of that site:
+//
+//	tripwire: save outside a turn: page model.setNodeAttrs blockial.go:269 <- model.SetBlockAttrs blockial.go:247
+//	tripwire: another caller of a save outside a turn: page model.setNodeAttrs blockial.go:269 <-
+//	    model.setDatabaseBlockView attribute_view.go:2594 (one line)
+//
+// The turn is model's flushLock: the queue's jobs, PerformTxSync and the commit hold it, and so do the writers that
+// already take turns with jobs. Locking flushLock enters the turn and unlocking it leaves (EnterTurn, LeaveTurn). The
+// save functions (filesys.WriteTree and WriteTreeIfUnchanged, av.SaveAttributeView and SaveAttributeViewIfUnchanged)
+// call Save before they write. Inside a turn that costs one atomic load. Outside one, Save passes over a file that
+// doesn't exist yet, the first save of a brand-new page or database, and otherwise finds the first caller outside the
+// save functions, the site, and that function's own caller. The site's first save logs the marker's line; a save from
+// a caller the site hasn't been seen with logs CallerMarker's line. So a helper that several writers save through is
+// named once for each of them, while the marker's lines stay one per site.
+//
+// It's a guide, not a proof. Go can't tell which goroutine holds a lock, so the turn says only that some goroutine
+// holds flushLock: a save made outside a turn while another goroutine holds one isn't logged. A site is logged once it
+// saves outside every turn; one that only ever saves during other turns is never named.
+//
+// It changes no behaviour: it takes no lock but its own, which are leaves, drops nothing from any cache and never fails
+// a save.
+package tripwire
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path"
+	"reflect"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/siyuan-note/logging"
+)
+
+// Kind is what a save writes.
+type Kind string
+
+const (
+	Page     Kind = "page"
+	Database Kind = "database"
+)
+
+// Marker starts the line the tripwire logs for a site's first save outside a turn.
+const Marker = "tripwire: save outside a turn"
+
+// CallerMarker starts the line the tripwire logs for a further caller of a site already logged.
+const CallerMarker = "tripwire: another caller of a save outside a turn"
+
+// turns counts the holders of the turn. flushLock is a mutex, so it is 0 or 1 in the kernel.
+var turns atomic.Int32
+
+// EnterTurn is called by flushLock's holder once it has the lock.
+func EnterTurn() {
+	turns.Add(1)
+}
+
+// LeaveTurn is called by flushLock's holder before it unlocks.
+func LeaveTurn() {
+	turns.Add(-1)
+}
+
+// InTurn reports whether some goroutine holds the turn.
+func InTurn() bool {
+	return 0 < turns.Load()
+}
+
+// Save is called by a save function before it writes path, the file of a page or a database. A save while some
+// goroutine holds the turn costs one atomic load, and nothing else. path "" means the file doesn't exist yet.
+func Save(kind Kind, path string) {
+	if InTurn() {
+		return
+	}
+	saveOutsideTurn(kind, path, nil)
+}
+
+// SaveMovable is Save for a save function that can tell where what it saves lives now. When path has no file,
+// movedAway reports whether the page or database lives at another path: then the save isn't the first save of a
+// brand-new file, but a writer putting a copy back where its page was before a move, and it is logged. movedAway runs
+// only outside a turn, and only when path has no file.
+func SaveMovable(kind Kind, path string, movedAway func() bool) {
+	if InTurn() {
+		return
+	}
+	saveOutsideTurn(kind, path, movedAway)
+}
+
+func saveOutsideTurn(kind Kind, path string, movedAway func() bool) {
+	if "" == path {
+		return
+	}
+	if _, err := os.Stat(path); errors.Is(err, fs.ErrNotExist) && (nil == movedAway || !movedAway()) {
+		// The first save of a brand-new page or database: nothing older can be lost.
+		return
+	}
+	site, caller := callSite()
+	entry := site
+	if "" != caller {
+		entry += " <- " + caller
+	}
+	firstSite, newCaller, full := note(kind, site, entry)
+	if full {
+		logWarnf("%s: more than %d call sites and callers; saves from further ones are not logged", Marker, siteLimit)
+	}
+	if firstSite {
+		logWarnf("%s: %s %s", Marker, kind, entry)
+	} else if newCaller {
+		logWarnf("%s: %s %s", CallerMarker, kind, entry)
+	}
+}
+
+// logWarnf is logging.LogWarnf; the package's tests replace it.
+var logWarnf = logging.LogWarnf
+
+// testHookCallSite, when set by a test, is called each time Save looks for its caller.
+var testHookCallSite func()
+
+// callSite returns the first caller outside the save functions, the site, as "<package.Function> <file>:<line>", and
+// the site's own caller in the same form: "" when the site is a goroutine's first function.
+//
+// A go statement that calls a save function directly, "go writeTreeUpsertQueue(tree)", leaves no writer's frame:
+// runtime.CallersFrames leaves out the function Go makes for the statement (F.gowrap1), so past the save functions the
+// walk reaches the goroutine's start, runtime.goexit. Then callSite names the outermost save function it passed, at its
+// call of the next, and gives "go statement" as its caller. A defer statement's function (F.deferwrap1) is left out
+// too, but its caller is the function the defer sits in, which is named at its closing brace.
+func callSite() (site, caller string) {
+	if nil != testHookCallSite {
+		testHookCallSite()
+	}
+	var pcs [48]uintptr
+	n := runtime.Callers(1, pcs[:])
+	frames := runtime.CallersFrames(pcs[:n])
+	var outermost runtime.Frame
+	frame, more := frames.Next()
+	for "" != frame.Function {
+		var next runtime.Frame
+		if more {
+			next, more = frames.Next()
+		}
+		// A closure is part of the save when it sits in a save function, or when a save function calls it: once the
+		// function it sits in is inlined, Go names the closure after the caller it was inlined into
+		// ("model.renameDoc.writeRenameDocIfUnchanged.func1").
+		if !isSaveFunction(frame.Function) && !(isClosure(frame.Function) && isSaveFunction(next.Function)) {
+			if "runtime.goexit" == frame.Function && "" != outermost.Function {
+				return formatFrame(outermost), "go statement"
+			}
+			if "" == next.Function || strings.HasPrefix(next.Function, "runtime.") {
+				return formatFrame(frame), ""
+			}
+			return formatFrame(frame), formatFrame(next)
+		}
+		outermost = frame
+		frame = next
+	}
+	if "" != outermost.Function {
+		// More frames than callSite reads: the outermost save function it read is at least a site of its own.
+		return formatFrame(outermost), ""
+	}
+	return "unknown", ""
+}
+
+func formatFrame(frame runtime.Frame) string {
+	return shortFunction(frame.Function) + " " + path.Base(frame.File) + ":" + strconv.Itoa(frame.Line)
+}
+
+// isClosure reports whether name is a function literal's: "pkg.F.func1", or "pkg.F.func1.2" for one inside another. The
+// functions Go makes for go and defer statements (F.gowrap1, F.deferwrap1) never reach it: runtime.CallersFrames leaves
+// them out.
+func isClosure(name string) bool {
+	last := name[strings.LastIndexByte(name, '.')+1:]
+	if isNumber(last) {
+		return true
+	}
+	number, ok := strings.CutPrefix(last, "func")
+	return ok && isNumber(number)
+}
+
+func isNumber(s string) bool {
+	return "" != s && "" == strings.TrimLeft(s, "0123456789")
+}
+
+// shortFunction drops the import path before the package's name: "model.setNodeAttrs",
+// "model.(*Transaction).commit".
+func shortFunction(name string) string {
+	if i := strings.LastIndexByte(name, '/'); 0 <= i {
+		return name[i+1:]
+	}
+	return name
+}
+
+// saveFunctions holds the full names of the functions a save passes through before the writer's own code: the
+// tripwire's, the save functions' and the thin wrappers around them. callSite passes over them, and over the closures
+// inside them.
+var saveFunctions = struct {
+	sync.RWMutex
+	names map[string]struct{}
+}{names: map[string]struct{}{}}
+
+// SaveFunctions adds functions a save passes through before the writer's own code, so the writer's call is named
+// instead of theirs. Each is a function value, such as filesys.WriteTree.
+func SaveFunctions(fns ...any) {
+	saveFunctions.Lock()
+	defer saveFunctions.Unlock()
+	for _, fn := range fns {
+		v := reflect.ValueOf(fn)
+		if reflect.Func != v.Kind() || v.IsNil() {
+			continue
+		}
+		if f := runtime.FuncForPC(v.Pointer()); nil != f {
+			saveFunctions.names[f.Name()] = struct{}{}
+		}
+	}
+}
+
+func isSaveFunction(name string) bool {
+	saveFunctions.RLock()
+	defer saveFunctions.RUnlock()
+	if _, ok := saveFunctions.names[name]; ok {
+		return true
+	}
+	// A closure is named after the function it sits in: "model.writeRenameDocIfUnchanged.func1".
+	for i := strings.LastIndexByte(name, '.'); 0 < i; i = strings.LastIndexByte(name[:i], '.') {
+		if _, ok := saveFunctions.names[name[:i]]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+func init() {
+	SaveFunctions(Save, SaveMovable, saveOutsideTurn, callSite)
+}
+
+// siteLimit bounds the lines remembered, one per site and caller. The kernel has a few hundred call sites of the save
+// functions, each with a few callers; once the limit is reached, further ones are not logged, and that is logged once.
+var siteLimit = 4096
+
+var sites = struct {
+	sync.Mutex
+	seen   map[string]Kind     // each site logged, with its kind
+	logged map[string]struct{} // each "site <- caller" logged
+	full   bool
+}{seen: map[string]Kind{}, logged: map[string]struct{}{}}
+
+// note records entry, a site and its caller. It reports whether the site is new, whether only the caller is, and
+// whether this call found the set full for the first time.
+func note(kind Kind, site, entry string) (firstSite, newCaller, full bool) {
+	sites.Lock()
+	defer sites.Unlock()
+	if _, ok := sites.logged[entry]; ok {
+		return false, false, false
+	}
+	if len(sites.logged) >= siteLimit {
+		if sites.full {
+			return false, false, false
+		}
+		sites.full = true
+		return false, false, true
+	}
+	sites.logged[entry] = struct{}{}
+	if _, ok := sites.seen[site]; ok {
+		return false, true, false
+	}
+	sites.seen[site] = kind
+	return true, false, false
+}
+
+// Sites returns the call sites logged so far, without their callers, each with the kind of save it made.
+func Sites() map[string]Kind {
+	sites.Lock()
+	defer sites.Unlock()
+	ret := make(map[string]Kind, len(sites.seen))
+	for site, kind := range sites.seen {
+		ret[site] = kind
+	}
+	return ret
+}
diff --git a/kernel/tripwire/tripwire_test.go b/kernel/tripwire/tripwire_test.go
new file mode 100644
index 0000000..681025f
--- /dev/null
+++ b/kernel/tripwire/tripwire_test.go
@@ -0,0 +1,389 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package tripwire
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/siyuan-note/logging"
+)
+
+// captureLog replaces the log with a list of lines for the test, and starts it with no site seen.
+func captureLog(t *testing.T) *[]string {
+	t.Helper()
+	var mu sync.Mutex
+	lines := []string{}
+	previous := logWarnf
+	logWarnf = func(format string, v ...any) {
+		mu.Lock()
+		defer mu.Unlock()
+		lines = append(lines, fmt.Sprintf(format, v...))
+	}
+	sites.Lock()
+	seen, logged, full := sites.seen, sites.logged, sites.full
+	sites.seen, sites.logged, sites.full = map[string]Kind{}, map[string]struct{}{}, false
+	sites.Unlock()
+	t.Cleanup(func() {
+		logWarnf = previous
+		sites.Lock()
+		sites.seen, sites.logged, sites.full = seen, logged, full
+		sites.Unlock()
+	})
+	return &lines
+}
+
+// existingFile returns the path of a file that exists, as a saved page's or database's does.
+func existingFile(t *testing.T) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "20261018000000-page001.sy")
+	if err := os.WriteFile(p, []byte("{}"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// nextLine returns the line after its caller's.
+func nextLine() int {
+	_, _, line, _ := runtime.Caller(1)
+	return line + 1
+}
+
+func site(function string, line int) string {
+	return fmt.Sprintf("tripwire.%s tripwire_test.go:%d", function, line)
+}
+
+// requireLines checks the lines logged, each without the caller after its site, " <- ...", but for a go statement's.
+func requireLines(t *testing.T, what string, lines *[]string, want ...string) {
+	t.Helper()
+	var got []string
+	for _, line := range *lines {
+		if site, caller, ok := strings.Cut(line, " <- "); ok && "go statement" != caller {
+			line = site
+		}
+		got = append(got, line)
+	}
+	if fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Fatalf("%s logged %q, want %q", what, *lines, want)
+	}
+}
+
+// saveAt is one call site, shared by the tests that save from the same site inside and outside a turn.
+var saveAtLine = nextLine() + 1
+
+func saveAt(kind Kind, p string) { Save(kind, p) }
+
+func TestSaveOutsideATurnLogsItsSiteOnce(t *testing.T) {
+	lines := captureLog(t)
+	page, database := existingFile(t), existingFile(t)
+
+	line := nextLine() + 1
+	for range 3 {
+		Save(Page, page)
+	}
+	first := Marker + ": page " + site("TestSaveOutsideATurnLogsItsSiteOnce", line)
+	requireLines(t, "three saves from one site", lines, first)
+
+	line = nextLine()
+	Save(Database, database)
+	second := Marker + ": database " + site("TestSaveOutsideATurnLogsItsSiteOnce", line)
+	requireLines(t, "a save from a second site", lines, first, second)
+	if got := Sites(); 2 != len(got) || Database != got[site("TestSaveOutsideATurnLogsItsSiteOnce", line)] {
+		t.Fatalf("Sites() = %v", got)
+	}
+}
+
+func TestSaveInsideATurnLogsNothingAndFindsNoCaller(t *testing.T) {
+	lines := captureLog(t)
+	page := existingFile(t)
+	walks := 0
+	testHookCallSite = func() { walks++ }
+	t.Cleanup(func() { testHookCallSite = nil })
+
+	EnterTurn()
+	saveAt(Page, page)
+	if allocs := testing.AllocsPerRun(100, func() { saveAt(Page, page) }); 0 != allocs {
+		t.Errorf("a save inside a turn allocated %v times", allocs)
+	}
+	LeaveTurn()
+	if 0 != len(*lines) || 0 != walks {
+		t.Fatalf("saves inside a turn logged %q and looked for their caller %d times", *lines, walks)
+	}
+
+	// The site isn't remembered from inside the turn: its first save outside one is logged.
+	saveAt(Page, page)
+	requireLines(t, "the save after the turn", lines, Marker+": page "+site("saveAt", saveAtLine))
+}
+
+func TestLineReachesSiYuansLog(t *testing.T) {
+	sites.Lock()
+	seen, logged, full := sites.seen, sites.logged, sites.full
+	sites.seen, sites.logged, sites.full = map[string]Kind{}, map[string]struct{}{}, false
+	sites.Unlock()
+	previous := logging.LogPath
+	logPath := filepath.Join(t.TempDir(), "siyuan.log")
+	logging.SetLogPath(logPath)
+	t.Cleanup(func() {
+		logging.SetLogPath(previous)
+		sites.Lock()
+		sites.seen, sites.logged, sites.full = seen, logged, full
+		sites.Unlock()
+	})
+
+	line := nextLine()
+	Save(Database, existingFile(t))
+	data, err := os.ReadFile(logPath)
+	if nil != err {
+		t.Fatal(err)
+	}
+	want := Marker + ": database " + site("TestLineReachesSiYuansLog", line) + " <- testing.tRunner testing.go:"
+	if got := strings.TrimSpace(string(data)); !strings.HasPrefix(got, "W ") || !strings.Contains(got, want) || 1 != strings.Count(got, "\n")+1 {
+		t.Fatalf("SiYuan's log holds %q, want one warning holding %q", got, want)
+	}
+}
+
+func TestSaveMovableLogsACopyPutBackWhereItsPageWas(t *testing.T) {
+	lines := captureLog(t)
+	missing := filepath.Join(t.TempDir(), "20261018000000-page003.sy")
+	asked := 0
+	moved := false
+	movedAway := func() bool {
+		asked++
+		return moved
+	}
+
+	line := nextLine()
+	SaveMovable(Page, missing, movedAway)
+	requireLines(t, "a save of a new page, which lives nowhere else", lines)
+	if 1 != asked {
+		t.Fatalf("the save of a missing file asked where its page lives %d times, want 1", asked)
+	}
+
+	moved = true
+	line = nextLine()
+	SaveMovable(Page, missing, movedAway)
+	requireLines(t, "a save of a page that moved, at the path it left", lines,
+		Marker+": page "+site("TestSaveMovableLogsACopyPutBackWhereItsPageWas", line))
+
+	// Where the page lives is asked only outside a turn, and only when the path has no file.
+	asked = 0
+	SaveMovable(Page, existingFile(t), movedAway)
+	EnterTurn()
+	SaveMovable(Page, missing, movedAway)
+	if allocs := testing.AllocsPerRun(100, func() { SaveMovable(Page, missing, func() bool { return moved }) }); 0 != allocs {
+		t.Errorf("a save inside a turn allocated %v times", allocs)
+	}
+	LeaveTurn()
+	if 0 != asked {
+		t.Fatalf("saves of an existing file, or inside a turn, asked where the page lives %d times", asked)
+	}
+}
