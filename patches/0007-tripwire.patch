+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package av
+
+import (
+	"fmt"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/tripwire"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// siteOfSaveOnNextLine returns how the tripwire names a save made on the line after its caller's.
+func siteOfSaveOnNextLine() string {
+	pcs := make([]uintptr, 1)
+	runtime.Callers(2, pcs)
+	frame, _ := runtime.CallersFrames(pcs).Next()
+	name := frame.Function[strings.LastIndexByte(frame.Function, '/')+1:]
+	return fmt.Sprintf("%s %s:%d", name, filepath.Base(frame.File), frame.Line+1)
+}
+
+func TestTripwireLogsADatabaseSaveOutsideATurnAtItsWriter(t *testing.T) {
+	const avID = "20261018000000-tripwav"
+	originalDataDir := util.DataDir
+	util.DataDir = t.TempDir()
+	t.Cleanup(func() {
+		cache.RemoveAVData(avID)
+		util.DataDir = originalDataDir
+	})
+	attrView := &AttributeView{ID: avID, Spec: RichTextSpec, Name: "Original",
+		KeyValues: []*KeyValues{{Key: &Key{ID: "20261018000000-blockky", Name: "Name", Type: KeyTypeBlock}}},
+		Views: []*View{{ID: "20261018000000-tablevw", Name: "Table", LayoutType: LayoutTypeTable, Table: NewLayoutTable(),
+			PageSize: ViewDefaultPageSize}},
+		RenderedViewables: map[string]Viewable{}}
+
+	firstSave := siteOfSaveOnNextLine()
+	if err := SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	if _, ok := tripwire.Sites()[firstSave]; ok {
+		t.Fatal("the first save of a brand-new database was logged")
+	}
+
+	attrView.Name = "Edited"
+	save := siteOfSaveOnNextLine()
+	if err := SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	if kind, ok := tripwire.Sites()[save]; !ok || tripwire.Database != kind {
+		t.Fatalf("a save of an existing database outside a turn wasn't logged at %q: %v", save, tripwire.Sites())
+	}
+
+	tripwire.EnterTurn()
+	attrView.Name = "Edited in a turn"
+	inTurn := siteOfSaveOnNextLine()
+	err := SaveAttributeView(attrView)
+	tripwire.LeaveTurn()
+	if nil != err {
+		t.Fatal(err)
+	}
+	if _, ok := tripwire.Sites()[inTurn]; ok {
+		t.Fatal("a save inside a turn was logged")
+	}
+}
