+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package cache
+
+import (
+	"hash/fnv"
+	"slices"
+	"sync"
+	"sync/atomic"
+)
+
+// Every entry of the page cache and of the block and page attribute caches knows which version of its page's file it
+// copies. A page's version is the reading of one clock, which only rises, taken at the page's last raise: a write of
+// its file raises it at both ends (BeginTreeWrite, EndTreeWrite), and so does dropping a cached copy of it. A reader
+// notes the clock (NewFillToken) before its first lookup, and what it loads from a file it caches with that token; a
+// write caches what it wrote with the version EndTreeWrite returned. A cache serves an entry only if nothing raised its
+// page since (fresh), the read check; otherwise the read misses and goes to the file. A store never raises a version,
+// and every store takes the version as an argument, so no store can make one up.
+
+// FillToken is a version: a reading of the clock, noted by a reader before its first lookup, or returned by the end of
+// a write. The clock's first raise is 1, so a write's version is never 0, and 0 can say that nothing was written.
+type FillToken uint64
+
+var fillClock atomic.Uint64
+
+// NewFillToken notes the clock. A reader takes it before it first looks in a cache, so that what it then loads from a
+// file is at least as new as the token says.
+func NewFillToken() FillToken {
+	return FillToken(fillClock.Load())
+}
+
+// fillVersionsLimit bounds how many ids a fillVersions remembers one by one. Past it, the eighth raised longest ago is
+// forgotten into fillVersionsBuckets buckets, each keeping the newest raise forgotten into it, so a forgotten id still
+// refuses the entries noted before its last raise. That refuses, too, the older entries of the other ids sharing those
+// buckets, and only those: forgetting never empties every cache at once.
+const (
+	fillVersionsLimit   = 1 << 15
+	fillVersionsBuckets = 1 << 16
+)
+
+// fillVersions records, per id, the clock's value at the id's last raise. It is checked on every read of a cache that
+// uses it, and has its own lock, which is never held while another is taken.
+type fillVersions struct {
+	mu        sync.RWMutex
+	last      map[string]uint64 // id -> the clock's value at its last raise
+	forgotten []uint64          // bucket -> the newest last raise of the ids forgotten into it
+}
+
+func newFillVersions() *fillVersions {
+	return &fillVersions{last: map[string]uint64{}, forgotten: make([]uint64, fillVersionsBuckets)}
+}
+
+// treeVersions holds the version of every page, by page id, for the page cache and the block and page attribute caches.
+var treeVersions = newFillVersions()
+
+// bump raises id's version and returns it.
+func (v *fillVersions) bump(id string) FillToken {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.bumpLocked(id)
+}
+
+// end raises id's version at the end of a write that began at begin. It returns the new version if nothing else raised
+// id since begin, and 0 otherwise.
+func (v *fillVersions) end(id string, begin FillToken) FillToken {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	last, ok := v.last[id]
+	version := v.bumpLocked(id)
+	if !ok || last != uint64(begin) {
+		return 0
+	}
+	return version
+}
+
+func (v *fillVersions) bumpLocked(id string) FillToken {
+	if _, ok := v.last[id]; !ok && fillVersionsLimit <= len(v.last) {
+		v.forgetOldestLocked()
+	}
+	version := fillClock.Add(1)
+	v.last[id] = version
+	return FillToken(version)
+}
+
+// fresh reports whether nothing raised id since token, the read check.
+func (v *fillVersions) fresh(id string, token FillToken) bool {
+	v.mu.RLock()
+	defer v.mu.RUnlock()
+	last, ok := v.last[id]
+	if !ok {
+		last = v.forgotten[v.bucket(id)]
+	}
+	return last <= uint64(token)
+}
+
+func (v *fillVersions) bucket(id string) uint64 {
+	h := fnv.New64a()
+	h.Write([]byte(id))
+	return h.Sum64() % fillVersionsBuckets
+}
+
+// forgetOldestLocked forgets the ids raised longest ago, an eighth of them, into their buckets.
+func (v *fillVersions) forgetOldestLocked() {
+	versions := make([]uint64, 0, len(v.last))
+	for _, version := range v.last {
+		versions = append(versions, version)
+	}
+	slices.Sort(versions)
+	cutoff := versions[len(versions)/8]
+	for id, version := range v.last {
+		if version > cutoff {
+			continue
+		}
+		if b := v.bucket(id); v.forgotten[b] < version {
+			v.forgotten[b] = version
+		}
+		delete(v.last, id)
+	}
+}
+
+// BeginTreeWrite and EndTreeWrite bracket a write of page rootID's file, raising its version at both ends: an entry
+// noted before the write, or while it is under way, is refused from then on. BeginTreeWrite returns the version it set,
+// which the write hands to EndTreeWrite. EndTreeWrite returns the version that whatever the write caches must carry;
+// the writer calls it before it stores, never after.
+//
+// Writes of one page needn't end in the order they reached the file: one that wrote first can end last. So a write
+// caches only if nothing else raised the page during it. If another write, or a drop, did, EndTreeWrite returns 0 and
+// the write caches nothing; its end has still raised the page, so whatever the other write cached misses too, and the
+// next read goes to the file.
+func BeginTreeWrite(rootID string) FillToken {
+	return treeVersions.bump(rootID)
+}
+
+func EndTreeWrite(rootID string, begin FillToken) FillToken {
+	return treeVersions.end(rootID, begin)
+}
+
+// TreeFresh reports whether nothing wrote page rootID, or dropped a cached copy of it, since token.
+func TreeFresh(rootID string, token FillToken) bool {
+	return treeVersions.fresh(rootID, token)
+}
+
+// cacheFloor is a cache's own floor: clearing the cache raises it, and the cache refuses every entry noted below it,
+// so a fill that read before a clear and stores after it isn't served. A clear touches no other cache.
+type cacheFloor struct {
+	floor atomic.Uint64
+}
+
+// testHookFloorRaise, when set by a test, is called by cacheFloor.raise after it has read its new floor off the clock
+// and before it stores it.
+var testHookFloorRaise func()
+
+// raise never lowers the floor: of two clears running at once, the later raise stands.
+func (f *cacheFloor) raise() {
+	floor := fillClock.Add(1)
+	if nil != testHookFloorRaise {
+		testHookFloorRaise()
+	}
+	for {
+		current := f.floor.Load()
+		if current >= floor || f.floor.CompareAndSwap(current, floor) {
+			return
+		}
+	}
+}
+
+// current is the read check of an entry that copies page rootID at version.
+func (f *cacheFloor) current(rootID string, version FillToken) bool {
+	return "" != rootID && f.floor.Load() <= uint64(version) && treeVersions.fresh(rootID, version)
+}
