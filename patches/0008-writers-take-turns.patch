+)
+
+// round1SetupRepo gives the test workspace a snapshot repository, as the one-page snapshot restore's challenge does.
+func round1SetupRepo(t *testing.T) *dejavu.Repo {
+	t.Helper()
+	originalRepoDir := util.RepoDir
+	util.RepoDir = filepath.Join(util.WorkspaceDir, "repo")
+	t.Cleanup(func() { util.RepoDir = originalRepoDir })
+	Conf.Repo.Store(&conf.Repo{Key: bytes.Repeat([]byte{7}, 32)}) // snapshots need the repository's key
+	Conf.System.Store(&conf.System{ID: "20261018160000-device1", Name: "test", OS: "linux"})
+	originalStatusBar := util.StatusBarCfg.Load()
+	util.StatusBarCfg.Store(util.NewStatusBar(false))
+	t.Cleanup(func() { util.StatusBarCfg.Store(originalStatusBar) })
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	return repo
+}
+
+// round1SnapshotPage gives the id of the copy of page file repoPath that snapshot snapshotID holds, and the value of
+// the page's attribute name in that copy; "" and "(no copy of the page)" when the snapshot holds none.
+func round1SnapshotPage(t *testing.T, repo *dejavu.Repo, snapshotID, boxID, pagePath, name string) (fileID, value string) {
+	t.Helper()
+	index, err := repo.GetIndex(snapshotID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	repoPath := "/" + boxID + pagePath
+	for _, id := range index.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if repoPath != file.Path {
+			continue
+		}
+		data, openErr := repo.OpenFile(file)
+		if nil != openErr {
+			t.Fatal(openErr)
+		}
+		tree, parseErr := filesys.LoadTreeByData(data, boxID, pagePath, util.NewLute())
+		if nil != parseErr {
+			t.Fatal(parseErr)
+		}
+		return id, tree.Root.IALAttr(name)
+	}
+	return "", "(no copy of the page)"
+}
+
+// The one-page snapshot restore's backup ("Backup before checkout") is the only copy of what the restore writes over.
+// A snapshot takes a file again only when its modification time differs, in whole seconds, from the copy the latest
+// snapshot holds (dejavu's equalFile compares the path and Updated/1000, not the size or the content). So a save made
+// after a snapshot, in the same second as the save that snapshot copied, is left out of every later snapshot until the
+// file changes again, the restore's backup included; the restore then writes the snapshot's copy over it, and the save
+// is in neither. Fix round 1 gives the file a later modification time (touchSnapshotRestoreTarget) only before a
+// retry's backup, not before the first.
+//
+// The scenario: polka sets a property on a page, an automatic snapshot runs, and polka (or the owner) sets another
+// property within the same second; later the owner restores the page from a snapshot through the history panel. The
+// second property is lost, and no snapshot holds it. The base (1591063) and b0df32a back up the same way.
+func TestStep6ChallengeWritesRound1OnePageSnapshotRestoreKeepsASaveInTheLatestSnapshotsSecond(t *testing.T) {
+	t.Skip("a gap SiYuan already has: a save in the latest snapshot copy's second is left out of the backup; recorded on #43")
+	boxID, pagePath := setupRestoreCacheTest(t)
+	repo := round1SetupRepo(t)
+	pageAbs := filepath.Join(util.DataDir, boxID, pagePath)
+	modSecond := func() int64 {
+		info, err := os.Stat(pageAbs)
+		if nil != err {
+			t.Fatal(err)
+		}
+		return info.ModTime().Unix()
+	}
+
+	// Each try starts just after a second begins, and must fit the first save, the snapshot and the second save in
+	// that second; a try that doesn't is set aside, with new values, as the saves must change the file.
+	var snapshotID, kept string
+	for try := 1; ; try++ {
+		if 10 < try {
+			t.Fatalf("setup: in 10 tries, the snapshot and the two saves never fitted in one second")
+		}
+		for 50*time.Millisecond < time.Duration(time.Now().Nanosecond()) {
+			time.Sleep(5 * time.Millisecond)
+		}
+		setRestoreCacheAttr(t, restoreCachePageID, "custom-step", fmt.Sprintf("before the snapshot %d", try))
+		first := modSecond()
+		id, err := IndexRepo(fmt.Sprintf("automatic snapshot %d", try))
+		if nil != err {
+			t.Fatalf("take a snapshot failed: %v", err)
+		}
+		kept = fmt.Sprintf("kept %d", try)
+		setRestoreCacheAttr(t, restoreCachePageID, turnJobAttr, kept)
+		if second := modSecond(); first == second {
+			snapshotID = id
+			break
+		}
+	}
+	fileID, inSnapshot := round1SnapshotPage(t, repo, snapshotID, boxID, pagePath, turnJobAttr)
+	if "" == fileID || kept == inSnapshot {
+		t.Fatalf("setup: the snapshot holds the page with %s=%q (file %q), want a copy without %q", turnJobAttr,
+			inSnapshot, fileID, kept)
+	}
+
+	if err := RollbackRepoSnapshotFile(fileID); nil != err {
+		t.Fatalf("roll the page back to the snapshot failed: %v", err)
+	}
+
+	inPage := pageFile(t, restoreCachePageID).Root.IALAttr(turnJobAttr)
+	latest, err := repo.Latest()
+	if nil != err {
+		t.Fatal(err)
+	}
+	_, inBackup := round1SnapshotPage(t, repo, latest.ID, boxID, pagePath, turnJobAttr)
+	if kept != inPage && kept != inBackup {
+		t.Errorf("a save of the page made in the same second as the copy the latest snapshot holds is lost by the "+
+			"one-page snapshot restore: the page holds %s=%q, and the latest snapshot %q (%s), the restore's "+
+			"backup or the one it found nothing new for, holds %q; want %q in one of them", turnJobAttr, inPage,
+			latest.Memo, latest.ID, inBackup, kept)
+	}
+}
