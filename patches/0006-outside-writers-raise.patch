+// raiseAfterSync raises, once a sync or an asset recovery returns, what its file events didn't. Each file dejavu
+// writes, and each it removes through its own removes, raises as it goes (raiseAfterCheckoutFile). An asset recovery,
+// which a sync with dejavu's asset downloads on runs to apply its merge, removes the merge's removed files with no
+// event, so they are raised here, by path. A failure may have written part of a file with no event, so it raises
+// everything.
+func raiseAfterSync(mergeResult *dejavu.MergeResult, err error) {
+	if nil != err {
+		cache.RaiseAll()
+		return
+	}
+	if nil == mergeResult {
+		return
+	}
+	removed := make([]string, 0, len(mergeResult.Removes))
+	for _, file := range mergeResult.Removes {
+		removed = append(removed, filepath.Join(util.DataDir, file.Path))
+	}
+	filesys.RaiseForDataPath(removed...)
+}
