+// Rolling a page back to a snapshot that holds what the page holds now keeps the page's file. The rollback removes the
+// page's file raw, then writes the page from the snapshot through WriteTree, which skips the write when the page
+// cache's copy is current and holds the same bytes. The remove raises the page, so the copy isn't current and the
+// write lands.
+func TestRollingAnUnchangedPageBackToASnapshotKeepsItsFile(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	originalRepoDir := util.RepoDir
+	util.RepoDir = filepath.Join(util.WorkspaceDir, "repo")
+	t.Cleanup(func() { util.RepoDir = originalRepoDir })
+	Conf.Repo.Store(&conf.Repo{Key: bytes.Repeat([]byte{7}, 32)}) // snapshots need the repository's key
+	Conf.System.Store(&conf.System{ID: "20261017160000-device1", Name: "test", OS: "linux"})
+	originalStatusBar := util.StatusBarCfg.Load()
+	util.StatusBarCfg.Store(util.NewStatusBar(false))
+	t.Cleanup(func() { util.StatusBarCfg.Store(originalStatusBar) })
+
+	snapshotID, err := IndexRepo("an unchanged page")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	index, err := repo.GetIndex(snapshotID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	fileID := ""
+	for _, id := range index.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if "/"+boxID+pagePath == file.Path {
+			fileID = id
+		}
+	}
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no %s", "/"+boxID+pagePath)
+	}
+
+	// The page cache holds the page as its file does.
+	if _, err = filesys.LoadTree(boxID, pagePath, util.NewLute()); nil != err {
+		t.Fatalf("setup: load the page failed: %v", err)
+	}
+	for deadline := time.Now().Add(time.Second); ; time.Sleep(time.Millisecond) {
+		if _, ok := cache.GetTreeDataInBox(restoreCachePageID, boxID); ok {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("setup: the page cache doesn't serve the page")
+		}
+	}
+
+	if err = RollbackRepoSnapshotFile(fileID); nil != err {
+		t.Fatalf("roll the page back to the snapshot failed: %v", err)
+	}
+	if _, statErr := os.Stat(filepath.Join(util.DataDir, boxID, pagePath)); nil != statErr {
+		t.Fatalf("after the rollback, the page's file is gone: %v", statErr)
+	}
+}
