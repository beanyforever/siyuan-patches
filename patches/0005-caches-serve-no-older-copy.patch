+// challengeBlockAttrsInFile reads block id's attributes from page p's file as it is on disk, past every cache.
+func challengeBlockAttrsInFile(t *testing.T, boxID, p, id string) map[string]string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(util.DataDir, boxID, p))
+	if nil != err {
+		t.Fatalf("read %s failed: %v", p, err)
+	}
+	tree, err := filesys.LoadTreeByData(data, boxID, p, util.NewLute())
+	if nil != err {
+		t.Fatalf("parse %s failed: %v", p, err)
+	}
+	node := treenode.GetNodeInTree(tree, id)
+	if nil == node {
+		t.Fatalf("%s's file holds no block %s", p, id)
+	}
+	return parse.IAL2Map(node.KramdownIAL)
+}
+
+// challengeWaitBlockAttrsCached waits up to a second for the block attribute cache to take in what a read stored.
+func challengeWaitBlockAttrsCached(t *testing.T, id, boxID string) {
+	t.Helper()
+	for deadline := time.Now().Add(time.Second); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		if nil != cache.GetBlockIALInBox(id, boxID) {
+			return
+		}
+	}
+	t.Fatalf("setup: the block attribute cache doesn't serve %s's attributes", id)
+}
