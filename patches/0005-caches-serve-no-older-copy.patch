+
+// setupBoxDropTest is an empty workspace holding one database, named Original, that lives in a notebook of its own,
+// as an encrypted notebook's databases do (<box>/storage/av/<id>.json), saved and then dropped from the database
+// cache, as after a restart. The test runs without encryption: with no key provider set, the notebook's files are
+// read and written as they are, and only the cache key, the notebook's, differs from a plain database's.
+func setupBoxDropTest(t *testing.T) {
+	t.Helper()
+	originalDataDir := util.DataDir
+	util.DataDir = t.TempDir()
+	SetAVBoxID(boxDropTestID, boxDropTestBox)
+	t.Cleanup(func() {
+		testHookAVFill = nil
+		cache.RemoveAVDataInBox(boxDropTestID, boxDropTestBox)
+		cache.RemoveAVData(boxDropTestID)
+		SetAVBoxID(boxDropTestID, "")
+		util.DataDir = originalDataDir
+	})
+	attrView := &AttributeView{ID: boxDropTestID, Spec: RichTextSpec, Name: "Original",
+		KeyValues: []*KeyValues{{Key: &Key{ID: "20261017140000-blockky", Name: "Name", Type: KeyTypeBlock}}},
+		Views: []*View{{ID: "20261017140000-tablevw", Name: "Table", LayoutType: LayoutTypeTable, Table: NewLayoutTable(),
+			PageSize: ViewDefaultPageSize}},
+		RenderedViewables: map[string]Viewable{}}
+	if err := SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	if p := attributeViewDataPathByBox(boxDropTestID, boxDropTestBox); !fileExists(p) {
+		t.Fatalf("setup: the database wasn't saved in its notebook, at %s", p)
+	}
+	cache.RemoveAVData(boxDropTestID) // as after a restart; also what a sync does after it replaces the file
+}
+
+func fileExists(p string) bool {
+	_, err := os.Stat(p)
+	return nil == err
+}
+
+func parseBoxDropTest(t *testing.T) *AttributeView {
+	t.Helper()
+	ret, err := ParseAttributeViewInBox(boxDropTestID, boxDropTestBox)
+	if nil != err || nil == ret {
+		t.Fatalf("parse the database failed: %v", err)
+	}
+	return ret
+}
+
+func boxDropTestFileName(t *testing.T) string {
+	t.Helper()
+	data, err := os.ReadFile(attributeViewDataPathByBox(boxDropTestID, boxDropTestBox))
+	if nil != err {
+		t.Fatal(err)
+	}
+	ret, err := ParseAttributeViewData(boxDropTestID, data)
+	if nil != err {
+		t.Fatal(err)
+	}
+	return ret.Name
+}
+
+// settleBoxDropTest gives the database cache up to 200 ms to take in what a read stored under the notebook's key.
+func settleBoxDropTest() {
+	for deadline := time.Now().Add(200 * time.Millisecond); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		if _, ok := cache.GetAVDataInBox(boxDropTestID, boxDropTestBox); ok {
+			return
+		}
+	}
+}
+
+// A database replaced on disk and dropped from the cache, as a sync, a history or snapshot rollback, an asset rename or
+// a command-line write does (they write the file, then call cache.RemoveAVData), reads as the new file even when a
+// read that loaded the old file was under way. The spec says a drop raises the version, so a fill noted before it is
+// refused. RemoveAVData raises only the plain key ("" + id) and the keys that hold an entry; a database in an
+// encrypted notebook is cached under its notebook's key, which a read notes (EnsureAVDataVersionInBox) before it
+// stores anything there. So when the drop lands between that read's load and its store, nothing raises the key the
+// read noted: the read caches the old file at a version that is still current, and every read serves it until the
+// next save, which the next operation then builds on, saving the old copy over the new file.
+//
+// Fault at df08f4e: kernel/cache/av.go:200 RemoveAVData (raises only avCacheKeys[avID]'s keys and the "" key); the fill
+// is kernel/av/av.go parseAttributeViewByPathInBoxWithOptions (Ensure at :864, store at :892).
+func TestAVDropRacingAFillInANotebookLeavesNoOlderCopy(t *testing.T) {
+	setupBoxDropTest(t)
+	livePath := attributeViewDataPathByBox(boxDropTestID, boxDropTestBox)
+	fired := false
+	testHookAVFill = func() {
+		if fired {
+			return
+		}
+		fired = true
+		// A raw writer replaces the file, then drops the database from the cache, as sync does.
+		data, err := os.ReadFile(livePath)
+		if nil != err {
+			t.Error(err)
+			return
+		}
+		synced := replaceJSONString(data, "name", "Original", "Synced")
+		if bytes.Equal(synced, data) {
+			t.Error("setup: the database's file holds no name")
+			return
+		}
+		if err = os.WriteFile(livePath, synced, 0644); nil != err {
+			t.Error(err)
+			return
+		}
+		cache.RemoveAVData(boxDropTestID)
+	}
+	if got := parseBoxDropTest(t).Name; "Original" != got {
+		t.Fatalf("setup: the read that loaded the file before the drop gave the name %q", got)
+	}
+	testHookAVFill = nil
+	if !fired {
+		t.Fatal("setup: the read didn't fill the database cache")
+	}
+	if got := boxDropTestFileName(t); "Synced" != got {
+		t.Fatalf("setup: the database's file holds the name %q", got)
+	}
+
+	for _, read := range []string{"first", "second"} {
+		settleBoxDropTest()
+		if got := parseBoxDropTest(t).Name; "Synced" != got {
+			t.Errorf("the %s read after the drop gave the name %q, though the file holds Synced", read, got)
+		}
+	}
+	settleBoxDropTest()
+	next := parseBoxDropTest(t)
+	next.Views[0].Name = "Edited"
+	if err := SaveAttributeView(next); nil != err {
+		t.Fatal(err)
+	}
+	if got := boxDropTestFileName(t); "Synced" != got {
+		t.Errorf("the next operation saved the name %q over the synced file", got)
+	}
+}
+
+// Two saves of one database that overlap leave the database cache holding what the file holds. A save raises the
+// database's version before and after its file write and caches its bytes with the version its end returned; a read
+// serves an entry only if its version is still the database's. That holds only if the ends come in the order of the
+// file writes. Each file write takes the file's lock, but the end comes after the lock is released, so a save that
+// wrote first can end last: its copy is then cached at the current version, and served, though the file holds the
+// other save's bytes, and the next operation saves the older copy over the file. Saves that don't take turns with jobs
+// (getAttributeViewKeys, the race-3 endpoints, the ref-text refresh, the MCP database tools) can overlap a job's save
+// this way. A test hook holds the first save between its file write and its end while a second save writes and ends.
+//
+// Fault at df08f4e: kernel/av/av.go saveAttributeView, EndAVWrite (:1177) runs after the file lock is released,
+// so the order of the ends needn't be the order of the writes; the same holds for the compare-and-swap path (:1122).
+func TestAVOverlappingSavesCacheWhatTheFileHolds(t *testing.T) {
+	setupSaveCacheTest(t)
+	first := parseSaveCacheTest(t)
+	first.Name = "First"
+	second := parseSaveCacheTest(t)
+	second.Name = "Second"
+
+	var calls atomic.Int32
+	firstWritten, secondDone := make(chan struct{}), make(chan struct{})
+	testHookAVSaveBeforeEnd = func() {
+		if 1 == calls.Add(1) {
+			// The first save has written its file and stalls before its end, as a goroutine descheduled there would.
+			close(firstWritten)
+			// A fix that keeps writes of one page or database from overlapping holds the second writer back, so
+			// this one goes on after a second instead of waiting for it forever.
+			select {
+			case <-secondDone:
+			case <-time.After(time.Second):
+			}
+		}
+	}
+	t.Cleanup(func() { testHookAVSaveBeforeEnd = nil })
+	firstErr := make(chan error, 1)
+	go func() { firstErr <- SaveAttributeView(first) }()
+	<-firstWritten
+	if err := SaveAttributeView(second); nil != err {
+		t.Fatal(err)
+	}
+	close(secondDone)
+	if err := <-firstErr; nil != err {
+		t.Fatal(err)
+	}
+	testHookAVSaveBeforeEnd = nil
+	if got := saveCacheTestFileName(t); "Second" != got {
+		t.Fatalf("setup: the database's file holds the name %q, not the second save's", got)
+	}
+
+	for _, read := range []string{"first", "second"} {
+		settleAVCache()
+		if got := parseSaveCacheTest(t).Name; "Second" != got {
+			t.Errorf("the %s read after the two saves gave the name %q, though the file holds Second", read, got)
+		}
+	}
+	settleAVCache()
+	next := parseSaveCacheTest(t)
+	next.Views[0].Name = "Edited"
+	if err := SaveAttributeView(next); nil != err {
+		t.Fatal(err)
+	}
+	if got := saveCacheTestFileName(t); "Second" != got {
+		t.Errorf("the next operation saved the name %q over the second save", got)
+	}
+}
