+
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// Step 4's challenger: a remove's bracket misses a page written into the folder after the bracket began.
+//
+// A remove of a folder bracketed by BeginDataPathWrite (removeDataPath, so box.Remove of a page's sub-page folder,
+// removeBoxDir, the file API's removeFile, the MCP file tool's delete, WebDAV's RemoveAll, the notebook archive's move
+// out of data/) notes the pages the folder holds by walking it when the bracket begins, and its end raises what it
+// noted and what the folder holds afterwards, which is nothing. A page written into the folder in between, such as a
+// sub-page created, or moved in, while its parent is being deleted, is in neither walk, and nothing raises it. Its
+// page cache entry, which its own WriteTree stored with the version that write's end returned, stays current though
+// the remove took its file away: SiYuan serves the page, and a save of the page as it was (a job that holds it and
+// commits it unchanged) is skipped by WriteTree's skip lookup as already written, so the page gets no file at all.
+func TestRemovingAFolderRaisesAPageWrittenIntoItDuringTheRemove(t *testing.T) {
+	box, parent, _, _ := setupStalePathTest(t)
+	folder := filepath.Join(util.DataDir, box, parent)
+	existing := treenode.NewTree(box, "/"+parent+"/20261018020001-existng.sy", "/Parent/Existing", "Existing")
+	if _, err := WriteTree(existing); nil != err {
+		t.Fatal(err)
+	}
+
+	end := BeginDataPathWrite(folder)
+	// While the remove is under way, a page is written into the folder, and caches what it wrote.
+	late := treenode.NewTree(box, "/"+parent+"/20261018020002-latepge.sy", "/Parent/Late", "Late")
+	if _, err := WriteTree(late); nil != err {
+		t.Fatal(err)
+	}
+	for deadline := time.Now().Add(200 * time.Millisecond); ; time.Sleep(time.Millisecond) {
+		if _, ok := cache.GetTreeDataInBox(late.ID, box); ok {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("setup: the page cache doesn't serve the page written into the folder")
+		}
+	}
+	if err := os.RemoveAll(folder); nil != err {
+		t.Fatal(err)
+	}
+	end()
+
+	latePath := filepath.Join(util.DataDir, box, late.Path)
+	if _, err := os.Stat(latePath); !os.IsNotExist(err) {
+		t.Fatalf("setup: the remove left the page's file: %v", err)
+	}
+	if _, ok := cache.GetTreeDataInBox(late.ID, box); ok {
+		t.Error("after the remove, the page cache serves the page written into the folder during it, whose file the " +
+			"remove took away")
+	}
+	if _, err := WriteTree(late); nil != err {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(latePath); nil != err {
+		t.Errorf("a save of the page as it was, after the remove, wrote no file: %v", err)
+	}
+}
diff --git a/kernel/filesys/raise.go b/kernel/filesys/raise.go
new file mode 100644
index 0000000..71b3f14
--- /dev/null
+++ b/kernel/filesys/raise.go
@@ -0,0 +1,240 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package filesys
+
+import (
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/88250/lute/ast"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// RaiseForDataPath raises, after a write that bypassed WriteTree and saveAttributeView, what the write changed at each
+// path: a page file (data/<box>/…/<id>.sy) raises its page, a database file (data/storage/av/<id>.json, or
+// data/<box>/storage/av/<id>.json in an encrypted notebook) its database, and a folder every page and database file
+// under it. A path holding data/ itself raises everything (cache.RaiseAll); a path outside data/ raises nothing.
+//
+// A folder is walked as it is after the write. That raises exactly the pages and databases it holds, and never floors
+// or the caches of anything else. A write that may take files away (a remove) brackets itself with BeginDataPathWrite
+// instead, which also walks the folder before the write; a copy into a folder that holds more than the copy raises
+// with RaiseForDataCopy, which walks only what was copied.
+func RaiseForDataPath(absPaths ...string) {
+	var targets dataPathTargets
+	for _, p := range absPaths {
+		targets.collect(p)
+	}
+	targets.raise()
+}
+
+// BeginDataPathWrite notes the pages and databases each path holds before a write that may take them away, such as a
+// remove, and returns the raise to call once the write has finished: it raises what was noted and what the paths hold
+// then, as RaiseForDataPath does.
+//
+// When a path is a folder, a page written into it while the write runs is in neither walk, and a remove takes its file
+// away. So the end also raises every page and database whose version rose since the bracket began
+// (cache.RaiseChangedSince): every write of a page raises it, so that covers the pages written into the folder, and
+// touches only what was written while the remove ran.
+func BeginDataPathWrite(absPaths ...string) (end func()) {
+	since := cache.NewFillToken()
+	var before dataPathTargets
+	folder := false
+	for _, p := range absPaths {
+		folder = before.collect(p) || folder
+	}
+	return func() {
+		for _, p := range absPaths {
+			before.collect(p)
+		}
+		before.raise()
+		if folder {
+			cache.RaiseChangedSince(since)
+		}
+	}
+}
+
+// RaiseForDataCopy raises, after a copy of src to dest that bypassed WriteTree and saveAttributeView, what the copy
+// wrote under dest: src's own file, or each file of the folder src where it lands under dest. What dest held beside the
+// copy isn't raised, so a copy into a notebook raises only the pages it brought. The copy may have failed part way; it
+// is raised all the same.
+func RaiseForDataCopy(src, dest string) {
+	var targets dataPathTargets
+	targets.collectCopy(src, dest)
+	targets.raise()
+}
+
+// dataPathTargets are the pages and databases a write changed.
+type dataPathTargets struct {
+	pages []string
+	avs   []cache.AVKey
+	all   bool
+}
+
+func (t *dataPathTargets) raise() {
+	if t.all {
+		cache.RaiseAll()
+		return
+	}
+	cache.RaisePages(t.pages...)
+	cache.RaiseAVs(t.avs...)
+}
+
+// dataPathPlace says where absPath lies: inside data/ (with its path relative to data/), at or above data/ (holding
+// it), or elsewhere.
+type dataPathPlace int
+
+const (
+	outsideData dataPathPlace = iota
+	insideData
+	holdingData
+)
+
+func placeDataPath(absPath string) (place dataPathPlace, rel string) {
+	if "" == absPath || "" == util.DataDir {
+		return
+	}
+	dataDir := filepath.Clean(util.DataDir)
+	rel, err := filepath.Rel(dataDir, filepath.Clean(absPath))
+	if nil != err {
+		return
+	}
+	if "." == rel {
+		return holdingData, ""
+	}
+	if !isParentRel(rel) {
+		return insideData, rel
+	}
+	if up, upErr := filepath.Rel(filepath.Clean(absPath), dataDir); nil == upErr && !isParentRel(up) {
+		return holdingData, ""
+	}
+	return
+}
+
+func isParentRel(rel string) bool {
+	return ".." == rel || strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
+
+// collect adds what absPath holds now: the page or database it names, or every one under it if it is a folder inside
+// data/. It reports whether it walked a folder.
+func (t *dataPathTargets) collect(absPath string) (folder bool) {
+	if t.all {
+		return
+	}
+	place, rel := placeDataPath(absPath)
+	switch place {
+	case holdingData:
+		t.all = true
+		return
+	case outsideData:
+		return
+	}
+
+	info, err := os.Lstat(absPath)
+	if nil != err || !info.IsDir() {
+		// A file, or a path the write took away: it names what it held.
+		t.collectFile(rel)
+		return
+	}
+	walkFiles(absPath, func(sub string) {
+		t.collectFile(filepath.Join(rel, sub))
+	})
+	return true
+}
+
+// collectCopy adds what a copy of src to dest wrote under dest.
+func (t *dataPathTargets) collectCopy(src, dest string) {
+	if t.all {
+		return
+	}
+	place, rel := placeDataPath(dest)
+	switch place {
+	case holdingData:
+		t.all = true
+		return
+	case outsideData:
+		return
+	}
+
+	info, err := os.Lstat(src)
+	if nil != err || !info.IsDir() {
+		t.collectFile(rel)
+		return
+	}
+	walkFiles(src, func(sub string) {
+		t.collectFile(filepath.Join(rel, sub))
+	})
+}
+
+// walkFiles calls file with the path, relative to root, of every file under the folder root. A folder it can't read is
+// skipped.
+func walkFiles(root string, file func(sub string)) {
+	_ = filepath.WalkDir(root, func(p string, d fs.DirEntry, walkErr error) error {
+		if nil != walkErr {
+			if nil != d && d.IsDir() && p != root {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if d.IsDir() {
+			return nil
+		}
+		if sub, relErr := filepath.Rel(root, p); nil == relErr {
+			file(sub)
+		}
+		return nil
+	})
+}
+
+// collectFile adds the page or database the file at rel, relative to data/, holds, if it holds one.
+func (t *dataPathTargets) collectFile(rel string) {
+	rel = filepath.ToSlash(rel)
+	name := pathBase(rel)
+	if id, ok := strings.CutSuffix(name, ".sy"); ok {
+		if ast.IsNodeIDPattern(id) {
+			t.pages = append(t.pages, id)
+		}
+		return
+	}
+	if avID, ok := strings.CutSuffix(name, ".json"); ok && ast.IsNodeIDPattern(avID) {
+		if key, ok := liveAVKey(rel, avID); ok {
+			t.avs = append(t.avs, key)
+		}
+	}
+}
+
+// liveAVKey names the database whose live file is at rel: storage/av/<id>.json, or <box>/storage/av/<id>.json in an
+// encrypted notebook. Database files anywhere else, such as copies in a page's folder, are no database's live file.
+func liveAVKey(rel, avID string) (key cache.AVKey, ok bool) {
+	parts := strings.Split(rel, "/")
+	switch {
+	case 3 == len(parts) && "storage" == parts[0] && "av" == parts[1]:
+		return cache.AVKey{AVID: avID}, true
+	case 4 == len(parts) && ast.IsNodeIDPattern(parts[0]) && "storage" == parts[1] && "av" == parts[2]:
+		return cache.AVKey{AVID: avID, BoxID: parts[0]}, true
+	}
+	return
+}
+
+func pathBase(slashPath string) string {
+	if i := strings.LastIndex(slashPath, "/"); 0 <= i {
+		return slashPath[i+1:]
+	}
+	return slashPath
+}
