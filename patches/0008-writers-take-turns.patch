+		checkPageKeepsJob(t, job, "\"+ New\" with a content template", created.BlockID)
+		if text := string(pageFile(t, created.BlockID).Root.Text()); !strings.Contains(text, "Template text") {
+			t.Errorf("after \"+ New\" with a content template, the page's file holds %q, without the template", text)
+		}
