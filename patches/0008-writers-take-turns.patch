+// renameAssetInPageInTurn replaces the asset's old name in page file treeAbsPath and saves it, and gives the page as
+// saved, or nil if it no longer names the asset or doesn't parse. Its caller has the turn.
+func renameAssetInPageInTurn(treeAbsPath, boxID string, oldNameBytes, escapedOldNameBytes []byte,
+	nameReplacer *strings.Replacer, historyDir string, luteEngine *lute.Lute) (tree *parse.Tree, err error) {
+	data, err := filelock.ReadFile(treeAbsPath)
+	if nil != err {
+		logging.LogErrorf("get data [path=%s] failed: %s", treeAbsPath, err)
+		return
+	}
+	if !bytes.Contains(data, oldNameBytes) && !bytes.Contains(data, escapedOldNameBytes) {
+		return
+	}
+	if nil != testHookRenameAssetPageRead {
+		testHookRenameAssetPageRead(util.GetTreeID(treeAbsPath))
+	}
+
+	data = []byte(nameReplacer.Replace(string(data)))
+	err = filelock.WriteFile(treeAbsPath, data)
+	filesys.RaiseForDataPath(treeAbsPath)
+	if nil != err {
+		logging.LogErrorf("write data [path=%s] failed: %s", treeAbsPath, err)
+		return
+	}
+
+	cache.RemoveTreeData(util.GetTreeID(treeAbsPath))
+	p := filepath.ToSlash(strings.TrimPrefix(treeAbsPath, filepath.Join(util.DataDir, boxID)))
+	tree, parseErr := filesys.LoadTreeByData(data, boxID, p, luteEngine)
+	if nil != parseErr {
+		logging.LogWarnf("parse json to tree [%s] failed: %s", treeAbsPath, parseErr)
+		return nil, nil
+	}
+
+	generateTreeHistory(tree, historyDir)
+	treenode.UpsertBlockTree(tree)
+	sql.UpsertTreeQueue(tree)
+	return
+}
+
+// assetRenameChangesAttributeView reports whether replacing oldPath with newPath changes a database's data, as
+// replaceAttributeViewAssetPath replaces it.
+func assetRenameChangesAttributeView(data []byte, oldPath, newPath string) bool {
+	oldPath = strings.SplitN(AssetPathWithoutQuery(oldPath), "#", 2)[0]
+	newPath = strings.SplitN(AssetPathWithoutQuery(newPath), "#", 2)[0]
+	if oldPath == "" || oldPath == newPath {
+		return false
+	}
+	return !bytes.Equal(data, []byte(newAssetRenameReplacer(oldPath, newPath).Replace(string(data))))
+}
+
