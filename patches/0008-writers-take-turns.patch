index 0000000..99b05f2
--- /dev/null
+++ b/kernel/model/turns_challenge_writes_r4_fts5_test.go
@@ -0,0 +1,133 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// Challenges to fix round 4 of step 6 of issue #43, on lost writes: the one-page snapshot restore's touch passing over
+// the seconds the repository holds a copy of the file in.
+
+import (
+	"os"
+	"path"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/dejavu"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// round4LatestCopySecond gives the second of the latest snapshot's copy of repoPath.
+func round4LatestCopySecond(t *testing.T, repo *dejavu.Repo, repoPath string) int64 {
+	t.Helper()
+	latest, err := repo.Latest()
+	if nil != err {
+		t.Fatal(err)
+	}
+	files, err := repo.GetFiles(latest)
+	if nil != err {
+		t.Fatal(err)
+	}
+	for _, f := range files {
+		if f.Path == repoPath {
+			return f.Updated / 1000
+		}
+	}
+	t.Fatalf("the latest snapshot %q holds no copy of %s", latest.Memo, repoPath)
+	return 0
+}
+
+// round4CheckTouchPassesOverStoredCopies dates file abs ahead of the clock in seconds F and F+1, taking a snapshot in
+// each, so the repository holds a copy of it in both, the latest snapshot's in F+1. It then dates the file in F-1, as
+// putFile with an older modTime does, and touches it: the touch's first candidate is F. It must date the file in F+2,
+// the first second with no stored copy; a repo path or store path other than dejavu's would find no copy and date it
+// in F. A backup taken after the touch must then copy the file in F+2.
+func round4CheckTouchPassesOverStoredCopies(t *testing.T, repo *dejavu.Repo, isDoc bool, rootID, abs, repoPath string) {
+	t.Helper()
+	f := time.Now().Add(30 * time.Second).Truncate(time.Second)
+	for i := 0; i < 2; i++ {
+		at := f.Add(time.Duration(i)*time.Second + 300*time.Millisecond)
+		if err := os.Chtimes(abs, at, at); nil != err {
+			t.Fatal(err)
+		}
+		if _, err := IndexRepo("automatic snapshot"); nil != err {
+			t.Fatalf("take a snapshot failed: %v", err)
+		}
+		if got := round4LatestCopySecond(t, repo, repoPath); got != at.Unix() {
+			t.Fatalf("setup: the latest snapshot's copy of %s is in second %d, want %d", repoPath, got, at.Unix())
+		}
+	}
+	before := f.Add(-700 * time.Millisecond)
+	if err := os.Chtimes(abs, before, before); nil != err {
+		t.Fatal(err)
+	}
+	touchSnapshotRestoreTarget(isDoc, rootID, abs)
+	info, err := os.Stat(abs)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if want := f.Add(2 * time.Second).Unix(); info.ModTime().Unix() != want {
+		t.Errorf("the touch dated %s in second %d (F%+d), want %d (F+2), the first second with no stored copy",
+			repoPath, info.ModTime().Unix(), info.ModTime().Unix()-f.Unix(), want)
+	}
+	if _, err = IndexRepo("Backup before checkout"); nil != err {
+		t.Fatalf("back up failed: %v", err)
+	}
+	if got := round4LatestCopySecond(t, repo, repoPath); got != info.ModTime().Unix() {
+		t.Errorf("the backup after the touch copied %s in second %d, want the touched second %d: it took the file as "+
+			"unchanged", repoPath, got, info.ModTime().Unix())
+	}
+}
+
+// The touch builds the file's repo path and its object's path in the store itself, to pass over the seconds of stored
+// copies. Each must be exactly what dejavu uses, for a page found through the block tree, for a database file and for
+// a file in nested folders of a notebook, or the touch finds no copy and dates the file in the latest copy's second.
+func TestStep6ChallengeWritesRound4TouchFindsStoredCopiesWhereDejavuPutsThem(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	repo := round1SetupRepo(t)
+
+	t.Run("page", func(t *testing.T) {
+		abs := filepath.Join(util.DataDir, boxID, pagePath)
+		round4CheckTouchPassesOverStoredCopies(t, repo, true, restoreCachePageID, abs, path.Join("/", boxID, pagePath))
+	})
+
+	t.Run("database", func(t *testing.T) {
+		dir := filepath.Join(util.DataDir, "storage", "av")
+		if err := os.MkdirAll(dir, 0755); nil != err {
+			t.Fatal(err)
+		}
+		abs := filepath.Join(dir, "20261018120000-round4a.json")
+		if err := os.WriteFile(abs, []byte(`{"spec":2,"id":"20261018120000-round4a","name":"","keyValues":[],"views":[]}`), 0644); nil != err {
+			t.Fatal(err)
+		}
+		round4CheckTouchPassesOverStoredCopies(t, repo, false, "", abs, "/storage/av/20261018120000-round4a.json")
+	})
+
+	t.Run("nested", func(t *testing.T) {
+		dir := filepath.Join(util.DataDir, boxID, "20261018120000-round4b", "20261018120000-round4c")
+		if err := os.MkdirAll(dir, 0755); nil != err {
+			t.Fatal(err)
+		}
+		abs := filepath.Join(dir, "round4.txt")
+		if err := os.WriteFile(abs, []byte("round 4"), 0644); nil != err {
+			t.Fatal(err)
+		}
+		round4CheckTouchPassesOverStoredCopies(t, repo, false, "", abs,
+			"/"+boxID+"/20261018120000-round4b/20261018120000-round4c/round4.txt")
+	})
+}
