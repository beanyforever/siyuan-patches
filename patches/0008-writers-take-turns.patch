+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// The locks challenger's tests of step 6's fix round 3 (issue #43): how long the touch before a one-page snapshot
+// restore's backup waits, for a file dated anywhere.
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// touchSnapshotRestoreTarget returns at once for a file dated in an earlier second or ahead of the clock, however far,
+// and waits at most about a second for a file dated in the current second, also when the file is saved or dated ahead
+// during that wait. Afterwards the file is dated in another second than before: a later one, and not ahead of the
+// clock, when it waited; the second after its own when it was ahead.
+func TestStep6ChallengeLocksRound3TouchBeforeASnapshotRestoreBackupWaitsAtMostASecond(t *testing.T) {
+	dir := t.TempDir()
+	const prompt, aSecond = 200 * time.Millisecond, 1300 * time.Millisecond
+	cases := []struct {
+		name   string
+		date   func() time.Time
+		most   time.Duration
+		ahead  bool
+		change func(p string) // runs 300 ms into the touch, or nil
+	}{
+		{name: "the epoch's first second", date: func() time.Time { return time.Unix(1, 0) }, most: prompt},
+		{name: "a minute ago", date: func() time.Time { return time.Now().Add(-time.Minute) }, most: prompt},
+		{name: "the current second", date: time.Now, most: aSecond},
+		{name: "the current second, saved during the wait", date: time.Now, most: aSecond, change: func(p string) {
+			_ = os.WriteFile(p, []byte("saved during the wait"), 0644)
+		}},
+		{name: "the current second, dated an hour ahead during the wait", date: time.Now, most: aSecond, change: func(p string) {
+			later := time.Now().Add(time.Hour)
+			_ = os.Chtimes(p, later, later)
+		}},
+		{name: "two seconds ahead", date: func() time.Time { return time.Now().Add(2 * time.Second) }, most: prompt, ahead: true},
+		{name: "a day ahead", date: func() time.Time { return time.Now().Add(24 * time.Hour) }, most: prompt, ahead: true},
+		{name: "the year 2200", date: func() time.Time { return time.Date(2200, 1, 1, 0, 0, 0, 0, time.UTC) }, most: prompt, ahead: true},
+		// Past 2262 a time's nanoseconds overflow int64, which os.Chtimes uses, so the touch dates the file wherever the
+		// overflow lands; only how long it takes is checked.
+		{name: "the year 2300", date: func() time.Time { return time.Date(2300, 1, 1, 0, 0, 0, 0, time.UTC) }, most: prompt},
+	}
+	for i, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if aSecond == c.most {
+				// Start early in a second, so that the touch waits most of it and a change at 300 ms lands in the wait.
+				time.Sleep(time.Until(time.Now().Truncate(time.Second).Add(time.Second + 20*time.Millisecond)))
+			}
+			p := filepath.Join(dir, string(rune('a'+i))+".json")
+			if err := os.WriteFile(p, []byte("{}"), 0644); nil != err {
+				t.Fatal(err)
+			}
+			d := c.date()
+			ts := syscall.Timespec{Sec: d.Unix(), Nsec: int64(d.Nanosecond())}
+			if err := syscall.UtimesNano(p, []syscall.Timespec{ts, ts}); nil != err {
+				t.Fatal(err)
+			}
+			before, err := os.Stat(p)
+			if nil != err {
+				t.Fatal(err)
+			}
+			changed := make(chan struct{})
+			go func() {
+				defer close(changed)
+				if nil != c.change {
+					time.Sleep(300 * time.Millisecond)
+					c.change(p)
+				}
+			}()
+			start := time.Now()
+			touchSnapshotRestoreTarget(false, "", p)
+			took := time.Since(start)
+			<-changed
+			after, err := os.Stat(p)
+			if nil != err {
+				t.Fatal(err)
+			}
+			t.Logf("dated %s, touched to %s in %s", before.ModTime().UTC(), after.ModTime().UTC(), took)
+			if took > c.most {
+				t.Errorf("the touch took %s, more than %s", took, c.most)
+			}
+			was, is := before.ModTime().Truncate(time.Second), after.ModTime().Truncate(time.Second)
+			switch {
+			case c.ahead:
+				if !is.Equal(was.Add(time.Second)) {
+					t.Errorf("a file dated ahead was touched to %s, not the second after its date", after.ModTime())
+				}
+			case 0 == d.Year()-2300:
+			default:
+				if !is.After(was) {
+					t.Errorf("the touch dated the file %s, not in a later second than %s", after.ModTime(), before.ModTime())
+				}
+				if after.ModTime().After(time.Now()) {
+					t.Errorf("the touch dated the file %s, ahead of the clock", after.ModTime())
+				}
+			}
+		})
+	}
+}
