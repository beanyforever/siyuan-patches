+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// Challenges to fix round 5 of step 6 of issue #43, on lost writes: the one-page snapshot restore touches the page only
+// before a retry's backup, and waits after it until the clock has passed the touched second.
+
+import (
+	"path"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// A job saves the page after the restore's first backup, so the restore backs up again, the page touched to a second
+// no stored copy has. The restore's write, and a save right after it, must land past that second; otherwise the next
+// snapshot takes the page as unchanged since the backup and keeps the copy from before the restore. Since
+// round 5 a restore without a retry isn't touched, so this test makes one retry, to reach the touch.
+func TestStep6ChallengeWritesRound5RetriedRestoreNextSnapshotHoldsTheRestoredPageAndASaveRightAfterIt(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	repo := round1SetupRepo(t)
+	pageAbs := filepath.Join(util.DataDir, boxID, pagePath)
+	snapshotID, err := IndexRepo("before the Type changed")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	fileID, _ := round1SnapshotPage(t, repo, snapshotID, boxID, pagePath, turnJobAttr)
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no copy of the page")
+	}
+	// The change waits for the next second, so the restore's first backup takes a copy of its own.
+	time.Sleep(1100 * time.Millisecond)
+	setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "task")
+	FlushTxQueue()
+
+	job := newTurnJob()
+	setTurnHook(t, job, &testHookRollbackRepoSnapshotFileBackedUp, func() { job.send(pageJob(restoreCachePageID)...) })
+	job.run(t, "the one-page snapshot restore", func() {
+		if err = RollbackRepoSnapshotFile(fileID); nil != err {
+			t.Fatalf("roll the page back to the snapshot failed: %v", err)
+		}
+	})
+	restoredAt := round3ModTime(t, pageAbs)
+	latest, err := repo.Latest()
+	if nil != err {
+		t.Fatal(err)
+	}
+	if _, jobInBackup := round1SnapshotPage(t, repo, latest.ID, boxID, pagePath, turnJobAttr); turnJobValue != jobInBackup {
+		t.Fatalf("setup: the restore's last backup holds %s=%q, want %q: it did not back up again after the job's save",
+			turnJobAttr, jobInBackup, turnJobValue)
+	}
+	backupSecond := round4LatestCopySecond(t, repo, path.Join("/", boxID, pagePath))
+	setRestoreCacheAttr(t, restoreCachePageID, turnJobAttr, "kept")
+	FlushTxQueue()
+	savedAt := round3ModTime(t, pageAbs)
+	checkPageAttr(t, "after the retried restore and the save", restoreCachePageID, "custom-object-type", "note")
+	next, err := IndexRepo("automatic snapshot")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	_, typeInNext := round1SnapshotPage(t, repo, next, boxID, pagePath, "custom-object-type")
+	_, keptInNext := round1SnapshotPage(t, repo, next, boxID, pagePath, turnJobAttr)
+	t.Logf("the retry's backup copy is in second %d; the restore dated the page %s, the save after it %s",
+		backupSecond, restoredAt.Format("15:04:05.000"), savedAt.Format("15:04:05.000"))
+	if "note" != typeInNext || "kept" != keptInNext {
+		t.Errorf("the snapshot after the retried restore holds the page with custom-object-type=%q and %s=%q, want "+
+			"\"note\" (restored) and \"kept\" (saved after it): it took the page as unchanged since the backup",
+			typeInNext, turnJobAttr, keptInNext)
+	}
+}
diff --git a/kernel/model/turns_databases_fts5_test.go b/kernel/model/turns_databases_fts5_test.go
