+// newChallengeDefPage writes a new page in the fixture's notebook holding one paragraph with text, and gives the page
+// as read back and the paragraph in it.
+func newChallengeDefPage(t *testing.T, files *fileOperationTestFixture, title, text string) (*parse.Tree, *ast.Node) {
+	t.Helper()
+	id := ast.NewNodeID()
+	page := treenode.NewTree(files.box.ID, "/"+id+".sy", "/"+title, title)
+	paragraph := treenode.NewParagraph("")
+	paragraph.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(text)})
+	page.Root.AppendChild(paragraph)
+	writeTurnPage(t, page)
+	read, err := LoadTreeByBlockID(id)
+	if nil != err {
+		t.Fatal(err)
+	}
+	return read, treenode.GetNodeInTree(read, paragraph.ID)
+}
+
+// A ref-text refresh run in short turns (the ref-text job after a rename, the refresh after a block's attributes
+// change) reads its definitions again in each page's turn (currentDefNodes, since 6b80480), but it reads all of the
+// round's definitions in every turn, not the ones the page refers to. From its second round on, the definitions are
+// every reference the first round changed, on as many pages: a page that refers to one of them then holds the turn
+// while every one of those pages is read, and so does each database with a dynamic reference to one of them.
+//
+// Here the round's definitions are paragraph p on page R and paragraph x on page X, and page Q refers to p alone. X's
+// file is a named pipe, so a read of it waits until the test answers it: the test notes whether that read came while a
+// turn was held. Q's turn should read R, and never X.
+func TestStep6ChallengeLocksRound1RefTextTurnReadsOnlyTheDefinitionsItsPageRefersTo(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	dropRefTextRetries(t)
+
+	r, p := newChallengeDefPage(t, files, "R", "Text of p")
+	x, xNode := newChallengeDefPage(t, files, "X", "Text of x")
+	q, _ := newChallengeDefPage(t, files, "Q", "Q refers to p")
+	ref := addTurnRef(q, p.ID, "d", "Stale text")
+	writeTurnPage(t, q)
+
+	// X's file becomes a named pipe holding what the file held; its cached copy goes, so a read of X reads the pipe.
+	xPath := filepath.Join(util.DataDir, files.box.ID, x.Path)
+	xData, err := os.ReadFile(xPath)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if err = os.Remove(xPath); nil != err {
+		t.Fatal(err)
+	}
+	if err = syscall.Mkfifo(xPath, 0644); nil != err {
+		t.Fatal(err)
+	}
+	cache.RemoveTreeData(x.ID)
+
+	type xRead struct{ inTurn bool }
+	xReads := make(chan xRead, 1)
+	answered := make(chan struct{})
+	go func() {
+		defer close(answered)
+		// Opening the pipe to write waits until a reader opens it.
+		f, err := os.OpenFile(xPath, os.O_WRONLY, 0)
+		if nil != err {
+			return
+		}
+		inTurn := !flushLock.mu.TryLock()
+		if !inTurn {
+			flushLock.mu.Unlock()
+		}
+		xReads <- xRead{inTurn: inTurn}
+		_, _ = f.Write(xData)
+		_ = f.Close()
+	}()
+
+	defs := map[string]*ast.Node{p.ID: p, xNode.ID: xNode}
+	trees := map[string]*parse.Tree{r.ID: r, x.ID: x}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		refreshDynamicRefTextsWithWriter(inShortTurns, defs, trees, writeTreeUpsertQueue)
+	}()
+	select {
+	case <-done:
+	case <-time.After(60 * time.Second):
+		t.Fatal("the refresh didn't end within 60 s")
+	}
+
+	select {
+	case read := <-xReads:
+		t.Errorf("Q's refresh read page X, whose definition Q doesn't refer to (in a turn: %v): each turn reads every "+
+			"definition of the round", read.inTurn)
+	default:
+		// Nothing read X: open the pipe to read, so the writer above finishes.
+		if f, err := os.OpenFile(xPath, os.O_RDONLY|syscall.O_NONBLOCK, 0); nil == err {
+			_, _ = io.Copy(io.Discard, f)
+			_ = f.Close()
+		}
+	}
+	<-answered
+	// The pipe goes back to a file, for the fixture's cleanup.
+	_ = os.Remove(xPath)
+	_ = os.WriteFile(xPath, xData, 0644)
+
+	if got, want := refText(t, q.ID, ref.ID), p.ID+" Text of p"; want != got {
+		t.Errorf("after the refresh, Q's file holds the reference %q, want %q", got, want)
+	}
+}
