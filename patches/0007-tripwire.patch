+// siteOfSaveOnNextLine returns how the tripwire names a save made on the line after its caller's.
+func siteOfSaveOnNextLine() string {
+	pcs := make([]uintptr, 1)
+	runtime.Callers(2, pcs)
+	frame, _ := runtime.CallersFrames(pcs).Next()
+	name := frame.Function[strings.LastIndexByte(frame.Function, '/')+1:]
+	return fmt.Sprintf("%s %s:%d", name, filepath.Base(frame.File), frame.Line+1)
+}
+
+// The queue's flusher takes flushLock every 50 ms. With no job queued it runs nothing and saves nothing, so that tick is
+// no turn: a save outside a turn that lands in it is still logged. The test watches the turn for six ticks in a process
+// of its own, where nothing else takes flushLock.
+func TestTripwireTheFlushersEmptyTickIsNoTurn(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		if 0 < txQueueSize() {
+			t.Fatal("setup: a job is queued")
+		}
+		seen := 0
+		for deadline := time.Now().Add(300 * time.Millisecond); time.Now().Before(deadline); {
+			if tripwire.InTurn() {
+				seen++
+			}
+		}
+		if 0 < seen {
+			t.Fatalf("with no job queued, the turn was held at %d of the moments watched", seen)
+		}
+	})
+}
+
+// An existing page is saved three times, each from a site of its own: by a job's page write, while holding flushLock as
+// the writers that take turns with jobs do, and with no turn. Only the last is logged, and at the writer's own line:
+// the wrapper it saves through, writeTreeUpsertQueue, is passed over. Each site is checked for itself, since a site
+// stays logged for the rest of the process, as when the test runs again with -count.
+func TestTripwireLogsOnlyTheSaveMadeOutsideATurn(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	var jobSite string
+	tx := &Transaction{DoOperations: jobAttrsOperations(files)}
+	tx.writeTransactionTree = func(tree *parse.Tree) error {
+		jobSite = siteOfSaveOnNextLine()
+		return writeTreeUpsertQueue(tree)
+	}
+	if err := PerformTxSync(tx); nil != err {
+		t.Fatal(err)
+	}
+	if "" == jobSite {
+		t.Fatal("setup: the job wrote no page")
+	}
+	if _, ok := tripwire.Sites()[jobSite]; ok {
+		t.Fatalf("a job's page write was logged at %q", jobSite)
+	}
+
+	page := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath)
+	page.Root.SetIALAttr("custom-locked", "saved")
+	flushLock.Lock()
+	lockedSite := siteOfSaveOnNextLine()
+	err := writeTreeUpsertQueue(page)
+	flushLock.Unlock()
+	if nil != err {
+		t.Fatal(err)
+	}
+	if _, ok := tripwire.Sites()[lockedSite]; ok {
+		t.Fatalf("a page write holding flushLock was logged at %q", lockedSite)
+	}
+
+	// A save landing while another goroutine holds flushLock, as work the job started may, is taken for one made in a
+	// turn: the tripwire can't tell which goroutine holds it. So the save is made again until one lands outside every
+	// turn.
+	var outsideSite string
+	for i := range 50 {
+		page.Root.SetIALAttr("custom-outside", fmt.Sprint(i))
+		outsideSite = siteOfSaveOnNextLine()
+		if err = writeTreeUpsertQueue(page); nil != err {
+			t.Fatal(err)
+		}
+		if _, ok := tripwire.Sites()[outsideSite]; ok {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if kind, ok := tripwire.Sites()[outsideSite]; !ok || tripwire.Page != kind {
+		t.Fatalf("a page write outside a turn wasn't logged at %q: %v", outsideSite, tripwire.Sites())
+	}
+}
