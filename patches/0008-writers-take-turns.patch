+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// FlushTxQueue returns once the jobs queued before it have run: polka's flush (/api/sqlite/flushTransaction) calls it
+// after each /api/transactions, then flushes SQL and reads back what the job wrote. A writer's turn runs the jobs
+// queued before it (takeTurn). While it has taken them off the queue and not yet run them, the queue is empty, so
+// isFlushing must already say that jobs are being applied, as the flusher and PerformTransactionSync set it before they
+// take the queue.
+func TestStep6ChallengeLocksFlushTxQueueWaitsForTheJobsATurnHasTakenOffTheQueue(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	t.Cleanup(func() { testHookQueuedJobsTaken = nil })
+
+	for attempt := 1; attempt <= 50; attempt++ {
+		value := fmt.Sprintf("job %d", attempt)
+		tx := &Transaction{DoOperations: []*Operation{{Action: "setAttrs", ID: files.sourceID,
+			Data: fmt.Sprintf(`{"custom-queued":%q}`, value)}}}
+
+		var once sync.Once
+		taken := false
+		var flushedEarly bool
+		var held string
+		testHookQueuedJobsTaken = func() {
+			once.Do(func() {
+				taken = true
+				// The queued job is off the queue and hasn't run: FlushTxQueue must wait for it.
+				flushed := make(chan struct{})
+				go func() {
+					FlushTxQueue()
+					close(flushed)
+				}()
+				select {
+				case <-flushed:
+					flushedEarly = true
+					held = loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-queued")
+				case <-time.After(500 * time.Millisecond):
+				}
+			})
+		}
+
+		// The job is queued while the flusher can't take it, and a writer waits for the turn; once the flusher's mutex
+		// is let go, the writer that waited first usually gets it and runs the job. When the flusher wins, the hook
+		// isn't called, and the test tries again.
+		flushLock.mu.Lock()
+		PerformTransactions(&[]*Transaction{tx})
+		writerDone := make(chan struct{})
+		go func() {
+			defer close(writerDone)
+			release := takeTurn()
+			release()
+		}()
+		time.Sleep(20 * time.Millisecond)
+		flushLock.mu.Unlock()
+		select {
+		case <-writerDone:
+		case <-time.After(30 * time.Second):
+			t.Fatal("the writer's turn didn't end")
+		}
+		tx.WaitForCommit()
+		testHookQueuedJobsTaken = nil
+
+		if !taken {
+			continue
+		}
+		if flushedEarly {
+			t.Errorf("FlushTxQueue returned while a writer's turn had taken a queued job off the queue and not yet run "+
+				"it: the page's file then held custom-queued=%q, want %q (attempt %d)", held, value, attempt)
+		}
+		return
+	}
+	t.Fatal("setup: in 50 attempts the flusher always took the queued job before the writer's turn")
+}
+
+// A probe, run only when SIYUAN_TEST_CHALLENGE_PROBE is set: without the hook, how often FlushTxQueue returns before a
+// job queued just before it has committed, while writers take turns in a loop, as polka's setBlockAttrs, background
+// refreshes and the reads that save do. It logs the count and asserts nothing.
+func TestStep6ChallengeLocksProbeFlushTxQueueReturnsBeforeAQueuedJobUnderTurns(t *testing.T) {
+	if "" == os.Getenv("SIYUAN_TEST_CHALLENGE_PROBE") {
+		t.Skip("a probe: set SIYUAN_TEST_CHALLENGE_PROBE to run it")
+	}
+	files := setupAttrsCacheTest(t)
+	stop := make(chan struct{})
+	var writers sync.WaitGroup
+	for range 2 {
+		writers.Add(1)
+		go func() {
+			defer writers.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				release := takeTurn()
+				release()
+			}
+		}()
+	}
+	early, total := 0, 0
+	for deadline := time.Now().Add(10 * time.Second); time.Now().Before(deadline); total++ {
+		tx := &Transaction{DoOperations: []*Operation{{Action: "setAttrs", ID: files.sourceID,
+			Data: fmt.Sprintf(`{"custom-probe":"%d"}`, total)}}}
+		PerformTransactions(&[]*Transaction{tx})
+		FlushTxQueue()
+		select {
+		case <-tx.completion.Load().done:
+		default:
+			early++
+		}
+		tx.WaitForCommit()
+	}
+	close(stop)
+	writers.Wait()
+	t.Logf("FlushTxQueue returned before the job queued just before it had committed %d times in %d", early, total)
+}
+
+// A probe, run only when SIYUAN_TEST_CHALLENGE_PROBE is set: the test writer's stress test of jobs and every writer,
+// followed by a check it lacks, that no goroutine of SiYuan's own is left once it ends. Caches and database pools that
+// the stress opens for the first time start goroutines that stay (ristretto's, database/sql's, ants'), so counting all
+// goroutines, as the locks stress test does, only works once they have started; this counts the goroutines with a frame
+// in model, other than the flusher and the test's own. Run it by name, with -locks-stress.
+func TestStep6ChallengeLocksProbeTurnsStressLeavesNoGoroutines(t *testing.T) {
+	if "" == os.Getenv("SIYUAN_TEST_CHALLENGE_PROBE") {
+		t.Skip("a probe: set SIYUAN_TEST_CHALLENGE_PROBE to run it")
+	}
+	TestTurnsStressJobsAndEveryWriter(t)
+	var left []string
+	for deadline := time.Now().Add(20 * time.Second); ; time.Sleep(100 * time.Millisecond) {
+		left = left[:0]
+		buf := make([]byte, 8<<20)
+		buf = buf[:runtime.Stack(buf, true)]
+		for _, goroutine := range strings.Split(string(buf), "\n\n") {
+			if strings.Contains(goroutine, "siyuan/kernel/model.") && !strings.Contains(goroutine, "model.flushQueue(") &&
+				!strings.Contains(goroutine, "model.TestStep6ChallengeLocksProbeTurnsStressLeavesNoGoroutines(") {
+				left = append(left, goroutine)
+			}
+		}
+		if 0 == len(left) || time.Now().After(deadline) {
+			break
+		}
+	}
+	t.Logf("goroutines of SiYuan's own left after the stress: %d", len(left))
+	if 0 < len(left) {
+		t.Errorf("%d goroutines of SiYuan's own were left after the stress:\n%s", len(left), strings.Join(left, "\n\n"))
+	}
+}
+
+// Asset relink holds the turn while it saves, and refreshes the dynamic refs to the pages it changed in that turn
+// (reloadProtyle with inTurn, since step 6). The test writer's deadlock tests cover the job's commit and the ref-text
+// retry; this is the third place SiYuan refreshes refs while it holds the turn. The relinked page holds a paragraph that
+// another page refers to with a dynamic ref, and that is a database's row.
+func TestStep6ChallengeLocksAssetRelinkRefreshesRefsInItsTurnWithoutDeadlock(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		f := setupTurnRefTextFixture(t)
+		previousWorkspace, previousHistory := util.WorkspaceDir, util.HistoryDir
+		util.WorkspaceDir = filepath.Dir(util.DataDir)
+		util.HistoryDir = filepath.Join(util.WorkspaceDir, "history")
+		t.Cleanup(func() { util.WorkspaceDir, util.HistoryDir = previousWorkspace, previousHistory })
+		for rel, data := range map[string]string{"assets/challenge-a.png": "source", "assets/challenge-b.webp": "target"} {
+			abs := filepath.Join(util.DataDir, filepath.FromSlash(rel))
+			if err := os.MkdirAll(filepath.Dir(abs), 0755); nil != err {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(abs, []byte(data), 0644); nil != err {
+				t.Fatal(err)
+			}
+		}
+
+		// The definition's text changes in the file, and a paragraph of the page links the asset the relink renames.
+		f.definition.FirstChild.Tokens = []byte("Relinked text")
+		linking := treenode.NewParagraph(ast.NewNodeID())
+		linking.AppendChild(&ast.Node{Type: ast.NodeTextMark, TextMarkType: "a", TextMarkAHref: "assets/challenge-a.png",
+			TextMarkTextContent: "the asset"})
+		f.target.Root.AppendChild(linking)
+		writeTurnPage(t, f.target)
+
+		var err error
+		requireFinishes(t, "asset relink, which refreshes refs in its turn", turnDeadlockWait, func() {
+			_, err = RelinkAsset("assets/challenge-a.png", "assets/challenge-b.webp", false)
+		})
+		if nil != err {
+			t.Fatalf("the relink failed: %v", err)
+		}
+		relinked := loadAttrsCachePageFile(t, f.files.box.ID, f.files.targetPath)
+		if node := treenode.GetNodeInTree(relinked, linking.ID); nil == node || nil == node.FirstChild ||
+			"assets/challenge-b.webp" != node.FirstChild.TextMarkAHref {
+			t.Fatal("setup: the relink didn't rename the page's link")
+		}
+		if got, want := refText(t, f.files.sourceID, f.ref.ID), f.definition.ID+" Relinked text"; want != got {
+			t.Errorf("setup: after the relink the referring page holds %q, want %q: the relink didn't refresh it", got, want)
+		}
+	})
+}
+
+// challengeLocksSubPages writes a page and n pages under it, indexed as SiYuan indexes pages, and returns its path.
+func challengeLocksSubPages(t *testing.T, files *fileOperationTestFixture, title string, n int) (parentPath string) {
+	t.Helper()
+	parentID := ast.NewNodeID()
+	parentPath = "/" + parentID + ".sy"
+	parent := treenode.NewTree(files.box.ID, parentPath, "/"+title, title)
+	trees := []*parse.Tree{parent}
+	for i := range n {
+		id := ast.NewNodeID()
+		name := fmt.Sprintf("%s %d", title, i)
+		sub := treenode.NewTree(files.box.ID, path.Join("/", parentID, id+".sy"), "/"+title+"/"+name, name)
+		sub.Root.FirstChild.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(fmt.Sprintf("Sub-page %d", i))})
+		trees = append(trees, sub)
+	}
+	for _, tree := range trees {
+		if _, err := filesys.WriteTree(tree); nil != err {
+			t.Fatal(err)
+		}
+		treenode.UpsertBlockTree(tree)
+	}
+	t.Cleanup(func() {
+		for _, tree := range trees {
+			cache.RemoveTreeData(tree.ID)
+		}
+	})
+	return
+}
+
+// jobWaitInTurn queues a job on the fixture's source page when hook is called, inside the writer's turn, and measures
+// how long the job waits for its commit. It gives the wait, and how long the writer took from its call.
+func jobWaitInTurn(t *testing.T, files *fileOperationTestFixture, hook *func(), write func() error) (jobWait, writerTook time.Duration) {
+	t.Helper()
+	var tx *Transaction
+	var queued time.Time
+	var once sync.Once
+	*hook = func() {
+		once.Do(func() {
+			tx = &Transaction{DoOperations: []*Operation{{Action: "setAttrs", ID: files.sourceID, Data: `{"custom-behind":"ran"}`}}}
+			queued = time.Now()
+			PerformTransactions(&[]*Transaction{tx})
+		})
+	}
+	defer func() { *hook = nil }()
+	start := time.Now()
+	var err error
+	runWriter(t, "the writer", func() { err = write() })
+	writerTook = time.Since(start)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if nil == tx {
+		t.Fatal("setup: the writer didn't reach its hook")
+	}
+	tx.WaitForCommit()
+	jobWait = time.Since(queued)
+	return
+}
+
+// How long a job, such as an edit in the editor, waits behind a move of a page with many sub-pages. moveDocs gives each
+// page it moves a turn of its own, and that turn re-indexes every page under it (moveTree reads each), so the job waits
+// for the whole subtree. On the image before step 6 a move holds no turn and the job doesn't wait.
+func TestStep6ChallengeLocksJobWaitBehindAMoveOfManySubPages(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	n := challengeLocksSubPageCount()
+	parentPath := challengeLocksSubPages(t, files, "Moved", n)
+	jobWait, took := jobWaitInTurn(t, files, &testHookMoveDocMoved, func() error {
+		return MoveDocs([]string{parentPath}, files.box.ID, files.targetPath, nil)
+	})
+	t.Logf("a job queued in the turn of a move of a page with %d sub-pages waited %s for its commit; the move took %s",
+		n, jobWait.Round(time.Millisecond), took.Round(time.Millisecond))
+	if limit := challengeLocksJobWaitLimit(); jobWait > limit {
+		t.Errorf("a job waited %s behind the move of a page with %d sub-pages, over %s", jobWait.Round(time.Millisecond), n, limit)
+	}
+}
+
+// How long a job waits behind the deletion of a page with many sub-pages: removeDoc copies the subtree to history,
+// reads every page under it for its database rows, and indexes the history, all in one turn.
+func TestStep6ChallengeLocksJobWaitBehindADeletionOfManySubPages(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	previousHistory := util.HistoryDir
+	util.HistoryDir = filepath.Join(filepath.Dir(util.DataDir), "history")
+	t.Cleanup(func() { util.HistoryDir = previousHistory })
+	n := challengeLocksSubPageCount()
+	parentPath := challengeLocksSubPages(t, files, "Deleted", n)
+	jobWait, took := jobWaitInTurn(t, files, &testHookPageDeletionChecked, func() error {
+		return RemoveDoc(files.box.ID, parentPath)
+	})
+	t.Logf("a job queued in the turn of a deletion of a page with %d sub-pages waited %s for its commit; the deletion took %s",
+		n, jobWait.Round(time.Millisecond), took.Round(time.Millisecond))
+	if limit := challengeLocksJobWaitLimit(); jobWait > limit {
+		t.Errorf("a job waited %s behind the deletion of a page with %d sub-pages, over %s", jobWait.Round(time.Millisecond), n, limit)
+	}
+}
+
+// challengeLocksSubPageCount is how many sub-pages the measurements make: 300, or SIYUAN_TEST_SUB_PAGES.
+func challengeLocksSubPageCount() int {
+	if n, err := strconv.Atoi(os.Getenv("SIYUAN_TEST_SUB_PAGES")); nil == err && 0 < n {
+		return n
+	}
+	return 300
+}
+
+// challengeLocksJobWaitLimit is how long the measurements let a job wait: 1 s, or SIYUAN_TEST_JOB_WAIT_LIMIT.
+func challengeLocksJobWaitLimit() time.Duration {
+	if d, err := time.ParseDuration(os.Getenv("SIYUAN_TEST_JOB_WAIT_LIMIT")); nil == err {
+		return d
+	}
+	return time.Second
+}
