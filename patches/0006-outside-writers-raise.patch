+// os.Remove, outside WriteTree and saveAttributeView, so nothing raises the version of the page or database it writes.
+// A page or database SiYuan read before keeps its cache entries current, and SiYuan serves them, older than the file:
+// getBlockAttrs and a page load give the page as it was, and every read of the database gives it as it was. Each test
+// below caches a page and a database through SiYuan's own reads, writes one of them with one of the tool's actions, and
+// reads it back through what SiYuan serves.
+
+const (
+	toolBoxID  = "20261017211000-toolbox"
+	toolPageID = "20261017211001-toolpag"
+	toolAVID   = "20261017211002-tooldbs"
+)
+
+// toolWriterFixture is a workspace with one notebook, holding one page whose root has custom-v=old, and one database
+// named Old table. Both have been read through SiYuan's own reads after a restart, so the page cache, the block
+// attribute cache and the database cache hold them.
+type toolWriterFixture struct {
+	pagePath    string // the page's file, relative to the workspace
+	avPath      string // the database's file, relative to the workspace
+	newPage     []byte // the page's file with custom-v=new
+	newDatabase []byte // the database's file named New table
+}
+
+func setupToolWriterTest(t *testing.T) *toolWriterFixture {
+	t.Helper()
+	previousConf := model.Conf
+	previousWorkspace, previousData, previousTemp := util.WorkspaceDir, util.DataDir, util.TempDir
+	previousHistory, previousConfDir, previousBlockTree := util.HistoryDir, util.ConfDir, util.BlockTreeDBPath
+	workspace := t.TempDir()
+	util.WorkspaceDir = workspace
+	util.DataDir = filepath.Join(workspace, "data")
+	util.TempDir = filepath.Join(workspace, "temp")
+	util.HistoryDir = filepath.Join(workspace, "history")
+	util.ConfDir = filepath.Join(workspace, "conf")
+	util.BlockTreeDBPath = filepath.Join(util.TempDir, "blocktree.db")
+	for _, dir := range []string{util.TempDir, util.ConfDir} {
+		if err := os.MkdirAll(dir, 0755); nil != err {
+			t.Fatal(err)
+		}
+	}
+	model.Conf = model.NewAppConf()
+	model.Conf.FileTree.Store(conf.NewFileTree())
+	model.Conf.Sync.Store(conf.NewSync())
+	model.Conf.NotebookCrypto = conf.NewNotebookCrypto()
+	treenode.InitBlockTree(true)
+	clearCaches := func() {
+		cache.ClearTreeCache()
+		cache.ClearBlocksIAL()
+		cache.ClearDocsIAL()
+		cache.RemoveAVData(toolAVID)
+	}
+	t.Cleanup(func() {
+		clearCaches()
+		treenode.CloseDatabase()
+		model.Conf = previousConf
+		util.WorkspaceDir, util.DataDir, util.TempDir = previousWorkspace, previousData, previousTemp
+		util.HistoryDir, util.ConfDir, util.BlockTreeDBPath = previousHistory, previousConfDir, previousBlockTree
+	})
+
+	box := &model.Box{ID: toolBoxID}
+	boxConf := conf.NewBoxConf()
+	boxConf.Name = "Work"
+	boxConf.Closed = false
+	if err := box.SaveConf(boxConf); nil != err {
+		t.Fatalf("setup: save the notebook's conf failed: %v", err)
+	}
+	tree := treenode.NewTree(toolBoxID, "/"+toolPageID+".sy", "/Page", "Page")
+	tree.Root.SetIALAttr("custom-v", "old")
+	if _, err := filesys.WriteTree(tree); nil != err {
+		t.Fatalf("setup: write the page failed: %v", err)
+	}
+	treenode.UpsertBlockTree(tree)
+	attrView := &av.AttributeView{ID: toolAVID, Spec: av.RichTextSpec, Name: "Old table",
+		KeyValues: []*av.KeyValues{{Key: &av.Key{ID: "20261017211003-blockky", Name: "Name", Type: av.KeyTypeBlock}}},
+		Views: []*av.View{{ID: "20261017211004-tablevw", Name: "Table", LayoutType: av.LayoutTypeTable,
+			Table: av.NewLayoutTable(), PageSize: av.ViewDefaultPageSize}},
+		RenderedViewables: map[string]av.Viewable{}}
+	if err := av.SaveAttributeView(attrView); nil != err {
+		t.Fatalf("setup: save the database failed: %v", err)
+	}
+
+	f := &toolWriterFixture{
+		pagePath: "data/" + toolBoxID + "/" + toolPageID + ".sy",
+		avPath:   "data/storage/av/" + toolAVID + ".json",
+	}
+	f.newPage = replaceToolJSONString(t, readToolFile(t, f.pagePath), "custom-v", "old", "new")
+	f.newDatabase = replaceToolJSONString(t, readToolFile(t, f.avPath), "name", "Old table", "New table")
+
+	// As after a restart, then SiYuan's own reads: getBlockAttrs loads the page, which fills the page cache and the
+	// block attribute cache, and a read of the database fills the database cache. One read each: a second fill of a
+	// key ristretto hasn't taken in yet is turned away, and the page cache then serves neither copy.
+	clearCaches()
+	if got := sql.GetBlockAttrs(toolPageID)["custom-v"]; "old" != got {
+		t.Fatalf("setup: getBlockAttrs gives the page custom-v=%q", got)
+	}
+	if attrView, err := av.ParseAttributeView(toolAVID); nil != err || "Old table" != attrView.Name {
+		t.Fatalf("setup: the database reads %v, %v", attrView, err)
+	}
+	waitToolCached(t, "the page cache doesn't serve the page", func() bool {
+		_, ok := cache.GetTreeDataInBox(toolPageID, toolBoxID)
+		return ok
+	})
+	waitToolCached(t, "the block attribute cache doesn't serve the page's attributes", func() bool {
+		return nil != cache.GetBlockIALInBox(toolPageID, toolBoxID)
+	})
+	waitToolCached(t, "the database cache doesn't serve the database", func() bool {
+		_, ok := cache.GetAVData(toolAVID)
+		return ok
+	})
+	return f
+}
+
+// waitToolCached waits up to 200 ms for the cache to take in what a read stored: ristretto takes a store in on a
+// goroutine of its own, and a read straight after it would miss and read the file, which would hide the fault.
+func waitToolCached(t *testing.T, what string, cached func() bool) {
+	t.Helper()
+	for deadline := time.Now().Add(200 * time.Millisecond); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		if cached() {
+			return
+		}
+	}
+	t.Fatalf("setup: %s", what)
+}
+
+func readToolFile(t *testing.T, workspacePath string) []byte {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(util.WorkspaceDir, filepath.FromSlash(workspacePath)))
+	if nil != err {
+		t.Fatalf("read %s failed: %v", workspacePath, err)
+	}
+	return data
+}
+
+// toolJSONString is "name":"value" as SiYuan writes it in workspacePath's file, on one line or indented.
+func toolJSONString(data []byte, name, value string) []byte {
+	for _, separator := range []string{":", ": "} {
+		if s := []byte(`"` + name + `"` + separator + `"` + value + `"`); bytes.Contains(data, s) {
+			return s
+		}
+	}
+	return nil
+}
+
+// replaceToolJSONString replaces "name":"old" with "name":"new" in a file SiYuan wrote.
+func replaceToolJSONString(t *testing.T, data []byte, name, old, new string) []byte {
+	t.Helper()
+	from := toolJSONString(data, name, old)
+	if nil == from {
+		t.Fatalf("setup: the file holds no %q: %q", name, old)
+	}
+	return bytes.Replace(data, from, bytes.Replace(from, []byte(`"`+old+`"`), []byte(`"`+new+`"`), 1), 1)
+}
+
+// requireToolFileHolds stops the test unless the file at workspacePath holds "name":"value": an action under test
+// that wrote nothing would make every read look stale.
+func requireToolFileHolds(t *testing.T, step, workspacePath, name, value string) {
+	t.Helper()
+	if nil == toolJSONString(readToolFile(t, workspacePath), name, value) {
+		t.Fatalf("%s: %s doesn't hold %s=%q", step, workspacePath, name, value)
+	}
+}
+
+// checkToolPage reads the page as SiYuan serves it, through getBlockAttrs and a page load, and wants custom-v=want,
+// which its file holds.
+func checkToolPage(t *testing.T, step, want string) {
+	t.Helper()
+	requireToolFileHolds(t, step, "data/"+toolBoxID+"/"+toolPageID+".sy", "custom-v", want)
+	if got := sql.GetBlockAttrs(toolPageID)["custom-v"]; want != got {
+		t.Errorf("%s: getBlockAttrs gives the page custom-v=%q, though its file holds %q", step, got, want)
+	}
+	tree, err := filesys.LoadTree(toolBoxID, "/"+toolPageID+".sy", util.NewLute())
+	if nil != err {
+		t.Errorf("%s: load the page failed: %v", step, err)
+		return
+	}
+	if got := tree.Root.IALAttr("custom-v"); want != got {
+		t.Errorf("%s: the page loads with custom-v=%q, though its file holds %q", step, got, want)
+	}
+}
+
+// checkToolDatabase reads the database as every operation on it starts, and wants its name to be want, which its file
+// holds.
+func checkToolDatabase(t *testing.T, step, want string) {
+	t.Helper()
+	requireToolFileHolds(t, step, "data/storage/av/"+toolAVID+".json", "name", want)
+	attrView, err := av.ParseAttributeView(toolAVID)
+	if nil != err || nil == attrView {
+		t.Errorf("%s: read the database failed: %v", step, err)
+		return
+	}
+	if want != attrView.Name {
+		t.Errorf("%s: the database reads with the name %q, though its file holds %q", step, attrView.Name, want)
+	}
+}
+
+// callFileTool runs one action of the MCP file tool and wants it to succeed.
+func callFileTool(t *testing.T, args map[string]any) {
+	t.Helper()
+	result, err := fileHandler(args)
+	if nil != err || result.IsError {
+		t.Fatalf("file tool %v failed: %s, %v", args["action"], probeText(result), err)
+	}
+}
+
+// stageToolFile writes data at a workspace path outside data/, where nothing caches, for the tool to copy or rename
+// from.
+func stageToolFile(t *testing.T, workspacePath string, data []byte) {
+	t.Helper()
+	writeProbeFile(t, filepath.Join(util.WorkspaceDir, filepath.FromSlash(workspacePath)), string(data))
+}
+
+// Each of the MCP file tool's actions that write, on a page's file or a database's file: write and copy over the
+// database (a plain write with os.WriteFile, a copy with the tool's own copyFile), write and edit of the page (edit
+// through util.MutateTextFile, which the tool also uses for conditional writes), rename of a new copy over the page
+// (os.Rename replaces it), and delete of the page, after which getBlockAttrs must give the page no attributes, since
+// its file holds nothing. On v3.8.7 and step 3 none of them raises anything.
+func TestFileToolWritesServeWhatTheToolWrote(t *testing.T) {
+	t.Run("write a page", func(t *testing.T) {
+		f := setupToolWriterTest(t)
+		callFileTool(t, map[string]any{"action": "write", "path": f.pagePath, "data": string(f.newPage)})
+		checkToolPage(t, "after the tool's write", "new")
+	})
+	t.Run("write a database", func(t *testing.T) {
+		f := setupToolWriterTest(t)
+		callFileTool(t, map[string]any{"action": "write", "path": f.avPath, "data": string(f.newDatabase)})
+		checkToolDatabase(t, "after the tool's write", "New table")
+	})
+	t.Run("edit a page", func(t *testing.T) {
+		f := setupToolWriterTest(t)
+		page := readFilePage(t, map[string]any{"path": f.pagePath, "lineLimit": -1})
+		oldText := string(toolJSONString(readToolFile(t, f.pagePath), "custom-v", "old"))
+		newText := string(toolJSONString(f.newPage, "custom-v", "new"))
+		callFileTool(t, map[string]any{"action": "edit", "path": f.pagePath, "expectedRevision": page.Revision,
+			"edits": []any{map[string]any{"oldText": oldText, "newText": newText}}})
+		checkToolPage(t, "after the tool's edit", "new")
+	})
+	t.Run("copy over a database", func(t *testing.T) {
+		f := setupToolWriterTest(t)
+		stageToolFile(t, "stage/"+toolAVID+".json", f.newDatabase)
+		callFileTool(t, map[string]any{"action": "copy", "src": "stage/" + toolAVID + ".json", "dst": f.avPath})
+		checkToolDatabase(t, "after the tool's copy", "New table")
+	})
+	t.Run("rename over a page", func(t *testing.T) {
+		f := setupToolWriterTest(t)
+		stageToolFile(t, "stage/"+toolPageID+".sy", f.newPage)
+		callFileTool(t, map[string]any{"action": "rename", "old": "stage/" + toolPageID + ".sy", "new": f.pagePath})
+		checkToolPage(t, "after the tool's rename", "new")
+	})
+	t.Run("delete a page", func(t *testing.T) {
+		f := setupToolWriterTest(t)
+		callFileTool(t, map[string]any{"action": "delete", "path": f.pagePath})
+		if _, err := os.Stat(filepath.Join(util.WorkspaceDir, filepath.FromSlash(f.pagePath))); !os.IsNotExist(err) {
+			t.Fatalf("setup: the tool's delete left the page's file: %v", err)
+		}
+		if got := sql.GetBlockAttrs(toolPageID); 0 < len(got) {
+			t.Errorf("after the tool's delete, getBlockAttrs gives the page the attributes %v, though its file is gone", got)
+		}
+	})
+}
