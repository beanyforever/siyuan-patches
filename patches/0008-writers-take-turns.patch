+
+//go:build fts5
+
+package model
+
+// Challenges to fix round 3 of step 6 of issue #43, on lost writes: the one-page snapshot restore's touch of a file
+// dated ahead of the clock.
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// round3ModTime gives the modification time of file p.
+func round3ModTime(t *testing.T, p string) time.Time {
+	t.Helper()
+	info, err := os.Stat(p)
+	if nil != err {
+		t.Fatal(err)
+	}
+	return info.ModTime()
+}
+
+// round3CheckKept fails the test when neither the page nor the latest snapshot's copy of it holds turnJobAttr=kept.
+func round3CheckKept(t *testing.T, boxID, pagePath, what string) {
+	t.Helper()
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	inPage := pageFile(t, restoreCachePageID).Root.IALAttr(turnJobAttr)
+	latest, err := repo.Latest()
+	if nil != err {
+		t.Fatal(err)
+	}
+	_, inBackup := round1SnapshotPage(t, repo, latest.ID, boxID, pagePath, turnJobAttr)
+	if "kept" != inPage && "kept" != inBackup {
+		t.Errorf("%s is lost by the one-page snapshot restore: the page holds %s=%q, and the latest snapshot %q (%s) "+
+			"holds %q; want \"kept\" in one of them", what, turnJobAttr, inPage, latest.Memo, latest.ID, inBackup)
+	}
+}
+
+// Fix round 3 dates a file dated ahead of the clock one second past its own date at once, instead of waiting for the
+// clock to pass that date. That date is then ahead of the clock too, so a save made after the backup copied the file
+// can be dated, by the clock, before the copy's second: in the file's old second, when the file was dated ahead by
+// less than the time the backup took. The restore's turn finds the save and backs up again, but the second touch dates
+// the file one second past the save's second, which is the first touch's second, the second of the copy the first
+// backup holds. dejavu then takes the file as unchanged, the second backup leaves the save out, the turn finds nothing
+// saved since its note, and the restore writes the snapshot's copy over the save. Round 2 waited for the clock to pass
+// the second after the file's date before the first backup, so a save after it was dated past the copy's second.
+//
+// The scenario: the file is dated half a second to a second and a half ahead (a clock stepped back, a file system's
+// clock slightly ahead, or putFile with a modTime a little ahead), the owner restores the page from the history
+// panel, and polka sets a property while the restore backs up.
+func TestStep6ChallengeWritesRound3OnePageSnapshotRestoreKeepsASaveAfterItsBackupOfAPageDatedAhead(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	repo := round1SetupRepo(t)
+	pageAbs := filepath.Join(util.DataDir, boxID, pagePath)
+	snapshotID, err := IndexRepo("before the Type changed")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	fileID, _ := round1SnapshotPage(t, repo, snapshotID, boxID, pagePath, turnJobAttr)
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no copy of the page")
+	}
+	setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "task")
+	FlushTxQueue()
+
+	// Just after a second begins, the page's file is dated in the next second, X.
+	for 50*time.Millisecond < time.Duration(time.Now().Nanosecond()) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	x := time.Now().Truncate(time.Second).Add(time.Second)
+	ahead := x.Add(500 * time.Millisecond)
+	if err = os.Chtimes(pageAbs, ahead, ahead); nil != err {
+		t.Fatal(err)
+	}
+
+	// After the first backup, once the clock is in second X, polka sets a property: SiYuan dates the save by the clock.
+	backups := 0
+	var savedAt time.Time
+	testHookRollbackRepoSnapshotFileBackedUp = func() {
+		backups++
+		if 1 != backups || !time.Now().Before(x.Add(800*time.Millisecond)) {
+			return
+		}
+		for time.Now().Before(x.Add(50 * time.Millisecond)) {
+			time.Sleep(5 * time.Millisecond)
+		}
+		setRestoreCacheAttr(t, restoreCachePageID, turnJobAttr, "kept")
+		savedAt = round3ModTime(t, pageAbs)
+	}
+	t.Cleanup(func() { testHookRollbackRepoSnapshotFileBackedUp = nil })
+
+	if err = RollbackRepoSnapshotFile(fileID); nil != err {
+		t.Fatalf("roll the page back to the snapshot failed: %v", err)
+	}
+	if savedAt.IsZero() {
+		t.Fatalf("setup: the first backup ended after %s, too late for a save dated in the file's second", x.Add(800*time.Millisecond).Format("15:04:05.000"))
+	}
+	if savedAt.Unix() != x.Unix() || 2 > backups {
+		t.Fatalf("setup: the save is dated %s, want in second %s, and the restore backed up %d times, want 2",
+			savedAt.Format("15:04:05.000"), x.Format("15:04:05"), backups)
+	}
+	checkPageAttr(t, "after the one-page snapshot restore", restoreCachePageID, "custom-object-type", "note")
+	round3CheckKept(t, boxID, pagePath, "a save made after the restore's first backup, in the second of the file it saved over (dated ahead)")
+}
+
+// The touch dates a file dated ahead to the start of the second after its date, without looking at the copy the
+// latest snapshot holds. When a write dated the file back from that second to the one before, as /api/file/putFile
+// with its caller's modTime does, the touch puts the file back in the latest copy's second, and the backup leaves the
+// write out; the restore then writes over it. Without the touch, as on the official build, the file's own second
+// differs from the copy's, and the backup takes it. Round 2 has the same fault, after waiting for the clock to reach
+// that second.
+func TestStep6ChallengeWritesRound3OnePageSnapshotRestoreKeepsAWriteDatedBackWhileAhead(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	repo := round1SetupRepo(t)
+	pageAbs := filepath.Join(util.DataDir, boxID, pagePath)
+	snapshotID, err := IndexRepo("before the Type changed")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	fileID, _ := round1SnapshotPage(t, repo, snapshotID, boxID, pagePath, turnJobAttr)
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no copy of the page")
+	}
+
+	// putFile writes the page dated in second X+1, 20 s ahead, and a snapshot copies it.
+	x := time.Now().Add(20 * time.Second).Truncate(time.Second)
+	setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "task")
+	FlushTxQueue()
+	first := x.Add(1500 * time.Millisecond)
+	if err = os.Chtimes(pageAbs, first, first); nil != err {
+		t.Fatal(err)
+	}
+	if _, err = IndexRepo("automatic snapshot"); nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+
+	// putFile then writes it again with a modTime in second X: the save, then the date putFile gives it.
+	setRestoreCacheAttr(t, restoreCachePageID, turnJobAttr, "kept")
+	FlushTxQueue()
+	second := x.Add(500 * time.Millisecond)
+	if err = os.Chtimes(pageAbs, second, second); nil != err {
+		t.Fatal(err)
+	}
+
+	if err = RollbackRepoSnapshotFile(fileID); nil != err {
+		t.Fatalf("roll the page back to the snapshot failed: %v", err)
+	}
+	checkPageAttr(t, "after the one-page snapshot restore", restoreCachePageID, "custom-object-type", "note")
+	round3CheckKept(t, boxID, pagePath, "a write dated back by one second, while ahead of the clock,")
+}
diff --git a/kernel/model/turns_challenge_writes_r4_fts5_test.go b/kernel/model/turns_challenge_writes_r4_fts5_test.go
