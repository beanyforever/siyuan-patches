+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package filesys
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// Neither of the page cache's fills serves what it read once a save of the page has landed between its read and its
+// store: a LoadTree that missed the cache, and a WriteTree that finds the file already holds its bytes, so skips
+// writing and caches what it read. After the race the next load gives the save, and the next edit, which loads the page
+// from the cache and saves it, keeps the save in the file. A test hook places the save between each fill's read of the
+// file and its store, after the save's own copy is in the cache, so the race goes the bad way every time. Unlike
+// TestTreeFillRacesWrite, this reaches WriteTree's fill, whose read and store are too close together to race from a
+// test.
+func TestTreeFillsRacingASaveServeTheSave(t *testing.T) {
+	cases := []struct {
+		name string
+		hook *func()
+		read func(t *testing.T, tree *parse.Tree)
+	}{
+		{"LoadTree", &testHookLoadTreeFill, func(t *testing.T, tree *parse.Tree) {
+			if _, err := LoadTree(tree.Box, tree.Path, util.NewLute()); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{"WriteTree of the bytes the file holds", &testHookWriteTreeSkipFill, func(t *testing.T, tree *parse.Tree) {
+			if size, err := WriteTree(tree); err != nil || 0 != size {
+				t.Fatalf("a WriteTree of the bytes the file holds wrote %d bytes: %v", size, err)
+			}
+		}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			box, root, _, _ := setupStalePathTest(t)
+			tree := treenode.NewTree(box, "/"+root+".sy", "/Page", "Page")
+			tree.Root.SetIALAttr("custom-n", "before")
+			if _, err := WriteTree(tree); err != nil {
+				t.Fatal(err)
+			}
+			filePath := filepath.Join(util.DataDir, box, tree.Path)
+			readFile := func() *parse.Tree {
+				t.Helper()
+				data, err := os.ReadFile(filePath)
+				if err != nil {
+					t.Fatal(err)
+				}
+				ret, err := LoadTreeByData(data, box, tree.Path, util.NewLute())
+				if err != nil {
+					t.Fatal(err)
+				}
+				return ret
+			}
+			saved := readFile()
+			saved.Root.SetIALAttr("custom-n", "saved")
+			cache.RemoveTreeDataInBox(tree.ID, box) // as after a restart: the next read misses
+
+			fired := false
+			*c.hook = func() {
+				if fired {
+					return
+				}
+				fired = true
+				if _, err := WriteTree(saved); err != nil {
+					t.Error(err)
+				}
+				// The save's own copy is in the cache before the fill stores, as when the fill parses a large page.
+				for deadline := time.Now().Add(time.Second); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+					if raw, ok := cache.GetTreeDataInBox(tree.ID, box); ok && bytes.Contains(raw, []byte(`"saved"`)) {
+						break
+					}
+				}
+			}
+			t.Cleanup(func() { *c.hook = nil })
+			c.read(t, tree)
+			*c.hook = nil
+			if !fired {
+				t.Fatal("setup: the read didn't fill the page cache")
+			}
+			if got := readFile().Root.IALAttr("custom-n"); "saved" != got {
+				t.Fatalf("setup: the file holds custom-n=%q, not the save", got)
+			}
+			time.Sleep(5 * time.Millisecond) // let ristretto take queued sets in
+
+			loaded, err := LoadTree(box, tree.Path, util.NewLute())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := loaded.Root.IALAttr("custom-n"); "saved" != got {
+				t.Errorf("the next load gives custom-n=%q, what the fill read before the save, though the file holds the save", got)
+			}
+			// The next edit loads the page as SiYuan does, from the cache first, and saves it.
+			loaded.Root.SetIALAttr("custom-other", "edited")
+			if _, err = WriteTree(loaded); err != nil {
+				t.Fatal(err)
+			}
+			if got := readFile().Root.IALAttr("custom-n"); "saved" != got {
+				t.Errorf("the next edit saved custom-n=%q over the save", got)
+			}
+		})
+	}
+}
