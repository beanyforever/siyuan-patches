+// newTripwireDatabase saves a new database, its first save, and returns it.
+func newTripwireDatabase(t *testing.T, id, name string) *av.AttributeView {
+	t.Helper()
+	ret := newTripwireAttributeView(t, id, name)
+	if err := av.SaveAttributeView(ret); nil != err {
+		t.Fatal(err)
+	}
+	requireTripwireFileHolds(t, "the new database", av.GetAttributeViewDataPath(id), name)
+	return ret
+}
