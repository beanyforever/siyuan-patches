+package cache
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dgraph-io/ristretto"
+)
+
+// Two puts of a block's or a document's attributes back to back, the second before the cache has taken in the first,
+// as making a row with "+ New" does: once both have returned, a read gives the second. ristretto queues a put of a key
+// it doesn't hold yet, and then turns away a second put of that key as one it already holds, so without waiting the
+// read gives the first put's attributes, here a page's from before it was bound to its row.
+func TestIALCacheKeepsLatestPut(t *testing.T) {
+	cases := []struct {
+		name  string
+		put   func(id, boxID string, ial map[string]string)
+		get   func(id, boxID string) map[string]string
+		wait  func()
+		clear func()
+	}{
+		{"block", PutBlockIALInBox, GetBlockIALInBox, blockIALCache.Wait, ClearBlocksIAL},
+		{"document", PutDocIALInBox, GetDocIALInBox, docIALCache.Wait, ClearDocsIAL},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			t.Cleanup(c.clear)
+			for i := range 100 {
+				id := fmt.Sprintf("20261016090000-latest%d", i)
+				c.put(id, "box", map[string]string{"id": id})
+				c.put(id, "box", map[string]string{"id": id, "custom-avs": "20261016090000-database"})
+				c.wait() // whatever the cache still has queued, it has now taken in
+				if got := c.get(id, "box"); got["custom-avs"] != "20261016090000-database" {
+					t.Fatalf("after two puts of %s, a read gave %v, not the second put's attributes", id, got)
+				}
+			}
+		})
+	}
+}
+
+// A write ristretto turns away, here for want of room, leaves no older copy of the block's attributes to read. An
+// edit stores a block's attributes under its bare key; setBlockAttrs then stores newer ones under the block's
+// notebook key. If the cache turns that write away, reads fall back to the bare key and serve the edit's older copy,
+// which still says custom-object-type=note, unless the write drops the block's other keys, so reads go to the file.
+func TestIALCacheTurnedAwayWriteLeavesNoOlderCopy(t *testing.T) {
+	controlled, err := ristretto.NewCache(&ristretto.Config{NumCounters: 100, MaxCost: 2048, BufferItems: 64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := blockIALCache
+	blockIALCache = controlled
+	t.Cleanup(func() {
+		ClearBlocksIAL()
+		controlled.Close()
+		blockIALCache = original
+	})
+
+	const id, boxID = "20261016090000-turned1", "20261016090000-notebk1"
+	// Each copy costs more than half the cache, so the cache can't hold both.
+	pad := strings.Repeat("x", 600)
+	older := map[string]string{"id": id, "custom-object-type": "note", "custom-pad": pad}
+	newer := map[string]string{"id": id, "custom-object-type": "task", "custom-pad": pad}
+
+	// Whether ristretto turns the write away depends on its admission policy's timing, so set it up a few times, and
+	// skip rather than fail if it never does: that says nothing about the fix.
+	refused := false
+	for attempt := 0; 5 > attempt && !refused; attempt++ {
+		ClearBlocksIAL()
+		PutBlockIAL(id, older) // an edit's write, under the bare key
+		controlled.Wait()      // without the fix the put is still queued
+		if got := GetBlockIAL(id); got["custom-object-type"] != "note" {
+			continue
+		}
+		// Reads of the edit's copy make it look busier to ristretto's admission policy than a key it has never seen.
+		// The policy counts reads in batches on its own goroutine, and drops a batch while it is busy, so read in
+		// bursts and give it time to count them.
+		for range 20 {
+			for range 256 {
+				GetBlockIAL(id)
+			}
+			time.Sleep(time.Millisecond)
+		}
+		time.Sleep(10 * time.Millisecond)
+
+		PutBlockIALInBox(id, boxID, newer) // setBlockAttrs' write, under the notebook key
+		controlled.Wait()
+		refused = nil == GetBlockIALInBox(id, boxID)
+	}
+	if !refused {
+		t.Skip("ristretto took the write in on every try, so this run can't show what a turned-away write leaves")
+	}
+
+	if got := GetBlockIALWithBoxFallback(id, boxID); nil != got {
+		t.Fatalf("after a write the cache turned away, a read served an older copy, custom-object-type=%q, "+
+			"rather than missing so that it reads the file", got["custom-object-type"])
+	}
+}
