+// treeVersions and treeWriting say, per page id, when the page was last written or removed from this cache, and how
+// many writes of its file are under way. A load storing what it read bumps neither, so they tell a block attribute
+// fill whether the page it read the block from may have changed since its FillToken (TreeFresh). treeCacheKeysMu
+// guards them.
+var treeVersions = newFillVersions()
+var treeWriting = map[string]int{}
+
+// BeginTreeWrite and EndTreeWrite bracket a write of page rootID's file. A page write changes its blocks' attributes
+// without bumping their versions, so a block fill checks the page's as well.
+func BeginTreeWrite(rootID string) {
+	treeCacheKeysMu.Lock()
+	defer treeCacheKeysMu.Unlock()
+	treeVersions.bump(rootID)
+	treeWriting[rootID]++
+}
+
+func EndTreeWrite(rootID string) {
+	treeCacheKeysMu.Lock()
+	defer treeCacheKeysMu.Unlock()
+	if n := treeWriting[rootID] - 1; 0 < n {
+		treeWriting[rootID] = n
+	} else {
+		delete(treeWriting, rootID)
+	}
+	treeVersions.bump(rootID)
+}
+
+// TreeFresh reports whether page rootID's file is not being written and nothing wrote it or removed it from this cache
+// since token, so that what a reader that took token loaded from the page is still current.
+func TreeFresh(rootID string, token FillToken) bool {
+	treeCacheKeysMu.Lock()
+	defer treeCacheKeysMu.Unlock()
+	return 0 == treeWriting[rootID] && treeVersions.fresh(rootID, token)
+}
+
 func RemoveTreeData(rootID string) {
 	treeCacheKeysMu.Lock()
 	defer treeCacheKeysMu.Unlock()
+	treeVersions.bump(rootID)
 	keys := treeCacheKeys[rootID]
 	delete(treeCacheKeys, rootID)
 
@@ -136,6 +172,7 @@ func RemoveTreeDataInBox(rootID, boxID string) {
 	key := treeCacheKey(rootID, boxID)
 	treeCacheKeysMu.Lock()
 	defer treeCacheKeysMu.Unlock()
+	treeVersions.bump(rootID)
 	treeCache.Del(key)
 	if keys := treeCacheKeys[rootID]; keys != nil {
 		delete(keys, key)
@@ -148,6 +185,7 @@ func RemoveTreeDataInBox(rootID, boxID string) {
 func ClearTreeCache() {
 	treeCacheKeysMu.Lock()
 	defer treeCacheKeysMu.Unlock()
+	treeVersions.reset()
 	treeCacheKeys = map[string]map[string]uint64{}
 	treeCache.Clear()
 }
