+	"github.com/siyuan-note/siyuan/kernel/tripwire"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// turnWriterStarted runs write on a goroutine while the test holds flushLock, as a job does. It reports whether write
+// finished while the lock was held, then releases it and waits for write to finish, failing the test if it doesn't.
+func turnWriterStarted(t *testing.T, write func()) (finishedInOurTurn bool) {
+	t.Helper()
+	flushLock.Lock()
+	release := flushLock.Unlock
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		write()
+	}()
+	select {
+	case <-done:
+		finishedInOurTurn = true
+	case <-time.After(300 * time.Millisecond):
+	}
+	release()
+	select {
+	case <-done:
+	case <-time.After(30 * time.Second):
+		t.Fatal("the writer didn't finish once the turn was released")
+	}
+	return
+}
+
+func readTurnTestFile(t *testing.T, p string) []byte {
+	t.Helper()
+	data, err := os.ReadFile(p)
+	if nil != err {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// takeTurn runs the jobs queued before it, and its holder has the turn: no job runs until it releases. A job is queued
+// while the flusher can't run; once the turn is taken the job has run, whoever ran it.
+func TestTakeTurnRunsTheQueuedJobsFirst(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	flushLock.mu.Lock()
+	tx := &Transaction{DoOperations: []*Operation{{Action: "setAttrs", ID: files.sourceID, Data: `{"custom-queued":"ran"}`}}}
+	PerformTransactions(&[]*Transaction{tx})
+	flushLock.mu.Unlock()
+
+	release := takeTurn()
+	queued, inTurn, flushing := txQueueSize(), tripwire.InTurn(), isFlushing.Load()
+	got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-queued")
+	release()
+	if 0 != queued {
+		t.Errorf("%d jobs were still queued in the turn", queued)
+	}
+	if "ran" != got {
+		t.Errorf("in the turn the page's file held custom-queued=%q, before the queued job ran", got)
+	}
+	if !inTurn {
+		t.Error("the turn's holder isn't in a turn")
+	}
+	// The queued jobs have run, so FlushTxQueue's callers don't wait for the writer's own work.
+	if flushing {
+		t.Error("isFlushing stayed set after the queued jobs ran")
+	}
+	tx.WaitForCommit()
+}
+
+// A job queued while a writer has the turn waits for the writer to release it.
+func TestTakeTurnKeepsJobsOutUntilItsRelease(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	release := takeTurn()
+	tx := &Transaction{DoOperations: []*Operation{{Action: "setAttrs", ID: files.sourceID, Data: `{"custom-queued":"ran"}`}}}
+	PerformTransactions(&[]*Transaction{tx})
+	time.Sleep(200 * time.Millisecond)
+	during := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-queued")
+	release()
+	tx.WaitForCommit()
+	if "" != during {
+		t.Errorf("a job ran during another writer's turn: custom-queued=%q", during)
+	}
+	if got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-queued"); "ran" != got {
+		t.Errorf("the job didn't run after the turn was released: custom-queued=%q", got)
+	}
+}
+
+// A writer that panics in its turn gives the turn back.
+func TestWithTurnGivesTheTurnBackWhenTheWriterPanics(t *testing.T) {
+	func() {
+		defer func() { _ = recover() }()
+		_ = withTurn(func() error { panic("writer failed") })
+	}()
+	taken := make(chan struct{})
+	go func() {
+		release := takeTurn()
+		release()
+		close(taken)
+	}()
+	select {
+	case <-taken:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the turn wasn't given back after the writer panicked")
+	}
+	if isFlushing.Load() {
+		t.Error("isFlushing was left set")
+	}
+}
+
+// Each writer on step 6's list takes the turn before it reads what it saves: started while another writer has the
+// turn, it neither finishes nor changes its file until that turn is released.
+func TestWritersWaitForTheTurnBeforeTheyRead(t *testing.T) {
+	t.Run("setBlockAttrs", func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		if turnWriterStarted(t, func() {
+			if err := SetBlockAttrs(files.sourceID, map[string]string{"custom-turn": "set"}); nil != err {
+				t.Error(err)
+			}
+		}) {
+			t.Error("SetBlockAttrs finished during another writer's turn")
+		}
+		if got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-turn"); "set" != got {
+			t.Errorf("SetBlockAttrs didn't save: custom-turn=%q", got)
+		}
+	})
+	t.Run("batchSetBlockAttrs", func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		if turnWriterStarted(t, func() {
+			if err := BatchSetBlockAttrs([]map[string]any{{"id": files.sourceID, "attrs": map[string]string{"custom-turn": "set"}}}); nil != err {
+				t.Error(err)
+			}
+		}) {
+			t.Error("BatchSetBlockAttrs finished during another writer's turn")
+		}
+		if got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("custom-turn"); "set" != got {
+			t.Errorf("BatchSetBlockAttrs didn't save: custom-turn=%q", got)
+		}
+	})
+	t.Run("renameDoc", func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		if turnWriterStarted(t, func() {
+			if err := RenameDoc(files.box.ID, files.sourcePath, "Renamed in its turn"); nil != err {
+				t.Error(err)
+			}
+		}) {
+			t.Error("RenameDoc finished during another writer's turn")
+		}
+		if got := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath).Root.IALAttr("title"); "Renamed in its turn" != got {
+			t.Errorf("RenameDoc didn't save: title=%q", got)
+		}
+	})
+	t.Run("removeDoc", func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		p := filepath.Join(util.DataDir, files.box.ID, files.targetPath)
+		if turnWriterStarted(t, func() {
+			if err := RemoveDoc(files.box.ID, files.targetPath); nil != err {
+				t.Error(err)
+			}
+		}) {
+			t.Error("RemoveDoc finished during another writer's turn")
+		}
+		if _, err := os.Stat(p); !os.IsNotExist(err) {
+			t.Errorf("RemoveDoc didn't remove the page: %v", err)
+		}
+	})
+	t.Run("moveDocs", func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		if turnWriterStarted(t, func() {
+			if err := MoveDocs([]string{files.sourcePath}, files.box.ID, files.targetPath, nil); nil != err {
+				t.Error(err)
+			}
+		}) {
+			t.Error("MoveDocs finished during another writer's turn")
+		}
+		moved := filepath.Join(util.DataDir, files.box.ID, strings.TrimSuffix(files.targetPath, ".sy"), files.sourceID+".sy")
+		if _, err := os.Stat(moved); nil != err {
+			t.Errorf("MoveDocs didn't move the page: %v", err)
+		}
+	})
+	t.Run("updateAttributeViewBlockText", func(t *testing.T) {
+		files, view := setupTurnReadSaveTest(t)
+		tree, err := LoadTreeByBlockID(files.targetID)
+		if nil != err {
+			t.Fatal(err)
+		}
+		tree.Root.SetIALAttr("icon", "1f600")
+		if _, err = filesys.WriteTree(tree); nil != err {
+			t.Fatal(err)
+		}
+		if turnWriterStarted(t, func() {
+			updateAttributeViewBlockText(map[string]*ast.Node{tree.Root.ID: tree.Root})
+		}) {
+			t.Error("updateAttributeViewBlockText finished during another writer's turn")
+		}
+		for _, value := range readAttributeViewItemsTest(t, view.ID).GetBlockKeyValues().Values {
+			if files.targetID == value.Block.ID && "1f600" != value.Block.Icon {
+				t.Errorf("updateAttributeViewBlockText didn't save the row's icon: %q", value.Block.Icon)
+			}
+		}
+	})
+}
+
+// setupTurnReadSaveTest is a database with four rows, one bound to the fixture's target page, shown by a database
+// block, the source page's id standing for it, and its fields in order.
+func setupTurnReadSaveTest(t *testing.T) (*fileOperationTestFixture, *av.AttributeView) {
+	t.Helper()
+	files, view, _, _ := setupAttributeViewItemsTest(t, true)
+	av.UpsertBlockRel(view.ID, files.sourceID)
+	refreshAttrViewKeyIDs(view)
+	if err := av.SaveAttributeView(view); nil != err {
+		t.Fatal(err)
+	}
+	return files, readAttributeViewItemsTest(t, view.ID)
+}
+
+// Reads that save read without the turn: with nothing to correct they neither wait for another writer's turn nor
+// save the database. Each read runs once first, to make the corrections the fixture's database needs.
+func TestReadsThatSaveDontWaitForTheTurn(t *testing.T) {
+	files, view := setupTurnReadSaveTest(t)
+	reads := map[string]func(){
+		"getAttributeViewKeys": func() {
+			if got := GetBlockAttributeViewKeys(files.targetID); 1 != len(got) {
+				t.Errorf("getAttributeViewKeys gave %d databases, want 1", len(got))
+			}
+		},
+		"getAttributeViewPrimaryKeyValues": func() {
+			if _, _, _, _, err := GetAttributeViewPrimaryKeyValues(view.ID, "", nil, 1, 16); nil != err {
+				t.Error(err)
+			}
+		},
+		"renderAttributeView": func() {
+			if _, _, err := RenderAttributeView("", view.ID, "", "", 1, -1, nil, false, false); nil != err {
+				t.Error(err)
+			}
+		},
+	}
+	for _, read := range reads {
+		read()
+	}
+	p := av.GetAttributeViewDataPath(view.ID)
+	before := readTurnTestFile(t, p)
+	version := cache.EnsureAVDataVersionInBox(view.ID, "")
+	for name, read := range reads {
+		if !turnWriterStarted(t, read) {
+			t.Errorf("%s waited for another writer's turn with nothing to correct", name)
+		}
+	}
+	if !bytes.Equal(before, readTurnTestFile(t, p)) {
+		t.Error("a read with nothing to correct changed the database's file")
+	}
+	if got := cache.EnsureAVDataVersionInBox(view.ID, ""); version != got {
+		t.Errorf("a read with nothing to correct saved the database: version %d, then %d", version, got)
+	}
+	for site := range tripwire.Sites() {
+		if strings.HasPrefix(site, "model.refreshAttrViewKeyIDs ") || strings.HasPrefix(site, "model.GetBlockAttributeViewKeys") {
+			t.Errorf("getAttributeViewKeys saved outside a turn at %s", site)
+		}
+	}
+}
+
+// A read's correction is saved, in a turn, only if nothing saved the database since the read noted its version: a
+// newer save isn't written over. A correction saved through the note leaves the note current, so a second correction
+// of the same read is saved too.
+func TestReadNoteSavesOnlyWhatNothingSavedSince(t *testing.T) {
+	_, view := setupTurnReadSaveTest(t)
+	note := noteAttrViewRead(view.ID)
+	stale := readAttributeViewItemsTest(t, view.ID)
+	newer := readAttributeViewItemsTest(t, view.ID)
+	newer.Name = "Saved by a writer"
+	if err := av.SaveAttributeView(newer); nil != err {
+		t.Fatal(err)
+	}
+	stale.Name = "Corrected by a read"
+	if saved, err := note.saveIfUnchanged(stale); nil != err || saved {
+		t.Errorf("a read's correction was saved over a newer save: saved=%v err=%v", saved, err)
+	}
+	if got := readAttributeViewItemsTest(t, view.ID).Name; "Saved by a writer" != got {
+		t.Errorf("the database's name is %q, want the newer save's", got)
+	}
+
+	note = noteAttrViewRead(view.ID)
+	current := readAttributeViewItemsTest(t, view.ID)
+	for i, name := range []string{"First correction", "Second correction"} {
+		current.Name = name
+		if saved, err := note.saveIfUnchanged(current); nil != err || !saved {
+			t.Errorf("correction %d wasn't saved: saved=%v err=%v", i+1, saved, err)
+		}
+		if got := readAttributeViewItemsTest(t, view.ID).Name; name != got {
+			t.Errorf("after correction %d the database's name is %q", i+1, got)
+		}
+	}
+}
+
+// getAttributeViewKeys still corrects a database whose fields are out of order, and saves it in a turn.
+func TestGetAttributeViewKeysSavesItsCorrection(t *testing.T) {
+	files, view := setupTurnReadSaveTest(t)
+	want := slices.Clone(view.KeyIDs)
+	view.KeyIDs = view.KeyIDs[1:]
+	if err := av.SaveAttributeView(view); nil != err {
+		t.Fatal(err)
+	}
+	if got := GetBlockAttributeViewKeys(files.targetID); 1 != len(got) {
+		t.Fatalf("getAttributeViewKeys gave %d databases, want 1", len(got))
+	}
+	got := readAttributeViewItemsTest(t, view.ID).KeyIDs
+	slices.Sort(got)
+	slices.Sort(want)
+	if !slices.Equal(want, got) {
+		t.Errorf("the database's fields weren't corrected: %v, want %v", got, want)
+	}
+}
+
+// The in-turn variants take no turn: a caller that has one runs them without waiting for itself.
+func TestInTurnVariantsRunInATurn(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	done := make(chan error, 1)
+	go func() {
+		done <- withTurn(func() error {
+			if err := setBlockAttrsInTurn(files.sourceID, map[string]string{"custom-in-turn": "set"}); nil != err {
+				return err
+			}
+			if err := batchSetBlockAttrsInTurn([]map[string]any{{"id": files.targetID, "attrs": map[string]string{"custom-in-turn": "set"}}}); nil != err {
+				return err
+			}
+			if _, _, _, err := renameDocInTurn(Conf.Box(files.box.ID), files.sourcePath, "Renamed in a turn"); nil != err {
+				return err
+			}
+			_, err := removeDocInTurn(Conf.Box(files.box.ID), files.targetPath)
+			return err
+		})
+	}()
+	select {
+	case err := <-done:
+		if nil != err {
+			t.Fatal(err)
+		}
+	case <-time.After(30 * time.Second):
+		t.Fatal("an in-turn variant waited for the turn its caller holds")
+	}
+	source := loadAttrsCachePageFile(t, files.box.ID, files.sourcePath)
+	if "set" != source.Root.IALAttr("custom-in-turn") || "Renamed in a turn" != source.Root.IALAttr("title") {
+		t.Errorf("the in-turn writes weren't saved: %v", source.Root.KramdownIAL)
+	}
+	if _, err := os.Stat(filepath.Join(util.DataDir, files.box.ID, files.targetPath)); !os.IsNotExist(err) {
+		t.Errorf("removeDocInTurn didn't remove the page: %v", err)
+	}
+}
