index 0000000..7b28286
--- /dev/null
+++ b/kernel/model/turns_fts5_test.go
@@ -0,0 +1,751 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+//go:build fts5
+
+package model
+
+// Every writer takes its turn (issue #43, step 6). A writer of a page or a database reads, changes and saves within a
+// turn of flushLock, as a job does, so a job's save can't land between the writer's read and its save.
+//
+// How these tests make that interleaving happen every time: each writer has a test hook between its read and its save.
+// At the hook the test sends a job through the queue, as the editor's /api/transactions does, from a goroutine of its
+// own, and waits for the job to commit, for a bounded time:
+//   - When the writer holds no turn at its hook, the queue runs the job within its 50 ms tick and the wait ends. The
+//     writer then saves the copy it read before the job, over the job's change.
+//   - When the writer holds the turn there, the job can't run until the writer has saved and let the turn go. The
+//     wait ends unanswered, the writer saves, and the job runs after it, on the writer's change.
+//
+// Either way the test then waits for the job, and checks that the job's change is in the file and in what SiYuan
+// serves. So the job's change is lost before the change and kept after it, and a test can't deadlock against the fix.
+//
+// The same tests run again in tripwire mode (TestWritersSaveWithinTheirTurn): each in a process of its own, sending no
+// job, and checking instead that the writer's call logs no save outside a turn from SiYuan's own code.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/filelock"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/sql"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/tripwire"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const (
+	// turnJobWait is how long a writer's hook waits for the job it sent to commit. Without a turn at the hook the job
+	// commits within the queue's tick, so the wait ends long before this.
+	turnJobWait = 3 * time.Second
+	// turnJobHeldWait is how long the hook waits instead when the tripwire shows the turn held as the hook begins: no
+	// job runs at that moment, so the writer holds it, and the job can't commit before the writer's save.
+	turnJobHeldWait = 100 * time.Millisecond
+	// turnJobCommitWait is how long a test waits for the job once the writer has returned.
+	turnJobCommitWait = 15 * time.Second
+
+	// turnJobAttr and turnJobValue are what a page job sets on its page.
+	turnJobAttr  = "custom-job"
+	turnJobValue = "kept"
+	// turnJobDatabaseName is what a database job names its database.
+	turnJobDatabaseName = "Renamed by a job"
+
+	// turnTripwireEnv, set to 1, runs the process's tests in tripwire mode.
+	turnTripwireEnv = "SIYUAN_TEST_TURN_TRIPWIRE"
+)
+
+// turnTripwireMode is set in a process TestWritersSaveWithinTheirTurn starts: its tests send no job at their writer's
+// hook, and check instead that the writer's call logs no save outside a turn from SiYuan's own code.
+var turnTripwireMode = "1" == os.Getenv(turnTripwireEnv)
+
+// turnJob is a job a test sends at a writer's test hook, between the writer's read and its save.
+type turnJob struct {
+	mu        sync.Mutex
+	sent      bool
+	atHook    bool // the job committed while the hook waited, before the writer's save
+	turnHeld  bool // the tripwire showed the turn held as the hook began
+	operation string
+	done      chan struct{}
+}
+
+func newTurnJob() *turnJob {
+	return &turnJob{done: make(chan struct{})}
+}
+
+// send is called by a writer's test hook. Its first call sends operations as one job through the queue, from a
+// goroutine of its own, and waits for the job to commit for a bounded time; later calls do nothing.
+func (j *turnJob) send(operations ...*Operation) {
+	j.mu.Lock()
+	if j.sent {
+		j.mu.Unlock()
+		return
+	}
+	j.sent = true
+	if turnTripwireMode {
+		j.mu.Unlock()
+		return
+	}
+	if 0 < len(operations) {
+		j.operation = operations[0].Action
+	}
+	j.mu.Unlock()
+
+	held := tripwire.InTurn()
+	tx := &Transaction{Timestamp: time.Now().UnixMilli(), DoOperations: operations}
+	go func() {
+		defer close(j.done)
+		PerformTransactions(&[]*Transaction{tx})
+		tx.WaitForCommit()
+	}()
+	wait := turnJobWait
+	if held {
+		wait = turnJobHeldWait
+	}
+	atHook := false
+	select {
+	case <-j.done:
+		atHook = true
+	case <-time.After(wait):
+	}
+	j.mu.Lock()
+	j.atHook, j.turnHeld = atHook, held
+	j.mu.Unlock()
+}
+
+// run runs the writer under test, which sends the job from its hook, with nothing queued before it, under runWriter's
+// watchdog; then it waits for the job (finish).
+//
+// In tripwire mode it runs the writer with SiYuan's log pointed at a file of the test's own, and checks the lines the
+// writer's call logged instead.
+func (j *turnJob) run(t *testing.T, writer string, fn func()) {
+	t.Helper()
+	FlushTxQueue()
+	if turnTripwireMode {
+		log := newTripwireLog(t)
+		mark := log.mark(t)
+		runWriter(t, writer, fn)
+		// What the writer left to run in the background has its moment too.
+		FlushTxQueue()
+		time.Sleep(200 * time.Millisecond)
+		checkSavesWithinTurns(t, writer, log, mark)
+		return
+	}
+	runWriter(t, writer, fn)
+	j.finish(t)
+}
