+// A save of an existing page made while no job holds the turn logs its call site, once: two saves from one site log
+// one line, and a save from another site logs a line of its own. The conditional save, WriteTreeIfUnchanged, logs too.
+// Each save changes the page, so each writes its file.
+func TestTripwireLogsAPageSaveOutsideATurnOncePerSite(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		files := setupFileOperationTest(t)
+		log := newTripwireLog(t)
+		page := loadTripwirePage(t, files.box.ID, files.sourcePath)
+		begin := log.mark(t)
+
+		page.Root.SetIALAttr("custom-tripwire", "a1")
+		siteA, err := tripwireSavePageA(page)
+		if nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the first save from site A", tripwirePagePath(page), `"a1"`)
+		checkTripwireSite(t, "after the first save from site A", log.linesSince(t, begin), siteA, "page", 1)
+
+		page.Root.SetIALAttr("custom-tripwire", "a2")
+		if _, err = tripwireSavePageA(page); nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the second save from site A", tripwirePagePath(page), `"a2"`)
+		checkTripwireSite(t, "after the second save from site A", log.linesSince(t, begin), siteA, "page", 1)
+
+		page.Root.SetIALAttr("custom-tripwire", "b")
+		siteB, err := tripwireSavePageB(page)
+		if nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the save from site B", tripwirePagePath(page), `"b"`)
+		checkTripwireSite(t, "after the save from site B", log.linesSince(t, begin), siteB, "page", 1)
+		checkTripwireSite(t, "after the save from site B", log.linesSince(t, begin), siteA, "page", 1)
+
+		page, original, err := filesys.LoadTreeSnapshot(files.box.ID, files.sourcePath, util.NewLute())
+		if nil != err {
+			t.Fatal(err)
+		}
+		page.Root.SetIALAttr("custom-tripwire", "c")
+		siteC, err := tripwireSavePageIfUnchanged(page, original)
+		if nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the conditional save", tripwirePagePath(page), `"c"`)
+		checkTripwireSite(t, "after the conditional save (WriteTreeIfUnchanged)", log.linesSince(t, begin), siteC,
+			"page", 1)
+	})
+}
