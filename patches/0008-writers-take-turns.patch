+// dropQueuedRefTextRenames forgets the renames a test queued for the ref-text job, so no later test runs them.
+func dropQueuedRefTextRenames(t *testing.T) {
+	t.Cleanup(func() {
+		updateRefTextRenameDocLock.Lock()
+		updateRefTextRenameDocs = map[string]*parse.Tree{}
+		updateRefTextRenameDocLock.Unlock()
+	})
+}
