+		checkDatabaseKeepsJob(t, job, "the asset's rename", db.avID)
+		attrView, err := av.ParseAttributeView(db.avID)
+		if nil != err {
+			t.Fatal(err)
+		}
+		if note, _ := attrView.GetKey(db.noteKeyID); nil == note || newPath != note.Desc {
+			t.Errorf("after the asset's rename, the database's Note field is %+v, without the new path %s", note, newPath)
+		}
+	})
+}
+
+// turnTestMessage matches a test's own message in go test's output, as "    turns_fts5_test.go:123: ...".
+var turnTestMessage = regexp.MustCompile(`^\s+\S+_test\.go:\d+: `)
+
+// turnWriterTests are the tests above that run a writer with a job between its read and its save.
+var turnWriterTests = []string{
+	"TestSetBlockAttrsKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestBatchSetBlockAttrsKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestReadsThatSaveKeepAJobsSaveMadeAfterTheirRead",
+	"TestPageDeletionKeepsAJobsSaveToItsDatabasesMadeBetweenTheirReadAndTheirSave",
+	"TestRenameDocKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestNewRowKeepsAJobsSaveToItsPageMadeBetweenItsReadAndItsSave",
+	"TestRefTextJobKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestReloadProtyleKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestTransferBlockRefKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestDatabaseDuplicateKeepsAJobsSaveToARowsPageMadeBetweenItsReadAndItsSave",
+	"TestPageHistoryRestoreKeepsAJobsSaveMadeBetweenItsReadAndItsWrite",
+	"TestOnePageSnapshotRestoreKeepsAJobsSaveMadeBetweenItsReadAndItsWrite",
+	"TestDatabaseHistoryRollbackKeepsAJobsSaveMadeBetweenItsReadAndItsWrite",
+	"TestDailyNoteKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+	"TestMoveDocsKeepsAJobsSaveMadeWhileItMovesThePage",
+	"TestAssetRenameKeepsAJobsSaveMadeBetweenItsReadAndItsSave",
+}
+
+// Every writer saves within its turn: called outside a job, as its endpoint calls it, it logs no tripwire line for a
+// save outside a turn from a site in SiYuan's code. Each test in turnWriterTests runs again in tripwire mode, in a
+// process of its own, since the tripwire logs a site once per process. Its writer's other checks still run. The tripwire
+// watches only WriteTree, WriteTreeIfUnchanged and saveAttributeView, and takes a save to a path with no file for a new
+// page's first, so some cases are guards before step 6: those whose writer writes its files around them (the move, the
+// asset rename, the database history rollback), and the one-page snapshot restore, which removes the page's file
+// before it writes the copy. The system page's test isn't here: what it checks needs its job, which makes the page.
+func TestWritersSaveWithinTheirTurn(t *testing.T) {
+	if turnTripwireMode {
+		t.Skip("in tripwire mode this process runs the writers' tests")
+	}
+	for _, name := range turnWriterTests {
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+			defer cancel()
+			command := exec.CommandContext(ctx, os.Args[0], "-test.run=^"+name+"$", "-test.count=1",
+				"-test.timeout=4m", "-test.v")
+			command.Env = append(os.Environ(), turnTripwireEnv+"=1")
+			output, err := command.CombinedOutput()
+			if nil != err {
+				var failures []string
+				for _, line := range strings.Split(string(output), "\n") {
+					if strings.Contains(line, "--- FAIL") || turnTestMessage.MatchString(line) {
+						failures = append(failures, strings.TrimSpace(line))
+					}
+				}
+				t.Fatalf("in tripwire mode (%v):\n%s", err, strings.Join(failures, "\n"))
+			}
+			if !bytes.Contains(output, []byte("--- PASS: "+name+" ")) {
+				t.Fatalf("setup: the process in tripwire mode didn't run the test:\n%s", output)
+			}
+		})
+	}
+}
