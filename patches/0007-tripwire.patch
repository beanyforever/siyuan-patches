+// Finding: a go statement that calls a save function or one of model's wrappers directly, as "go
+// writeTreeUpsertQueue(tree)" would, is named "runtime.goexit asm_amd64.s:1771". Go elides the function it makes for
+// the statement (F.gowrap1) from the frames runtime.CallersFrames gives, so the walk passes over the wrapper and reaches
+// only the goroutine's start: every such statement in the kernel would share that one site, which names no writer.
+// callSite's rule for "gowrap" never sees one. No kernel code saves this way today, so it is latent.
+//
+// The test calls a wrapper of its own, registered as model's are, so that it can wait for the save to end; "go
+// writeTreeUpsertQueue(page)" is named the same way, but can't be waited for without a race with the test's cleanup.
+func TestTripwireChallengeNamesAGoStatementThatCallsASaveFunction(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		files := setupStructureTransactionTest(t)
+		setupFoldTransactionDatabase(t, files)
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		newTripwireLog(t)
+		tripwire.SaveFunctions(tripwireChallengeWrapper)
+		page := loadTripwirePage(t, files.box.ID, files.sourcePath)
+		page.Root.SetIALAttr("custom-tripwire-go", "saved")
+
+		before := tripwire.Sites()
+		done := make(chan struct{})
+		go tripwireChallengeWrapper(page, done)
+		<-done
+		requireTripwireFileHolds(t, "the save from the go statement", tripwirePagePath(page), "custom-tripwire-go")
+		got := probeNewSites(before)
+		if 1 != len(got) || !regexp.MustCompile(`^model\.\S+ \S+\.go:\d+$`).MatchString(got[0]) {
+			t.Errorf("a go statement calling a save function outside a turn was logged at %q, want one site in model, "+
+				"the writer's", got)
+		}
+	})
+}
+
+// tripwireChallengeWrapper is a thin wrapper around WriteTree, as model's are, which says when it is done.
+//
+//go:noinline
+func tripwireChallengeWrapper(tree *parse.Tree, done chan<- struct{}) {
+	defer close(done)
+	_, _ = filesys.WriteTree(tree)
+}
+
+// probeNewSites returns the sites the tripwire recorded since before, a copy of its set. A save made on another
+// goroutine may land after save returns, so it waits up to two seconds for one.
+func probeNewSites(before map[string]tripwire.Kind) (ret []string) {
+	for deadline := time.Now().Add(2 * time.Second); ; time.Sleep(10 * time.Millisecond) {
+		ret = ret[:0]
+		for site := range tripwire.Sites() {
+			if _, ok := before[site]; !ok {
+				ret = append(ret, site)
+			}
+		}
+		if 0 < len(ret) || time.Now().After(deadline) {
+			break
+		}
+	}
+	slices.Sort(ret)
+	return
+}
+
+// Probe: a save outside a turn through each of model's wrappers, and from a closure, a range-over-func body, a go
+// statement and a defer statement, is named at the writer's own line. Run it also under -race and with inlining off.
+func TestTripwireProbeNamesTheWriterThroughEveryWrapper(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		files := setupStructureTransactionTest(t)
+		setupFoldTransactionDatabase(t, files)
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		newTripwireLog(t)
+		page := loadTripwirePage(t, files.box.ID, files.sourcePath)
+
+		// check makes one save through save, which returns the site the tripwire should name: an exact site, or, with
+		// pattern, a regular expression for it. A page save schedules a background refresh that takes the turn 128 ms
+		// later, so check waits for those first.
+		check := func(name string, save func() (want string, pattern bool)) {
+			t.Helper()
+			backgroundRefreshWaitGroup.Wait()
+			page.Root.SetIALAttr("custom-probe", name)
+			before := tripwire.Sites()
+			want, pattern := save()
+			got := probeNewSites(before)
+			if 1 != len(got) {
+				t.Errorf("%s: the save added %d sites, want 1: %q", name, len(got), got)
+				return
+			}
+			if pattern {
+				if !regexp.MustCompile(want).MatchString(got[0]) {
+					t.Errorf("%s: the tripwire named %q, want a match for %s", name, got[0], want)
+				}
+				return
+			}
+			if want != got[0] {
+				t.Errorf("%s: the tripwire named %q, want %q", name, got[0], want)
+			}
+		}
+
+		check("writeTreeUpsertQueue", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_ = writeTreeUpsertQueue(page)
+			return site, false
+		})
+		check("writeTreeUpsertQueue0", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_, _ = writeTreeUpsertQueue0(page)
+			return site, false
+		})
+		check("indexWriteTreeIndexQueue", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_ = indexWriteTreeIndexQueue(page)
+			return site, false
+		})
+		check("indexWriteTreeUpsertQueue", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_ = indexWriteTreeUpsertQueue(page)
+			return site, false
+		})
+		check("indexWriteTreeUpsertQueue0", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_, _ = indexWriteTreeUpsertQueue0(page)
+			return site, false
+		})
+		check("renameWriteJSONQueue", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_ = renameWriteJSONQueue(page)
+			return site, false
+		})
+		check("writeRenameDoc", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_, _ = writeRenameDoc(page)
+			return site, false
+		})
+		check("writeRenameDocWith and a writer's own closure", func() (string, bool) {
+			site := siteOfSaveOnNextLine()
+			_, _ = writeRenameDocWith(page, func(tree *parse.Tree) (uint64, error) { return filesys.WriteTree(tree) })
+			return site, false
+		})
+		check("writeRenameDocIfUnchanged", func() (string, bool) {
+			original, err := os.ReadFile(tripwirePagePath(page))
+			if nil != err {
+				t.Fatal(err)
+			}
+			site := siteOfSaveOnNextLine()
+			_, _ = writeRenameDocIfUnchanged(page, original)
+			return site, false
+		})
+		check("a closure calling the wrapper", func() (string, bool) {
+			var site string
+			func() {
+				site = siteOfSaveOnNextLine()
+				_ = writeTreeUpsertQueue(page)
+			}()
+			return site, false
+		})
+		check("a range-over-func body", func() (string, bool) {
+			var site string
+			for range slices.Values([]int{1}) {
+				site = siteOfSaveOnNextLine()
+				_ = writeTreeUpsertQueue(page)
+			}
+			return site, false
+		})
+		check("a goroutine's closure", func() (string, bool) {
+			var wg sync.WaitGroup
+			wg.Add(1)
+			site := siteOfSaveOnNextLine()
+			go func() { defer wg.Done(); _ = writeTreeUpsertQueue(page) }()
+			wg.Wait()
+			// The goroutine's function is a closure in this one: "...func13.1".
+			function, fileLine, _ := strings.Cut(site, " ")
+			return "^" + regexp.QuoteMeta(function) + `\.\d+ ` + regexp.QuoteMeta(fileLine) + "$", true
+		})
+		check("a defer statement calling the wrapper", func() (string, bool) {
+			return probeDeferSave(page), true
+		})
+	})
+}
+
+// probeDeferSave saves tree from a defer statement calling the wrapper, and returns a pattern for the site. Go elides
+// the function it makes for the statement (deferwrap1) from the frames, so the site is the function the defer is in, at
+// the line where the deferred call runs, its closing brace.
+//
+//go:noinline
+func probeDeferSave(tree *parse.Tree) (want string) {
+	pc, file, line, _ := runtime.Caller(0)
+	name := runtime.FuncForPC(pc).Name()
+	want = fmt.Sprintf(`^%s\.func1 %s:%d$`, regexp.QuoteMeta(name[strings.LastIndexByte(name, '/')+1:]),
+		regexp.QuoteMeta(filepath.Base(file)), line+6)
+	func() {
+		defer writeTreeUpsertQueue(tree)
+	}()
+	return
+}
