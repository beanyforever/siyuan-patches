+// Step 4's challenger: the MCP file tool's copy follows symbolic links to folders, and its raise doesn't.
+//
+// The tool's copyPath stats each path it copies with os.Stat, so a link to a folder, as the copy's source or anywhere
+// inside it, is copied as the folder it points to, pages and all. RaiseForDataCopy walks the source with os.Lstat and
+// filepath.WalkDir, which follow no link: it sees each link as a file whose name is no page, and raises nothing for
+// what the copy wrote through it. Links inside the workspace are allowed (authorizePath refuses only those that leave
+// it). The test copies, over the notebook, a link to a notebook folder holding the page's new copy; a link to a
+// page's sub-page folder inside a copied folder is missed the same way.
+func TestFileToolCopyThroughALinkServesTheCopy(t *testing.T) {
+	f := setupToolWriterTest(t)
+	stageToolFile(t, "stage/real/"+toolBoxID+"/"+toolPageID+".sy", f.newPage)
+	link := filepath.Join(util.WorkspaceDir, "stage", "links", toolBoxID)
+	if err := os.MkdirAll(filepath.Dir(link), 0755); nil != err {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(util.WorkspaceDir, "stage", "real", toolBoxID), link); nil != err {
+		t.Skipf("symbolic links unavailable: %v", err)
+	}
+	callFileTool(t, map[string]any{"action": "copy", "src": "stage/links/" + toolBoxID, "dst": "data/" + toolBoxID})
+	checkToolPage(t, "after the tool's copy of a link to the notebook's folder", "new")
+}
