+}
+
+func TestTripwirePassesOverRepairsMadeWhileLoading(t *testing.T) {
+	box := setupTripwireSitesTest(t)
+	luteEngine := util.NewLute()
+
+	// The missing-parent rebuild: a child page whose parent page is missing rebuilds the parent on load.
+	child := treenode.NewTree(box, "/20261018000002-parent1/20261018000003-child01.sy", "/Parent/Child", "Child")
+	writeStalePathFixture(t, box, child.Path, render.NewJSONRenderer(child, luteEngine.RenderOptions, luteEngine.ParseOptions).Render())
+	if _, err := LoadTree(box, child.Path, luteEngine); nil != err {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(util.DataDir, box, "20261018000002-parent1.sy")); nil != err {
+		t.Fatalf("the load didn't rebuild the missing parent: %s", err)
+	}
+
+	// fixTreeJSONData's write-back: a page whose root id differs from its file's name is repaired and written back.
+	misnamed := treenode.NewTree(box, "/20261018000004-page002.sy", "/Misnamed", "Misnamed")
+	misnamed.Root.ID = "20261018000005-other01"
+	misnamed.Root.SetIALAttr("id", misnamed.Root.ID)
+	abs := writeStalePathFixture(t, box, misnamed.Path, render.NewJSONRenderer(misnamed, luteEngine.RenderOptions, luteEngine.ParseOptions).Render())
+	before, _ := os.ReadFile(abs)
+	if _, err := LoadTree(box, misnamed.Path, luteEngine); nil != err {
+		t.Fatal(err)
+	}
+	if after, _ := os.ReadFile(abs); string(before) == string(after) {
+		t.Fatal("the load didn't write the repaired page back")
+	}
+
+	requireNoTripwireSiteIn(t, "filesys.LoadTreeByData")
+	requireNoTripwireSiteIn(t, "filesys.LoadTreeWithFix")
+	requireNoTripwireSiteIn(t, "filesys.fixTreeJSONData")
+	requireNoTripwireSiteIn(t, "filesys.TestTripwirePassesOverRepairsMadeWhileLoading")
+}
