+// writeBlockAttrsPage writes a page and indexes it. If paragraphID isn't empty, the page also holds that paragraph,
+// whose custom-shelf is left.
+func writeBlockAttrsPage(t *testing.T, rootID, paragraphID string) *parse.Tree {
+	t.Helper()
+	tree := treenode.NewTree(blockAttrsTestBox, "/"+rootID+".sy", "/Page", "Page")
+	if "" != paragraphID {
+		paragraph := treenode.NewParagraph(paragraphID)
+		paragraph.SetIALAttr("custom-shelf", "left")
+		tree.Root.AppendChild(paragraph)
+	}
+	if _, err := filesys.WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	treenode.UpsertBlockTree(tree)
+	return tree
+}
