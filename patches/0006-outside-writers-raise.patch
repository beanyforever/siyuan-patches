+
+// The file API writes a workspace's files raw: putFile, the copies, renameFile, removeFile and the archive API's unzip
+// write a page's .sy or a database's storage/av/<id>.json without WriteTree or saveAttributeView, so nothing raises the
+// version of the page or database they write. A page or database SiYuan read before keeps its cache entries current,
+// and SiYuan serves them, older than the file, until something else writes it: getBlockAttrs and a page load give the
+// page as it was, and every read of the database gives it as it was. The next edit, which builds on that copy, then
+// saves it over the file, losing what the API wrote. Each test below caches a page and a database through SiYuan's own
+// reads, writes them through one of these handlers, and reads them back through what SiYuan serves.
+
+const (
+	outsideBoxID  = "20261017210000-outsbox"
+	outsidePageID = "20261017210001-outpage"
+	outsideAVID   = "20261017210002-outdtbs"
+)
+
+// outsideWriterFixture is a workspace with one notebook, holding one page whose root has custom-v=old, and one
+// database named Old table. Both have been read through SiYuan's own reads after a restart, so the page cache, the block
+// attribute cache and the database cache hold them, as they do once anything has shown them.
+type outsideWriterFixture struct {
+	pagePath    string // the page's file, relative to the workspace
+	avPath      string // the database's file, relative to the workspace
+	newPage     []byte // the page's file with custom-v=new
+	newDatabase []byte // the database's file named New table
+}
+
+func setupOutsideWriterTest(t *testing.T) *outsideWriterFixture {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	previousConf := model.Conf
+	previousWorkspace, previousData, previousTemp := util.WorkspaceDir, util.DataDir, util.TempDir
+	previousHistory, previousConfDir, previousBlockTree := util.HistoryDir, util.ConfDir, util.BlockTreeDBPath
+	workspace := t.TempDir()
+	util.WorkspaceDir = workspace
+	util.DataDir = filepath.Join(workspace, "data")
+	util.TempDir = filepath.Join(workspace, "temp")
+	util.HistoryDir = filepath.Join(workspace, "history")
+	util.ConfDir = filepath.Join(workspace, "conf")
+	util.BlockTreeDBPath = filepath.Join(util.TempDir, "blocktree.db")
+	for _, dir := range []string{util.TempDir, util.ConfDir} {
+		if err := os.MkdirAll(dir, 0755); nil != err {
+			t.Fatal(err)
+		}
+	}
+	model.Conf = model.NewAppConf()
+	model.Conf.FileTree.Store(conf.NewFileTree())
+	model.Conf.Sync.Store(conf.NewSync())
+	model.Conf.NotebookCrypto = conf.NewNotebookCrypto()
+	treenode.InitBlockTree(true)
+	clearCaches := func() {
+		cache.ClearTreeCache()
+		cache.ClearBlocksIAL()
+		cache.ClearDocsIAL()
+		cache.RemoveAVData(outsideAVID)
+	}
+	t.Cleanup(func() {
+		clearCaches()
+		treenode.CloseDatabase()
+		model.Conf = previousConf
+		util.WorkspaceDir, util.DataDir, util.TempDir = previousWorkspace, previousData, previousTemp
+		util.HistoryDir, util.ConfDir, util.BlockTreeDBPath = previousHistory, previousConfDir, previousBlockTree
+	})
+
+	box := &model.Box{ID: outsideBoxID}
+	boxConf := conf.NewBoxConf()
+	boxConf.Name = "Work"
+	boxConf.Closed = false
+	if err := box.SaveConf(boxConf); nil != err {
+		t.Fatalf("setup: save the notebook's conf failed: %v", err)
+	}
+	tree := treenode.NewTree(outsideBoxID, "/"+outsidePageID+".sy", "/Page", "Page")
+	tree.Root.SetIALAttr("custom-v", "old")
+	if _, err := filesys.WriteTree(tree); nil != err {
+		t.Fatalf("setup: write the page failed: %v", err)
+	}
+	treenode.UpsertBlockTree(tree)
+	attrView := &av.AttributeView{ID: outsideAVID, Spec: av.RichTextSpec, Name: "Old table",
+		KeyValues: []*av.KeyValues{{Key: &av.Key{ID: "20261017210003-blockky", Name: "Name", Type: av.KeyTypeBlock}}},
+		Views: []*av.View{{ID: "20261017210004-tablevw", Name: "Table", LayoutType: av.LayoutTypeTable,
+			Table: av.NewLayoutTable(), PageSize: av.ViewDefaultPageSize}},
+		RenderedViewables: map[string]av.Viewable{}}
+	if err := av.SaveAttributeView(attrView); nil != err {
+		t.Fatalf("setup: save the database failed: %v", err)
+	}
+
+	f := &outsideWriterFixture{
+		pagePath: filepath.ToSlash(filepath.Join("data", outsideBoxID, outsidePageID+".sy")),
+		avPath:   filepath.ToSlash(filepath.Join("data", "storage", "av", outsideAVID+".json")),
+	}
+	f.newPage = replaceOutsideJSONString(t, readOutsideFile(t, f.pagePath), "custom-v", "old", "new")
+	f.newDatabase = replaceOutsideJSONString(t, readOutsideFile(t, f.avPath), "name", "Old table", "New table")
+
+	// As after a restart, then SiYuan's own reads: getBlockAttrs loads the page, which fills the page cache and the
+	// block attribute cache, and a read of the database fills the database cache. One read each: a second fill of a
+	// key ristretto hasn't taken in yet is turned away, and the page cache then serves neither copy.
+	clearCaches()
+	if got := sql.GetBlockAttrs(outsidePageID)["custom-v"]; "old" != got {
+		t.Fatalf("setup: getBlockAttrs gives the page custom-v=%q", got)
+	}
+	if attrView, err := av.ParseAttributeView(outsideAVID); nil != err || "Old table" != attrView.Name {
+		t.Fatalf("setup: the database reads %v, %v", attrView, err)
+	}
+	waitOutsideCached(t, "the page cache doesn't serve the page", func() bool {
+		_, ok := cache.GetTreeDataInBox(outsidePageID, outsideBoxID)
+		return ok
+	})
+	waitOutsideCached(t, "the block attribute cache doesn't serve the page's attributes", func() bool {
+		return nil != cache.GetBlockIALInBox(outsidePageID, outsideBoxID)
+	})
+	waitOutsideCached(t, "the database cache doesn't serve the database", func() bool {
+		_, ok := cache.GetAVData(outsideAVID)
+		return ok
+	})
+	return f
+}
+
+// waitOutsideCached waits up to 200 ms for the cache to take in what a read stored: ristretto takes a store in on a
+// goroutine of its own, and a read straight after it would miss and read the file, which would hide the fault.
+func waitOutsideCached(t *testing.T, what string, cached func() bool) {
+	t.Helper()
+	for deadline := time.Now().Add(200 * time.Millisecond); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		if cached() {
+			return
+		}
+	}
+	t.Fatalf("setup: %s", what)
+}
+
+func readOutsideFile(t *testing.T, workspacePath string) []byte {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(util.WorkspaceDir, filepath.FromSlash(workspacePath)))
+	if nil != err {
+		t.Fatalf("read %s failed: %v", workspacePath, err)
+	}
+	return data
+}
+
+// replaceOutsideJSONString replaces "name":"old" with "name":"new" in a file SiYuan wrote, on one line or indented.
+func replaceOutsideJSONString(t *testing.T, data []byte, name, old, new string) []byte {
+	t.Helper()
+	for _, separator := range []string{":", ": "} {
+		from := []byte(`"` + name + `"` + separator + `"` + old + `"`)
+		if bytes.Contains(data, from) {
+			return bytes.Replace(data, from, []byte(`"`+name+`"`+separator+`"`+new+`"`), 1)
+		}
+	}
+	t.Fatalf("setup: the file holds no %q: %q", name, old)
+	return nil
+}
+
+// stageOutsideFile writes data at a workspace path outside data/, where nothing caches, for a handler to copy, rename
+// or unzip from.
+func stageOutsideFile(t *testing.T, workspacePath string, data []byte) string {
+	t.Helper()
+	absPath := filepath.Join(util.WorkspaceDir, filepath.FromSlash(workspacePath))
+	if err := os.MkdirAll(filepath.Dir(absPath), 0755); nil != err {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(absPath, data, 0644); nil != err {
+		t.Fatal(err)
+	}
+	return absPath
+}
+
+// requireOutsideFileHolds stops the test unless the file at workspacePath holds "name":"value": a writer under test
+// that wrote nothing would make every read look stale.
+func requireOutsideFileHolds(t *testing.T, step, workspacePath, name, value string) {
+	t.Helper()
+	data := readOutsideFile(t, workspacePath)
+	for _, separator := range []string{":", ": "} {
+		if bytes.Contains(data, []byte(`"`+name+`"`+separator+`"`+value+`"`)) {
+			return
+		}
+	}
+	t.Fatalf("%s: %s doesn't hold %s=%q", step, workspacePath, name, value)
+}
+
+// checkOutsidePage reads the page as SiYuan serves it, through getBlockAttrs and a page load, and wants custom-v=want,
+// which its file holds.
+func checkOutsidePage(t *testing.T, step, want string) {
+	t.Helper()
+	requireOutsideFileHolds(t, step, "data/"+outsideBoxID+"/"+outsidePageID+".sy", "custom-v", want)
+	if got := sql.GetBlockAttrs(outsidePageID)["custom-v"]; want != got {
+		t.Errorf("%s: getBlockAttrs gives the page custom-v=%q, though its file holds %q", step, got, want)
+	}
+	tree, err := filesys.LoadTree(outsideBoxID, "/"+outsidePageID+".sy", util.NewLute())
+	if nil != err {
+		t.Errorf("%s: load the page failed: %v", step, err)
+		return
+	}
+	if got := tree.Root.IALAttr("custom-v"); want != got {
+		t.Errorf("%s: the page loads with custom-v=%q, though its file holds %q", step, got, want)
+	}
+}
+
+// checkOutsideDatabase reads the database as every operation on it starts, and wants its name to be want, which its
+// file holds.
+func checkOutsideDatabase(t *testing.T, step, want string) {
+	t.Helper()
+	requireOutsideFileHolds(t, step, "data/storage/av/"+outsideAVID+".json", "name", want)
+	attrView, err := av.ParseAttributeView(outsideAVID)
+	if nil != err || nil == attrView {
+		t.Errorf("%s: read the database failed: %v", step, err)
+		return
+	}
+	if want != attrView.Name {
+		t.Errorf("%s: the database reads with the name %q, though its file holds %q", step, attrView.Name, want)
+	}
+}
+
+// callOutsideWriterAPI calls handler as an administrator and wants it to succeed.
+func callOutsideWriterAPI(t *testing.T, route string, handler gin.HandlerFunc, contentType string, body []byte) {
+	t.Helper()
+	engine := gin.New()
+	engine.Use(func(c *gin.Context) {
+		c.Set(model.RoleContextKey, model.RoleAdministrator)
+		c.Next()
+	})
+	engine.POST(route, handler)
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPost, route, bytes.NewReader(body))
+	request.Header.Set("Content-Type", contentType)
+	engine.ServeHTTP(recorder, request)
+	var response struct {
+		Code int    `json:"code"`
+		Msg  string `json:"msg"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &response); nil != err || 0 != response.Code {
+		t.Fatalf("%s failed: %s, %v", route, recorder.Body.String(), err)
+	}
+}
+
+func outsideJSONBody(t *testing.T, value any) []byte {
+	t.Helper()
+	data, err := json.Marshal(value)
+	if nil != err {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// /api/file/putFile over a page's file and over a database's file. On v3.8.7 and step 3 the handler writes with
+// filelock.WriteFile and raises nothing.
+func TestPutFileServesTheFileItWrote(t *testing.T) {
+	t.Run("a page", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		body, contentType := putFileMultipartBody(t, f.pagePath, f.newPage)
+		callOutsideWriterAPI(t, "/api/file/putFile", putFile, contentType, body)
+		checkOutsidePage(t, "after putFile", "new")
+	})
+	t.Run("a database", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		body, contentType := putFileMultipartBody(t, f.avPath, f.newDatabase)
+		callOutsideWriterAPI(t, "/api/file/putFile", putFile, contentType, body)
+		checkOutsideDatabase(t, "after putFile", "New table")
+	})
+}
+
+// The file API's copies, raw copies with filelock.Copy: /api/file/workspaceCopyFiles of a page's file and of a
+// database's file, and /api/file/globalCopyFiles of a whole notebook folder over the notebook, which writes the page
+// inside it. None raises anything on v3.8.7 and step 3.
+func TestCopiedFilesServeTheCopy(t *testing.T) {
+	t.Run("a page, by workspaceCopyFiles", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		stageOutsideFile(t, "stage/"+outsidePageID+".sy", f.newPage)
+		callOutsideWriterAPI(t, "/api/file/workspaceCopyFiles", workspaceCopyFiles, "application/json",
+			outsideJSONBody(t, map[string]any{"srcs": []string{"stage/" + outsidePageID + ".sy"},
+				"destDir": "data/" + outsideBoxID}))
+		checkOutsidePage(t, "after workspaceCopyFiles", "new")
+	})
+	t.Run("a notebook folder, by globalCopyFiles", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		stageOutsideFile(t, "stage/"+outsideBoxID+"/"+outsidePageID+".sy", f.newPage)
+		folder := filepath.Join(util.WorkspaceDir, "stage", outsideBoxID)
+		callOutsideWriterAPI(t, "/api/file/globalCopyFiles", globalCopyFiles, "application/json",
+			outsideJSONBody(t, map[string]any{"srcs": []string{folder}, "destDir": "data"}))
+		checkOutsidePage(t, "after globalCopyFiles of the notebook's folder", "new")
+	})
+	t.Run("a database, by workspaceCopyFiles", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		stageOutsideFile(t, "stage/"+outsideAVID+".json", f.newDatabase)
+		callOutsideWriterAPI(t, "/api/file/workspaceCopyFiles", workspaceCopyFiles, "application/json",
+			outsideJSONBody(t, map[string]any{"srcs": []string{"stage/" + outsideAVID + ".json"},
+				"destDir": "data/storage/av"}))
+		checkOutsideDatabase(t, "after workspaceCopyFiles", "New table")
+	})
+}
+
+// /api/file/renameFile of a new copy into the place of a page's file and of a database's file, the way a writer
+// replaces a file whole. renameFile refuses an existing destination, so the old file is first deleted by another
+// program, which SiYuan doesn't see; nothing reads in between. On v3.8.7 and step 3, filelock.RenameWithoutFatal raises
+// nothing.
+func TestRenamedFilesServeTheFileRenamedIn(t *testing.T) {
+	t.Run("a page", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		stageOutsideFile(t, "stage/"+outsidePageID+".sy", f.newPage)
+		if err := os.Remove(filepath.Join(util.WorkspaceDir, filepath.FromSlash(f.pagePath))); nil != err {
+			t.Fatal(err)
+		}
+		callOutsideWriterAPI(t, "/api/file/renameFile", renameFile, "application/json",
+			outsideJSONBody(t, map[string]any{"path": "stage/" + outsidePageID + ".sy", "newPath": f.pagePath}))
+		checkOutsidePage(t, "after renameFile", "new")
+	})
+	t.Run("a database", func(t *testing.T) {
+		f := setupOutsideWriterTest(t)
+		stageOutsideFile(t, "stage/"+outsideAVID+".json", f.newDatabase)
+		if err := os.Remove(filepath.Join(util.WorkspaceDir, filepath.FromSlash(f.avPath))); nil != err {
+			t.Fatal(err)
+		}
+		callOutsideWriterAPI(t, "/api/file/renameFile", renameFile, "application/json",
+			outsideJSONBody(t, map[string]any{"path": "stage/" + outsideAVID + ".json", "newPath": f.avPath}))
+		checkOutsideDatabase(t, "after renameFile", "New table")
+	})
+}
+
+// /api/file/removeFile of a page's file. The block index still lists the page, so getBlockAttrs looks it up; its
+// file holds nothing, so it must give no attributes. On v3.8.7 and step 3, filelock.RemoveWithoutFatal raises nothing,
+// and getBlockAttrs serves the attributes cached before the removal. (A page load checks that the file exists, and a
+// database read too, so those two already read the removal.)
+func TestRemovedPageServesNoAttributes(t *testing.T) {
+	f := setupOutsideWriterTest(t)
+	callOutsideWriterAPI(t, "/api/file/removeFile", removeFile, "application/json",
+		outsideJSONBody(t, map[string]any{"path": f.pagePath}))
+	if _, err := os.Stat(filepath.Join(util.WorkspaceDir, filepath.FromSlash(f.pagePath))); !os.IsNotExist(err) {
+		t.Fatalf("setup: removeFile left the page's file: %v", err)
+	}
+	if got := sql.GetBlockAttrs(outsidePageID); 0 < len(got) {
+		t.Errorf("after removeFile, getBlockAttrs gives the page the attributes %v, though its file is gone", got)
+	}
+}
+
+// /api/archive/unzip of an archive holding a new copy of the page and of the database into data/. On v3.8.7 and
+// step 3, unzipWorkspaceArchive writes each entry with os.Create and raises nothing.
+func TestUnzippedFilesServeTheArchivesCopy(t *testing.T) {
+	f := setupOutsideWriterTest(t)
+	zipPath := filepath.Join(util.TempDir, "payload.zip")
+	file, err := os.Create(zipPath)
+	if nil != err {
+		t.Fatal(err)
+	}
+	writer := archivezip.NewWriter(file)
+	for name, data := range map[string][]byte{
+		outsideBoxID + "/" + outsidePageID + ".sy": f.newPage,
+		"storage/av/" + outsideAVID + ".json":      f.newDatabase,
+	} {
+		entry, createErr := writer.Create(name)
+		if nil != createErr {
+			t.Fatal(createErr)
+		}
+		if _, err = entry.Write(data); nil != err {
+			t.Fatal(err)
+		}
+	}
+	if err = writer.Close(); nil != err {
+		t.Fatal(err)
+	}
+	if err = file.Close(); nil != err {
+		t.Fatal(err)
+	}
+	callOutsideWriterAPI(t, "/api/archive/unzip", unzip, "application/json",
+		outsideJSONBody(t, map[string]any{"zipPath": "temp/payload.zip", "path": "data"}))
+	checkOutsidePage(t, "after unzip", "new")
+	checkOutsideDatabase(t, "after unzip", "New table")
+}
