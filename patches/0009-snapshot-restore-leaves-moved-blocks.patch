+
+//go:build fts5
+
+package model
+
+import (
+	"bytes"
+	"fmt"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/sql"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const (
+	movedKitchenID  = "20261019100000-kitchen" // "Kitchen renovation", the page restored
+	movedSamID      = "20261019100000-sampage" // "Sam", the page its blocks move to after the snapshot
+	movedSinkID     = "20261019100000-sink001" // a paragraph moved to Sam's page
+	movedListID     = "20261019100000-list001" // a list moved to Sam's page, with its item and the item's paragraph
+	movedItemID     = "20261019100000-item001"
+	movedItemParaID = "20261019100000-itemp01"
+	movedKeptID     = "20261019100000-kept001" // a paragraph that stays in Kitchen renovation
+	movedGoneID     = "20261019100000-gone001" // a paragraph deleted from Kitchen renovation
+	movedSamParaID  = "20261019100000-samp001" // Sam's own paragraph
+
+	movedSinkText = "Ask Sam about the sink."
+	movedTapsText = "Taps"
+)
+
+func movedTestNodeID(n *ast.Node) string {
+	if nil == n {
+		return "none"
+	}
+	return n.ID
+}
+
+func movedTestParagraph(id, text string) *ast.Node {
+	paragraph := treenode.NewParagraph(id)
+	paragraph.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte(text)})
+	return paragraph
+}
+
+// writeMovedTestPage writes a page holding blocks and indexes it in the block record and SQL.
+func writeMovedTestPage(t *testing.T, boxID, id, title string, blocks ...*ast.Node) {
+	t.Helper()
+	tree := treenode.NewTree(boxID, "/"+id+".sy", "/"+title, title)
+	tree.Root.FirstChild.Unlink() // the empty paragraph a new page starts with
+	for _, block := range blocks {
+		tree.Root.AppendChild(block)
+	}
+	if _, err := filesys.WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	treenode.UpsertBlockTree(tree)
+	sql.IndexTreeQueue(tree)
+}
+
+// snapshotMovedTestPage takes a snapshot of the workspace and returns the id of the page's file in it.
+func snapshotMovedTestPage(t *testing.T, boxID, pageID string) (fileID string) {
+	t.Helper()
+	originalRepoDir := util.RepoDir
+	util.RepoDir = filepath.Join(util.WorkspaceDir, "repo")
+	t.Cleanup(func() { util.RepoDir = originalRepoDir })
+	Conf.Repo.Store(&conf.Repo{Key: bytes.Repeat([]byte{7}, 32)}) // snapshots need the repository's key
+	Conf.System.Store(&conf.System{ID: "20261019100000-device1", Name: "test", OS: "linux"})
+	originalStatusBar := util.StatusBarCfg.Load()
+	util.StatusBarCfg.Store(util.NewStatusBar(false))
+	t.Cleanup(func() { util.StatusBarCfg.Store(originalStatusBar) })
+
+	snapshotID, err := IndexRepo("before the blocks moved")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	index, err := repo.GetIndex(snapshotID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	for _, id := range index.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if "/"+boxID+"/"+pageID+".sy" == file.Path {
+			fileID = id
+		}
+	}
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no page %s", pageID)
+	}
+	return
+}
+
+func performMovedTestTx(t *testing.T, what string, op *Operation) {
+	t.Helper()
+	if err := PerformTxSync(&Transaction{DoOperations: []*Operation{op}}); nil != err {
+		t.Fatalf("%s failed: %v", what, err)
+	}
+	sql.FlushQueue()
+}
+
+// loadMovedTestPage reads a page from its file and returns it with its blocks by id.
+func loadMovedTestPage(t *testing.T, boxID, pageID string) (tree *parse.Tree, blocks map[string]*ast.Node) {
+	t.Helper()
+	tree, err := filesys.LoadTree(boxID, "/"+pageID+".sy", util.NewLute())
+	if nil != err {
+		t.Fatalf("read page %s failed: %v", pageID, err)
+	}
+	blocks = map[string]*ast.Node{}
+	ast.Walk(tree.Root, func(n *ast.Node, entering bool) ast.WalkStatus {
+		if entering && n.IsBlock() {
+			blocks[n.ID] = n
+		}
+		return ast.WalkContinue
+	})
+	return
+}
+
+// Restoring one page from a snapshot leaves the blocks moved from it to another page since only in that page, and
+// gives the restored page the snapshot's copy of them under new ids. On SiYuan v3.8.7 the restore kept every block's
+// id, so a moved paragraph was then in both pages under one id: two rows in the block record and two in SQL, reads by
+// id naming the other page, and an edit by id saved there while the restored page kept the old text. The restored
+// page's own blocks, and a paragraph deleted from it since, keep their ids, as a restore from history does.
+func TestOnePageSnapshotRestoreLeavesBlocksMovedSinceInTheirNewPage(t *testing.T) {
+	boxID, _ := setupRestoreCacheTest(t)
+	list := &ast.Node{Type: ast.NodeList, ID: movedListID, ListData: &ast.ListData{Typ: 1}}
+	list.SetIALAttr("id", movedListID)
+	item := &ast.Node{Type: ast.NodeListItem, ID: movedItemID, ListData: &ast.ListData{Typ: 1}}
+	item.SetIALAttr("id", movedItemID)
+	item.AppendChild(movedTestParagraph(movedItemParaID, movedTapsText))
+	list.AppendChild(item)
+	writeMovedTestPage(t, boxID, movedKitchenID, "Kitchen renovation", movedTestParagraph(movedKeptID, "Measure the window."),
+		movedTestParagraph(movedSinkID, movedSinkText), list, movedTestParagraph(movedGoneID, "Buy tiles."))
+	writeMovedTestPage(t, boxID, movedSamID, "Sam", movedTestParagraph(movedSamParaID, "Sam's number."))
+	sql.FlushQueue()
+	fileID := snapshotMovedTestPage(t, boxID, movedKitchenID)
+
+	// As the editor sends them: the paragraph and the list dragged into Sam's page, and a paragraph deleted.
+	performMovedTestTx(t, "setup: moving the paragraph", &Operation{Action: "move", ID: movedSinkID, ParentID: movedSamID, PreviousID: movedSamParaID})
+	performMovedTestTx(t, "setup: moving the list", &Operation{Action: "move", ID: movedListID, ParentID: movedSamID, PreviousID: movedSinkID})
+	performMovedTestTx(t, "setup: deleting a paragraph", &Operation{Action: "delete", ID: movedGoneID})
+
+	if err := RollbackRepoSnapshotFile(fileID); nil != err {
+		t.Fatalf("roll the page back to the snapshot failed: %v", err)
+	}
+	sql.FlushQueue()
+
+	moved := []string{movedSinkID, movedListID, movedItemID, movedItemParaID}
+	for _, bt := range treenode.GetBlockTreesByRootID(movedKitchenID) {
+		if slices.Contains(moved, bt.ID) {
+			t.Errorf("the block record places moved block %s in the restored page too", bt.ID)
+		}
+	}
+	for _, id := range moved {
+		if bt := treenode.GetBlockTree(id); nil == bt || movedSamID != bt.RootID {
+			t.Errorf("the block record doesn't place moved block %s in Sam's page: %+v", id, bt)
+		}
+		rows, err := sql.QueryNoLimit("SELECT root_id FROM blocks WHERE id = '" + id + "'")
+		if nil != err || 1 != len(rows) || movedSamID != rows[0]["root_id"] {
+			t.Errorf("SQL holds %v for moved block %s, not one row under Sam's page (%v)", rows, id, err)
+		}
+	}
+
+	kitchen, blocks := loadMovedTestPage(t, boxID, movedKitchenID)
+	if movedKitchenID != kitchen.ID {
+		t.Errorf("the restored page's id is %s, not %s", kitchen.ID, movedKitchenID)
+	}
+	for _, id := range moved {
+		if nil != blocks[id] {
+			t.Errorf("the restored page holds moved block %s under its old id", id)
+		}
+	}
+	for id, text := range map[string]string{movedKeptID: "Measure the window.", movedGoneID: "Buy tiles."} {
+		if nil == blocks[id] || text != blocks[id].Text() {
+			t.Errorf("the restored page doesn't hold %q under its own id %s", text, id)
+		}
+	}
+	copies := map[string]*ast.Node{}
+	for _, b := range blocks {
+		if ast.NodeParagraph == b.Type {
+			copies[b.Text()] = b
+		}
+	}
+	if sink := copies[movedSinkText]; nil == sink || slices.Contains(moved, sink.ID) {
+		t.Errorf("the restored page doesn't hold the snapshot's %q under a new id: %s", movedSinkText, movedTestNodeID(sink))
+	}
+	if taps := copies[movedTapsText]; nil == taps || ast.NodeListItem != taps.Parent.Type || ast.NodeList != taps.Parent.Parent.Type ||
+		slices.Contains(moved, taps.ID) || slices.Contains(moved, taps.Parent.ID) || slices.Contains(moved, taps.Parent.Parent.ID) {
+		t.Errorf("the restored page doesn't hold the snapshot's list under new ids: its paragraph is %s", movedTestNodeID(taps))
+	}
+
+	// An edit by the moved paragraph's id changes Sam's page only.
+	edited := "Ask Sam about the sink and the taps."
+	performMovedTestTx(t, "editing the moved paragraph", &Operation{Action: "update", ID: movedSinkID,
+		Data: fmt.Sprintf(`<div data-node-id="%s" data-type="NodeParagraph"><div contenteditable="true">%s</div></div>`, movedSinkID, edited)})
+	if _, sam := loadMovedTestPage(t, boxID, movedSamID); nil == sam[movedSinkID] || edited != sam[movedSinkID].Text() {
+		t.Errorf("the edit by id didn't reach the paragraph in Sam's page: %s", movedTestNodeID(sam[movedSinkID]))
+	}
+	_, blocks = loadMovedTestPage(t, boxID, movedKitchenID)
+	kept := false
+	for _, b := range blocks {
+		if edited == b.Text() {
+			t.Errorf("the edit by the moved paragraph's id changed the restored page's block %s", b.ID)
+		}
+		kept = kept || (ast.NodeParagraph == b.Type && movedSinkText == b.Text())
+	}
+	if !kept {
+		t.Errorf("after the edit, the restored page no longer holds the snapshot's %q", movedSinkText)
+	}
+}
