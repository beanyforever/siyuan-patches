+// doc2HeadingChallenge is /api/filetree/doc2Heading. Doc2Heading refreshes the two pages' backlinks on a goroutine of
+// its own, after SQL's flush interval, which reads Conf, so the test waits for it before its fixtures set Conf back.
+func doc2HeadingChallenge(t *testing.T, srcID, targetID string) {
+	t.Helper()
+	select {
+	case <-doc2HeadingRefreshed:
+	default:
+	}
+	_, _, err := Doc2Heading(srcID, targetID, false)
+	t.Cleanup(func() {
+		select {
+		case <-doc2HeadingRefreshed:
+		case <-time.After(util.SQLFlushInterval + 10*time.Second):
+			if nil == err {
+				t.Error("doc2Heading didn't finish refreshing backlinks within 13 s")
+			}
+		}
+	})
+	if nil != err {
+		t.Fatalf("doc2Heading failed: %v", err)
+	}
+}
