+		requireTripwireFileHolds(t, "the first save from site A", avPath, attrView.Name)
+		checkTripwireSite(t, "after the first save from site A", log.linesSince(t, begin), siteA, "database", 1)
+
+		attrView.Name = "Saved from A twice"
+		if _, err = tripwireSaveDatabaseA(attrView); nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the second save from site A", avPath, attrView.Name)
+		checkTripwireSite(t, "after the second save from site A", log.linesSince(t, begin), siteA, "database", 1)
+
+		attrView.Name = "Saved from B"
+		siteB, err := tripwireSaveDatabaseB(attrView)
+		if nil != err {
