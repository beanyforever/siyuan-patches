+		t.Fatal(err)
+	}
+	key := []byte("0123456789abcdef0123456789abcdef")
+	previousWorkspace, previousRepo, previousStatusBar := util.WorkspaceDir, util.RepoDir, util.StatusBarCfg.Load()
+	t.Cleanup(func() {
+		util.WorkspaceDir, util.RepoDir = previousWorkspace, previousRepo
+		util.StatusBarCfg.Store(previousStatusBar)
+	})
+	util.WorkspaceDir = filepath.Dir(util.DataDir)
+	util.RepoDir = filepath.Join(base, "repo")
+	util.StatusBarCfg.Store(&util.StatusBar{MsgDataSyncDisabled: true})
+	syncConf, repoConf, systemConf := conf.NewSync(), conf.NewRepo(), conf.NewSystem()
+	syncConf.Provider, syncConf.CloudName, syncConf.Enabled = conf.ProviderLocal, "main", true
+	syncConf.Local = &conf.Local{Endpoint: remote}
+	repoConf.Key = key
+	systemConf.ID, systemConf.Name, systemConf.OS = "kernel-device", "kernel-device", "linux"
+	Conf.Sync.Store(syncConf)
+	Conf.Repo.Store(repoConf)
+	Conf.System.Store(systemConf)
+	Conf.Search.Store(conf.NewSearch())
+
+	// The other device holds the same workspace with the page's new copy, saved an hour later, so the merge takes the
+	// cloud's copy (dejavu keeps the local one only when it isn't over 7 minutes older). Every other file carries the
+	// same time on both devices.
+	if err = os.MkdirAll(filepath.Join(util.DataDir, ".siyuan"), 0755); nil != err {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(util.DataDir, ".siyuan", "syncignore"), nil, 0644); nil != err {
+		t.Fatal(err)
+	}
+	otherDir := filepath.Join(base, "other")
+	otherData := filepath.Join(otherDir, "data")
+	if err = os.CopyFS(otherData, os.DirFS(util.DataDir)); nil != err {
+		t.Fatal(err)
+	}
+	otherPage := filepath.Join(otherData, f.work, page.path())
+	if err = os.WriteFile(otherPage, replaceOutsideJSONString(t, pageData, "custom-v", "old", "new"), 0644); nil != err {
+		t.Fatal(err)
+	}
+	for _, dir := range []string{util.DataDir, otherData} {
+		stampOutsideFiles(t, dir, time.Unix(1700000010, 0))
+	}
+	if err = os.Chtimes(otherPage, time.Unix(1700003610, 0), time.Unix(1700003610, 0)); nil != err {
+		t.Fatal(err)
+	}
+	backend := cloud.NewLocal(&cloud.BaseCloud{Conf: &cloud.Conf{Dir: "main", RepoPath: filepath.Join(otherDir, "repo"),
+		AvailableSize: 1 << 30, Local: &cloud.ConfLocal{Endpoint: remote}}})
+	other, err := dejavu.NewRepo(otherData, filepath.Join(otherDir, "repo"), filepath.Join(otherDir, "history"),
+		filepath.Join(otherDir, "temp"), "other-device", "other-device", "linux", key, nil, backend)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if _, err = other.Index("other device", true, nil); nil != err {
+		t.Fatal(err)
+	}
+	if _, _, err = other.Sync(nil); nil != err {
