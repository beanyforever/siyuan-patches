+package filesys
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const (
+	raiseBox      = "20261017130000-raisebx"
+	raiseParent   = "20261017130001-parent1"
+	raiseChild    = "20261017130002-child01"
+	raiseOutside  = "20261017130003-outside"
+	raiseAV       = "20261017130004-databas"
+	raiseBoxAV    = "20261017130005-boxdbas"
+	raiseStrayAV  = "20261017130006-strayav"
+	raiseHistory  = "20261017130007-history"
+	raiseNotAPage = "notes"
+)
+
+// setupRaiseTest makes a data folder with a notebook holding a page with a sub-page and a page beside it, a database in
+// data/storage/av, an encrypted notebook's database in its own storage/av, and files that are neither.
+func setupRaiseTest(t *testing.T) (dataDir string) {
+	t.Helper()
+	original := util.DataDir
+	workspace := t.TempDir()
+	util.DataDir = filepath.Join(workspace, "data")
+	t.Cleanup(func() { util.DataDir = original })
+	for _, p := range []string{
+		filepath.Join(raiseBox, raiseParent+".sy"),
+		filepath.Join(raiseBox, raiseParent, raiseChild+".sy"),
+		filepath.Join(raiseBox, raiseParent, raiseNotAPage+".sy"),
+		filepath.Join(raiseBox, raiseOutside+".sy"),
+		filepath.Join(raiseBox, ".siyuan", "conf.json"),
+		filepath.Join(raiseBox, "storage", "av", raiseBoxAV+".json"),
+		filepath.Join(raiseBox, raiseParent, "storage", "av", raiseStrayAV+".json"),
+		filepath.Join("storage", "av", raiseAV+".json"),
+		filepath.Join("storage", "av", "blocks.msgpack"),
+		filepath.Join("assets", "image.png"),
+		filepath.Join("..", "history", "2026-10-17-130000-update", raiseBox, raiseHistory+".sy"),
+	} {
+		abs := filepath.Join(util.DataDir, p)
+		if err := os.MkdirAll(filepath.Dir(abs), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(abs, []byte("{}"), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return util.DataDir
+}
+
+func collectForRaiseTest(paths ...string) (t dataPathTargets) {
+	for _, p := range paths {
+		t.collect(p)
+	}
+	slices.Sort(t.pages)
+	slices.SortFunc(t.avs, func(a, b cache.AVKey) int {
+		if a.AVID != b.AVID {
+			if a.AVID < b.AVID {
+				return -1
+			}
+			return 1
+		}
+		if a.BoxID < b.BoxID {
+			return -1
+		}
+		if a.BoxID > b.BoxID {
+			return 1
+		}
+		return 0
+	})
+	return
+}
+
+// A path names the pages and databases a write there changed: a page file its page, a live database file its database
+// in its notebook, a folder what it holds, data/ or a folder holding it everything, and anything outside data/ nothing.
+func TestDataPathsNameWhatTheyHold(t *testing.T) {
+	dataDir := setupRaiseTest(t)
+	for name, c := range map[string]struct {
+		paths []string
+		pages []string
+		avs   []cache.AVKey
+		all   bool
+	}{
+		"page file":                   {paths: []string{filepath.Join(dataDir, raiseBox, raiseOutside+".sy")}, pages: []string{raiseOutside}},
+		"page file removed":           {paths: []string{filepath.Join(dataDir, raiseBox, "20261017130009-removed.sy")}, pages: []string{"20261017130009-removed"}},
+		"page's folder":               {paths: []string{filepath.Join(dataDir, raiseBox, raiseParent)}, pages: []string{raiseChild}},
+		"page file and its folder":    {paths: []string{filepath.Join(dataDir, raiseBox, raiseParent+".sy"), filepath.Join(dataDir, raiseBox, raiseParent)}, pages: []string{raiseParent, raiseChild}},
+		"notebook":                    {paths: []string{filepath.Join(dataDir, raiseBox)}, pages: []string{raiseParent, raiseChild, raiseOutside}, avs: []cache.AVKey{{AVID: raiseBoxAV, BoxID: raiseBox}}},
+		"database":                    {paths: []string{filepath.Join(dataDir, "storage", "av", raiseAV+".json")}, avs: []cache.AVKey{{AVID: raiseAV}}},
+		"database folder":             {paths: []string{filepath.Join(dataDir, "storage")}, avs: []cache.AVKey{{AVID: raiseAV}}},
+		"encrypted notebook database": {paths: []string{filepath.Join(dataDir, raiseBox, "storage", "av", raiseBoxAV+".json")}, avs: []cache.AVKey{{AVID: raiseBoxAV, BoxID: raiseBox}}},
+		"database file elsewhere":     {paths: []string{filepath.Join(dataDir, raiseBox, raiseParent, "storage", "av", raiseStrayAV+".json")}},
+		"data":                        {paths: []string{dataDir}, all: true},
+		"data with a trailing slash":  {paths: []string{dataDir + string(filepath.Separator)}, all: true},
+		"workspace":                   {paths: []string{filepath.Dir(dataDir)}, all: true},
+		"history":                     {paths: []string{filepath.Join(filepath.Dir(dataDir), "history")}},
+		"history page":                {paths: []string{filepath.Join(filepath.Dir(dataDir), "history", "2026-10-17-130000-update", raiseBox, raiseHistory+".sy")}},
+		"assets":                      {paths: []string{filepath.Join(dataDir, "assets")}},
+		"notebook settings":           {paths: []string{filepath.Join(dataDir, raiseBox, ".siyuan", "conf.json")}},
+		"a folder beside data's name": {paths: []string{dataDir + "2"}},
+		"no path":                     {paths: []string{""}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			got := collectForRaiseTest(c.paths...)
+			if got.all != c.all || !slices.Equal(got.pages, c.pages) || !slices.Equal(got.avs, c.avs) {
+				t.Fatalf("got pages %v, databases %v, all %v; want pages %v, databases %v, all %v", got.pages, got.avs, got.all, c.pages, c.avs, c.all)
+			}
+		})
+	}
+}
+
+// RaiseForDataPath raises what a folder holds after a write into it, and nothing beside it.
+func TestRaiseForDataPathRaisesWhatAFolderHolds(t *testing.T) {
+	dataDir := setupRaiseTest(t)
+	noted := cache.NewFillToken()
+	RaiseForDataPath(filepath.Join(dataDir, raiseBox, raiseParent))
+	if cache.TreeFresh(raiseChild, noted) {
+		t.Fatal("a page in the folder written was not raised")
+	}
+	if !cache.TreeFresh(raiseOutside, noted) || !cache.TreeFresh(raiseParent, noted) {
+		t.Fatal("a page beside the folder written was raised")
+	}
+}
+
+// A remove bracketed by BeginDataPathWrite raises what the folder held before it took it away.
+func TestBeginDataPathWriteRaisesWhatARemoveTookAway(t *testing.T) {
+	dataDir := setupRaiseTest(t)
+	notebook := filepath.Join(dataDir, raiseBox)
+	t.Cleanup(cache.ClearAVCache)
+	avVersion := cache.EnsureAVDataVersionInBox(raiseBoxAV, raiseBox)
+	noted := cache.NewFillToken()
+
+	end := BeginDataPathWrite(notebook)
+	if err := os.RemoveAll(notebook); err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []string{raiseParent, raiseChild, raiseOutside} {
+		if !cache.TreeFresh(id, noted) {
+			t.Fatalf("page %s was raised before the write ended", id)
+		}
+	}
+	end()
+
+	for _, id := range []string{raiseParent, raiseChild, raiseOutside} {
+		if cache.TreeFresh(id, noted) {
+			t.Fatalf("page %s, which the remove took away, was not raised", id)
+		}
+	}
+	if cache.EnsureAVDataVersionInBox(raiseBoxAV, raiseBox) == avVersion {
+		t.Fatal("the notebook's database, which the remove took away, was not raised")
+	}
+}
+
+// A copy names what it wrote where it landed, and not what its destination held beside it; a copy into data/ itself
+// names everything.
+func TestDataCopiesNameWhatTheyWrote(t *testing.T) {
+	dataDir := setupRaiseTest(t)
+	const copied, copiedChild, copiedAV = "20261017130010-copied1", "20261017130011-copied2", "20261017130012-copieda"
+	src := filepath.Join(t.TempDir(), "import")
+	for _, p := range []string{
+		filepath.Join(copied + ".sy"),
+		filepath.Join(copied, copiedChild+".sy"),
+		filepath.Join("storage", "av", copiedAV+".json"),
+	} {
+		abs := filepath.Join(src, p)
+		if err := os.MkdirAll(filepath.Dir(abs), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(abs, []byte("{}"), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	var into dataPathTargets
+	into.collectCopy(src, filepath.Join(dataDir, raiseBox))
+	slices.Sort(into.pages)
+	if want := []string{copied, copiedChild}; into.all || !slices.Equal(into.pages, want) {
+		t.Fatalf("a copy into a notebook named pages %v, all %v; want %v", into.pages, into.all, want)
+	}
+	if want := []cache.AVKey{{AVID: copiedAV, BoxID: raiseBox}}; !slices.Equal(into.avs, want) {
+		t.Fatalf("a copy into a notebook named databases %v; want %v", into.avs, want)
+	}
+
+	var file dataPathTargets
+	file.collectCopy(filepath.Join(src, copied+".sy"), filepath.Join(dataDir, raiseBox, copied+".sy"))
+	if want := []string{copied}; !slices.Equal(file.pages, want) {
+		t.Fatalf("a copied page file named pages %v; want %v", file.pages, want)
+	}
+
+	var whole dataPathTargets
+	whole.collectCopy(src, dataDir)
+	if !whole.all {
+		t.Fatal("a copy into data/ didn't name everything")
+	}
+
+	var elsewhere dataPathTargets
+	elsewhere.collectCopy(filepath.Join(dataDir, raiseBox), filepath.Join(filepath.Dir(dataDir), "history", "copy"))
+	if elsewhere.all || 0 < len(elsewhere.pages) || 0 < len(elsewhere.avs) {
+		t.Fatalf("a copy out of data/ named pages %v, databases %v, all %v", elsewhere.pages, elsewhere.avs, elsewhere.all)
+	}
+
+	noted := cache.NewFillToken()
+	RaiseForDataCopy(src, filepath.Join(dataDir, raiseBox))
+	if cache.TreeFresh(copied, noted) || cache.TreeFresh(copiedChild, noted) {
+		t.Fatal("a copied page was not raised")
+	}
+	if !cache.TreeFresh(raiseOutside, noted) || !cache.TreeFresh(raiseParent, noted) {
+		t.Fatal("a page the destination held beside the copy was raised")
+	}
+}
