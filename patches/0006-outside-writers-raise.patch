+			len(mergeResult.Upserts), len(mergeResult.Removes), mergeResult.ConflictCount())
+	}
+	if "new" != fileDuring {
+		t.Fatal("setup: the page's file didn't hold the cloud's copy when the sync uploaded its index")
+	}
+	if "new" != servedDuring {
+		t.Errorf("while the sync uploaded, after it had written the cloud's copy of the page, getBlockAttrs gave the "+
