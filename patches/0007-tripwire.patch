+// Probe: a job whose page write panics leaves no turn behind, whether it runs at once (PerformTxSync) or through the
+// queue: a save outside a turn after it is still logged.
+func TestTripwireProbeAPanickingJobLeavesNoTurn(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+
+		tx := &Transaction{DoOperations: jobAttrsOperations(files)}
+		tx.writeTransactionTree = func(*parse.Tree) error { panic("probe: the job's page write panics") }
+		_ = PerformTxSync(tx)
+		if tripwire.InTurn() {
+			t.Fatal("after a job run at once panicked, the turn is still held")
+		}
+
+		queued := &Transaction{DoOperations: jobAttrsOperations(files)}
+		queued.writeTransactionTree = func(*parse.Tree) error { panic("probe: the queued job's page write panics") }
+		PerformTransactions(&[]*Transaction{queued})
+		WaitForTransactions([]*Transaction{queued})
+		FlushTxQueue()
+		if tripwire.InTurn() {
+			t.Fatal("after a queued job panicked, the turn is still held")
+		}
+
+		log := newTripwireLog(t)
+		checkPageControl(t, log, loadTripwirePage(t, files.box.ID, files.sourcePath))
+	})
+}
