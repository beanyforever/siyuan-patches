+package model
+
+// Writers that SiYuan also reaches while a job holds the turn don't wait for the turn again (issue #43, step 6):
+// flushLock can't be taken twice. Each case runs in a process of its own, since a deadlocked turn would hold up every
+// later test, and must finish within turnDeadlockWait; on a timeout it prints the goroutines waiting in SiYuan's code
+// and fails. These are guards on SiYuan before step 6, where no writer takes the turn.
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const turnDeadlockWait = 10 * time.Second
+
+// Undoing "+ New" deletes the page it made in the job's commit, through removeDoc, the function page deletion runs.
+func TestPageDeletionInsideAJobDoesntDeadlock(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		d := setupTurnNewItemDatabase(t, "")
+		created, err := CreateAttributeViewItem(d.attrView.ID, d.blockID, d.attrView.Views[0].ID, d.template.ID, "", "")
+		if nil != err {
+			t.Fatal(err)
+		}
+		pagePath := pageFile(t, created.BlockID).Path
+		undo := &Transaction{DoOperations: cloneOperations(created.Transaction.UndoOperations), isReplay: true}
+		requireFinishes(t, "undoing \"+ New\", whose commit deletes the page it made", turnDeadlockWait, func() {
+			err = PerformTxSync(undo)
+		})
+		if nil != err {
+			t.Fatalf("undoing \"+ New\" failed: %v", err)
+		}
+		if _, statErr := os.Stat(filepath.Join(util.DataDir, d.files.box.ID, pagePath)); !os.IsNotExist(statErr) {
+			t.Errorf("setup: undoing \"+ New\" left the page it made (%v)", statErr)
+		}
+	})
+}
+
+// A job that edits a block refreshes, in its commit, the dynamic reference texts that show the block, and the rows of
+// the databases the block is a row of: refreshDynamicRefTexts and updateAttributeViewBlockText, the functions the
+// ref-text job and the refresh after a move run.
+func TestRefTextRefreshInsideAJobDoesntDeadlock(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		f := setupTurnRefTextFixture(t)
+		edit := fmt.Sprintf(`<div data-node-id="%s" data-type="NodeParagraph" %s="%s"><div contenteditable="true">`+
+			`Edited text</div></div>`, f.definition.ID, av.NodeAttrNameAvs, f.db.avID)
+		var err error
+		requireFinishes(t, "a job editing a block that a page refers to and a database shows", turnDeadlockWait, func() {
+			err = PerformTxSync(&Transaction{DoOperations: []*Operation{{Action: "update", ID: f.definition.ID, Data: edit}}})
+		})
+		if nil != err {
+			t.Fatalf("the edit failed: %v", err)
+		}
+		if got, want := refText(t, f.files.sourceID, f.ref.ID), f.definition.ID+" Edited text"; want != got {
+			t.Errorf("setup: after the edit the referring page holds %q, want %q: the commit didn't refresh it", got, want)
+		}
+	})
+}
+
+// The ref-text job's retry of a refresh that failed takes the turn, and refreshes within it through
+// refreshDynamicRefTextsWithWriter.
+func TestRefTextRetryDoesntDeadlock(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		f := setupTurnRefTextFixture(t)
+		f.definition.FirstChild.Tokens = []byte("Retried text")
+		writeTurnPage(t, f.target)
+		dynamicRefTextRetries.Lock()
+		dynamicRefTextRetries.pending[dynamicRefTextRetryKey{f.files.box.ID, f.definition.ID}] = time.Time{}
+		dynamicRefTextRetries.Unlock()
+		requireFinishes(t, "the ref-text retry", turnDeadlockWait, flushDynamicRefTextRetries)
+		if got, want := refText(t, f.files.sourceID, f.ref.ID), f.definition.ID+" Retried text"; want != got {
+			t.Errorf("setup: after the retry the referring page holds %q, want %q: the retry didn't refresh it", got, want)
+		}
+	})
+}
