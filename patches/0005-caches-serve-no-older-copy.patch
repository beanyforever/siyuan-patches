+package filesys
+
+import (
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// Fix round 1 re-check (be97cad). A page write that panics after its file write still ends its bracket, raising the
+// page, and leaves no lock held: writeTreeBracketed defers EndTreeWrite, and the file write's lock is released by the
+// write's own defer. A test hook panics where a write would stall between its file write and its end. Then a copy noted
+// while the write was under way must not be current, and the next write of the page, which takes the same file lock
+// and the version map's lock, must end.
+func TestPanickingPageWriteRaisesItsPageAndReleasesItsLocks(t *testing.T) {
+	box, root, _, _ := setupStalePathTest(t)
+	tree := treenode.NewTree(box, "/"+root+".sy", "/Page", "Page")
+	if _, err := WriteTree(tree); err != nil {
+		t.Fatal(err)
+	}
+	var duringWrite cache.FillToken
+	testHookWriteTreeBeforeEnd = func() {
+		duringWrite = cache.NewFillToken()
+		panic("a page write panics before its end")
+	}
+	t.Cleanup(func() { testHookWriteTreeBeforeEnd = nil })
+	tree.Root.SetIALAttr("custom-n", "panicked")
+	func() {
+		defer func() {
+			if nil == recover() {
+				t.Error("setup: the write didn't panic")
+			}
+		}()
+		_, _ = WriteTree(tree)
+	}()
+	testHookWriteTreeBeforeEnd = nil
+	if cache.TreeFresh(tree.ID, duringWrite) {
+		t.Error("after a page write panicked, a copy noted while it was under way is current: its end didn't raise the page")
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		tree.Root.SetIALAttr("custom-n", "after")
+		_, err := WriteTree(tree)
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(10 * time.Second):
+		buf := make([]byte, 1<<20)
+		t.Fatalf("the next write of the page didn't end within 10 s, so the panicking write left a lock held:\n%s",
+			buf[:runtime.Stack(buf, true)])
+	}
+	loaded, err := LoadTree(box, tree.Path, util.NewLute())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := loaded.Root.IALAttr("custom-n"); "after" != got {
+		t.Errorf("after the write that followed the panic, the page loads custom-n=%q", got)
+	}
+}
