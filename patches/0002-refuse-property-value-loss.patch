+		}, nameMark},
+		{"pointing a relation property at another database", func(f *propertyGuardFixture) error {
+			return updateAttributeViewColRelation(&Operation{AvID: f.tasks, ID: f.people, KeyID: f.project, Format: "Project"})
+		}, projectLink},
+		{"breaking a relation property's pairing", func(f *propertyGuardFixture) error {
+			return updateAttributeViewColRelation(&Operation{AvID: f.tasks, ID: f.projects, KeyID: f.project, Format: "Project"})
+		}, projectLink},
+		{"breaking a relation property's pairing over MCP", func(f *propertyGuardFixture) error {
+			return UpdateAttributeViewKeyConfig(f.tasks, f.project, map[string]any{"relation": map[string]any{"avID": f.projects, "isTwoWay": false}})
+		}, projectLink},
+		{"pairing a relation property with another field", func(f *propertyGuardFixture) error {
+			return inEditor(&Operation{Action: "updateAttrViewColRelation", AvID: f.tasks, ID: f.projects, KeyID: f.project, Format: "Project",
+				IsTwoWay: true, BackRelationKeyID: ast.NewNodeID(), Name: "Jobs"})
