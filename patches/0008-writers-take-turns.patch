+// checkSavesWithinTurns checks that SiYuan's log holds, after mark, no tripwire line for a save outside a turn from a
+// site in SiYuan's code: the first line of a site, or a further caller's. Sites in test files are the fixtures' saves.
+func checkSavesWithinTurns(t *testing.T, writer string, log *tripwireLog, mark int) {
+	t.Helper()
+	var outside []string
+	for _, line := range strings.Split(string(log.read(t)[mark:]), "\n") {
+		i := strings.Index(line, tripwire.Marker)
+		if 0 > i {
+			i = strings.Index(line, tripwire.CallerMarker)
+		}
+		if 0 > i {
+			continue
+		}
+		entry := strings.TrimSpace(line[i:])
+		// The entry is "<marker>: <kind> <package.Function> <file>:<line> <- <caller>".
+		fields := strings.Fields(entry[strings.Index(entry, ": ")+2:])
+		if 3 <= len(fields) && strings.Contains(fields[2], "_test.go:") {
+			continue
+		}
+		outside = append(outside, entry)
+	}
+	if 0 < len(outside) {
+		t.Errorf("%s saved outside a turn; the tripwire logged %q", writer, outside)
+	}
+}
