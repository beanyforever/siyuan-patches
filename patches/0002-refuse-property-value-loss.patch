+// reloadNotices are messages for the windows a reload sends away. Each window that connects again
+// within a minute is shown each one, up to as many windows as were open.
+var (
+	reloadNotices     []*reloadNotice
+	reloadNoticesLock sync.Mutex
+)
+
+type reloadNotice struct {
+	msg   string
+	left  int
+	until time.Time
+}
+
+// ReloadUIWithMsg reloads every open window, as ReloadUI does, and shows msg in each once it has
+// connected again: a message sent before the reload would go with the page.
+func ReloadUIWithMsg(msg string) {
+	open := len(SessionsByType("main"))
+	if 0 == open {
+		return
+	}
+	reloadNoticesLock.Lock()
+	reloadNotices = append(reloadNotices, &reloadNotice{msg: msg, left: open, until: time.Now().Add(time.Minute)})
+	reloadNoticesLock.Unlock()
+	ReloadUI()
+}
+
+func pushReloadNotices(session *melody.Session) {
+	reloadNoticesLock.Lock()
+	defer reloadNoticesLock.Unlock()
+	now := time.Now()
+	var kept []*reloadNotice
+	for _, notice := range reloadNotices {
+		if now.After(notice.until) {
+			continue
+		}
+		// Shown as information, which stays until closed: an error's text gets SiYuan's version added,
+		// as for a bug report.
+		event := NewResult()
+		event.Cmd = "msg"
+		event.Msg = notice.msg
+		event.Data = map[string]any{"id": gulu.Rand.String(7), "closeTimeout": 0}
+		session.Write(event.Bytes())
+		notice.left--
+		if 0 < notice.left {
+			kept = append(kept, notice)
+		}
+	}
+	reloadNotices = kept
+}
