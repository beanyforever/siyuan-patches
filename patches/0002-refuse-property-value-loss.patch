+
+// Edits that would destroy the values a database property holds are refused before anything
+// changes. A property is a field whose description starts with "key: <key>": the key says what the
+// field means across databases, so views, rules and fixes find the field by it, whatever its name.
+// A field without a key is outside the schema and left alone, and so is a property no row fills in
+// yet, since an edit to it loses nothing; a primary field's Type mark is kept whatever the rows
+// hold, since it says which Type the database holds. The checks run in the shared
+// functions every way in reaches: the editor and /api/transactions through the transaction path,
+// which also checks a whole transaction before applying any of it, and /api/av/*, the MCP
+// database tool and the CLI directly. A refused edit leaves the database as it was and returns the
+// reason as its error.
+
+const attributeViewPropertyKeyPrefix = "key: "
+
+// attributeViewTypeMarkPattern finds the Type mark on a primary field's description, as in
+// "key: name (type: note)": it tells which Type a database holds.
+var attributeViewTypeMarkPattern = regexp.MustCompile(`\(type: [^()]*\)`)
+
+// AttributeViewEditRefusal is an edit refused because it would destroy property values.
+type AttributeViewEditRefusal struct {
+	msg string
+}
+
+func (r *AttributeViewEditRefusal) Error() string {
+	return r.msg
+}
+
+func refuseAttributeViewEdit(format string, args ...any) error {
+	return &AttributeViewEditRefusal{msg: fmt.Sprintf(format, args...)}
+}
+
+// attributeViewTxErr is the transaction error for a failed database operation. A refusal reloads
+// the open windows, which already show the edit, and then tells them why.
+func attributeViewTxErr(operation *Operation, err error) *TxErr {
+	var refusal *AttributeViewEditRefusal
+	if errors.As(err, &refusal) {
+		return &TxErr{code: TxErrCodeRefused, msg: refusal.msg}
+	}
+	return &TxErr{code: TxErrHandleAttributeView, id: operation.AvID, msg: err.Error()}
+}
+
+// attributeViewPropertyKey is the property key a field's description holds, read as the tooling
+// that writes keys reads it: the text after "key: " up to the first space.
+func attributeViewPropertyKey(desc string) string {
+	if !strings.HasPrefix(desc, attributeViewPropertyKeyPrefix) {
+		return ""
+	}
+	key, _, _ := strings.Cut(desc[len(attributeViewPropertyKeyPrefix):], " ")
+	return key
+}
+
+// isGuardedAttributeViewProperty reports whether a field is a property holding values that an edit
+// could destroy: its description carries a key, and a row the database lists holds a value in it. A
+// property no row fills in yet, such as one just added or a copy "Duplicate" made, loses nothing, so
+// it is left alone like a field outside the schema: its key can be fixed, an edit undone, the field
+// deleted.
+func isGuardedAttributeViewProperty(attrView *av.AttributeView, key *av.Key) bool {
+	return "" != attributeViewPropertyKey(key.Desc) && attributeViewFieldHoldsValues(attrView, key)
+}
+
+// attributeViewListedItems are the rows a database lists. A value stored for any other item, such
+// as one left by a deleted page, belongs to no row.
+func attributeViewListedItems(attrView *av.AttributeView) map[string]bool {
+	ret := map[string]bool{}
+	if blockValues := attrView.GetBlockKeyValues(); nil != blockValues {
+		for _, value := range blockValues.Values {
+			ret[value.BlockID] = true
+		}
+	}
+	return ret
+}
+
+func attributeViewFieldHoldsValues(attrView *av.AttributeView, key *av.Key) bool {
+	kv, _ := attrView.GetKeyValues(key.ID)
+	if nil == kv {
+		return false
+	}
+	listed := attributeViewListedItems(attrView)
+	for _, value := range kv.Values {
+		if nil == value || !listed[value.BlockID] {
+			continue
+		}
+		switch {
+		case av.KeyTypeRelation == key.Type || av.KeyTypeRelation == value.Type:
+			if nil != value.Relation && 0 < len(value.Relation.BlockIDs) {
+				return true
+			}
+		case av.KeyTypeRollup == key.Type || av.KeyTypeRollup == value.Type:
+			// Computed from other fields, so nothing of its own is lost.
+		case !value.IsEmpty():
+			return true
+		}
+	}
+	return false
+}
+
+// attributeViewOptionUses counts the rows of a database whose field holds the option, leaving out
+// the rows in except.
+func attributeViewOptionUses(attrView *av.AttributeView, keyID, option string, except map[string]bool) (ret int) {
+	kv, _ := attrView.GetKeyValues(keyID)
+	if nil == kv {
+		return
+	}
+	listed := attributeViewListedItems(attrView)
+	for _, value := range kv.Values {
+		if nil == value || !listed[value.BlockID] || except[value.BlockID] {
+			continue
+		}
+		for _, selected := range value.MSelect {
+			if nil != selected && selected.Content == option {
+				ret++
+				break
+			}
+		}
+	}
+	return
+}
+
+func attributeViewFieldLabel(key *av.Key) string {
+	if name := strings.TrimSpace(key.Name); "" != name {
+		return name
+	}
+	return "This field"
+}
+
+func attributeViewLabel(attrView *av.AttributeView) string {
+	if nil != attrView {
+		if name := strings.TrimSpace(attrView.Name); "" != name {
+			return name
+		}
+	}
+	return "another database"
+}
+
+func attributeViewRowsUsing(count int) string {
+	if 1 == count {
+		return "1 row uses it"
+	}
+	return fmt.Sprintf("%d rows use it", count)
+}
+
+// attributeViewLoader reads the databases a check needs besides the one it starts from.
+type attributeViewLoader func(avID string) *av.AttributeView
+
+func parsedAttributeViewLoader(attrView *av.AttributeView) attributeViewLoader {
+	return func(avID string) *av.AttributeView {
+		if avID == attrView.ID {
+			return attrView
+		}
+		ret, _ := av.ParseAttributeView(avID)
+		return ret
+	}
+}
+
+// checkAttributeViewFieldRemoval refuses deleting a property, and deleting a field whose two-way
+// partner is a property when the partner would be deleted with it.
+func checkAttributeViewFieldRemoval(attrView *av.AttributeView, key *av.Key, removeDest bool, load attributeViewLoader) error {
+	if isGuardedAttributeViewProperty(attrView, key) {
+		return refuseAttributeViewEdit("%s wasn't deleted: it's a property, and deleting it would empty the %s of every row in %s. Hide it from the view instead.",
+			attributeViewFieldLabel(key), attributeViewFieldLabel(key), attributeViewLabel(attrView))
+	}
+	relation := key.Relation
+	if !removeDest || av.KeyTypeRelation != key.Type || nil == relation || !relation.IsTwoWay || "" == relation.AvID {
+		return nil
+	}
+	dest := load(relation.AvID)
+	if nil == dest {
+		return nil
+	}
+	back, _ := dest.GetKey(relation.BackKeyID)
+	if nil == back || av.KeyTypeRelation != back.Type || nil == back.Relation || back.Relation.AvID != attrView.ID ||
+		!back.Relation.IsTwoWay || back.Relation.BackKeyID != key.ID || !isGuardedAttributeViewProperty(dest, back) {
+		return nil
+	}
+	return refuseAttributeViewEdit("%s wasn't deleted: its pair, %s in %s, is a property and would be deleted with it, emptying it on every row. Delete %s alone, keeping %s, or hide it from the view instead.",
+		attributeViewFieldLabel(key), attributeViewFieldLabel(back), attributeViewLabel(dest), attributeViewFieldLabel(key), attributeViewFieldLabel(back))
+}
+
+// checkAttributeViewFieldFormat refuses changing a property's format. A rename passes.
+func checkAttributeViewFieldFormat(attrView *av.AttributeView, key *av.Key, keyType av.KeyType) error {
+	if key.Type == keyType || !isGuardedAttributeViewProperty(attrView, key) {
+		return nil
+	}
+	return refuseAttributeViewEdit("%s's format wasn't changed: it's a property, and its values in %s would stop meaning what they mean. Add a new field with that format instead.",
+		attributeViewFieldLabel(key), attributeViewLabel(attrView))
+}
+
+// checkAttributeViewFieldDesc refuses removing or changing a property's key, or the Type mark on
+// a primary field. Adding either to a field without one passes, and so does any other text.
+func checkAttributeViewFieldDesc(attrView *av.AttributeView, key *av.Key, desc string) error {
+	if oldKey := attributeViewPropertyKey(key.Desc); "" != oldKey && attributeViewPropertyKey(desc) != oldKey &&
+		isGuardedAttributeViewProperty(attrView, key) {
+		return refuseAttributeViewEdit("%s's description wasn't changed: \"%s%s\" marks it as a property, and every view and rule relies on it. Keep it at the start and put any other text after a space.",
+			attributeViewFieldLabel(key), attributeViewPropertyKeyPrefix, oldKey)
+	}
+	if av.KeyTypeBlock != key.Type {
+		return nil
+	}
+	if oldMark := attributeViewTypeMarkPattern.FindString(key.Desc); "" != oldMark && attributeViewTypeMarkPattern.FindString(desc) != oldMark {
+		return refuseAttributeViewEdit("%s's description wasn't changed: \"%s\" says which Type %s holds. Keep it and change the rest.",
+			attributeViewFieldLabel(key), oldMark, attributeViewLabel(attrView))
+	}
+	return nil
+}
+
+// checkAttributeViewRelationChange refuses changing what a relation property links to, or whether
+// and with which field it is two-way, once it links to a database. Setting the first target
+// passes. The fields on the other side count too: the old partner loses its pairing, and the field
+// named as the new partner is pointed back at this one.
+func checkAttributeViewRelationChange(srcAv *av.AttributeView, operation *Operation, load attributeViewLoader) error {
+	key, _ := srcAv.GetKey(operation.KeyID)
+	if nil == key {
+		return nil
+	}
+	backKeyID := ""
+	if operation.IsTwoWay {
+		backKeyID = operation.BackRelationKeyID
+	}
+	relation := key.Relation
+	if nil != relation && "" != relation.AvID && isGuardedAttributeViewProperty(srcAv, key) &&
+		(relation.AvID != operation.ID || relation.IsTwoWay != operation.IsTwoWay || relation.BackKeyID != backKeyID) {
+		return attributeViewRelationRefusal(srcAv, key, false, load)
+	}
+	if nil != relation && relation.IsTwoWay && "" != relation.AvID &&
+		(relation.AvID != operation.ID || !operation.IsTwoWay || relation.BackKeyID != operation.BackRelationKeyID) {
+		if oldDest := load(relation.AvID); nil != oldDest {
+			oldBack, _ := oldDest.GetKey(relation.BackKeyID)
+			if nil != oldBack && nil != oldBack.Relation && oldBack.Relation.AvID == srcAv.ID && oldBack.Relation.IsTwoWay &&
+				isGuardedAttributeViewProperty(oldDest, oldBack) {
+				return attributeViewRelationRefusal(oldDest, oldBack, true, load)
+			}
+		}
+	}
+	if "" == operation.BackRelationKeyID {
+		return nil
+	}
+	dest := load(operation.ID)
+	if nil == dest {
+		return nil
+	}
+	back, _ := dest.GetKey(operation.BackRelationKeyID)
+	if nil == back || nil == back.Relation || "" == back.Relation.AvID || !isGuardedAttributeViewProperty(dest, back) {
+		return nil
+	}
+	pairedWith := ""
+	if operation.IsTwoWay {
+		pairedWith = operation.KeyID
+	}
+	if back.Relation.AvID != srcAv.ID || back.Relation.IsTwoWay != operation.IsTwoWay || back.Relation.BackKeyID != pairedWith {
+		return attributeViewRelationRefusal(dest, back, true, load)
+	}
+	return nil
+}
+
+func attributeViewRelationRefusal(attrView *av.AttributeView, key *av.Key, named bool, load attributeViewLoader) error {
+	label := attributeViewFieldLabel(key)
+	if named {
+		label += " in " + attributeViewLabel(attrView)
+	}
+	target := load(key.Relation.AvID)
+	pairing := ""
+	if key.Relation.IsTwoWay && nil != target {
+		if partner, _ := target.GetKey(key.Relation.BackKeyID); nil != partner {
+			pairing = ", paired with " + attributeViewFieldLabel(partner) + " there"
+		}
+	}
+	return refuseAttributeViewEdit("%s wasn't changed: it's a property linking to %s%s, and changing what it links to or its pairing would change what its links mean. Add a new relation field instead.",
+		label, attributeViewLabel(target), pairing)
+}
+
+// checkAttributeViewOptionChange refuses removing or renaming an option that rows of the database
+// use, other than the rows in except. Renaming onto an existing option, which merges the two, is a
+// rename.
+func checkAttributeViewOptionChange(attrView *av.AttributeView, key *av.Key, operation *Operation, remove bool, except map[string]bool) error {
+	if !isGuardedAttributeViewProperty(attrView, key) {
+		return nil
+	}
+	var oldName string
+	if remove {
+		oldName, _ = operation.Data.(string)
+	} else {
+		var data struct {
+			OldName string `json:"oldName"`
+			NewName string `json:"newName"`
+		}
+		encoded, err := json.Marshal(operation.Data)
+		if nil != err || nil != json.Unmarshal(encoded, &data) {
+			return nil
+		}
+		oldName = strings.TrimSpace(data.OldName)
+		if oldName == strings.TrimSpace(data.NewName) {
+			return nil
+		}
+	}
+	uses := attributeViewOptionUses(attrView, key.ID, oldName, except)
+	if 0 == uses {
+		return nil
+	}
+	verb := "renamed"
+	if remove {
+		verb = "removed"
+	}
+	if "tag" == attributeViewPropertyKey(key.Desc) {
+		return refuseAttributeViewEdit("The tag '%s' wasn't %s: %s. Use merge-tag.", oldName, verb, attributeViewRowsUsing(uses))
+	}
+	rows := "the rows"
+	if 1 == uses {
+		rows = "the row"
+	}
+	if remove {
+		return refuseAttributeViewEdit("The option '%s' wasn't removed from %s: %s. Move %s to another option first.",
+			oldName, attributeViewFieldLabel(key), attributeViewRowsUsing(uses), rows)
+	}
+	return refuseAttributeViewEdit("The option '%s' of %s wasn't renamed: %s. Add the new option and move %s to it first.",
+		oldName, attributeViewFieldLabel(key), attributeViewRowsUsing(uses), rows)
+}
+
+// pageDeletionRefusal refuses deleting a page through a block deletion, which removes the page's
+// rows and their values from every database and leaves the page. Pages are deleted from the tree.
+func pageDeletionRefusal(title string) error {
+	return refuseAttributeViewEdit("\"%s\" wasn't deleted: deleting a page as a block removes its rows from every database and leaves the page. Delete it from the page tree instead.", title)
+}
+
+func checkPageDeletion(id string) error {
+	bt := treenode.GetBlockTree(id)
+	if nil == bt || bt.ID != bt.RootID {
+		return nil
+	}
+	return pageDeletionRefusal(path.Base(bt.HPath))
+}
+
+// checkRefusedEdits checks a whole transaction before any of it is applied, so a refused edit
+// leaves nothing of the transaction behind. Each operation is checked against the databases as
+// they are now; the shared functions check again as each one runs.
+func (tx *Transaction) checkRefusedEdits() *TxErr {
+	for _, operation := range tx.DoOperations {
+		if nil == operation || nil != operation.attributeViewFields {
+			continue
+		}
+		var err error
+		switch operation.Action {
+		case "delete":
+			err = checkPageDeletion(operation.ID)
+		case "removeAttrViewCol", "updateAttrViewCol", "setAttrViewColDesc", "updateAttrViewColRelation",
+			"removeAttrViewColOption", "updateAttrViewColOption":
+			err = checkAttributeViewOperation(operation, tx.rowsPickedByUndoneEdit(operation, "removeAttrViewColOption" == operation.Action))
+		}
+		if nil != err {
+			return attributeViewTxErr(operation, err)
+		}
+	}
+	return nil
+}
+
+// rowsPickedByUndoneEdit are the rows an option removal that undoes an edit may clear: those the edit
+// set the field of. The editor undoes "add option" by removing the option, which also clears it from
+// the rows the same edit picked it on, so they always still use it. An undo carries the edit it undoes
+// as its undo operations; rows that took the option any other way are still counted.
+func (tx *Transaction) rowsPickedByUndoneEdit(operation *Operation, remove bool) map[string]bool {
+	if !remove || !tx.isReplay {
+		return nil
+	}
+	ret := map[string]bool{}
+	for _, undone := range tx.UndoOperations {
+		if nil == undone || undone.AvID != operation.AvID {
+			continue
+		}
+		switch undone.Action {
+		case "updateAttrViewCell":
+			if undone.KeyID == operation.ID {
+				ret[undone.RowID] = true
+			}
+		case "updateAttrViewCells":
+			for _, cell := range undone.CellUpdates {
+				if nil != cell && cell.KeyID == operation.ID {
+					ret[cell.RowID] = true
+				}
+			}
+		}
+	}
+	return ret
+}
+
+func checkAttributeViewOperation(operation *Operation, except map[string]bool) error {
+	attrView, err := av.ParseAttributeView(operation.AvID)
+	if nil != err || nil == attrView {
+		return nil
+	}
+	load := parsedAttributeViewLoader(attrView)
+	if "updateAttrViewColRelation" == operation.Action {
+		return checkAttributeViewRelationChange(attrView, operation, load)
+	}
+	key, _ := attrView.GetKey(operation.ID)
+	if nil == key {
+		return nil
+	}
+	switch operation.Action {
+	case "removeAttrViewCol":
+		return checkAttributeViewFieldRemoval(attrView, key, operation.RemoveDest, load)
+	case "updateAttrViewCol":
+		if "" != operation.Typ {
+			return checkAttributeViewFieldFormat(attrView, key, av.KeyType(operation.Typ))
+		}
+	case "setAttrViewColDesc":
+		desc, _ := operation.Data.(string)
+		return checkAttributeViewFieldDesc(attrView, key, desc)
+	case "removeAttrViewColOption":
+		return checkAttributeViewOptionChange(attrView, key, operation, true, except)
+	case "updateAttrViewColOption":
+		return checkAttributeViewOptionChange(attrView, key, operation, false, nil)
+	}
+	return nil
+}
