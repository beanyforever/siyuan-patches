+	originalAttrViewLangs := util.AttrViewLangs
+	util.AttrViewLangs = map[string]map[string]any{util.Lang: {"key": "Key", "select": "Select", "table": "Table",
+		"gallery": "Gallery", "kanban": "Kanban", "list": "List", "calendar": "Calendar"}}
+	t.Cleanup(func() { util.AttrViewLangs = originalAttrViewLangs })
