+package cache
+
+import (
+	"sync"
+
+	"github.com/dgraph-io/ristretto"
+)
+
+var blockIALPutMu, docIALPutMu sync.Mutex
+
+// putLatestIAL puts attributes in an attribute cache and returns once the cache holds them. ristretto takes in a key
+// it doesn't hold yet later, on its own goroutine, and turns away a second put of that key queued before the first is
+// taken in, as one it already holds; without waiting, the first put's attributes would stay, and a page made a row
+// just after it is made would read as bound to no database. Puts to one cache take turns, so a put queued after
+// another's is never turned away.
+func putLatestIAL(c *ristretto.Cache, mu *sync.Mutex, key string, ial map[string]string, cost int64) {
+	mu.Lock()
+	defer mu.Unlock()
+	c.Set(key, ial, cost)
+	c.Wait()
+}
