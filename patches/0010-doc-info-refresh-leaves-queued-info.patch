+package model
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/task"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// docInfoRefreshBoxID is a notebook of the test's own, so that only its page's refreshes reach the pushes it counts,
+// whatever earlier tests left in the task queue.
+const docInfoRefreshBoxID = "20200101000000-docinfo"
+
+// The task queue's duplicate check reads the arguments of the tasks running as well as those queued. A refresh of a
+// page's info that wrote the page's sub-page count into the info it was queued with changed a map that check could be
+// reading, and Go stopped SiYuan with "concurrent map iteration and map write". The refresh must leave that info as it
+// was queued: then a refresh of identical info queued while one runs is its duplicate, and the page is pushed once.
+func TestDocInfoRefreshLeavesTheInfoItWasQueuedWith(t *testing.T) {
+	setupFileOperationTest(t)
+	// A page last changed years ago, so its humanized times read the same in both refreshes.
+	tree := treenode.NewTree(docInfoRefreshBoxID, "/20200101000001-docinfo.sy", "/Doc info", "Doc info")
+	tree.Root.SetIALAttr("updated", "20200101000001")
+
+	var lock sync.Mutex
+	pushes := 0
+	held, release := make(chan struct{}), make(chan struct{})
+	finishFirstPush := sync.OnceFunc(func() { close(release) })
+	originalGuard := util.ReloadDocInfoGuard
+	// SiYuan calls the guard just before it pushes a page's info: it holds the first push of this page's info until the
+	// test lets it go.
+	util.ReloadDocInfoGuard = func(boxID string) bool {
+		if docInfoRefreshBoxID == boxID {
+			lock.Lock()
+			pushes++
+			first := 1 == pushes
+			lock.Unlock()
+			if first {
+				close(held)
+				<-release
+			}
+		}
+		return nil == originalGuard || originalGuard(boxID)
+	}
+	t.Cleanup(func() {
+		finishFirstPush()
+		util.ReloadDocInfoGuard = originalGuard
+	})
+
+	refreshDocInfo0(tree, 1)
+	runDueAsyncTasks()
+	select {
+	case <-held:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the page's info wasn't pushed")
+	}
+
+	// The same refresh while the first is being pushed: the queue sees its duplicate running and drops it.
+	refreshDocInfo0(tree, 1)
+	finishFirstPush()
+	runDueAsyncTasks()
+	// A refresh queued all the same runs as soon as it is due, and reaches the guard within milliseconds. A machine slow
+	// enough to take longer could only let a build without the fix pass, never fail one with it.
+	time.Sleep(300 * time.Millisecond)
+	lock.Lock()
+	defer lock.Unlock()
+	if 1 != pushes {
+		t.Errorf("the page's info was pushed %d times, want once: the running refresh's info had changed since it was queued", pushes)
+	}
+}
+
+// runDueAsyncTasks waits out the 500 ms delay refreshDocInfo0 queues a refresh of a page's info with, then runs the
+// async tasks that are due.
+func runDueAsyncTasks() {
+	time.Sleep(600 * time.Millisecond)
+	task.ExecAsyncTaskJob()
+}
diff --git a/kernel/model/push_reload.go b/kernel/model/push_reload.go
index 8c412b4..dc0d0a8 100644
--- a/kernel/model/push_reload.go
+++ b/kernel/model/push_reload.go
@@ -18,6 +18,7 @@ package model
 
 import (
 	"errors"
+	"maps"
 	"os"
 	"path"
 	"path/filepath"
@@ -309,8 +310,10 @@ func refreshDocInfo0(tree *parse.Tree, size uint64) {
 				}
 			}
 		}
-		docInfo["subFileCount"] = subFileCount
-		util.PushReloadDocInfo(docInfo)
+		// A copy: the queue's duplicate check reads a running task's arguments, so docInfo must stay as it was queued.
+		pushed := maps.Clone(docInfo)
+		pushed["subFileCount"] = subFileCount
+		util.PushReloadDocInfo(pushed)
 	}, docInfo)
 }
 
