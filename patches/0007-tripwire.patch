+// setBlockAttrs, a writer that saves the page outside a turn, logs once: its first call logs one page line, named for
+// a site in SiYuan's model, and its second call, from the same site, logs nothing more.
+func TestTripwireLogsSetBlockAttrsOnce(t *testing.T) {
+	runTripwireTest(t, func(t *testing.T) {
+		files := setupStructureTransactionTest(t)
+		setupFoldTransactionDatabase(t, files)
+		log := newTripwireLog(t)
+		pagePath := filepath.Join(util.DataDir, files.box.ID, files.sourcePath)
+		begin := log.mark(t)
+
+		if err := SetBlockAttrs(files.sourceID, map[string]string{"custom-tripwire": "first"}); nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the first setBlockAttrs", pagePath, `"first"`)
+		lines := log.linesSince(t, begin)
+		if 1 != len(lines) {
+			t.Fatalf("after setBlockAttrs saved the page outside a turn, the tripwire logged %d lines, want 1: %q",
+				len(lines), lines)
+		}
+		modelSite := regexp.MustCompile(`\bmodel\.\S+ (?:\S*[/\\])?\w+\.go:\d+\b`)
+		if !modelSite.MatchString(lines[0]) {
+			t.Errorf("the tripwire's line for setBlockAttrs names no call site in SiYuan's model as "+
+				"\"<package.Function> <file>:<line>\": %q", lines[0])
+		}
+		if !tripwireKinds["page"].MatchString(lines[0]) || tripwireKinds["database"].MatchString(lines[0]) {
+			t.Errorf("the tripwire's line for setBlockAttrs doesn't give the kind \"page\" alone: %q", lines[0])
+		}
+
+		if err := SetBlockAttrs(files.sourceID, map[string]string{"custom-tripwire": "second"}); nil != err {
+			t.Fatal(err)
+		}
+		requireTripwireFileHolds(t, "the second setBlockAttrs", pagePath, `"second"`)
+		if lines = log.linesSince(t, begin); 1 != len(lines) {
+			t.Errorf("after setBlockAttrs saved the page a second time, from the same site, the tripwire has logged %d "+
+				"lines, want 1: %q", len(lines), lines)
+		}
+	})
+}
