+
+// checkTripwireSite checks that lines, the tripwire's lines in a stretch of the log, hold want lines naming site, and
+// that each names the kind of what was saved and not the other kind.
+func checkTripwireSite(t *testing.T, step string, lines []string, site tripwireSite, kind string, want int) {
+	t.Helper()
+	var named []string
+	for _, line := range lines {
+		if site.matches(line) {
+			named = append(named, line)
+		}
+	}
+	if want != len(named) {
+		t.Errorf("%s: the log holds %d tripwire lines naming %s, want %d; the tripwire's lines since the test began: %q",
+			step, len(named), site, want, lines)
+		return
+	}
+	for _, line := range named {
+		for name, pattern := range tripwireKinds {
+			if (name == kind) != pattern.MatchString(line) {
+				t.Errorf("%s: the tripwire's line for %s doesn't give the kind %q alone: %q", step, site, kind, line)
+			}
+		}
+	}
+}
+
+// checkNothingLogged checks that the tripwire logged nothing since mark.
+func checkNothingLogged(t *testing.T, log *tripwireLog, mark int, step string) {
+	t.Helper()
+	if lines := log.linesSince(t, mark); 0 < len(lines) {
+		t.Errorf("%s, the tripwire logged %q", step, lines)
+	}
+}
+
+// checkPageControl saves tree outside a turn, from the control site, and checks that the tripwire logs it: the
+// tripwire is on in this process, and the test reads its lines.
+func checkPageControl(t *testing.T, log *tripwireLog, tree *parse.Tree) {
+	t.Helper()
+	mark := log.mark(t)
+	tree.Root.SetIALAttr("custom-tripwire-control", "saved")
+	site, err := tripwireSavePageControl(tree)
+	if nil != err {
+		t.Fatal(err)
+	}
+	requireTripwireFileHolds(t, "control", tripwirePagePath(tree), "custom-tripwire-control")
+	checkTripwireSite(t, "control: after a save of an existing page outside a turn", log.linesSince(t, mark), site,
+		"page", 1)
+}
+
+func tripwirePagePath(tree *parse.Tree) string {
+	return filepath.Join(util.DataDir, tree.Box, tree.Path)
+}
+
+// requireTripwireFileHolds stops the test if the file at absPath doesn't hold text: the save the test made didn't
+// write, so the test can't say what a save logs.
+func requireTripwireFileHolds(t *testing.T, step, absPath, text string) {
+	t.Helper()
+	data, err := os.ReadFile(absPath)
+	if nil != err {
+		t.Fatalf("setup: %s: %v", step, err)
+	}
+	if !bytes.Contains(data, []byte(text)) {
+		t.Fatalf("setup: %s: %s doesn't hold %q, so the save wrote nothing", step, absPath, text)
+	}
+}
