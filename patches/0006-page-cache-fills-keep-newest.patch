+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package cache
+
+import (
+	"bytes"
+	"testing"
+)
+
+// A page cache fill is a load that missed the cache, read the page's file and caches what it read. It takes a
+// FillToken before its lookup, and lands only if nothing wrote the page, or removed it from the cache, since.
+
+const treeFillBox, treeFillOtherBox, treeFillRoot = "20261017090000-notebk1", "20261017090000-notebk2", "20261017090000-fillpag"
+
+var treeFillOlder, treeFillNewer = []byte(`{"ID":"older"}`), []byte(`{"ID":"newer"}`)
+
+func readTreeFillPage() []byte {
+	treeCache.Wait()
+	raw, _ := GetTreeDataInBox(treeFillRoot, treeFillBox)
+	return raw
+}
+
+// A fill that took its token before a page write doesn't store, so the write stays: a save landing while the fill
+// reads the file from before it, whether or not the save brackets its file write.
+func TestTreeFillTakenBeforeWriteDoesNotStore(t *testing.T) {
+	cases := []struct {
+		name  string
+		write func()
+	}{
+		{"write", func() { SetTreeDataInBox(treeFillRoot, treeFillBox, treeFillNewer) }},
+		{"write of the file, bracketed", func() {
+			BeginTreeWrite(treeFillRoot)
+			SetTreeDataInBox(treeFillRoot, treeFillBox, treeFillNewer)
+			EndTreeWrite(treeFillRoot)
+		}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			ClearTreeCache()
+			t.Cleanup(ClearTreeCache)
+			token := NewFillToken() // the load missed, and is about to read the file
+			c.write()
+			if FillTreeDataInBox(treeFillRoot, treeFillBox, treeFillOlder, token) {
+				t.Fatal("a fill that took its token before a write stored the file's older copy")
+			}
+			if got := readTreeFillPage(); !bytes.Equal(got, treeFillNewer) {
+				t.Fatalf("after a write and a fill that started before it, a read gave %q, want %q", got, treeFillNewer)
+			}
+		})
+	}
+}
+
+// A fill that looked while a write of the page's file was under way doesn't store, before the write ends or after:
+// what it read may be the file from before the write, or a part-written one.
+func TestTreeFillDuringFileWriteDoesNotStore(t *testing.T) {
+	ClearTreeCache()
+	t.Cleanup(ClearTreeCache)
+	BeginTreeWrite(treeFillRoot)
+	token := NewFillToken()
+	if FillTreeDataInBox(treeFillRoot, treeFillBox, treeFillOlder, token) {
+		EndTreeWrite(treeFillRoot)
+		t.Fatal("a fill stored while a write of the page's file was under way")
+	}
+	EndTreeWrite(treeFillRoot)
+	if FillTreeDataInBox(treeFillRoot, treeFillBox, treeFillOlder, token) {
+		t.Fatal("a fill that looked while a write of the page's file was under way stored once it ended")
+	}
+	if got := readTreeFillPage(); nil != got {
+		t.Fatalf("after fills that looked during a write of the page's file, a read gave %q rather than missing", got)
+	}
+}
+
+// A remove or a clear between a fill's token and its store stops the fill, as a move, a deletion, sync or an asset
+// rename drops a page from the cache while a load of it reads the file from before. A remove under another notebook's
+// key stops it too: versions are kept per page, so a remove covers keys the cache's index of them never held.
+func TestTreeFillAfterRemoveDoesNotStore(t *testing.T) {
+	cases := []struct {
+		name   string
+		remove func()
+	}{
+		{"removed", func() { RemoveTreeData(treeFillRoot) }},
+		{"removed in its notebook", func() { RemoveTreeDataInBox(treeFillRoot, treeFillBox) }},
+		{"removed in another notebook", func() { RemoveTreeDataInBox(treeFillRoot, treeFillOtherBox) }},
+		{"cache cleared", ClearTreeCache},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			ClearTreeCache()
+			t.Cleanup(ClearTreeCache)
+			token := NewFillToken()
+			c.remove()
+			if FillTreeDataInBox(treeFillRoot, treeFillBox, treeFillOlder, token) {
+				t.Fatal("a fill stored after a remove between its token and its store")
+			}
+			if got := readTreeFillPage(); nil != got {
+				t.Fatalf("after a remove between a fill's token and its store, a read gave %q rather than missing", got)
+			}
+		})
+	}
+}
+
+// A fill nothing raced stores, and a read straight after it gets what it stored; a write after it replaces it.
+func TestTreeFillUnracedStores(t *testing.T) {
+	ClearTreeCache()
+	t.Cleanup(ClearTreeCache)
+	if !FillTreeDataInBox(treeFillRoot, treeFillBox, treeFillOlder, NewFillToken()) {
+		t.Fatal("a fill nothing raced didn't store")
+	}
+	if got := readTreeFillPage(); !bytes.Equal(got, treeFillOlder) {
+		t.Fatalf("after a fill nothing raced, a read gave %q, want %q", got, treeFillOlder)
+	}
+	SetTreeDataInBox(treeFillRoot, treeFillBox, treeFillNewer)
+	if got := readTreeFillPage(); !bytes.Equal(got, treeFillNewer) {
+		t.Fatalf("after a write over a fill, a read gave %q, want %q", got, treeFillNewer)
+	}
+}
