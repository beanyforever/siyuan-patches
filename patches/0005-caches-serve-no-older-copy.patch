+// Two writes of one page that overlap leave the page cache holding what the file holds. A write raises the page's
+// version before and after its file write, and caches its bytes with the version its end returned; a read serves an
+// entry only if nothing raised the page since. That holds only if the ends come in the order of the file writes. Each
+// file write takes the file's lock, but the end comes after the lock is released, so a writer that wrote first can end
+// last: its copy is then cached at the newest version, and served, though the file holds the other writer's bytes. The
+// next edit, which loads the page from the cache, then saves the older copy over the file. Writers of pages that don't
+// take turns with jobs (setBlockAttrs, the ref-text refresh, renames, tags, getAttributeViewKeys' repairs, and so on)
+// can overlap a job's commit this way. A test hook holds the first writer between its file write and its end while a
+// second writer writes and ends, so the race goes the bad way every time.
+//
+// Fault at df08f4e: kernel/filesys/tree.go WriteTreeWithVersion, EndTreeWrite (:564) runs after the file lock is
+// released, so the order of the ends needn't be the order of the writes; the same holds for WriteTreeIfUnchanged and
+// fixTreeJSONData's write-back.
+func TestOverlappingWritesOfAPageCacheWhatTheFileHolds(t *testing.T) {
+	box, root, _, _ := setupStalePathTest(t)
+	tree := treenode.NewTree(box, "/"+root+".sy", "/Page", "Page")
+	tree.Root.SetIALAttr("custom-n", "before")
+	if _, err := WriteTree(tree); err != nil {
+		t.Fatal(err)
+	}
+	filePath := filepath.Join(util.DataDir, box, tree.Path)
+	readFile := func() *parse.Tree {
+		t.Helper()
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ret, err := LoadTreeByData(data, box, tree.Path, util.NewLute())
+		if err != nil {
+			t.Fatal(err)
+		}
+		return ret
+	}
+	first, second := readFile(), readFile()
+	first.Root.SetIALAttr("custom-n", "first")
+	second.Root.SetIALAttr("custom-n", "second")
+
+	var calls atomic.Int32
+	firstWritten, secondDone := make(chan struct{}), make(chan struct{})
+	testHookWriteTreeBeforeEnd = func() {
+		if 1 == calls.Add(1) {
+			// The first writer has written its file and stalls before its end, as a goroutine descheduled there would.
+			close(firstWritten)
+			// A fix that keeps writes of one page or database from overlapping holds the second writer back, so
+			// this one goes on after a second instead of waiting for it forever.
+			select {
+			case <-secondDone:
+			case <-time.After(time.Second):
+			}
+		}
+	}
+	t.Cleanup(func() { testHookWriteTreeBeforeEnd = nil })
+	firstErr := make(chan error, 1)
+	go func() {
+		_, err := WriteTree(first)
+		firstErr <- err
+	}()
+	<-firstWritten
+	if _, err := WriteTree(second); err != nil {
+		t.Fatal(err)
+	}
+	close(secondDone)
+	if err := <-firstErr; err != nil {
+		t.Fatal(err)
+	}
+	testHookWriteTreeBeforeEnd = nil
+	if got := readFile().Root.IALAttr("custom-n"); "second" != got {
+		t.Fatalf("setup: the file holds custom-n=%q, not the second write", got)
+	}
+	time.Sleep(20 * time.Millisecond) // let ristretto take queued sets in
+
+	loaded, err := LoadTree(box, tree.Path, util.NewLute())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := loaded.Root.IALAttr("custom-n"); "second" != got {
+		t.Errorf("a load after the two writes gives custom-n=%q, though the file holds second", got)
+	}
+	// The next edit loads the page as SiYuan does, from the cache first, and saves it.
+	loaded.Root.SetIALAttr("custom-other", "edited")
+	if _, err = WriteTree(loaded); err != nil {
+		t.Fatal(err)
+	}
+	if got := readFile().Root.IALAttr("custom-n"); "second" != got {
+		t.Errorf("the next edit saved custom-n=%q over the second write", got)
+	}
+}
