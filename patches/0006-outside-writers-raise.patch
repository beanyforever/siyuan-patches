+
+//go:build fts5
+
+package model
+
+import (
+	archivezip "archive/zip"
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/dejavu"
+	"github.com/siyuan-note/dejavu/cloud"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/sql"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+var fullReindexRefreshed = make(chan struct{}, 1)
+
+func init() {
+	testHookFullReindexRefreshed = func() {
+		select {
+		case fullReindexRefreshed <- struct{}{}:
+		default:
+		}
+	}
+}
+
+// waitFullReindexRefreshed comes just before a call that starts a full reindex: ImportData, or a sync that changes
+// more than a fifth of the pages. FullReindex starts a goroutine that flushes SQL's queue and resets the virtual
+// reference cache, which reads Conf, so the test waits for it in a cleanup that runs before its fixtures set Conf back.
+func waitFullReindexRefreshed(t *testing.T) {
+	t.Helper()
+	select {
+	case <-fullReindexRefreshed:
+	default:
+	}
+	t.Cleanup(func() {
+		select {
+		case <-fullReindexRefreshed:
+		case <-time.After(10 * time.Second):
+			if !t.Failed() {
+				t.Error("FullReindex's goroutine didn't finish within 10 s")
+			}
+		}
+	})
+}
+
+// waitOutsideCached waits up to 200 ms for the cache to take in what a read stored: ristretto takes a store in on a
+// goroutine of its own, and a read straight after it would miss and read the file, which would hide the fault.
+func waitOutsideCached(t *testing.T, what string, cached func() bool) {
+	t.Helper()
+	for deadline := time.Now().Add(200 * time.Millisecond); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		if cached() {
+			return
+		}
+	}
+	t.Fatalf("setup: %s", what)
+}
+
+// outsideJSONString is "name":"value" as SiYuan writes it in a page's or a database's file, on one line or indented.
+func outsideJSONString(data []byte, name, value string) []byte {
+	for _, separator := range []string{":", ": "} {
+		if s := []byte(`"` + name + `"` + separator + `"` + value + `"`); bytes.Contains(data, s) {
+			return s
+		}
+	}
+	return nil
+}
+
+// replaceOutsideJSONString is data, a file SiYuan wrote, with "name":"old" replaced by "name":"new".
+func replaceOutsideJSONString(t *testing.T, data []byte, name, old, new string) []byte {
+	t.Helper()
+	from := outsideJSONString(data, name, old)
+	if nil == from {
+		t.Fatalf("setup: the file holds no %q: %q", name, old)
+	}
+	return bytes.Replace(data, from, bytes.Replace(from, []byte(`"`+old+`"`), []byte(`"`+new+`"`), 1), 1)
+}
+
+// requireOutsideFileHolds stops the test unless the file at absPath holds "name":"value": a writer under test that
+// wrote nothing would make every read look stale.
+func requireOutsideFileHolds(t *testing.T, step, absPath, name, value string) {
+	t.Helper()
+	data, err := os.ReadFile(absPath)
+	if nil != err {
+		t.Fatalf("%s: read %s failed: %v", step, absPath, err)
+	}
+	if nil == outsideJSONString(data, name, value) {
+		t.Fatalf("%s: %s doesn't hold %s=%q", step, absPath, name, value)
+	}
+}
+
+// outsidePage is a page at the top of a notebook whose root carries custom-v, and outsideDatabase a database, which
+// the tests below cache through SiYuan's own reads and then write through a bulk writer.
+type outsidePage struct {
+	boxID, id string
+	tree      *parse.Tree
+}
+
+func (p *outsidePage) path() string    { return "/" + p.id + ".sy" }
+func (p *outsidePage) absPath() string { return filepath.Join(util.DataDir, p.boxID, p.path()) }
+
+func addOutsidePage(t *testing.T, boxID, id, value string) *outsidePage {
+	t.Helper()
+	ret := &outsidePage{boxID: boxID, id: id}
+	ret.tree = treenode.NewTree(boxID, ret.path(), "/Outside "+id, "Outside "+id)
+	ret.setValue(t, value)
+	treenode.UpsertBlockTree(ret.tree)
+	return ret
+}
+
+// setValue saves the page with custom-v=value, as an edit does.
+func (p *outsidePage) setValue(t *testing.T, value string) {
+	t.Helper()
+	p.tree.Root.SetIALAttr("custom-v", value)
+	if _, err := filesys.WriteTree(p.tree); nil != err {
+		t.Fatalf("setup: write page %s failed: %v", p.id, err)
+	}
+}
+
+// read reads the page through SiYuan's own reads and caches it: getBlockAttrs loads the page, which fills the page
+// cache and the block attribute cache. One read: a second fill of a key ristretto hasn't taken in yet is turned away,
+// and the page cache then serves neither copy.
+func (p *outsidePage) read(t *testing.T, want string) {
+	t.Helper()
+	if got := sql.GetBlockAttrs(p.id)["custom-v"]; want != got {
+		t.Fatalf("setup: getBlockAttrs gives page %s custom-v=%q", p.id, got)
+	}
+	waitOutsideCached(t, "the page cache doesn't serve page "+p.id, func() bool {
+		_, ok := cache.GetTreeDataInBox(p.id, p.boxID)
+		return ok
+	})
+	waitOutsideCached(t, "the block attribute cache doesn't serve page "+p.id, func() bool {
+		return nil != cache.GetBlockIALInBox(p.id, p.boxID)
+	})
+}
+
+// check reads the page as SiYuan serves it, through getBlockAttrs and a page load, and wants custom-v=want, which its
+// file holds.
+func (p *outsidePage) check(t *testing.T, step, want string) {
+	t.Helper()
+	requireOutsideFileHolds(t, step, p.absPath(), "custom-v", want)
+	if got := sql.GetBlockAttrs(p.id)["custom-v"]; want != got {
+		t.Errorf("%s: getBlockAttrs gives page %s custom-v=%q, though its file holds %q", step, p.id, got, want)
+	}
+	tree, err := filesys.LoadTree(p.boxID, p.path(), util.NewLute())
+	if nil != err {
+		t.Errorf("%s: load page %s failed: %v", step, p.id, err)
+		return
+	}
+	if got := tree.Root.IALAttr("custom-v"); want != got {
+		t.Errorf("%s: page %s loads with custom-v=%q, though its file holds %q", step, p.id, got, want)
+	}
+}
+
+type outsideDatabase struct {
+	attrView *av.AttributeView
+}
+
+func saveOutsideDatabase(t *testing.T, id, name string) *outsideDatabase {
+	t.Helper()
+	ret := &outsideDatabase{attrView: &av.AttributeView{ID: id, Spec: av.RichTextSpec,
+		KeyValues: []*av.KeyValues{{Key: &av.Key{ID: id[:15] + "blockky", Name: "Name", Type: av.KeyTypeBlock}}},
+		Views: []*av.View{{ID: id[:15] + "tablevw", Name: "Table", LayoutType: av.LayoutTypeTable,
+			Table: av.NewLayoutTable(), PageSize: av.ViewDefaultPageSize}},
+		RenderedViewables: map[string]av.Viewable{}}}
+	ret.setName(t, name)
+	t.Cleanup(func() { cache.RemoveAVData(id) })
+	return ret
+}
+
+func (d *outsideDatabase) absPath() string { return av.GetAttributeViewDataPath(d.attrView.ID) }
+
+// setName saves the database named name, as an edit of it does.
+func (d *outsideDatabase) setName(t *testing.T, name string) {
+	t.Helper()
+	d.attrView.Name = name
+	if err := av.SaveAttributeView(d.attrView); nil != err {
+		t.Fatalf("setup: save database %s failed: %v", d.attrView.ID, err)
+	}
+}
+
+// read reads the database as every operation on it starts, which fills the database cache.
+func (d *outsideDatabase) read(t *testing.T, want string) {
+	t.Helper()
+	if attrView, err := av.ParseAttributeView(d.attrView.ID); nil != err || want != attrView.Name {
+		t.Fatalf("setup: database %s reads %v, %v", d.attrView.ID, attrView, err)
+	}
+	waitOutsideCached(t, "the database cache doesn't serve database "+d.attrView.ID, func() bool {
+		_, ok := cache.GetAVData(d.attrView.ID)
+		return ok
+	})
+}
+
+// check reads the database as every operation on it starts, and wants its name to be want, which its file holds.
+func (d *outsideDatabase) check(t *testing.T, step, want string) {
+	t.Helper()
+	requireOutsideFileHolds(t, step, d.absPath(), "name", want)
+	attrView, err := av.ParseAttributeView(d.attrView.ID)
+	if nil != err || nil == attrView {
+		t.Errorf("%s: read database %s failed: %v", step, d.attrView.ID, err)
+		return
+	}
+	if want != attrView.Name {
+		t.Errorf("%s: database %s reads with the name %q, though its file holds %q", step, d.attrView.ID, attrView.Name,
+			want)
+	}
+}
+
+// stampOutsideFiles gives every file under dir the modification time when.
+func stampOutsideFiles(t *testing.T, dir string, when time.Time) {
+	t.Helper()
+	err := filepath.WalkDir(dir, func(p string, d os.DirEntry, err error) error {
+		if nil != err || d.IsDir() {
+			return err
+		}
+		return os.Chtimes(p, when, when)
+	})
+	if nil != err {
+		t.Fatal(err)
+	}
+}
+
+// clearOutsideCaches empties the four caches, as a restart does.
+func clearOutsideCaches(avIDs ...string) {
+	cache.ClearTreeCache()
+	cache.ClearBlocksIAL()
+	cache.ClearDocsIAL()
+	for _, avID := range avIDs {
+		cache.RemoveAVData(avID)
+	}
+}
+
+// C4 of step 3's caches challenger. A page turned into a heading of another page (/api/filetree/doc2Heading) has its
+// file removed raw, by box.Remove, and nothing raises the page: the write that now holds its block raises the target
+// page. So the source page's two entries that only its id or its path reach stay current, older than its file, which
+// is gone:
+//   - its page attributes, which the page tree reads by path (box.docIAL), are still served;
+//   - its page cache entry still stands for its file, so a save of the page as it was read before, whose bytes equal
+//     that entry, is skipped as already written (WriteTree's skip lookup), and the page's file isn't written at all.
+//
+// Both must read what the source page's file holds: nothing.
+func TestDocToHeadingLeavesNoCopyOfTheSourcePage(t *testing.T) {
+	const srcID, targetID, pivotID = "20261017220001-c4srcpg", "20261017220002-c4trgpg", "20261017220021-c4pivot"
+	srcPath := "/" + srcID + ".sy"
+	setup := func(t *testing.T) (f *moveCacheFixture, srcTree *parse.Tree) {
+		t.Helper()
+		f = setupMoveCacheTest(t)
+		addMoveCachePage(t, f.work, srcPath, "/Source page", "Source page")
+		addMoveCachePage(t, f.work, "/"+targetID+".sy", "/Target page", "Target page")
+		appendMoveCacheParagraph(t, targetID, pivotID, "pivot")
+
+		// The page tree and an edit read the source page: its page attributes, and the page.
+		clearOutsideCaches()
+		if ial := Conf.Box(f.work).docIAL(srcPath); "Source page" != ial["title"] {
+			t.Fatalf("setup: the source page's attributes read %v", ial)
+		}
+		var err error
+		if srcTree, err = filesys.LoadTree(f.work, srcPath, util.NewLute()); nil != err {
+			t.Fatalf("setup: load the source page failed: %v", err)
+		}
+		waitOutsideCached(t, "the page attribute cache doesn't serve the source page", func() bool {
+			return nil != cache.GetDocIALInBox(srcPath, f.work)
+		})
+		waitOutsideCached(t, "the page cache doesn't serve the source page", func() bool {
+			_, ok := cache.GetTreeDataInBox(srcID, f.work)
+			return ok
+		})
+
+		doc2HeadingChallenge(t, srcID, pivotID)
+		if _, statErr := os.Stat(filepath.Join(util.DataDir, f.work, srcPath)); !os.IsNotExist(statErr) {
+			t.Fatalf("setup: doc2Heading left the source page's file: %v", statErr)
+		}
+		return
+	}
+
+	t.Run("its page attributes", func(t *testing.T) {
+		f, _ := setup(t)
+		if ial := Conf.Box(f.work).docIAL(srcPath); nil != ial {
+			t.Errorf("after doc2Heading, the source page's attributes read %v, though its file is gone", ial)
+		}
+	})
+	t.Run("its page", func(t *testing.T) {
+		f, srcTree := setup(t)
+		if _, err := filesys.WriteTree(srcTree); nil != err {
+			t.Fatalf("save the source page as read before failed: %v", err)
+		}
+		if _, err := os.Stat(filepath.Join(util.DataDir, f.work, srcPath)); nil != err {
+			t.Errorf("after doc2Heading, a save of the source page as read before wrote no file (%v): it took the page "+
+				"cache's copy, older than the removal, for what the file holds", err)
+		}
+	})
+}
+
+// A data.zip import (/api/import/importData) copies the archive's data folder over the workspace's with filelock.Copy
+// and only queues a full reindex, which clears the caches when the task queue reaches it. Until then, on v3.8.7 and
+// step 3, every page and database SiYuan read before the import is served as it was: nothing raised them. After
+// ImportData returns, the page and the database it imported must read as the archive holds them.
+func TestDataImportServesTheImportedCopies(t *testing.T) {
+	f := setupMoveCacheTest(t)
+	page := addOutsidePage(t, f.work, "20261017220101-imppage", "old")
+	database := saveOutsideDatabase(t, "20261017220102-impdbse", "Old table")
+	pageData, err := os.ReadFile(page.absPath())
+	if nil != err {
+		t.Fatal(err)
+	}
+	databaseData, err := os.ReadFile(database.absPath())
+	if nil != err {
+		t.Fatal(err)
+	}
+
+	// data.zip holds one folder, the workspace's data folder, here with the page's and the database's new copies.
+	zipPath := filepath.Join(t.TempDir(), "data.zip")
+	file, err := os.Create(zipPath)
+	if nil != err {
+		t.Fatal(err)
+	}
+	newPage := replaceOutsideJSONString(t, pageData, "custom-v", "old", "new")
+	newDatabase := replaceOutsideJSONString(t, databaseData, "name", "Old table", "New table")
+	writer := archivezip.NewWriter(file)
+	for name, data := range map[string][]byte{
+		"data/" + f.work + page.path():                      newPage,
+		"data/storage/av/" + database.attrView.ID + ".json": newDatabase,
+	} {
+		entry, createErr := writer.Create(name)
+		if nil != createErr {
+			t.Fatal(createErr)
+		}
+		if _, err = entry.Write(data); nil != err {
+			t.Fatal(err)
+		}
+	}
+	if err = writer.Close(); nil != err {
+		t.Fatal(err)
+	}
+	if err = file.Close(); nil != err {
+		t.Fatal(err)
+	}
+
+	clearOutsideCaches(database.attrView.ID)
+	page.read(t, "old")
+	database.read(t, "Old table")
+
+	waitFullReindexRefreshed(t)
+	if err = ImportData(zipPath); nil != err {
+		t.Fatalf("import data.zip failed: %v", err)
+	}
+	page.check(t, "after the data.zip import", "new")
+	database.check(t, "after the data.zip import", "New table")
+}
+
+// A sync that downloads from the cloud (syncRepoDownload, the sync menu's "download"), here from a cloud in a local
+// folder (the local provider), which another device has published to. dejavu writes the cloud's files over the
+// workspace's, and processSyncMergeResult then drops the changed pages from the caches, but when more than a fifth of
+// the pages changed it only queues a full reindex instead, which clears the caches when the task queue reaches it.
+// Until then, on v3.8.7 and step 3, the pages SiYuan read before the sync are served as they were: nothing raised
+// them. After the sync returns, the page it downloaded must read as the cloud holds it.
+func TestSyncDownloadServesTheDownloadedPage(t *testing.T) {
+	f := setupMoveCacheTest(t)
+	page := addOutsidePage(t, f.work, "20261017220301-syncpge", "old")
+	pageData, err := os.ReadFile(page.absPath())
+	if nil != err {
+		t.Fatal(err)
+	}
+
+	base := t.TempDir()
+	remote := filepath.Join(base, "cloud")
+	if err = os.MkdirAll(remote, 0755); nil != err {
+		t.Fatal(err)
+	}
+	key := []byte("0123456789abcdef0123456789abcdef")
+	previousWorkspace, previousRepo, previousStatusBar := util.WorkspaceDir, util.RepoDir, util.StatusBarCfg.Load()
+	t.Cleanup(func() {
+		util.WorkspaceDir, util.RepoDir = previousWorkspace, previousRepo
+		util.StatusBarCfg.Store(previousStatusBar)
+	})
+	util.WorkspaceDir = filepath.Dir(util.DataDir)
+	util.RepoDir = filepath.Join(base, "repo")
+	util.StatusBarCfg.Store(&util.StatusBar{MsgDataSyncDisabled: true})
+	syncConf, repoConf, systemConf := conf.NewSync(), conf.NewRepo(), conf.NewSystem()
+	syncConf.Provider, syncConf.CloudName, syncConf.Enabled = conf.ProviderLocal, "main", true
+	syncConf.Local = &conf.Local{Endpoint: remote}
+	repoConf.Key = key
+	systemConf.ID, systemConf.Name, systemConf.OS = "kernel-device", "kernel-device", "linux"
+	Conf.Sync.Store(syncConf)
+	Conf.Repo.Store(repoConf)
+	Conf.System.Store(systemConf)
+	Conf.Search.Store(conf.NewSearch())
+
+	// The other device holds the same workspace with the page's new copy, and publishes it to the cloud. dejavu tells
+	// files apart by path and modification second, so every file but the page carries the same time on both devices.
+	if err = os.MkdirAll(filepath.Join(util.DataDir, ".siyuan"), 0755); nil != err {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(util.DataDir, ".siyuan", "syncignore"), nil, 0644); nil != err {
+		t.Fatal(err)
+	}
+	otherDir := filepath.Join(base, "other")
+	otherData := filepath.Join(otherDir, "data")
+	if err = os.CopyFS(otherData, os.DirFS(util.DataDir)); nil != err {
+		t.Fatal(err)
+	}
+	otherPage := filepath.Join(otherData, f.work, page.path())
+	if err = os.WriteFile(otherPage, replaceOutsideJSONString(t, pageData, "custom-v", "old", "new"), 0644); nil != err {
+		t.Fatal(err)
+	}
+	for _, dir := range []string{util.DataDir, otherData} {
+		stampOutsideFiles(t, dir, time.Unix(1700000010, 0))
+	}
+	if err = os.Chtimes(otherPage, time.Unix(1700000020, 0), time.Unix(1700000020, 0)); nil != err {
+		t.Fatal(err)
+	}
+	backend := cloud.NewLocal(&cloud.BaseCloud{Conf: &cloud.Conf{Dir: "main", RepoPath: filepath.Join(otherDir, "repo"),
+		AvailableSize: 1 << 30, Local: &cloud.ConfLocal{Endpoint: remote}}})
+	other, err := dejavu.NewRepo(otherData, filepath.Join(otherDir, "repo"), filepath.Join(otherDir, "history"),
+		filepath.Join(otherDir, "temp"), "other-device", "other-device", "linux", key, nil, backend)
+	if nil != err {
+		t.Fatal(err)
+	}
+	if _, err = other.Index("other device", true, nil); nil != err {
+		t.Fatal(err)
+	}
+	if _, _, err = other.Sync(nil); nil != err {
+		t.Fatalf("the other device's sync failed: %v", err)
+	}
+
+	clearOutsideCaches()
+	page.read(t, "old")
+	waitFullReindexRefreshed(t)
+	if err = syncRepoDownload(); nil != err {
+		t.Fatalf("sync download failed: %v", err)
+	}
+	if upserted, trees := 1, treenode.CountTrees(); !needFullReindex(upserted) {
+		t.Fatalf("setup: one changed page of %d doesn't take the full-reindex branch", trees)
+	}
+	page.check(t, "after the sync download", "new")
+}
+
+// A full snapshot checkout (/api/repo/checkoutRepo) writes the snapshot's files over the workspace's through dejavu,
+// then hands over to its refresh, which in checkoutRepo reindexes everything. On v3.8.7 and step 3 nothing raises what
+// the checkout wrote, so until a clear reaches them, the pages and databases SiYuan read before are served as they
+// were, and a job landing then saves its copy over the snapshot's. checkoutRepoSnapshot takes the refresh as an
+// argument, as SiYuan's own checkout test uses it: right after the checkout's write, before any refresh, the page and
+// the database it restored must read as the snapshot holds them.
+func TestCheckoutServesTheSnapshotRightAfterItsWrite(t *testing.T) {
+	f := setupMoveCacheTest(t)
+	page := addOutsidePage(t, f.work, "20261017220201-snppage", "snapshot")
+	database := saveOutsideDatabase(t, "20261017220202-snpdbse", "Snapshot table")
+	stamp := func(tick int64) {
+		for _, p := range []string{page.absPath(), database.absPath()} {
+			when := time.Unix(1700000000+tick, 0)
+			if err := os.Chtimes(p, when, when); nil != err {
+				t.Fatal(err)
+			}
+		}
+	}
+	stamp(10)
+	base := t.TempDir()
+	repo, err := dejavu.NewRepo(util.DataDir, filepath.Join(base, "repo"), filepath.Join(base, "history"),
+		filepath.Join(base, "temp"), "device", "device", "linux", []byte("0123456789abcdef0123456789abcdef"), nil, nil)
+	if nil != err {
+		t.Fatal(err)
+	}
+	snapshot, err := repo.Index("snapshot", false, nil)
+	if nil != err {
+		t.Fatal(err)
+	}
+
+	page.setValue(t, "current value")
+	database.setName(t, "Current table name")
+	stamp(20)
+	clearOutsideCaches(database.attrView.ID)
+	page.read(t, "current value")
+	database.read(t, "Current table name")
+
+	refreshed := false
+	err = checkoutRepoSnapshot(repo, snapshot.ID, func(checkoutErr error) {
+		refreshed = true
+		if nil != checkoutErr {
+			t.Errorf("the checkout failed: %v", checkoutErr)
+			return
+		}
+		page.check(t, "right after the checkout's write", "snapshot")
+		database.check(t, "right after the checkout's write", "Snapshot table")
+	})
+	if nil != err || !refreshed {
+		t.Fatalf("checkout failed: %v, refreshed %v", err, refreshed)
+	}
+}
