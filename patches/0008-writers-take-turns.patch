+//go:build fts5
+
+package model
+
+// Restores take their turn (issue #43, step 6). A restore writes an older copy over a page or a database. A job saved
+// before the restore's turn is replaced, as the owner asked; a job saved after the restore's read and before its write
+// must be kept, since it ran after the restore had begun, and once the restore holds the turn such a job runs after it.
+// How the tests interleave a job with a writer is in turns_fts5_test.go.
+
+import (
+	"bytes"
+	"io/fs"
+	"path/filepath"
+	"testing"
+
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// A page restored from its history through /api/history/rollbackDocHistory keeps a job's change to the page made
+// between the restore's read of the history copy and its write of the copy over the page, and a job's save of a
+// database the restored page's rows come back to, made between the restore's read of the database and its save. The
+// editor's page history, and its restore of a deleted page, restore this way.
+func TestPageHistoryRestoreKeepsAJobsSaveMadeBetweenItsReadAndItsWrite(t *testing.T) {
+	t.Run("the page", func(t *testing.T) {
+		boxID, pagePath := setupRestoreCacheTest(t)
+		historyPath := keepRestoreCacheHistory(t, boxID, pagePath)
+		setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "task")
+		job := newTurnJob()
+		setTurnHook(t, job, &testHookRollbackDocHistoryBeforeWrite, func() {
+			job.send(pageJob(restoreCachePageID)...)
+		})
+		job.run(t, "the page's history restore", func() { rollbackRestoreCacheHistory(t, historyPath) })
+		checkPageKeepsJob(t, job, "the page's history restore", restoreCachePageID)
+		checkPageAttr(t, "after the page's history restore", restoreCachePageID, "custom-object-type", "note")
+	})
+	t.Run("a database its rows come back to", func(t *testing.T) {
+		boxID, _ := setupRestoreCacheTest(t)
+		db := newAttrsCacheDatabase(t)
+		const pageID = "20261018150000-delpage"
+		itemID, _ := addAttrsCacheRow(t, &fileOperationTestFixture{box: &Box{ID: boxID}}, db, pageID)
+		if err := RemoveDoc(boxID, "/"+pageID+".sy"); nil != err {
+			t.Fatal(err)
+		}
+		if attrView, err := av.ParseAttributeView(db.avID); nil != err || nil != attrView.GetBlockValue(itemID) {
+			t.Fatalf("setup: after the page's deletion its row is still in the database (%v)", err)
+		}
+		historyPath := ""
+		_ = filepath.WalkDir(util.HistoryDir, func(p string, entry fs.DirEntry, err error) error {
+			if nil == err && !entry.IsDir() && pageID+".sy" == entry.Name() {
+				historyPath, _ = filepath.Rel(util.WorkspaceDir, p)
+			}
+			return nil
+		})
+		if "" == historyPath {
+			t.Fatal("setup: the deletion left no history of the page")
+		}
+
+		job := newTurnJob()
+		setTurnHook(t, job, &testHookBoundHistoryRestoreRead, func() { job.send(databaseJob(db.avID)...) })
+		job.run(t, "the deleted page's history restore", func() { rollbackRestoreCacheHistory(t, historyPath) })
+		checkDatabaseKeepsJob(t, job, "the deleted page's history restore", db.avID)
+		if attrView, err := av.ParseAttributeView(db.avID); nil != err || nil == attrView.GetBlockValue(itemID) {
+			t.Errorf("after the deleted page's history restore, its row isn't back in the database (%v)", err)
+		}
+	})
+}
+
+// A page restored from a snapshot, one page at a time, through /api/repo/rollbackRepoSnapshotFile keeps a job's change
+// to the page made between the restore's snapshot of the current data and its write of the snapshot's copy over the
+// page. Without the turn the change is in neither: the snapshot was taken before it, and the copy is written over it.
+func TestOnePageSnapshotRestoreKeepsAJobsSaveMadeBetweenItsReadAndItsWrite(t *testing.T) {
+	boxID, pagePath := setupRestoreCacheTest(t)
+	originalRepoDir := util.RepoDir
+	util.RepoDir = filepath.Join(util.WorkspaceDir, "repo")
+	t.Cleanup(func() { util.RepoDir = originalRepoDir })
+	Conf.Repo.Store(&conf.Repo{Key: bytes.Repeat([]byte{7}, 32)}) // snapshots need the repository's key
+	Conf.System.Store(&conf.System{ID: "20261018150000-device1", Name: "test", OS: "linux"})
+	originalStatusBar := util.StatusBarCfg.Load()
+	util.StatusBarCfg.Store(util.NewStatusBar(false))
+	t.Cleanup(func() { util.StatusBarCfg.Store(originalStatusBar) })
+
+	snapshotID, err := IndexRepo("before the Type changed")
+	if nil != err {
+		t.Fatalf("take a snapshot failed: %v", err)
+	}
+	repo, err := newRepository()
+	if nil != err {
+		t.Fatal(err)
+	}
+	index, err := repo.GetIndex(snapshotID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	fileID := ""
+	for _, id := range index.Files {
+		file, getErr := repo.GetFile(id)
+		if nil != getErr {
+			t.Fatal(getErr)
+		}
+		if "/"+boxID+pagePath == file.Path {
+			fileID = id
+		}
+	}
+	if "" == fileID {
+		t.Fatalf("setup: the snapshot holds no %s", "/"+boxID+pagePath)
+	}
+	setRestoreCacheAttr(t, restoreCachePageID, "custom-object-type", "task")
+
+	job := newTurnJob()
+	setTurnHook(t, job, &testHookRollbackRepoSnapshotFileRead, func() { job.send(pageJob(restoreCachePageID)...) })
+	job.run(t, "the one-page snapshot restore", func() {
+		if err = RollbackRepoSnapshotFile(fileID); nil != err {
+			t.Fatalf("roll the page back to the snapshot failed: %v", err)
+		}
+	})
+	checkPageKeepsJob(t, job, "the one-page snapshot restore", restoreCachePageID)
+	checkPageAttr(t, "after the one-page snapshot restore", restoreCachePageID, "custom-object-type", "note")
+}
