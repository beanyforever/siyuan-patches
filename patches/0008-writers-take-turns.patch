+
+//go:build fts5
+
+package model
+
+// The writers of dynamic reference texts take their turn (issue #43, step 6): SiYuan's ref-text job, which retitles a
+// renamed page's references and rows every few seconds after the rename, and the refresh that follows a block's move.
+// How the tests interleave a job with a writer is in turns_fts5_test.go.
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/88250/lute/parse"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/sql"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+)
+
+// runRefTextJob runs SiYuan's ref-text job, as its timer does after a rename, until done says the job's change is in,
+// for at most 10 s, making any retry it left due at once. On SiYuan before step 6 the first run makes the change. The
+// job first waits for SQL's index queue to be written, which SiYuan's own timer does in use and nothing does in tests,
+// so the queue is written before each run.
+func runRefTextJob(done func() bool) {
+	sql.FlushQueue()
+	FlushUpdateRefTextRenameDocJob()
+	for deadline := time.Now().Add(10 * time.Second); !done() && time.Now().Before(deadline); {
+		time.Sleep(50 * time.Millisecond)
+		dynamicRefTextRetries.Lock()
+		for key := range dynamicRefTextRetries.pending {
+			dynamicRefTextRetries.pending[key] = time.Time{}
+		}
+		dynamicRefTextRetries.Unlock()
+		sql.FlushQueue()
+		FlushUpdateRefTextRenameDocJob()
+	}
+}
+
+// dropRefTextRetries forgets the ref-text retries a test left, so no later test runs them.
+func dropRefTextRetries(t *testing.T) {
+	t.Cleanup(func() {
+		dynamicRefTextRetries.Lock()
+		dynamicRefTextRetries.pending = map[dynamicRefTextRetryKey]time.Time{}
+		dynamicRefTextRetries.Unlock()
+	})
+}
+
+// refText is the text of the one block reference in the block id of the page rootID, as the page's file holds it.
+func refText(t *testing.T, rootID, id string) string {
+	t.Helper()
+	refs := turnRefs(pageFile(t, rootID), id)
+	if 1 != len(refs) {
+		return fmt.Sprintf("%d references", len(refs))
+	}
+	return refs[0]
+}
+
+// SiYuan's ref-text job, which runs every few seconds after a page is renamed and updates what shows the page's title,
+// keeps a job's change made between its read and its save: of a page that refers to the renamed page, and of a
+// database the renamed page is a row of. polka's set_property, change_type and audit rename pages, as does the editor's
+// title field, and polka's renamePage waits for this job to retitle the page's rows.
+func TestRefTextJobKeepsAJobsSaveMadeBetweenItsReadAndItsSave(t *testing.T) {
+	t.Run("a page that refers to the renamed page", func(t *testing.T) {
+		files := setupAttrsCacheTest(t)
+		dropQueuedRefTextRenames(t)
+		dropRefTextRetries(t)
+		source, err := LoadTreeByBlockID(files.sourceID)
+		if nil != err {
+			t.Fatal(err)
+		}
+		ref := addTurnRef(source, files.targetID, "d", "Target")
+		writeTurnPage(t, source)
+		if err = RenameDoc(files.box.ID, files.targetPath, "Renamed target"); nil != err {
+			t.Fatal(err)
+		}
+		want := files.targetID + " Renamed target"
+		job := newTurnJob()
+		setTurnHook(t, job, &testHookRefTextRefTreeLoaded, func(rootID string) {
+			if files.sourceID == rootID {
+				job.send(pageJob(rootID)...)
+			}
+		})
+		job.run(t, "the ref-text job", func() {
+			runRefTextJob(func() bool { return want == refText(t, files.sourceID, ref.ID) })
+		})
+		checkPageKeepsJob(t, job, "the ref-text job", files.sourceID)
+		if got := refText(t, files.sourceID, ref.ID); want != got {
+			t.Errorf("after the ref-text job, the referring page's file holds the reference %q, want %q", got, want)
+		}
+	})
+	t.Run("a database the renamed page is a row of", func(t *testing.T) {
+		r := setupTurnReadsDatabase(t)
+		dropQueuedRefTextRenames(t)
+		dropRefTextRetries(t)
+		if err := RenameDoc(r.files.box.ID, "/"+r.pageID+".sy", "Renamed entry"); nil != err {
+			t.Fatal(err)
+		}
+		rowContent := func() string {
+			value := r.stored(t).GetBlockValue(r.itemID)
+			if nil == value || nil == value.Block {
+				return ""
+			}
+			return value.Block.Content
+		}
+		job := newTurnJob()
+		setTurnHook(t, job, &testHookAttributeViewBlockTextRead, func(avID string) {
+			if r.db.avID == avID {
+				job.send(databaseJob(avID)...)
+			}
+		})
+		job.run(t, "the ref-text job", func() {
+			runRefTextJob(func() bool { return "Renamed entry" == rowContent() })
+		})
+		checkDatabaseKeepsJob(t, job, "the ref-text job", r.db.avID)
+		if got := rowContent(); "Renamed entry" != got {
+			t.Errorf("after the ref-text job, the database's file holds the renamed page's row as %q, want Renamed entry", got)
+		}
+	})
+}
+
+// The refresh of dynamic reference texts that follows /api/block/moveBlock (ReloadProtyle, for the pages the block left
+// and joined) keeps a job's change to a referring page made between the refresh's read of the page and its save.
+// polka's merge_objects moves blocks this way.
+func TestReloadProtyleKeepsAJobsSaveMadeBetweenItsReadAndItsSave(t *testing.T) {
+	files := setupAttrsCacheTest(t)
+	dropRefTextRetries(t)
+	target, err := LoadTreeByBlockID(files.targetID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	definition := target.Root.FirstChild
+	definition.SetIALAttr("name", "Moved definition")
+	writeTurnPage(t, target)
+	source, err := LoadTreeByBlockID(files.sourceID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	ref := addTurnRef(source, definition.ID, "d", "Stale text")
+	writeTurnPage(t, source)
+
+	job := newTurnJob()
+	setTurnHook(t, job, &testHookRefTextRefTreeLoaded, func(rootID string) {
+		if files.sourceID == rootID {
+			job.send(pageJob(rootID)...)
+		}
+	})
+	job.run(t, "the refresh after a move", func() { ReloadProtyle(files.targetID) })
+	checkPageKeepsJob(t, job, "the refresh after a move", files.sourceID)
+	if got, want := refText(t, files.sourceID, ref.ID), definition.ID+" Moved definition"; want != got {
+		t.Errorf("after the refresh, the referring page's file holds the reference %q, want %q", got, want)
+	}
+}
+
+// turnRefTextFixture is a paragraph on the target page, a row of a Journal database, which the source page refers to
+// dynamically by its text.
+type turnRefTextFixture struct {
+	files      *fileOperationTestFixture
+	db         *attrsCacheDatabase
+	definition *ast.Node
+	target     *parse.Tree
+	ref        *ast.Node
+}
+
+func setupTurnRefTextFixture(t *testing.T) *turnRefTextFixture {
+	t.Helper()
+	files := setupAttrsCacheTest(t)
+	dropRefTextRetries(t)
+	db := newAttrsCacheDatabase(t)
+	target, err := LoadTreeByBlockID(files.targetID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	definition := target.Root.FirstChild
+	definition.AppendChild(&ast.Node{Type: ast.NodeText, Tokens: []byte("Original text")})
+	writeTurnPage(t, target)
+	performAttrsCacheOperation(t, fmt.Sprintf(`{"action":"insertAttrViewBlock","avID":"%s","viewID":"%s",`+
+		`"srcs":[{"itemID":"%s","id":"%s","isDetached":false}]}`, db.avID, db.view.ID, ast.NewNodeID(), definition.ID))
+	source, err := LoadTreeByBlockID(files.sourceID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	ref := addTurnRef(source, definition.ID, "d", "Original text")
+	writeTurnPage(t, source)
+	if target, err = LoadTreeByBlockID(files.targetID); nil != err {
+		t.Fatal(err)
+	}
+	definition = treenode.GetNodeInTree(target, definition.ID)
+	if db.avID != definition.IALAttr(av.NodeAttrNameAvs) {
+		t.Fatalf("setup: the paragraph isn't a row of the database: %v", definition.KramdownIAL)
+	}
+	return &turnRefTextFixture{files: files, db: db, definition: definition, target: target, ref: ref}
+}
