+func TestTripwireLogsAPageSaveOutsideATurnAtItsWriter(t *testing.T) {
+	box := setupTripwireSitesTest(t)
+	tree := treenode.NewTree(box, "/20261018000001-page001.sy", "/Page", "Page")
+
+	firstSave := siteOfSaveOnNextLine()
+	if _, err := WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	if _, ok := tripwire.Sites()[firstSave]; ok {
+		t.Fatal("the first save of a brand-new page was logged")
+	}
+
+	tree.Root.SetIALAttr("title", "Edited")
+	save := siteOfSaveOnNextLine()
+	if _, err := WriteTree(tree); nil != err {
+		t.Fatal(err)
+	}
+	if kind, ok := tripwire.Sites()[save]; !ok || tripwire.Page != kind {
+		t.Fatalf("a save of an existing page outside a turn wasn't logged at %q: %v", save, tripwire.Sites())
+	}
+
+	snapshot, original, err := LoadTreeSnapshot(box, tree.Path, util.NewLute())
+	if nil != err {
+		t.Fatal(err)
+	}
+	snapshot.Root.SetIALAttr("title", "Edited again")
+	conditional := siteOfSaveOnNextLine()
+	if _, err = WriteTreeIfUnchanged(snapshot, original); nil != err {
+		t.Fatal(err)
+	}
+	if kind, ok := tripwire.Sites()[conditional]; !ok || tripwire.Page != kind {
+		t.Fatalf("a compare-and-swap save outside a turn wasn't logged at %q: %v", conditional, tripwire.Sites())
+	}
+
+	tripwire.EnterTurn()
+	inTurn := siteOfSaveOnNextLine()
+	_, err = WriteTree(tree)
+	tripwire.LeaveTurn()
+	if nil != err {
+		t.Fatal(err)
