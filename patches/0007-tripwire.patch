+func TestIsClosure(t *testing.T) {
+	for name, want := range map[string]bool{
+		"model.writeRenameDocIfUnchanged.func1":            true,
+		"model.renameDoc.writeRenameDocIfUnchanged.func12": true,
+		"model.(*Transaction).commit.func1.2":              true,
+		// Go's functions for go and defer statements never reach isClosure: CallersFrames leaves them out.
+		"model.setNodeAttrs.gowrap1":                        false,
+		"model.setNodeAttrs.deferwrap3":                     false,
+		"model.setNodeAttrs":                                false,
+		"model.function":                                    false,
+		"model.func2Pages":                                  false,
+		"github.com/siyuan-note/siyuan/kernel/model.funcs1": false,
+	} {
+		if got := isClosure(name); got != want {
+			t.Errorf("isClosure(%q) = %v, want %v", name, got, want)
+		}
+	}
+}
