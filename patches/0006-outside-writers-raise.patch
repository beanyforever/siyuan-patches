+// Fix round 1 re-check: a page a two-way sync removes, with dejavu's on-demand asset downloads on.
+//
+// With asset downloads on demand (Sync's "download assets when needed", conf AssetDownloadMode 1), dejavu applies a
+// sync's merge in recoverAssetApply instead of restoreFiles: it writes the merge's files through checkoutFile, which
+// sends EvtCheckoutUpsertFile, but removes the merge's removed files with a bare os.Remove, which sends no event. It then
+// uploads and updates the cloud's indexes, and only once Sync returns does raiseAfterSync raise the removed files by
+// path. So all through the upload, a page the sync removed is served as it was: getBlockAttrs gives its attributes, the
+// page tree its page attributes, and WriteTree's skip lookup takes a save of it as already written. With assets
+// downloaded with the sync (mode 0), removeFiles sends EvtCheckoutRemoveFile after each remove, and the page reads as
+// removed. The test has this device sync once, the other device remove a page and publish, and this device change
+// another page, so that its second sync both removes the page and uploads; when it is about to upload its index, the
+// page's file is gone, and getBlockAttrs must give the page nothing.
+func TestSyncServesNoRemovedPageWhileItUploads(t *testing.T) {
+	for _, c := range []struct {
+		name string
+		mode int
+	}{{"assets downloaded with the sync", 0}, {"assets downloaded on demand", 1}} {
+		t.Run(c.name, func(t *testing.T) {
+			if 1 == c.mode {
+				// The coordinator's decision in step 4's fix round 2, a known gap: dejavu's recoverAssetApply removes the
+				// merge's removed files with a bare os.Remove and sends no event, so a page the sync removes stays served
+				// until Sync returns. The fix in one place is in dejavu (publish EvtCheckoutRemoveFile after that remove),
+				// outside the patches to SiYuan's own tree.
+				t.Skip("known gap: dejavu's recoverAssetApply removes files with no EvtCheckoutRemoveFile; fix in dejavu")
+			}
+			f := setupMoveCacheTest(t)
+			removed := addOutsidePage(t, f.work, "20261018040101-rmvpage", "kept")
+			changed := addOutsidePage(t, f.work, "20261018040102-chgpage", "before")
+
+			base := t.TempDir()
+			remote := filepath.Join(base, "cloud")
+			if err := os.MkdirAll(remote, 0755); nil != err {
+				t.Fatal(err)
+			}
+			key := []byte("0123456789abcdef0123456789abcdef")
+			previousWorkspace, previousRepo, previousStatusBar := util.WorkspaceDir, util.RepoDir, util.StatusBarCfg.Load()
+			t.Cleanup(func() {
+				util.WorkspaceDir, util.RepoDir = previousWorkspace, previousRepo
+				util.StatusBarCfg.Store(previousStatusBar)
+			})
+			util.WorkspaceDir = filepath.Dir(util.DataDir)
+			util.RepoDir = filepath.Join(base, "repo")
+			util.StatusBarCfg.Store(&util.StatusBar{MsgDataSyncDisabled: true})
+			syncConf, repoConf, systemConf := conf.NewSync(), conf.NewRepo(), conf.NewSystem()
+			syncConf.Provider, syncConf.CloudName, syncConf.Enabled = conf.ProviderLocal, "main", true
+			syncConf.Local = &conf.Local{Endpoint: remote}
+			syncConf.AssetDownloadMode = c.mode
+			repoConf.Key = key
+			systemConf.ID, systemConf.Name, systemConf.OS = "kernel-device", "kernel-device", "linux"
+			Conf.Sync.Store(syncConf)
+			Conf.Repo.Store(repoConf)
+			Conf.System.Store(systemConf)
+			Conf.Search.Store(conf.NewSearch())
+			if err := os.MkdirAll(filepath.Join(util.DataDir, ".siyuan"), 0755); nil != err {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(util.DataDir, ".siyuan", "syncignore"), nil, 0644); nil != err {
+				t.Fatal(err)
+			}
+
+			// The other device holds the same workspace and publishes it first.
+			otherDir := filepath.Join(base, "other")
+			otherData := filepath.Join(otherDir, "data")
+			if err := os.CopyFS(otherData, os.DirFS(util.DataDir)); nil != err {
+				t.Fatal(err)
+			}
+			for _, dir := range []string{util.DataDir, otherData} {
+				stampOutsideFiles(t, dir, time.Unix(1700000010, 0))
+			}
+			backend := cloud.NewLocal(&cloud.BaseCloud{Conf: &cloud.Conf{Dir: "main", RepoPath: filepath.Join(otherDir, "repo"),
+				AvailableSize: 1 << 30, Local: &cloud.ConfLocal{Endpoint: remote}}})
+			other, err := dejavu.NewRepo(otherData, filepath.Join(otherDir, "repo"), filepath.Join(otherDir, "history"),
+				filepath.Join(otherDir, "temp"), "other-device", "other-device", "linux", key, nil, backend)
+			if nil != err {
+				t.Fatal(err)
+			}
+			if _, err = other.Index("other device", true, nil); nil != err {
+				t.Fatal(err)
+			}
+			if _, _, err = other.Sync(nil); nil != err {
+				t.Fatalf("setup: the other device's first sync failed: %v", err)
+			}
+
+			// This device syncs once, which gives both devices the same sync point.
+			repo, err := newSyncRepository()
+			if nil != err {
+				t.Fatal(err)
+			}
+			if _, _, err = indexRepoBeforeCloudSync(repo); nil != err {
+				t.Fatalf("setup: index this device's data failed: %v", err)
+			}
+			if _, _, _, err = syncRepoWithPublication(repo, newSyncContext()); nil != err {
+				t.Fatalf("setup: this device's first sync failed: %v", err)
+			}
+
+			// The other device removes the page and publishes; this device changes another page.
+			if err = os.Remove(filepath.Join(otherData, f.work, removed.path())); nil != err {
+				t.Fatal(err)
+			}
+			if _, err = other.Index("other device removes a page", true, nil); nil != err {
+				t.Fatal(err)
+			}
+			if _, _, err = other.Sync(nil); nil != err {
+				t.Fatalf("setup: the other device's second sync failed: %v", err)
+			}
+			changed.setValue(t, "after")
+			if _, _, err = indexRepoBeforeCloudSync(repo); nil != err {
+				t.Fatalf("setup: index this device's change failed: %v", err)
+			}
+			clearOutsideCaches()
+			removed.read(t, "kept")
+
+			var fired, goneDuring bool
+			var servedDuring map[string]string
+			probeSyncIndexUpload(t, func() {
+				if fired {
+					return
+				}
+				fired = true
+				_, statErr := os.Stat(removed.absPath())
+				goneDuring = os.IsNotExist(statErr)
+				servedDuring = sql.GetBlockAttrs(removed.id)
+			})
+			mergeResult, _, _, err := syncRepoWithPublication(repo, newSyncContext())
+			if nil != err {
+				t.Fatalf("the sync failed: %v", err)
+			}
+			if 1 != len(mergeResult.Removes) {
+				t.Fatalf("setup: the sync removed %d files, not the page", len(mergeResult.Removes))
+			}
+			if !fired {
+				t.Fatal("setup: the sync uploaded no index")
+			}
+			if !goneDuring {
+				t.Fatal("setup: the page's file was still there when the sync uploaded its index")
+			}
+			if 0 < len(servedDuring) {
+				t.Errorf("while the sync uploaded, after it had removed the page's file, getBlockAttrs gave the page "+
+					"the attributes %v", servedDuring)
+			}
+			if got := sql.GetBlockAttrs(removed.id); 0 < len(got) {
+				t.Errorf("after the sync, getBlockAttrs gives the removed page the attributes %v", got)
+			}
+		})
+	}
+}
