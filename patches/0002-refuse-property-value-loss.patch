+	if err := inEditor(&Operation{Action: "updateAttrViewCell", AvID: f.tasks, KeyID: f.scratch, RowID: f.renewal,
+		Data: map[string]any{"text": map[string]any{"content": "high"}}}); nil != err {
+		t.Fatal(err)
+	}
+	before := f.stored(t)
+	for _, edit := range []struct {
+		edit func() error
+		want string
+	}{
+		{func() error {
+			return inEditor(&Operation{Action: "setAttrViewColDesc", AvID: f.tasks, ID: f.scratch, Data: "key: priority"})
+		}, "Priority's description wasn't changed: \"key: prio\" marks it as a property, and every view and rule relies on it. Keep it at the start and put any other text after a space."},
+		{func() error {
+			return UpdateAttributeViewKeyConfig(f.tasks, f.scratch, map[string]any{"type": "number"})
+		}, "Priority's format wasn't changed: it's a property, and its values in Tasks would stop meaning what they mean. Add a new field with that format instead."},
+		{func() error {
+			return RemoveAttributeViewKey(f.tasks, f.scratch, false)
+		}, "Priority wasn't deleted: it's a property, and deleting it would empty the Priority of every row in Tasks. Hide it from the view instead."},
+	} {
+		if err := edit.edit(); nil == err || err.Error() != edit.want {
+			t.Fatalf("want the refusal\n  %s\ngot\n  %v", edit.want, err)
+		}
+	}
+	for i, data := range f.stored(t) {
+		if !bytes.Equal(before[i], data) {
+			t.Fatalf("a refused edit changed database [%s]", f.databases[i])
+		}
+	}
+}
