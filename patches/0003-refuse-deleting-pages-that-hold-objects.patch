+package model
+
+import (
+	"fmt"
+	"io/fs"
+	"path/filepath"
+	"strings"
+
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// Deleting a page deletes the pages under it, and removing a notebook deletes every page in it. A
+// system page, one whose custom-object-type is "system", is scaffolding such as a home folder, and a
+// home folder like People holds every page of its Type in the notebook. So deleting a system page is
+// refused while pages sit under it, and so is removing a notebook that holds a system page. Every way
+// of deleting a page reaches RemoveDoc or RemoveDocs, and every way of removing a notebook reaches
+// RemoveBox; files deleted directly, a snapshot checkout and sync go around them.
+
+const systemPageType = "system"
+
+// systemPageDeletionRefusal refuses deleting a system page while pages sit under it.
+func systemPageDeletionRefusal(box *Box, p string) error {
+	// A page whose attributes can't be read isn't taken for a system page.
+	ial, _ := filesys.DocIAL(filepath.Join(util.DataDir, box.ID, p))
+	if systemPageType != ial["custom-object-type"] {
+		return nil
+	}
+	under := 0
+	_ = filepath.WalkDir(filepath.Join(util.DataDir, box.ID, strings.TrimSuffix(p, ".sy")),
+		func(path string, entry fs.DirEntry, err error) error {
+			if nil == err && !entry.IsDir() && strings.HasSuffix(path, ".sy") {
+				under++
+			}
+			return nil
+		})
+	if 0 == under {
+		return nil
+	}
+	pages := fmt.Sprintf("%d pages are", under)
+	if 1 == under {
+		pages = "1 page is"
+	}
+	return fmt.Errorf("%s wasn't deleted: %s under it and would go with it. Move or delete the pages under it first.",
+		ial["title"], pages)
+}
+
+// systemNotebookRemovalRefusal refuses removing a notebook that holds a system page.
+func systemNotebookRemovalRefusal(boxID string) error {
+	var held string
+	_ = filepath.WalkDir(filepath.Join(util.DataDir, boxID), func(path string, entry fs.DirEntry, err error) error {
+		if nil != err {
+			return nil
+		}
+		if entry.IsDir() && ".siyuan" == entry.Name() {
+			return filepath.SkipDir
+		}
+		if !entry.IsDir() && strings.HasSuffix(path, ".sy") {
+			if ial, _ := filesys.DocIAL(path); systemPageType == ial["custom-object-type"] {
+				held = ial["title"]
+				return filepath.SkipAll
+			}
+		}
+		return nil
+	})
+	if "" == held {
+		return nil
+	}
+	return fmt.Errorf("%s wasn't removed: it holds system pages, such as %s, and removing it would delete every page in it. Delete its pages first.",
+		(&Box{ID: boxID}).GetConf().Name, held)
+}
