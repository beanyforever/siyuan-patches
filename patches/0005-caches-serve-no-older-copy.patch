new file mode 100644
index 0000000..d82b79f
--- /dev/null
+++ b/kernel/av/save_cache_test.go
@@ -0,0 +1,281 @@
+// SiYuan - From thought to insight, with agents
+// Copyright (c) 2020-present, b3log.org
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package av
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const saveCacheTestID = "20261017130000-savedav"
+
+// setupSaveCacheTest is an empty workspace holding one database, named Original, saved and then dropped from the
+// database cache, as after a restart.
+func setupSaveCacheTest(t *testing.T) {
+	t.Helper()
+	originalDataDir := util.DataDir
+	util.DataDir = t.TempDir()
+	t.Cleanup(func() {
+		testHookAVFill = nil
+		testHookAVSaveSkipFill = nil
+		cache.RemoveAVData(saveCacheTestID)
+		util.DataDir = originalDataDir
+	})
+	attrView := &AttributeView{ID: saveCacheTestID, Spec: RichTextSpec, Name: "Original",
+		KeyValues: []*KeyValues{{Key: &Key{ID: "20261017130000-blockky", Name: "Name", Type: KeyTypeBlock}}},
+		Views: []*View{{ID: "20261017130000-tablevw", Name: "Table", LayoutType: LayoutTypeTable, Table: NewLayoutTable(),
+			PageSize: ViewDefaultPageSize}},
+		RenderedViewables: map[string]Viewable{}}
+	if err := SaveAttributeView(attrView); nil != err {
+		t.Fatal(err)
+	}
+	cache.RemoveAVData(saveCacheTestID)
+}
+
+// parseSaveCacheTest is a read of the database, as every operation on it starts with.
+func parseSaveCacheTest(t *testing.T) *AttributeView {
+	t.Helper()
+	ret, err := ParseAttributeView(saveCacheTestID)
+	if nil != err || nil == ret {
+		t.Fatalf("parse the database failed: %v", err)
+	}
+	return ret
+}
+
+// saveCacheTestFileName is the database's name as its file holds it.
+func saveCacheTestFileName(t *testing.T) string {
+	t.Helper()
+	data, err := os.ReadFile(GetAttributeViewDataPath(saveCacheTestID))
+	if nil != err {
+		t.Fatal(err)
+	}
+	ret, err := ParseAttributeViewData(saveCacheTestID, data)
+	if nil != err {
+		t.Fatal(err)
+	}
+	return ret.Name
+}
+
+// saveInHook returns a test hook that saves attrView the first time it is called, and returns once the save's own copy
+// is in the database cache, as it is when the read it races takes longer.
+func saveInHook(t *testing.T, attrView *AttributeView, fired *bool) func() {
+	return func() {
+		if *fired {
+			return
+		}
+		*fired = true
+		if err := SaveAttributeView(attrView); nil != err {
+			t.Error(err)
+		}
+		for deadline := time.Now().Add(time.Second); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+			if data, ok := cache.GetAVData(saveCacheTestID); ok && bytes.Contains(data, []byte(attrView.Name)) {
+				return
+			}
+		}
+	}
+}
+
+// settleAVCache gives the database cache time to take in what a read has just stored in it. Each store goes under a
+// key ristretto doesn't hold yet, which it takes in on a goroutine of its own, so a read straight after the store
+// misses it and reads the file, which would hide what the store left. It returns once the cache serves the database,
+// or after 200 ms if it doesn't.
+func settleAVCache() {
+	for deadline := time.Now().Add(200 * time.Millisecond); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+		if _, ok := cache.GetAVData(saveCacheTestID); ok {
+			return
+		}
+	}
+}
+
+// replaceJSONString replaces the first "name": "old" in a file SiYuan saved, on one line or indented.
+func replaceJSONString(data []byte, name, old, new string) []byte {
+	for _, separator := range []string{":", ": "} {
+		from := []byte(`"` + name + `"` + separator + `"` + old + `"`)
+		if bytes.Contains(data, from) {
+			return bytes.Replace(data, from, []byte(`"`+name+`"`+separator+`"`+new+`"`), 1)
+		}
+	}
+	return data
+}
+
+// Each save of a database reads back at once, and a read whose fill loaded the file before a save, and stored what it
+// loaded after it, is never served, neither its copy nor the normalized copy the parse stores next. Without the fix,
+// the fill after a miss labels what it read with a new version, so the older copy is served as the newest until the
+// next save, and the next operation, which builds on it, saves it over the file. A test hook places the save between
+// the fill's read and its store, so the race happens every time.
+func TestAVReadAfterSaveGivesTheSave(t *testing.T) {
+	t.Run("each save", func(t *testing.T) {
+		setupSaveCacheTest(t)
+		for i := range 100 {
+			attrView := parseSaveCacheTest(t)
+			attrView.Name = fmt.Sprintf("save %d", i)
+			if err := SaveAttributeView(attrView); nil != err {
+				t.Fatal(err)
+			}
+			if got := parseSaveCacheTest(t).Name; attrView.Name != got {
+				t.Fatalf("save %d: a read straight after it gave the name %q", i, got)
+			}
+		}
+	})
+	t.Run("a fill that read before a save", func(t *testing.T) {
+		setupSaveCacheTest(t)
+		saved := parseSaveCacheTest(t)
+		saved.Name = "Saved"
+		cache.RemoveAVData(saveCacheTestID) // the next read misses
+		fired := false
+		testHookAVFill = saveInHook(t, saved, &fired)
+		if got := parseSaveCacheTest(t).Name; "Original" != got {
+			t.Fatalf("setup: the read that loaded the file before the save gave the name %q", got)
+		}
+		testHookAVFill = nil
+		if !fired {
+			t.Fatal("setup: the read didn't fill the database cache")
+		}
+		if got := saveCacheTestFileName(t); "Saved" != got {
+			t.Fatalf("setup: the database's file holds the name %q", got)
+		}
+		settleAVCache()
+
+		// The first read after the race stores a normalized copy, which the second reads.
+		for _, read := range []string{"first", "second"} {
+			settleAVCache()
+			if got := parseSaveCacheTest(t).Name; "Saved" != got {
+				t.Errorf("the %s read after the race gave the name %q, though the file holds Saved", read, got)
+			}
+		}
+		// The next operation builds on what it reads and saves.
+		settleAVCache()
+		next := parseSaveCacheTest(t)
+		next.Views[0].Name = "Edited"
+		if err := SaveAttributeView(next); nil != err {
+			t.Fatal(err)
+		}
+		if got := saveCacheTestFileName(t); "Saved" != got {
+			t.Errorf("the next operation saved the name %q over the save", got)
+		}
+	})
+}
+
+// A save of an unchanged copy of a database that races a save of a changed one keeps the changed one. A save whose
+// lookup misses reads the file, and when the file already holds its bytes it writes nothing and caches them, a fill like
+// a read's: getAttributeViewKeys saves every database a page lists on each call, so most of its saves are of unchanged
+// copies. If another save lands between that read and that store, the unchanged copy, now older than the file, is
+// cached as the newest without the fix, and the next operation saves it over the file. A test hook places the other
+// save there, so the race happens every time.
+func TestAVSaveOfUnchangedCopyRacingASaveKeepsTheSave(t *testing.T) {
+	setupSaveCacheTest(t)
+	unchanged := parseSaveCacheTest(t)
+	renamed := parseSaveCacheTest(t)
+	renamed.Name = "Renamed"
+	cache.RemoveAVData(saveCacheTestID) // the unchanged copy's save misses
+	fired := false
+	testHookAVSaveSkipFill = saveInHook(t, renamed, &fired)
+	if err := SaveAttributeView(unchanged); nil != err {
+		t.Fatal(err)
+	}
+	testHookAVSaveSkipFill = nil
+	if !fired {
+		t.Fatal("setup: the save of the unchanged copy didn't find the file holding its bytes")
+	}
+	if got := saveCacheTestFileName(t); "Renamed" != got {
+		t.Fatalf("setup: the database's file holds the name %q", got)
+	}
+	settleAVCache()
+
+	if got := parseSaveCacheTest(t).Name; "Renamed" != got {
+		t.Errorf("a read after the race gave the name %q, though the file holds Renamed", got)
+	}
+	settleAVCache()
+	next := parseSaveCacheTest(t)
+	next.Views[0].Name = "Edited"
+	if err := SaveAttributeView(next); nil != err {
+		t.Fatal(err)
+	}
+	if got := saveCacheTestFileName(t); "Renamed" != got {
+		t.Errorf("the next operation saved the name %q over the rename", got)
+	}
+}
+
+// Indexing a database's history neither reads nor fills the live database's cache entry. History indexing reads each
+// history copy through GetAttributeViewContentByPath, which parses it by path, and a history copy's file is named
+// after the live database. Without the fix, the parse looks the copy up under the live database's key: with the live
+// database cached it indexes the live database as the history copy, and with nothing cached it caches the history
+// copy as the live database, which every read then serves until the next save.
+func TestAVHistoryReadLeavesTheLiveEntry(t *testing.T) {
+	setupHistory := func(t *testing.T) string {
+		t.Helper()
+		setupSaveCacheTest(t)
+		live := parseSaveCacheTest(t)
+		live.Name = "Live"
+		if err := SaveAttributeView(live); nil != err {
+			t.Fatal(err)
+		}
+		data, err := os.ReadFile(GetAttributeViewDataPath(saveCacheTestID))
+		if nil != err {
+			t.Fatal(err)
+		}
+		history := replaceJSONString(data, "name", "Live", "History")
+		if bytes.Equal(history, data) {
+			t.Fatal("setup: the database's file holds no name")
+		}
+		historyPath := filepath.Join(t.TempDir(), "history", "2026-10-17-130000-update", "storage", "av", saveCacheTestID+".json")
+		if err = os.MkdirAll(filepath.Dir(historyPath), 0755); nil != err {
+			t.Fatal(err)
+		}
+		if err = os.WriteFile(historyPath, history, 0644); nil != err {
+			t.Fatal(err)
+		}
+		cache.RemoveAVData(saveCacheTestID)
+		return historyPath
+	}
+
+	t.Run("with the live database cached", func(t *testing.T) {
+		historyPath := setupHistory(t)
+		if got := parseSaveCacheTest(t).Name; "Live" != got {
+			t.Fatalf("setup: the live database reads the name %q", got)
+		}
+		for deadline := time.Now().Add(time.Second); ; time.Sleep(time.Millisecond) {
+			if _, ok := cache.GetAVData(saveCacheTestID); ok {
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatal("setup: the live database isn't cached")
+			}
+		}
+		if content := GetAttributeViewContentByPath(historyPath); !strings.HasPrefix(content, "History ") {
+			t.Errorf("history indexing read the history copy as %q, not as its file holds it", content)
+		}
+	})
+	t.Run("with nothing cached", func(t *testing.T) {
+		historyPath := setupHistory(t)
+		if content := GetAttributeViewContentByPath(historyPath); !strings.HasPrefix(content, "History ") {
+			t.Fatalf("setup: history indexing read the history copy as %q", content)
+		}
+		settleAVCache()
+		if got := parseSaveCacheTest(t).Name; "Live" != got {
+			t.Errorf("after history indexing, the live database reads the name %q, though its file holds Live", got)
+		}
+	})
+}
