+
+//go:build fts5
+
+package model
+
+import (
+	"fmt"
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/siyuan-note/filelock"
+	"github.com/siyuan-note/siyuan/kernel/av"
+	"github.com/siyuan-note/siyuan/kernel/cache"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/sql"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// Jobs and step 6's writers (issue #43) all run at once, on the stress fixture of TestLocksStressJobsReadsRendersAndWriters,
+// for -locks-stress (5 s by default; the acceptance check runs it for 30 s under -race: go test -race ... -run
+// TestTurnsStress -args -locks-stress=30s). Jobs come through the queue and at once; some edit a paragraph that another
+// page refers to, so their commit refreshes reference texts inside the turn. The writers run outside jobs, as their
+// endpoints call them, and some reach the same functions inside a job: undoing "+ New" deletes its page in the job's
+// commit, and the ref-text retry refreshes inside the turn it takes. Then every worker must stop within its limit (no
+// deadlock), the queue must drain, and every watched block must read what its file holds. Errors the writers meet as
+// they trip over each other are counted, not failed: what this checks is that nothing waits forever, and, under -race,
+// that nothing races. A guard before step 6, where no writer takes the turn. Two of the 18 writers aren't here: the
+// asset rename, which refuses an asset outside the workspace folder, as the fixture's data folder is, and the
+// one-page snapshot restore, which takes a snapshot of the whole workspace each time.
+func TestTurnsStressJobsAndEveryWriter(t *testing.T) {
+	f := setupLocksStress(t)
+	files := f.files
+	dropQueuedRefTextRenames(t)
+	dropRefTextRetries(t)
+
+	// "+ New" makes a page with an icon. The template is saved as a writer saves: once the fixture's jobs and background
+	// refreshes are done, and in a turn. Saved outside a turn, it could land inside a writer's turn that read the
+	// database before it, and that writer's save, without the template, would write over it; "+ New" then failed until
+	// the first rollback to the history copy, about 2 s in.
+	FlushTxQueue()
+	backgroundRefreshWaitGroup.Wait()
+	sql.FlushQueue()
+	template := &av.NewItemTemplate{ID: ast.NewNodeID(), Name: "Entry", TargetType: av.NewItemTargetDocument,
+		Icon: "1f4c4", PrimaryKeyTemplate: "Entry"}
+	err := withTurn(func() error {
+		attrView, parseErr := av.ParseAttributeView(f.avID)
+		if nil != parseErr {
+			return parseErr
+		}
+		if setErr := attrView.SetNewItemTemplates(&av.NewItemTemplatesConfig{Templates: []*av.NewItemTemplate{template}}); nil != setErr {
+			return setErr
+		}
+		return av.SaveAttributeView(attrView)
+	})
+	if nil != err {
+		t.Fatal(err)
+	}
+	// The database's history copy has the template too, so that a rollback to it leaves "+ New" working.
+	data, err := filelock.ReadFile(av.GetAttributeViewDataPath(f.avID))
+	if nil != err {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(f.historyAVPath, data, 0644); nil != err {
+		t.Fatal(err)
+	}
+	// Daily notes go under "/Daily note/<date>".
+	boxConf := files.box.GetConf()
+	boxConf.DailyNoteSavePath = `/Daily note/{{now | date "2006-01-02"}}`
+	if err = files.box.SaveConf(boxConf); nil != err {
+		t.Fatal(err)
+	}
+	// The source page refers to the first row's page; the target page refers to the source page's paragraph, which the
+	// jobs edit.
+	source, err := LoadTreeByBlockID(files.sourceID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	transferred := addTurnRef(source, f.rowPages[0], "d", "Row 0")
+	writeTurnPage(t, source)
+	target, err := LoadTreeByBlockID(files.targetID)
+	if nil != err {
+		t.Fatal(err)
+	}
+	addTurnRef(target, files.childID, "d", "")
+	writeTurnPage(t, target)
+	historyAVPath, err := filepath.Rel(util.WorkspaceDir, f.historyAVPath)
+	if nil != err {
+		t.Fatal(err)
+	}
+	FlushTxQueue()
+	backgroundRefreshWaitGroup.Wait()
+	sql.FlushQueue()
+	// The workers start from a database that has the template: "+ New" errors count against the workers, not the setup.
+	if data, readErr := filelock.ReadFile(av.GetAttributeViewDataPath(f.avID)); nil != readErr ||
+		!strings.Contains(string(data), template.ID) {
+		t.Fatalf("the database lost its \"+ New\" template during the setup (%v)", readErr)
+	}
+
+	// SQL's index queue is written every 50 ms, as SiYuan's timer writes it in use: the ref-text job waits for it. It
+	// runs until every worker has stopped, since a worker may be waiting for it.
+	flusherStop, flusherDone := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(flusherDone)
+		for {
+			select {
+			case <-flusherStop:
+				return
+			case <-time.After(50 * time.Millisecond):
+				sql.FlushQueue()
+			}
+		}
+	}()
+	r := newStressRun()
+	r.worker("queued and immediate jobs", func(i int) error {
+		edit := fmt.Sprintf(`<div data-node-id="%s" data-type="NodeParagraph"><div contenteditable="true">edit %d</div></div>`,
+			files.childID, i)
+		txs := []*Transaction{
+			{DoOperations: []*Operation{{Action: "setAttrs", ID: f.rowPages[i%len(f.rowPages)], Data: fmt.Sprintf(`{"custom-job":"%d"}`, i)}}},
+			{DoOperations: []*Operation{{Action: "update", ID: files.childID, Data: edit}}},
+		}
+		PerformTransactions(&txs)
+		time.Sleep(80 * time.Millisecond)
+		return PerformTxSync(&Transaction{DoOperations: []*Operation{{Action: "setAttrViewName", ID: f.avID,
+			Data: fmt.Sprintf("Stress %d", i)}}})
+	})
+	r.worker("attributes", func(i int) error {
+		k := i % len(f.rowPages)
+		if 0 == i%2 {
+			return SetBlockAttrs(f.rowPages[k], map[string]string{"custom-writer": fmt.Sprint(i)})
+		}
+		return BatchSetBlockAttrs([]map[string]any{{"id": f.rowPages[k], "attrs": map[string]string{"custom-batch": fmt.Sprint(i)}}})
+	})
+	r.worker("reads that save", func(i int) error {
+		switch i % 3 {
+		case 0:
+			GetBlockAttributeViewKeys(f.rowPages[i%len(f.rowPages)])
+			return nil
+		case 1:
+			_, _, err := RenderAttributeView(f.blockID, f.avID, f.tableID, "", 1, 50, nil, false, false)
+			return err
+		default:
+			_, _, _, _, err := GetAttributeViewPrimaryKeyValues(f.avID, "", nil, 1, 16)
+			return err
+		}
+	})
+	// Renames and the ref-text job run apart, so that a rename can queue its page for the job while the job runs.
+	r.worker("renames", func(i int) error {
+		k := i % len(f.rowPages)
+		time.Sleep(20 * time.Millisecond)
+		return RenameDoc(files.box.ID, "/"+f.rowPages[k]+".sy", fmt.Sprintf("Row %d %d", k, i))
+	})
+	r.worker("the ref-text job, its retry and the refresh after a move", func(i int) error {
+		FlushUpdateRefTextRenameDocJob()
+		dynamicRefTextRetries.Lock()
+		for key := range dynamicRefTextRetries.pending {
+			dynamicRefTextRetries.pending[key] = time.Time{}
+		}
+		dynamicRefTextRetries.Unlock()
+		flushDynamicRefTextRetries()
+		ReloadProtyle(files.sourceID)
+		time.Sleep(10 * time.Millisecond)
+		return nil
+	})
+	r.worker("references moved", func(i int) error {
+		from, to := f.rowPages[0], f.rowPages[1]
+		if 1 == i%2 {
+			from, to = to, from
+		}
+		return TransferBlockRef(from, to, []string{transferred.ID})
+	})
+	r.worker("new rows and their undo", func(i int) error {
+		created, err := CreateAttributeViewItem(f.avID, f.blockID, f.tableID, template.ID, "", "")
+		if nil != err {
+			return err
+		}
+		return PerformTxSync(&Transaction{DoOperations: cloneOperations(created.Transaction.UndoOperations), isReplay: true})
+	})
+	r.worker("pages deleted", func(i int) error {
+		pageID := fmt.Sprintf("2026101816%04d-deleted", i%10000)
+		page := treenode.NewTree(files.box.ID, "/"+pageID+".sy", "/Deleted "+fmt.Sprint(i), "Deleted "+fmt.Sprint(i))
+		if _, err := filesys.WriteTree(page); nil != err {
+			return err
+		}
+		treenode.UpsertBlockTree(page)
+		bind := &Operation{Action: "insertAttrViewBlock", AvID: f.avID, ViewID: f.tableID,
+			Srcs: []map[string]any{{"itemID": ast.NewNodeID(), "id": pageID, "isDetached": false}}}
+		if err := PerformTxSync(&Transaction{DoOperations: []*Operation{bind}}); nil != err {
+			return err
+		}
+		return RemoveDoc(files.box.ID, page.Path)
+	})
+	r.worker("daily notes", func(i int) error {
+		_, _, err := CreateDailyNoteAt(files.box.ID, time.Date(2026, 10, 1+i%5, 9, 0, 0, 0, time.Local))
+		return err
+	})
+	r.worker("duplicates and history rollbacks", func(i int) error {
+		time.Sleep(time.Second)
+		if 0 == i%2 {
+			newAvID, _, err := DuplicateDatabaseBlock(f.avID)
+			if "" != newAvID {
+				t.Cleanup(func() { cache.RemoveAVData(newAvID) })
+			}
+			return err
+		}
+		return RollbackAttributeViewHistory(historyAVPath)
+	})
+	r.worker("moves and page restores", func(i int) error {
+		if 0 == i%2 {
+			bt := treenode.GetBlockTree(stressMovePage)
+			if nil == bt {
+				return fmt.Errorf("the moving page isn't in the block index")
+			}
+			to := files.targetPath
+			if strings.Count(bt.Path, "/") > 1 {
+				to = "/"
+			}
+			return MoveDocs([]string{bt.Path}, files.box.ID, to, nil)
+		}
+		err := RollbackDocHistory(f.historyPath)
+		time.Sleep(100 * time.Millisecond)
+		return err
+	})
+
+	time.Sleep(*locksStress)
+	r.stop.Store(true)
+	stopped := make(chan struct{})
+	go func() {
+		r.wg.Wait()
+		close(stopped)
+	}()
+	if !waitOrDump(t, "the workers", 120*time.Second, stopped) {
+		os.Exit(1) // the cleanups would wait on the stuck turn too
+	}
+	close(flusherStop)
+	<-flusherDone
+	drained := make(chan struct{})
+	go func() {
+		FlushTxQueue()
+		backgroundRefreshWaitGroup.Wait()
+		sql.FlushQueue()
+		close(drained)
+	}()
+	if !waitOrDump(t, "the job queue and background refreshes", 60*time.Second, drained) {
+		os.Exit(1)
+	}
+
+	r.mu.Lock()
+	for _, name := range slices.Sorted(maps.Keys(r.ops)) {
+		t.Logf("%-34s %5d operations, %4d errors %s", name, r.ops[name], r.errs[name], r.sample[name])
+	}
+	r.mu.Unlock()
+
+	// What every watched block reads is what its file holds.
+	for _, id := range f.watchedIDs {
+		want, err := fileBlockAttrs(id)
+		if nil != err {
+			t.Errorf("read %s from its file: %v", id, err)
+			continue
+		}
+		got := sql.GetBlockAttrs(id)
+		for _, key := range slices.Sorted(maps.Keys(want)) {
+			if strings.HasPrefix(key, "custom-") && got[key] != want[key] {
+				t.Errorf("after the stress, %s %s reads %q, its file holds %q", id, key, got[key], want[key])
+			}
+		}
+	}
+}
